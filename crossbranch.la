# ════════════════════════════════════════════════════════════════
#  crossbranch.la — THE CROSS-BRANCH COMPRESSION COLLAPSE: κ_B ≡ κ_B' ?
#
#  ★★ TWO PREMISES OF THE REQUEST FAIL, AND THEY ARE REPORTED FIRST RATHER THAN BUILT AROUND.
#
#  (i) **THERE ARE NOT TWENTY-EIGHT BRANCHES. THERE ARE NINETEEN.** `branchgenesis.la` admits 18 base
#      branches plus Δ_B itself (gated: "base=18 … set=19"); the other names in that file are the SIX
#      REFUSAL FIXTURES, not branches. Of the six dimensions the request requires, three exist as built
#      branches — phonetics/phonology, semantics, syntax — and **Liminal and Anamnetic do not exist
#      anywhere in the tree** (zero occurrences). LA_TOMORROW.md records why: they are TTOE branches
#      NAMED-BUT-NOT-BUILT, **BLOCKED on a definition that is not on disk** (the Codex Llogoscribeologiae),
#      with the standing instruction *"ask Erik or do not invent."* This module does not invent them.
#
#  (ii) **THERE IS ONLY ONE COMPRESSION OPERATION IN THE CODE, SO THE COLLAPSE IS TRUE BY CONSTRUCTION,
#      NOT BY CONVERGENCE.** Every branch is sealed by the same `SEALc` (`branchgenesis.la:121`,
#      `BG = la x. SEALc(CONT(RELATION)(x))`); there is no per-branch compression anywhere. So "κ_B ≡ κ_B'
#      for all B,B'" is not the discovery of twenty-eight independent operations agreeing — it is the
#      observation that ONE function is called in every branch. **Asserting it without saying that would
#      be a vacuous green**, which is this project's most frequent defect and the thing the request itself
#      rightly warns against ("a gate that cannot go red is not a gate").
#
#  ★ SO WHAT MAKES THIS GATE REAL IS THE FIXTURES. The comparison is shown to DISCRIMINATE by running it
#  against two constructed branches whose compression genuinely differs — exactly the two failure paths
#  the request specifies:
#    PATH A — COMPRESSION BY CONVENTION: a branch whose "compression" is a stipulated ren rather than a
#             structural operation. Its ren is not its etymology, `AUTO_OK` is FALSE, and it therefore
#             CANNOT be canonicalized as an operation. Extraction fails and the branch is NAMED.
#    PATH B — COMPRESSION BY DELETION: a branch that compresses by dropping a parent (▷, which keeps a
#             direction) instead of merging (⊗ ≡ 𝔑, which retains both). Its canonical form DIFFERS from
#             every merging branch's, and every pair it takes part in is RED.
#  If neither fired, the green above would mean nothing.
#
#  ★ OPERATION, NOT OUTPUT — the distinction the request insists on. What is compared is the GLYPH OF THE
#  OPERATOR used at the sealing step (𝔑 ≡ ⊗, Def. neologo), canonicalized by κ. Two branches producing the
#  same output by different operators would still be RED here, and Path B is precisely that case.
#
#  ★★ THE ANSWER TO "operation level or fixed-point level": **OPERATION LEVEL, and trivially so.** The
#  branches do not converge to κ en route from different starting operations; they each call the one
#  sealer. The strong claim ("the compression operation IS κ across all branches") is TRUE for the 18
#  built branches. The interesting claim ("twenty-eight independent operations converge") is NOT TESTED,
#  because the independent operations do not exist to be tested.
#
#  GATE (gate_registers.sh §46)  18 branches extracted; all pairs κ-identical; Path A named; Path B named
#        and its pairs counted RED.
#        RED PATHS: the two fixtures above, both firing in the green run itself (they are in-file, so the
#        discrimination is witnessed on EVERY run, not assumed).
#  ★ EVIDENTIAL: [W] the extraction, the pairwise identity, both failure paths; [B] **the collapse is
#     gated for the 18 BUILT branches only, and it holds BY CONSTRUCTION (one sealer), not by convergence.
#     Against the Codex Llogoscribeologiae's own list (App B): fifteen of its twenty-eight are not among
#     the 18 built — the overlap is its 13 Tier-5 branches. The five deferred branches now HAVE definitions
#     (codex ~4120–4175, corrected 2026-09-18); what is still owed is each one's interface operand x.** The ledger row stays [B] with that bound, not [W].
#  Pure strings + κ walks ⇒ byte-identical on the C host and the SECD VM.
# ════════════════════════════════════════════════════════════════
import("recdepth.la")   # NORMK CANON AUTO_OK MONO the mode forms + the base surface

export XB_EXTRACT XB_BUILT XB_ALL XB_PAIRS XB_SAME

glyph XB_B = la b. b("T")("F")
# Px comes from recdepth.la (a local copy was dead under tiny_host — FREEZE-TRACKF.md F8, removed 2026-09-18)
glyph XB_JOIN = Z(la self. la l. l("")(la h. la t. concat(h)(self(t))))

# ── a branch record: (name, compression-operator glyph). EXTRACTION returns "" when the operator cannot
#    be canonicalized as a structural operation (its ren is not its etymology). ──
glyph XB_MERGE  = MONO(CANON(MODE_SYN_F))(MODE_SYN_F)      # 𝔑 ≡ ⊗ : merge, both parents retained
glyph XB_DELETE = MONO(CANON(MODE_DIR_F))(MODE_DIR_F)      # ▷ : compress by dropping a parent
glyph XB_CONV   = MONO("by-convention")(MODE_SYN_F)        # a stipulated ren: NOT a structural operation
glyph XB_EXTRACT = la g. IF(AUTO_OK(g))(la _. NORMK(ETYM(g)))(la _. "")

glyph XB_BR = la nm. la op. PAIRc(nm)(op)
glyph XB_BUILT =
  CONSc(XB_BR("phonetics")(XB_MERGE))(
  CONSc(XB_BR("phonology")(XB_MERGE))(
  CONSc(XB_BR("morphology")(XB_MERGE))(
  CONSc(XB_BR("syntax")(XB_MERGE))(
  CONSc(XB_BR("semantics")(XB_MERGE))(
  CONSc(XB_BR("pragmatics")(XB_MERGE))(
  CONSc(XB_BR("discourse")(XB_MERGE))(
  CONSc(XB_BR("etymology")(XB_MERGE))(
  CONSc(XB_BR("semiotics")(XB_MERGE))(
  CONSc(XB_BR("historical")(XB_MERGE))(
  CONSc(XB_BR("sociolinguistics")(XB_MERGE))(
  CONSc(XB_BR("psycholinguistics")(XB_MERGE))(
  CONSc(XB_BR("computational")(XB_MERGE))(
  CONSc(XB_BR("grammatology")(XB_MERGE))(
  CONSc(XB_BR("grapholinguistics")(XB_MERGE))(
  CONSc(XB_BR("hermeneutics")(XB_MERGE))(
  CONSc(XB_BR("poetics")(XB_MERGE))(
  CONSc(XB_BR("ethics")(XB_MERGE))(
  NILc))))))))))))))))))
glyph XB_ALL = CONSc(XB_BR("FIXTURE-deletion")(XB_DELETE))(CONSc(XB_BR("FIXTURE-convention")(XB_CONV))(XB_BUILT))

# ── pairwise over the BUILT branches: identical canonical forms? ──
glyph XB_OK = la e. NOT(str_eq(XB_EXTRACT(SNDc(e)))(""))
glyph XB_SAME = la a. la b. AND(XB_OK(a))(AND(XB_OK(b))(str_eq(XB_EXTRACT(SNDc(a)))(XB_EXTRACT(SNDc(b)))))
glyph XB_PAIRS = Z(la self. la l. l(PAIRc(0)(0))(la h. la t.
  (la rest. RD_FOLD(la o. la acc.
     IF(XB_SAME(h)(o))(la _. PAIRc(add(FSTc(acc))(1))(SNDc(acc)))
                      (la _. PAIRc(FSTc(acc))(add(SNDc(acc))(1))))(rest)(t))(self(t))))
glyph XB_UNEXTRACTABLE = RD_FOLD(la e. la acc. IF(XB_OK(e))(la _. acc)(la _. FSTc(e)))("")(XB_ALL)

glyph REPORT =
  XB_JOIN(
  CONSc("CROSSBRANCH branches BUILT=")(
  CONSc(int_to_str(LEN(XB_BUILT)))(
  CONSc(" (NOT 28 — branchgenesis gates base=18, set=19 with Δ_B; Liminal and Anamnetic do not exist and are BLOCKED on a definition not on disk)")(
  CONSc(" | extracted=")(
  CONSc(int_to_str(RD_FOLD(la e. la acc. add(acc)(IF(XB_OK(e))(la _. 1)(la _. 0)))(0)(XB_BUILT)))(
  CONSc("\nCROSSBRANCH pairwise over the built branches — κ-IDENTICAL pairs: ")(
  CONSc(int_to_str(FSTc(XB_PAIRS(XB_BUILT))))(
  CONSc(" DIFFERING pairs: ")(
  CONSc(int_to_str(SNDc(XB_PAIRS(XB_BUILT))))(
  CONSc(" | all pairs collapse:")(
  CONSc(XB_B(int_eq(SNDc(XB_PAIRS(XB_BUILT)))(0)))(
  CONSc(" ★ BUT BY CONSTRUCTION, NOT BY CONVERGENCE: every branch is sealed by the ONE SEALc of branchgenesis.la:121; there is no per-branch compression in the code to converge")(
  CONSc("\nCROSSBRANCH PATH A (compression by CONVENTION — a stipulated ren, not a structural operation): extractable:")(
  CONSc(XB_B(XB_OK(PAIRc("c")(XB_CONV))))(
  CONSc(" (must be F) OFFENDER=")(
  CONSc(XB_UNEXTRACTABLE)(
  CONSc(" | PATH B (compression by DELETION — ▷ drops a parent instead of ⊗ merging): κ form=")(
  CONSc(XB_EXTRACT(XB_DELETE))(
  CONSc(" vs merging branches’ ")(
  CONSc(XB_EXTRACT(XB_MERGE))(
  CONSc(" differs:")(
  CONSc(XB_B(NOT(str_eq(XB_EXTRACT(XB_DELETE))(XB_EXTRACT(XB_MERGE)))))(
  CONSc(" — both failure paths FIRE, so the green above is a real comparison and not a tautology")(
  CONSc("\nCROSSBRANCH ★★ VERDICT [B]: the collapse holds AT THE OPERATION LEVEL for the 18 BUILT branches, trivially — they do not converge to κ from different operations, they each call the one sealer. The strong reading (“twenty-eight independent operations are identical”) is NOT TESTED because those operations do not exist. Ledger row stays [B] with the bound named, not [W]")(
  NILc)))))))))))))))))))))))))
glyph MAIN = print(REPORT)
