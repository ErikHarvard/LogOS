glyph X25519_TOPA = la m. la X. la K.
  X(la a. la b. la c. la d. la e. la f. la g. la h. la i. la j. K(m(a))(m(b))(m(c))(m(d))(m(e))(m(f))(m(g))(m(h))(m(i))(m(j)))
glyph X25519_L2 = la p. la s. la Q. la O. la R.
    la a. la b. la c. la d. la e. la f. la g. la h. la i. la j.
    la A. la B. la C. la D. la E. la F. la G. la H. la I. la J. la K.
  K(la k. k(p(a)(A))(p(b)(B))(p(c)(C))(p(d)(D))(p(e)(E))
