# ═══════════════════════════════════════════════════════════════════════
#  metalogic_spec.la — the THREE LAWS OF THOUGHT as first-class glyphs,
#  instantiating the TTOE's metalogical ontosyntax, written as a SPEC and
#  produced by the spec→implementation pipeline (import("specpipe.la")).
#
#  Sources: Codex I (Being & Becoming) and Logos & Paradox.
#
#  ── FALSIFIABLE LAWS (LA completion arc, item 1) ───────────────────────
#  A law that cannot return FALSE distinguishes nothing (Popper: unfalsifiable
#  ⇒ vacuous). The earlier laws — `la a. TRIBAR(a)(a)`, `¬(X∧¬X)`, `X∨¬X` —
#  were constant-TRUE tautologies on every input, and their "autology" applied
#  each law to a STRING PROXY of its own name, never to itself. This version
#  grounds each law in machinery that ALREADY has both TRUE and FALSE witnesses,
#  so each law now separates law-abiding structures from violating ones AND
#  genuinely self-applies (a law is built as a monoglyph its own predicate can
#  judge — no string proxy, no type error):
#
#    LAW_IDENTITY          g ↦ AUTO_OK(g)      a glyph IS its own etymology
#                                              (REN g ≡ κ(ETYM g)); FALSE when a
#                                              heterological Ren floats free.
#    LAW_NONCONTRADICTION  t ↦ INHABITS(...)   a term cannot both inhabit and
#                                              not-inhabit its type; FALSE on an
#                                              arity contradiction (decl ≠ body).
#    LAW_EXCLUDED_MIDDLE   t ↦ WELLFORMED(t)   a term either has a being or not,
#                                              no silent third; FALSE on the
#                                              empty-form term (no being).
#
#  ── HONEST BOUND (Gödel II) ────────────────────────────────────────────
#  The laws close to BOUNDED SELF-VERIFICATION, not total soundness.
#  LAWS_AUTOLOGICAL proves each law-glyph abides by the identity law (its Ren
#  is its etymology) — a finite consistency check RELATIVE TO the criterion. It
#  does not and cannot prove its own completeness or joint consistency from
#  within (a consistent system of sufficient strength cannot prove its own
#  consistency). What is witnessed is LOCAL AUTOLOGICAL CLOSURE — the same bound
#  canon.la's NORMK and denote.la's κ-agreement already carry, not a
#  frame-independent metatheorem.
#
#  ── THE TWO RELATIONS, NEVER CONFLATED (retained) ──────────────────────
#  ≡ TRIBAR — ONTOLOGICAL IDENTITY over a being's self-grounded FORM (∃(∃) ≡ ∃).
#  = YIELDS — COMPUTATIONAL EQUALITY over evaluated VALUE. They disagree:
#  add(2,3) = 5 yet add(2,3) ≢ 5; TRIBAR ⟹ YIELDS but YIELDS ⇏ TRIBAR.
#
#  ── κ MACHINERY IS INLINED, NOT IMPORTED ───────────────────────────────
#  canon.la has no `export` line and nothing import()s it; modules that walk
#  κ-nodes (sigil, denote, metaglyph) each re-inline the constructors. This
#  follows suit — the node constructors, CANON, MONO/REN/ETYM and AUTO_OK are
#  inlined verbatim from canon_spec.la — which also sidesteps the codegen /
#  mangling risk entirely.
#
#  This is NOT hand-written module source: it is a SPECIFICATION. DEPLOY writes
#  metalogic.la, type-checks the generated source, and META_DEBUG verifies every
#  glyph; the module is accepted only if all pass.
# ═══════════════════════════════════════════════════════════════════════

import("specpipe.la")   # GENERATE / DEPLOY / META_DEBUG + PAIR/FST/SND/CONS/NIL/Z/IF/TRUE/FALSE/AND/...

# ── implementation VALUES (what META_DEBUG runs) ──────────────────────────────
# Logical core (Church booleans; TRUE/FALSE/AND/IF come from specpipe at authoring
# time, and are SHIPPED into the generated module so it is self-contained).
glyph NOT     = la b. b(FALSE)(TRUE)
glyph OR      = la a. la b. a(TRUE)(b)
glyph IMPLIES = la a. la b. OR(NOT(a))(b)

# Z — the call-by-value fixed-point combinator (shipped: CANON is Z-recursive).
glyph ZC = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))

# A TERM carries both projections of a being: its FORM (intension — the being's
# self-disclosure) and its VAL (extension — what it evaluates to).
glyph TERM = la form. la val. la f. f(form)(val)
glyph FORM = la t. t(la form. la val. form)
glyph VAL  = la t. t(la form. la val. val)

# GROUND — the one self-grounding rewrite (the Archē): ∃(∃) normalizes to ∃.
glyph GROUND = la s. IF(str_eq(s)("∃(∃)"))(la _. "∃")(la _. s)

# THE TWO RELATIONS — never conflated.
glyph YIELDS = la a. la b. str_eq(VAL(a))(VAL(b))
glyph TRIBAR = la a. la b. str_eq(GROUND(FORM(a)))(GROUND(FORM(b)))

# ── κ machinery, inlined from canon_spec.la (node constructors, CANON, the
#    etymology layer, AUTO_OK). Scott-encoded nodes; CANON is a Z-recursive
#    prefix-string walker; a monoglyph MONO(ren)(etym) is autological iff its
#    stored Ren equals the canonical form of its etymology. ─────────────────────
glyph PRIM = la nm. la fp. la fs. la fc. la fd. la fo. la fm. fp(nm)
glyph SYN  = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fs(a)(b)
glyph CON  = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fc(a)(b)
glyph DIR  = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fd(a)(b)
glyph CONT = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fo(a)(b)
glyph MC   = la a. la fp. la fs. la fc. la fd. la fo. la fm. fm(a)
glyph CANON = ZC(la self. la node. node (la nm. nm) (la a. la b. concat("⊗(")(concat(self(a))(concat(",")(concat(self(b))(")"))))) (la a. la b. concat("⊕(")(concat(self(a))(concat(",")(concat(self(b))(")"))))) (la a. la b. concat("▷(")(concat(self(a))(concat(",")(concat(self(b))(")"))))) (la a. la b. concat("⊂(")(concat(self(a))(concat(",")(concat(self(b))(")"))))) (la a. concat("↻(")(concat(self(a))(")"))))
glyph MONO = la ren. la etym. la f. f(ren)(etym)
glyph REN  = la g. g(la r. la e. r)
glyph ETYM = la g. g(la r. la e. e)
glyph AUTO_OK = la g. str_eq(REN(g))(CANON(ETYM(g)))

# ── LAW OF IDENTITY → autological well-formedness (AUTO_OK) ────────────────────
# The law of identity as a LAW is not "A≡A" (vacuous) but "the system treats
# identicals as identical": a being's name IS its etymology, REN(g) ≡ κ(ETYM g).
glyph LAW_IDENTITY = la g. AUTO_OK(g)

# ── LAW OF NON-CONTRADICTION → type-lock (INHABITS) ────────────────────────────
# A term cannot both inhabit and not-inhabit a type. An arity term carries its
# declared and its body arity; INHABITS decides, and already has a FALSE case.
glyph ATERM      = la d. la b. la f. f(d)(b)
glyph DECL_ARITY = la t. t(la d. la b. d)
glyph BODY_ARITY = la t. t(la d. la b. b)
glyph INHABITS   = la dec. la bod. int_eq(dec)(bod)
glyph LAW_NONCONTRADICTION = la term. INHABITS(DECL_ARITY(term))(BODY_ARITY(term))
# The old ¬(INHABITS ∧ ¬INHABITS) stays as the META-statement — itself a
# tautology, correctly — but the LAW now returns the INHABITS verdict directly.
glyph NC_TYPECHECK = la dec. la bod. NOT(AND(INHABITS(dec)(bod))(NOT(INHABITS(dec)(bod))))

# ── LAW OF EXCLUDED MIDDLE → total verdict / well-formedness ───────────────────
# A term either has a being or not; no silent third. VERDICT is total; on an
# ill-formed term VERDICT_OR_DIE HALTS LOUDLY. The law reports the missing middle.
glyph VERDICT       = la a. la b. IF(TRIBAR(a)(b))(la _. "≡")(la _. "≢")
glyph WELLFORMED    = la a. NOT(str_eq(FORM(a))(""))
glyph LAW_EXCLUDED_MIDDLE = la term. WELLFORMED(term)
glyph VERDICT_OR_DIE = la a. la b.
    IF(WELLFORMED(a))(la _. VERDICT(a)(b))
        (la _. error("metalogic: ill-formed term — excluded middle admits no silent third value; halting"))

# ── the three laws AS MONOGLYPHS, so each law self-applies for real ────────────
# Each law is built as a sealed monoglyph MONO(κ(node))(node) — its Ren IS its
# canonical etymology by construction, so it is autological, and LAW_IDENTITY run
# on it is genuine (AUTO_OK of the law's own structure), never a string proxy.
# The etymology nodes are principled decompositions (like metaglyph's mode
# assignments): identity = ↻(BEING) (being folded on itself), non-contradiction =
# ▷(FORM,VOID) (a form directed away from its own absence), excluded middle =
# ⊗(BEING,VOID) (being and void as the exhaustive dichotomy).
glyph LAW_IDENTITY_G         = MONO(CANON(MC(PRIM("BEING"))))(MC(PRIM("BEING")))
glyph LAW_NONCONTRADICTION_G = MONO(CANON(DIR(PRIM("FORM"))(PRIM("VOID"))))(DIR(PRIM("FORM"))(PRIM("VOID")))
glyph LAW_EXCLUDED_MIDDLE_G  = MONO(CANON(SYN(PRIM("BEING"))(PRIM("VOID"))))(SYN(PRIM("BEING"))(PRIM("VOID")))

# AUTOLOGY: each law-glyph abides by the identity law — its Ren is its etymology.
# A finite, decidable consistency check relative to the criterion (Gödel bound
# stated in the header). Genuine self-application: AUTO_OK run on the real
# law-monoglyphs, not string names. (Thunked; force with any argument.)
glyph LAWS_AUTOLOGICAL = la _.
    AND(LAW_IDENTITY(LAW_IDENTITY_G))
       (AND(LAW_IDENTITY(LAW_NONCONTRADICTION_G))
            (LAW_IDENTITY(LAW_EXCLUDED_MIDDLE_G)))

# ── source strings (what GENERATE writes; behaviourally equal to the values) ──
glyph SRC_TRUE   = "la t. la f. t"
glyph SRC_FALSE  = "la t. la f. f"
glyph SRC_NOT    = "la b. b(FALSE)(TRUE)"
glyph SRC_AND    = "la a. la b. a(b)(FALSE)"
glyph SRC_OR     = "la a. la b. a(TRUE)(b)"
glyph SRC_IF     = "la c. la t. la f. c(t)(f)(\"!\")"
glyph SRC_IMPL   = "la a. la b. OR(NOT(a))(b)"
glyph SRC_ZC     = "la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))"
glyph SRC_TERM   = "la form. la val. la f. f(form)(val)"
glyph SRC_FORM   = "la t. t(la form. la val. form)"
glyph SRC_VAL    = "la t. t(la form. la val. val)"
glyph SRC_GROUND = "la s. IF(str_eq(s)(\"∃(∃)\"))(la _. \"∃\")(la _. s)"
glyph SRC_YIELDS = "la a. la b. str_eq(VAL(a))(VAL(b))"
glyph SRC_TRIBAR = "la a. la b. str_eq(GROUND(FORM(a)))(GROUND(FORM(b)))"
glyph SRC_PRIM   = "la nm. la fp. la fs. la fc. la fd. la fo. la fm. fp(nm)"
glyph SRC_SYN    = "la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fs(a)(b)"
glyph SRC_CON    = "la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fc(a)(b)"
glyph SRC_DIR    = "la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fd(a)(b)"
glyph SRC_CONT   = "la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fo(a)(b)"
glyph SRC_MC     = "la a. la fp. la fs. la fc. la fd. la fo. la fm. fm(a)"
glyph SRC_CANON  = "ZC(la self. la node. node (la nm. nm) (la a. la b. concat(\"⊗(\")(concat(self(a))(concat(\",\")(concat(self(b))(\")\"))))) (la a. la b. concat(\"⊕(\")(concat(self(a))(concat(\",\")(concat(self(b))(\")\"))))) (la a. la b. concat(\"▷(\")(concat(self(a))(concat(\",\")(concat(self(b))(\")\"))))) (la a. la b. concat(\"⊂(\")(concat(self(a))(concat(\",\")(concat(self(b))(\")\"))))) (la a. concat(\"↻(\")(concat(self(a))(\")\"))))"
glyph SRC_MONO   = "la ren. la etym. la f. f(ren)(etym)"
glyph SRC_REN    = "la g. g(la r. la e. r)"
glyph SRC_ETYM   = "la g. g(la r. la e. e)"
glyph SRC_AUTOOK = "la g. str_eq(REN(g))(CANON(ETYM(g)))"
glyph SRC_ATERM  = "la d. la b. la f. f(d)(b)"
glyph SRC_DECLA  = "la t. t(la d. la b. d)"
glyph SRC_BODYA  = "la t. t(la d. la b. b)"

# ── sequence-validator VALUES (spec-side twins of the SRC strings above) ──
glyph ITEM   = la m. la a. la t. la f. f(m)(a)(t)
glyph ITMONO = la it. it(la m. la a. la t. m)
glyph ITAR   = la it. it(la m. la a. la t. a)
glyph ITTERM = la it. it(la m. la a. la t. t)
glyph LAWS_ALL = la it. AND(LAW_IDENTITY(ITMONO(it)))(AND(LAW_NONCONTRADICTION(ITAR(it)))(LAW_EXCLUDED_MIDDLE(ITTERM(it))))
glyph SNIL   = la n. la c. n
glyph SCONS  = la h. la t. la n. la c. c(h)(t)
glyph SEQ_OK = ZC(la self. la s. s(TRUE)(la h. la t. AND(LAWS_ALL(h))(self(t))))
glyph RENCMP = la ra. la rb. concat("⊗(")(concat(ra)(concat(",")(concat(rb)(")"))))
glyph SEQ_COMPOSE = ZC(la self. la s. s(MONO("")(PRIM("VOID")))(la h. la t. t(ITMONO(h))(la h2. la t2. (la rest. MONO(RENCMP(REN(ITMONO(h)))(REN(rest)))(SYN(ETYM(ITMONO(h)))(ETYM(rest))))(self(t)))))
glyph SEQ_VALID = la s. AND(SEQ_OK(s))(AUTO_OK(SEQ_COMPOSE(s)))
# fixtures: a law-abiding item, and one whose Ren FLOATS FREE of its etymology.
# The heterological one is what gives every FALSE witness above a real cause.
glyph GOOD_ITEM   = ITEM(MONO(CANON(MC(PRIM("BEING"))))(MC(PRIM("BEING"))))(ATERM(2)(2))(ADD23)
glyph HETERO_ITEM = ITEM(MONO("floats-free")(MC(PRIM("BEING"))))(ATERM(2)(2))(ADD23)

glyph SRC_LAWID  = "la g. AUTO_OK(g)"

# ── the SEQUENCE VALIDATOR (Erik 2.4): a spoken/compiled glyph SEQUENCE checked
#    against the ontosyntax. An ITEM carries the three aspects the three laws
#    each need -- identity (monoglyph), arity, and form -- because the laws are
#    NOT type-uniform: identity applies to a monoglyph, non-contradiction to an
#    arity term, excluded middle to a form-bearing term.
glyph SRC_ITEM   = "la m. la a. la t. la f. f(m)(a)(t)"
glyph SRC_ITMONO = "la it. it(la m. la a. la t. m)"
glyph SRC_ITAR   = "la it. it(la m. la a. la t. a)"
glyph SRC_ITTERM = "la it. it(la m. la a. la t. t)"
glyph SRC_LAWSALL= "la it. AND(LAW_IDENTITY(ITMONO(it)))(AND(LAW_NONCONTRADICTION(ITAR(it)))(LAW_EXCLUDED_MIDDLE(ITTERM(it))))"
glyph SRC_SNIL   = "la n. la c. n"
glyph SRC_SCONS  = "la h. la t. la n. la c. c(h)(t)"
glyph SRC_SEQOK  = "ZC(la self. la s. s(TRUE)(la h. la t. AND(LAWS_ALL(h))(self(t))))"
# the composite's Ren is built from the PARTS' DECLARED Rens -- never recomputed
# from the structure, which is what keeps the closure test able to FAIL.
glyph SRC_RENCMP = "la ra. la rb. concat(\"⊗(\")(concat(ra)(concat(\",\")(concat(rb)(\")\"))))"
glyph SRC_SEQCMP = "ZC(la self. la s. s(MONO(\"\")(PRIM(\"VOID\")))(la h. la t. t(ITMONO(h))(la h2. la t2. (la rest. MONO(RENCMP(REN(ITMONO(h)))(REN(rest)))(SYN(ETYM(ITMONO(h)))(ETYM(rest))))(self(t)))))"
glyph SRC_SEQVAL = "la s. AND(SEQ_OK(s))(AUTO_OK(SEQ_COMPOSE(s)))"
glyph SRC_SEQDIE = "la s. IF(SEQ_VALID(s))(la _. \"VALID\")(la _. error(\"ontosyntax: sequence violates the three laws\"))"
glyph SRC_LAWNC  = "la term. INHABITS(DECL_ARITY(term))(BODY_ARITY(term))"
glyph SRC_LAWEM  = "la term. WELLFORMED(term)"
glyph SRC_INHAB  = "la dec. la bod. int_eq(dec)(bod)"
glyph SRC_NCTC   = "la dec. la bod. NOT(AND(INHABITS(dec)(bod))(NOT(INHABITS(dec)(bod))))"
glyph SRC_VERD   = "la a. la b. IF(TRIBAR(a)(b))(la _. \"≡\")(la _. \"≢\")"
glyph SRC_WF     = "la a. NOT(str_eq(FORM(a))(\"\"))"
glyph SRC_VOD    = "la a. la b. IF(WELLFORMED(a))(la _. VERDICT(a)(b))(la _. error(\"metalogic: ill-formed term — excluded middle admits no silent third value; halting\"))"
glyph SRC_LIG    = "MONO(CANON(MC(PRIM(\"BEING\"))))(MC(PRIM(\"BEING\")))"
glyph SRC_LNG    = "MONO(CANON(DIR(PRIM(\"FORM\"))(PRIM(\"VOID\"))))(DIR(PRIM(\"FORM\"))(PRIM(\"VOID\")))"
glyph SRC_LEG    = "MONO(CANON(SYN(PRIM(\"BEING\"))(PRIM(\"VOID\"))))(SYN(PRIM(\"BEING\"))(PRIM(\"VOID\")))"
glyph SRC_AUTO   = "la _. AND(LAW_IDENTITY(LAW_IDENTITY_G))(AND(LAW_IDENTITY(LAW_NONCONTRADICTION_G))(LAW_IDENTITY(LAW_EXCLUDED_MIDDLE_G)))"

# ── test scaffolding (spec-file-local; NOT part of the generated module) ──────
glyph TC  = la probe. la expected. PAIR(probe)(expected)
glyph T1L = la a. CONS(a)(NIL)
glyph T2L = la a. la b. CONS(a)(CONS(b)(NIL))
glyph T3L = la a. la b. la c. CONS(a)(CONS(b)(CONS(c)(NIL)))
glyph T4L = la a. la b. la c. la d. CONS(a)(CONS(b)(CONS(c)(CONS(d)(NIL))))
glyph E   = la name. la sig. la src. la val. la tests. TRIPLE(name)(DEF(sig)(src)(val))(tests)

# witness terms (spec-local). The category-error pair + the Archē; the FALSE
# witnesses per law (the crux of item 1 — each law now returns T AND F):
glyph ADD23     = TERM("add(2,3)")(int_to_str(add(2)(3)))   # a being with a form
glyph FIVE      = TERM("5")(int_to_str(5))
glyph EXIST     = TERM("∃")("∃")
glyph EMPTY     = TERM("")("x")                             # NO form → no being (EM FALSE witness)
# a HETEROLOGICAL monoglyph: its Ren floats free of its etymology (identity FALSE
# witness) — the first real FALSE the law of identity has ever produced.
glyph HETERO_ID = MONO("floats-free")(MC(PRIM("BEING")))

# ── the SPEC ──────────────────────────────────────────────────────────────────
glyph METALOGIC_SPEC =
  CONS(E("TRUE")(":: a -> b -> a")(SRC_TRUE)(TRUE)(
        T1L(TC(la g. g("yes")("no"))("yes"))))(
  CONS(E("FALSE")(":: a -> b -> b")(SRC_FALSE)(FALSE)(
        T1L(TC(la g. g("yes")("no"))("no"))))(
  CONS(E("NOT")(":: a -> a")(SRC_NOT)(NOT)(
        T2L(TC(la g. g(TRUE)("y")("n"))("n"))
           (TC(la g. g(FALSE)("y")("n"))("y"))))(
  CONS(E("AND")(":: a -> b -> c")(SRC_AND)(AND)(
        T2L(TC(la g. g(TRUE)(TRUE)("y")("n"))("y"))
           (TC(la g. g(TRUE)(FALSE)("y")("n"))("n"))))(
  CONS(E("OR")(":: a -> b -> c")(SRC_OR)(OR)(
        T2L(TC(la g. g(FALSE)(TRUE)("y")("n"))("y"))
           (TC(la g. g(FALSE)(FALSE)("y")("n"))("n"))))(
  CONS(E("IF")(":: a -> b -> c -> d")(SRC_IF)(IF)(
        T2L(TC(la g. g(TRUE)(la _. "y")(la _. "n"))("y"))
           (TC(la g. g(FALSE)(la _. "y")(la _. "n"))("n"))))(
  CONS(E("IMPLIES")(":: a -> b -> c")(SRC_IMPL)(IMPLIES)(
        T2L(TC(la g. g(FALSE)(FALSE)("T")("F"))("T"))
           (TC(la g. g(TRUE)(FALSE)("T")("F"))("F"))))(
  CONS(E("ZC")("the call-by-value fixed-point combinator (trusted)")(SRC_ZC)(ZC)(
        T1L(TC(la z. z(la self. la x. x)("ok"))("ok"))))(
  CONS(E("TERM")(":: a -> b -> c -> d")(SRC_TERM)(TERM)(
        T1L(TC(la g. g("fo")("va")(la f. la v. concat(f)(v)))("fova"))))(
  CONS(E("FORM")(":: a -> b")(SRC_FORM)(FORM)(
        T1L(TC(la g. g(TERM("fo")("va")))("fo"))))(
  CONS(E("VAL")(":: a -> b")(SRC_VAL)(VAL)(
        T1L(TC(la g. g(TERM("fo")("va")))("va"))))(
  CONS(E("GROUND")(":: a -> b")(SRC_GROUND)(GROUND)(
        T2L(TC(la g. g("∃(∃)"))("∃"))
           (TC(la g. g("B"))("B"))))(
  CONS(E("YIELDS")(":: a -> b -> c")(SRC_YIELDS)(YIELDS)(
        T3L(TC(la g. g(ADD23)(FIVE)("=")("x"))("="))
           (TC(la g. g(ADD23)(ADD23)("=")("x"))("="))
           (TC(la g. g(EXIST)(EXIST)("=")("x"))("="))))(
  CONS(E("TRIBAR")(":: a -> b -> c")(SRC_TRIBAR)(TRIBAR)(
        T3L(TC(la g. g(ADD23)(ADD23)("≡")("≢"))("≡"))
           (TC(la g. g(ADD23)(FIVE)("≡")("≢"))("≢"))
           (TC(la g. g(EXIST)(EXIST)("≡")("≢"))("≡"))))(
  CONS(E("PRIM")("κ node: a primitive leaf (trusted, Scott-encoded)")(SRC_PRIM)(PRIM)(
        T1L(TC(la p. p("BEING")(la n. n)(la a. la b. "s")(la a. la b. "c")(la a. la b. "d")(la a. la b. "o")(la a. "m"))("BEING"))))(
  CONS(E("SYN")("κ node: ⊗ synthesis (trusted)")(SRC_SYN)(SYN)(
        T1L(TC(la s. s(PRIM("A"))(PRIM("B"))(la n. n)(la a. la b. "s")(la a. la b. "c")(la a. la b. "d")(la a. la b. "o")(la a. "m"))("s"))))(
  CONS(E("CON")("κ node: ⊕ conjunction (trusted)")(SRC_CON)(CON)(
        T1L(TC(la c. c(PRIM("A"))(PRIM("B"))(la n. n)(la a. la b. "s")(la a. la b. "c")(la a. la b. "d")(la a. la b. "o")(la a. "m"))("c"))))(
  CONS(E("DIR")("κ node: ▷ direction (trusted)")(SRC_DIR)(DIR)(
        T1L(TC(la d. d(PRIM("A"))(PRIM("B"))(la n. n)(la a. la b. "s")(la a. la b. "c")(la a. la b. "d")(la a. la b. "o")(la a. "m"))("d"))))(
  CONS(E("CONT")("κ node: ⊂ containment (trusted)")(SRC_CONT)(CONT)(
        T1L(TC(la o. o(PRIM("A"))(PRIM("B"))(la n. n)(la a. la b. "s")(la a. la b. "c")(la a. la b. "d")(la a. la b. "o")(la a. "m"))("o"))))(
  CONS(E("MC")("κ node: ↻ metacursion (trusted)")(SRC_MC)(MC)(
