# =====================================================================
#  link_reloc.la — SLICE 3: APPLYING THE RELOCATIONS.
#
#  Slice 2 computed where everything lands. This PATCHES the code so it points
#  there: the bytes a relocation reserved are overwritten with the resolved
#  address, which is the act that turns two independent objects into one
#  coherent program.
#
#  ── WHY BYTE-IDENTITY IS LEGITIMATE HERE, HAVING BEEN REFUSED TWICE ─────────
#  slice 1 and slice 2 both refused to diff against `ld`, for a real reason:
#  ld's FILE carries choices that are ld's own (build-id, section ordering,
#  padding), so a whole-file diff measures the wrong thing.
#
#  A relocated instruction is different in kind. Given the same addresses, the
#  patched bytes are DETERMINED — `call greet` at 0x401001 targeting 0x401010
#  has exactly one correct rel32, and ld has no freedom about it. So each
#  object's patched .text is diffed BYTE-FOR-BYTE against the corresponding
#  span of ld's .text. Where the answer is forced, demand identity; where it is
#  a choice, use an independent witness. That distinction is the whole
#  verification strategy of this linker.
#
#  The one place we do keep a choice is the ALIGNMENT GAP between the two
#  objects' .text. ld fills it with a 2-byte nop (66 90); this pads with 0x90
#  single-byte nops. Both are correct and neither is reachable (control leaves
#  A via `call`), so the gate compares the two CODE SPANS and deliberately does
#  not compare the gap. That is stated rather than hidden, because a gate that
#  quietly skipped a region would be worth nothing.
#
#  ── THE TWO RELOCATION KINDS, AND WHY P MATTERS ─────────────────────────────
#    R_X86_64_PC32  (2)  value = S + A - P     4 bytes
#    R_X86_64_PLT32 (4)  value = S + A - P     4 bytes  (static: same as PC32)
#    R_X86_64_64    (1)  value = S + A         8 bytes
#
#  P — the address OF THE PATCH SITE — is what makes PC32 relative, and it is
#  the field with nowhere to hide: S and A come straight out of the object,
#  but P must be derived from the layout. Get the layout wrong and PC32 is
#  wrong while the absolute relocation still looks fine, which is exactly the
#  asymmetry this fixture pair was built to catch (A uses PC32, B uses 64).
#
#  A's `call greet` sits at .text+1, so P = 0x401000 + 1, S = 0x401010,
#  A = -4, giving 11 — and ld emits e8 0b 00 00 00. The addend is negative
#  because the CPU measures rel32 from the END of the instruction; folding it
#  into unsigned range before splitting into bytes is the same discipline
#  asm.la uses for backward jumps (LA's div/mod on a negative is unreliable).
# =====================================================================

import("link.la")

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph TRUE = la t. la f. t
glyph FALSE = la t. la f. f
glyph AND  = la a. la b. a(b)(FALSE)
glyph NOT  = la b. b(FALSE)(TRUE)
glyph OR   = la a. la b. a(TRUE)(b)
glyph CONS = la h. la t. la n. la c. c(h)(t)
glyph NIL  = la n. la c. n
glyph PAIR = la a. la b. la f. f(a)(b)
glyph FST  = la p. p(la a. la b. a)
glyph SND  = la p. p(la a. la b. b)
glyph REV  = Z(la self. la l. la acc. l(acc)(la h. la t. self(t)(CONS(h)(acc))))
glyph CAT  = Z(la self. la l. l("")(la h. la t. concat(h)(self(t))))
glyph NL   = "\n"

glyph TEXT_BASE = 4198400
glyph RODATA_BASE = 4202496

glyph ALIGNUP = la n. la a.
    IF(int_eq(a)(0))
      (la _. n)
      (la _. IF(int_eq(mod(n)(a))(0))
               (la _. n)
               (la _. add(n)(sub(a)(mod(n)(a)))))

# ── byte-string surgery ─────────────────────────────────────────────────────
glyph DROPS = Z(la self. la n. la s.
    IF(int_eq(n)(0))(la _. s)(la _. self(sub(n)(1))(str_tail(s))))
glyph TAKES = Z(la self. la n. la s.
    IF(int_eq(n)(0))(la _. "")(la _. concat(str_head(s))(self(sub(n)(1))(str_tail(s)))))
glyph B1 = la n. chr(int_to_str(mod(n)(256)))
#   Little-endian split, explicit. FOLD32 is why negatives never enter div/mod.
glyph FOLD32 = la n. IF(lt(n)(0))(la _. add(n)(4294967296))(la _. n)
glyph LE4 = la v. (la n. CAT(CONS(B1(n))(CONS(B1(div(n)(256)))(
                             CONS(B1(div(n)(65536)))(CONS(B1(div(n)(16777216)))(NIL))))))
                  (FOLD32(v))
#   The upper word is zero for every address this linker produces (see the
#   32-bit window note in link.la); emitting it explicitly keeps the field the
#   8 bytes the format demands rather than silently short-writing.
glyph LE8 = la v. concat(LE4(v))(CAT(CONS(B1(0))(CONS(B1(0))(
                                     CONS(B1(0))(CONS(B1(0))(NIL))))))

glyph PATCH = la s. la off. la width. la bytes.
    CAT(CONS(TAKES(off)(s))(CONS(bytes)(CONS(DROPS(add(off)(width))(s))(NIL))))

glyph SECBYTES = la f. la sec. TAKES(SH_SIZE(f)(sec))(DROPS(SH_OFF(f)(sec))(f))

# ── the relocation value ────────────────────────────────────────────────────
#   S, the symbol's address. An UNDEFINED symbol is the cross-object case and
#   goes to the resolver; everything else — including a SECTION symbol, whose
#   st_value is 0 — is its section's base plus its offset, so one rule covers
#   both without a special case.
#   ★ PLT32 IS PC32 HERE, and that is a statement about static linking rather
#   than a shortcut. R_X86_64_PLT32 asks for the address of the symbol's
#   PROCEDURE LINKAGE TABLE entry — the indirection a dynamic linker needs when
#   the target may live in another shared object and is only bound at load
#   time. This linker produces a static, self-contained image: the callee is in
#   the very .text being emitted, its final address is already known, so the
#   PLT entry it would jump through would be a stub that immediately jumps to
#   an address we can just write directly. Resolving it as PC32 is what `ld`
#   does for a static link too. It is NOT correct for a dynamic one, and if
#   shared objects ever arrive here this must become a real PLT.
glyph ISPCREL = la ty. OR(int_eq(ty)(2))(int_eq(ty)(4))

glyph SYMVAL = la f. la ss. la va. la resolve. la i.
    IF(SYM_IS_UNDEF(f)(ss)(i))
      (la _. resolve(SYMNAME(f)(ss)(i)))
      (la _. add(va(SYM_SHNDX(f)(ss)(i)))(SYM_VALUE(f)(ss)(i)))

#   Apply every relocation of one object's .text, folding over the list so each
#   patch sees the previous one's result.
glyph APPLYRELS = la f. la ss. la rs. la va. la resolve. la secva. la bytes.
  IF(lt(rs)(0))
    (la _. bytes)
    (la _. (Z(la self. la i. la acc.
      IF(int_eq(i)(REL_COUNT(f)(rs)))
        (la _. acc)
        (la _.
          (la off. (la ty. (la s. (la a.
            (la v.
              self(add(i)(1))
                  (IF(int_eq(ty)(1))
                     (la _. PATCH(acc)(off)(8)(LE8(v)))
                     (la _. IF(ISPCREL(ty))
                              (la _. PATCH(acc)(off)(4)(LE4(v)))
                              (la _. error(concat("link: unsupported relocation type ")(int_to_str(ty))))))
            )(IF(ISPCREL(ty))
                (la _. sub(add(s)(a))(add(secva)(off)))
                (la _. add(s)(a)))
          )(REL_ADDEND(f)(rs)(i))
          )(SYMVAL(f)(ss)(va)(resolve)(REL_SYM(f)(rs)(i)))
          )(REL_TYPE(f)(rs)(i))
          )(REL_OFFSET(f)(rs)(i)))))(0)(bytes))

#   Pad with single-byte nops — see the header on why this is our choice and
#   why the gate does not diff it.
glyph NOPS = Z(la self. la n.
    IF(int_eq(n)(0))(la _. "")(la _. concat(chr("144"))(self(sub(n)(1)))))
glyph ZEROS = Z(la self. la n.
    IF(int_eq(n)(0))(la _. "")(la _. concat(chr("0"))(self(sub(n)(1)))))
glyph LE2 = la v. concat(B1(v))(B1(div(v)(256)))

# ── SLICE 4: EMITTING THE EXECUTABLE ────────────────────────────────────────
#   The patched bytes are correct; this wraps them in the ELF a kernel will
#   load. Two PT_LOAD segments, because .text and .rodata need DIFFERENT
#   permissions — R+X and R. Emitting one RWX segment would be simpler and
#   would still run, which is exactly why it is not done: W^X is a property the
#   kernel in this project enforces on itself (ROADMAP K4c), and a linker that
#   quietly produced writable code would undercut it.
#
#   ★ THE CONSTRAINT THAT DICTATES THE FILE LAYOUT: for each segment the kernel
#   requires p_offset ≡ p_vaddr (mod page size) — it maps whole pages, so the
#   file offset and the virtual address must agree on where they sit within a
#   page. Both bases here are page-aligned (0x1000, 0x2000 in the file;
#   0x401000, 0x402000 in memory), which satisfies it in the simplest way and
#   is why the file carries padding it does not strictly "need". Violate this
#   and execve fails with ENOEXEC, or the program loads with its code at the
#   wrong address — a failure that looks like a corrupt binary, not a layout
#   bug.
glyph PAGE = 4096
glyph TEXT_FILEOFF = 4096
glyph RODATA_FILEOFF = 8192
glyph EHSIZE = 64
glyph PHENTSIZE = 56

#   e_ident: magic, ELFCLASS64, ELFDATA2LSB (little-endian), EV_CURRENT,
#   SysV ABI, then 8 zero bytes.
glyph EIDENT = CAT(CONS(chr("127"))(CONS("ELF")(CONS(B1(2))(CONS(B1(1))(
                   CONS(B1(1))(CONS(ZEROS(9))(NIL)))))))

#   ET_EXEC (2), EM_X86_64 (62). e_shoff/e_shnum/e_shstrndx are 0: section
#   headers are for linkers and debuggers, not for the loader, and this
#   produces none. The program runs without them.
glyph EHDR = la entry. la nph. CAT(
    CONS(EIDENT)(
    CONS(LE2(2))(
    CONS(LE2(62))(
    CONS(LE4(1))(
    CONS(LE8(entry))(
    CONS(LE8(EHSIZE))(
    CONS(LE8(0))(
    CONS(LE4(0))(
    CONS(LE2(EHSIZE))(
    CONS(LE2(PHENTSIZE))(
    CONS(LE2(nph))(
    CONS(LE2(0))(
    CONS(LE2(0))(
    CONS(LE2(0))(
    NIL)))))))))))))))

#   PT_LOAD. p_memsz equals p_filesz here — nothing in these fixtures needs
#   zero-fill beyond the file (no .bss), and claiming more memory than the file
#   supplies would be a silent lie about what gets mapped.
#   p_filesz and p_memsz are now DISTINCT. They were equal for every section
#   whose bytes live in the file; a NOBITS section (.bss) has filesz 0 and a
#   non-zero memsz, and the kernel zero-fills the difference. Passing one size
#   for both was correct only as long as no such section existed.
glyph PHDR = la flags. la off. la vaddr. la fsz. la msz. CAT(
    CONS(LE4(1))(
    CONS(LE4(flags))(
    CONS(LE8(off))(
    CONS(LE8(vaddr))(
    CONS(LE8(vaddr))(
    CONS(LE8(fsz))(
    CONS(LE8(msz))(
    CONS(LE8(PAGE))(
    NIL)))))))))

# ── resolution (slice 2's rule, restated over the two objects) ──────────────
glyph DEFINES = la f. la ss. la i.
    AND(SYM_IS_GLOBAL(SYM_INFO(f)(ss)(i)))
       (AND(NOT(SYM_IS_UNDEF(f)(ss)(i)))(NOT(SYM_IS_SECTION(f)(ss)(i))))
#   ★ DUPLICATE DEFINITIONS MUST BE REFUSED, and this was a real gap: LOOKUP
#   returns the FIRST match, so two objects both defining `greet` would have
#   linked silently and one definition would have been chosen by input order.
#   That is not a stylistic complaint — it is the "multiple definition" error
#   every real linker raises, and the failure it prevents is vicious: the
#   program links, runs, and calls whichever copy happened to come first, so
#   the bug presents as the wrong behaviour rather than as a link failure.
#
#   Checked BEFORE anything is emitted, so a rejected link writes no output at
#   all. A linker that refuses but leaves a stale executable behind invites the
#   next command to run yesterday's binary.
#   ★ REFUSE SECTIONS WE CANNOT PLACE, rather than ignoring them.
#   The layout knows exactly two allocatable sections, .text and .rodata. An
#   object carrying a third — .bss and .eh_frame are the ordinary cases, and
#   every gcc object has both — was previously handled by NOT LOOKING: those
#   sections were skipped, and any symbol defined in one resolved against a
#   base that was never assigned. That is silent wrong addresses, which is
#   strictly worse than refusing, because the program links and then misbehaves
#   far from the cause.
#
#   SHF_ALLOC (bit 1, value 2) is exactly the right test: it means "this
#   section occupies memory at run time", so it is precisely the set the layout
#   must have an answer for. Non-alloc sections (.symtab, .strtab, .comment,
#   .note*) are metadata the loader never maps, and ignoring those is correct.
glyph IS_ALLOC = la f. la i. int_eq(mod(div(SH_FLAGS(f)(i))(2))(2))(1)
glyph PLACEABLE = la n. OR(str_eq(n)(".text"))(OR(str_eq(n)(".rodata"))(OR(str_eq(n)(".data"))(str_eq(n)(".bss"))))
glyph CHECKSECS = la f. la tag. (Z(la self. la i.
    IF(int_eq(i)(E_SHNUM(f)))
      (la _. "ok")
      (la _. IF(AND(IS_ALLOC(f)(i))(NOT(PLACEABLE(SECNAME(f)(i)))))
               (la _. error(CAT(CONS("link: ")(CONS(tag)(CONS(
                        " has an allocatable section this layout cannot place: ")(
                        CONS(SECNAME(f)(i))(NIL)))))))
               (la _. self(add(i)(1))))))(0)

# ── THE PLACEMENT PLAN — step 1 of generalising the layout ──────────────────
#   The layout used to be hard-coded: three binders (t1sec/t2sec/r2sec) and two
#   per-object lambdas mapping a section index to an address. That shape cannot
#   grow — a third section or a third object means more binders, and the
#   addresses live in the binder chain where nothing can iterate over them.
#
#   A PLAN is a list of (object, section index, virtual address). It is computed
#   by walking a SECTION-NAME ORDER, and for each name packing every object's
#   copy of that section in input order, each aligned up to its own
#   sh_addralign. Adding a section becomes adding a name to PLACE_ORDER;
#   adding an object becomes one more STEP over the same code.
#
#   This step changes NO behaviour — it is the same policy expressed so it can
#   iterate. The gates are the proof of equivalence: same addresses, same bytes,
#   same running binary.
glyph PLACE_ORDER = CONS(".text")(CONS(".rodata")(CONS(".data")(CONS(".bss")(NIL))))
glyph DATA_BASE = 4206592
glyph BSS_BASE  = 4210688
glyph BASEOF = la n.
    IF(str_eq(n)(".text"))(la _. TEXT_BASE)(la _.
    IF(str_eq(n)(".data"))(la _. DATA_BASE)(la _.
    IF(str_eq(n)(".bss"))(la _. BSS_BASE)(la _. RODATA_BASE)))

glyph MKE   = la o. la s. la a. PAIR(o)(PAIR(s)(a))
glyph E_OBJ = la e. FST(e)
glyph E_SEC = la e. FST(SND(e))
glyph E_ADDR= la e. SND(SND(e))

#   Place one object's copy of one section, if it has a non-empty one.
#   Returns PAIR(entries)(cursor) so the next object continues where this ended.
glyph PSTEP = la f. la o. la name. la acc. la cur.
    (la sec.
      IF(lt(sec)(0))
        (la _. PAIR(acc)(cur))
        (la _. IF(int_eq(SH_SIZE(f)(sec))(0))
                 (la _. PAIR(acc)(cur))
                 (la _. (la a. PAIR(CONS(MKE(o)(sec)(a))(acc))(add(a)(SH_SIZE(f)(sec))))
                        (ALIGNUP(cur)(SH_ALIGN(f)(sec))))))
    (FIND_SEC(f)(name))

#   All objects, one section name. Each name starts at its own base address.
glyph PNAME = la f1. la f2. la name. la acc.
    (la r1. FST(PSTEP(f2)(2)(name)(FST(r1))(SND(r1))))
    (PSTEP(f1)(1)(name)(acc)(BASEOF(name)))

glyph MKPLAN = la f1. la f2.
    REV((Z(la self. la names. la acc.
        names(acc)(la h. la t. self(t)(PNAME(f1)(f2)(h)(acc)))))(PLACE_ORDER)(NIL))(NIL)

#   Address of a given object's given section, or -1 if it was not placed.
glyph VAOF = la plan. la o. la sec. (Z(la self. la l.
    l(sub(0)(1))(la h. la t.
      IF(AND(int_eq(E_OBJ(h))(o))(int_eq(E_SEC(h))(sec)))
        (la _. E_ADDR(h))
        (la _. self(t)))))(plan)

# ── REGIONS — step 2: emission stops hardcoding two segments ────────────────
#   Placement became data in step 1; emission was still shaped for exactly two
#   PT_LOADs with hardcoded file offsets. A REGION is one loadable segment:
#   its section name, its bytes, its virtual base and its permissions. The
#   image is then a fold over the region list, so the segment COUNT is
#   LEN(regions) rather than the literal 2.
#
#   ★ PERMISSIONS ARE PER-REGION, which is the point W^X turns on. .text is
#   R+X, .rodata is R, and .data would be R+W — never R+W+X. Emitting one RWX
#   segment would be simpler and would still run, and is exactly what a linker
#   must not do when the kernel it serves enforces W^X on itself (K4c).
glyph F_RX = 5
glyph F_R  = 4
glyph F_RW = 6
glyph FLAGSOF = la n.
    IF(str_eq(n)(".text"))(la _. F_RX)(la _.
    IF(str_eq(n)(".data"))(la _. F_RW)(la _.
    IF(str_eq(n)(".bss"))(la _. F_RW)(la _. F_R)))

#   The bytes a plan entry contributes: the RELOCATED text for a .text section,
#   the raw section otherwise. Relocations are applied to .text only here, so
#   this is where patched and raw meet.
glyph ENAME = la f1. la f2. la e.
    IF(int_eq(E_OBJ(e))(1))(la _. SECNAME(f1)(E_SEC(e)))(la _. SECNAME(f2)(E_SEC(e)))
glyph ESIZE = la f1. la f2. la e.
    IF(int_eq(E_OBJ(e))(1))(la _. SH_SIZE(f1)(E_SEC(e)))(la _. SH_SIZE(f2)(E_SEC(e)))
glyph SH_NOBITS = 8
glyph ETYPE = la f1. la f2. la e.
    IF(int_eq(E_OBJ(e))(1))(la _. SH_TYPE(f1)(E_SEC(e)))(la _. SH_TYPE(f2)(E_SEC(e)))
glyph EBYTES = la f1. la f2. la p1. la p2. la t1sec. la t2sec. la e.
    IF(int_eq(ETYPE(f1)(f2)(e))(SH_NOBITS))
      (la _. "")
      (la _. IF(int_eq(E_OBJ(e))(1))
        (la _. IF(int_eq(E_SEC(e))(t1sec))(la _. p1)(la _. SECBYTES(f1)(E_SEC(e))))
        (la _. IF(int_eq(E_SEC(e))(t2sec))(la _. p2)(la _. SECBYTES(f2)(E_SEC(e)))))

#   Concatenate every plan entry of one section name, in placed order, padding
#   each gap so the bytes land exactly where the plan says. Padding a code gap
#   with nops keeps it executable if control ever reaches it; other sections
#   pad with zeros.
glyph REGBYTES = la f1. la f2. la p1. la p2. la t1sec. la t2sec. la name. la plan.
    (Z(la self. la l. la cur. la acc.
      l(acc)(la h. la t.
        IF(str_eq(ENAME(f1)(f2)(h))(name))
          (la _. (la gap. self(t)(add(E_ADDR(h))(ESIZE(f1)(f2)(h)))
                        (CAT(CONS(acc)(CONS(IF(str_eq(name)(".text"))
                                              (la _. NOPS(gap))(la _. ZEROS(gap)))(
                             CONS(EBYTES(f1)(f2)(p1)(p2)(t1sec)(t2sec)(h))(NIL))))))
                 (sub(E_ADDR(h))(cur)))
          (la _. self(t)(cur)(acc)))))
    (plan)(BASEOF(name))("")

#   A region exists for a name only if the plan placed something under it, so
#   an absent .rodata (or .data) costs no segment rather than an empty one.
glyph HASNAME = la f1. la f2. la name. la plan. (Z(la self. la l.
    l(FALSE)(la h. la t.
      IF(str_eq(ENAME(f1)(f2)(h))(name))(la _. TRUE)(la _. self(t)))))(plan)

#   A region's file offset is fixed by the loader's rule p_offset = p_vaddr
#   (mod page). Deriving it from the base — rather than hardcoding 0x1000 and
#   0x2000 — keeps that congruence true by construction for any number of
#   page-separated regions.
glyph LENL    = Z(la self. la l. l(0)(la h. la t. add(1)(self(t))))
glyph FILEOFF = la base. add(PAGE)(sub(base)(TEXT_BASE))
glyph R_NAME  = la r. FST(r)
glyph R_BYTES = la r. FST(SND(r))
glyph R_MEMSZ = la r. SND(SND(r))

#   A region's MEMORY size is where its last placed section ends, which for a
#   NOBITS section is past the end of its file bytes. This is the number the
#   kernel zero-fills up to.
glyph REGEND = la f1. la f2. la name. la plan. (Z(la self. la l. la end.
    l(end)(la h. la t.
      IF(str_eq(ENAME(f1)(f2)(h))(name))
        (la _. self(t)(add(E_ADDR(h))(ESIZE(f1)(f2)(h))))
        (la _. self(t)(end)))))(plan)(BASEOF(name))

glyph MKREGIONS = la f1. la f2. la p1. la p2. la t1sec. la t2sec. la plan.
    (Z(la self. la names.
      names(NIL)(la h. la t.
        IF(HASNAME(f1)(f2)(h)(plan))
          (la _. CONS(PAIR(h)(PAIR(REGBYTES(f1)(f2)(p1)(p2)(t1sec)(t2sec)(h)(plan))
                              (sub(REGEND(f1)(f2)(h)(plan))(BASEOF(h)))))(self(t)))
          (la _. self(t)))))(PLACE_ORDER)

glyph PHDRS = la regs. (Z(la self. la l.
    l("")(la h. la t.
      concat(PHDR(FLAGSOF(R_NAME(h)))(FILEOFF(BASEOF(R_NAME(h))))(BASEOF(R_NAME(h)))
                 (str_to_int(str_len(R_BYTES(h))))(R_MEMSZ(h)))(self(t)))))(regs)

#   The image body: pad from wherever we are to each region's file offset,
#   then its bytes. One fold, so the number of segments is data.
#   ★ A REGION WITH NO FILE BYTES CONSUMES NO FILE SPACE. Padding up to a
#   .bss segment's offset wrote 16 KB of zeros to hold nothing — the file grew
#   to 0x4000 for a program with 54 bytes of code. The loader never reads a
#   segment whose p_filesz is 0, so the padding bought exactly nothing. Its
#   p_offset stays as computed and stays congruent with p_vaddr, which is all
#   the format requires.
glyph BODY = la regs. (Z(la self. la l. la cur.
    l("")(la h. la t.
      (la b.
        IF(int_eq(str_to_int(str_len(b)))(0))
          (la _. self(t)(cur))
          (la _. (la off.
                   CAT(CONS(ZEROS(sub(off)(cur)))(CONS(b)(
                       CONS(self(t)(add(off)(str_to_int(str_len(b)))))(NIL)))))
                 (FILEOFF(BASEOF(R_NAME(h))))))
      (R_BYTES(h)))))(regs)

glyph HASDEF = la f. la ss. la want. (Z(la self. la i.
    IF(int_eq(i)(SYM_COUNT(f)(ss)))
      (la _. FALSE)
      (la _. IF(AND(DEFINES(f)(ss)(i))(str_eq(SYMNAME(f)(ss)(i))(want)))
               (la _. TRUE)
               (la _. self(add(i)(1))))))(0)

glyph DUPCHECK = la f1. la ss1. la f2. la ss2. (Z(la self. la i.
    IF(int_eq(i)(SYM_COUNT(f2)(ss2)))
      (la _. "ok")
      (la _. IF(AND(DEFINES(f2)(ss2)(i))(HASDEF(f1)(ss1)(SYMNAME(f2)(ss2)(i))))
               (la _. error(concat("link: duplicate symbol: ")(SYMNAME(f2)(ss2)(i))))
               (la _. self(add(i)(1))))))(0)

glyph LOOKUP = la f. la ss. la va. la want. (Z(la self. la i.
    IF(int_eq(i)(SYM_COUNT(f)(ss)))
      (la _. sub(0)(1))
      (la _. IF(AND(DEFINES(f)(ss)(i))(str_eq(SYMNAME(f)(ss)(i))(want)))
               (la _. add(va(SYM_SHNDX(f)(ss)(i)))(SYM_VALUE(f)(ss)(i)))
               (la _. self(add(i)(1))))))(0)

glyph MAIN =
  (la f1. (la f2.
  (la _c1. (la _c2.
  (la ss1. (la ss2.
  (la t1sec. (la t2sec. (la r2sec.
  (la plan.
  (la t2addr.
  (la va1. (la va2.
  (la resolve.
  (la p1. (la p2.
    (la merged. (la rodata.
      SEQ(DUPCHECK(f1)(ss1)(f2)(ss2))(
      SEQ(write_file("link_text.bin")(merged))(
      SEQ(write_exec("link_out")(
            (la regs. (la nph. CAT(
               CONS(EHDR(resolve("_start"))(nph))(
               CONS(PHDRS(regs))(
               CONS(BODY(regs)(add(EHSIZE)(mul(nph)(PHENTSIZE))))(
               NIL)))))
             (LENL(regs)))
            (MKREGIONS(f1)(f2)(p1)(p2)(t1sec)(t2sec)(plan))))(
      print(CAT(
        CONS("merged .text = ")(
        CONS(int_to_str(str_to_int(str_len(merged))))(
        CONS(" bytes")(
        CONS(NL)(
        CONS("  obj1 patched ")(
        CONS(int_to_str(str_to_int(str_len(p1))))(
        CONS(" bytes @ ")(
        CONS(int_to_str(TEXT_BASE))(
        CONS(NL)(
        CONS("  obj2 patched ")(
        CONS(int_to_str(str_to_int(str_len(p2))))(
        CONS(" bytes @ ")(
        CONS(int_to_str(t2addr))(
        CONS(NL)(
        NIL)))))))))))))))))))
    )(SECBYTES(f2)(r2sec))
    )(CAT(CONS(p1)(CONS(NOPS(sub(t2addr)(add(TEXT_BASE)(SH_SIZE(f1)(t1sec)))))(CONS(p2)(NIL)))))
  )(APPLYRELS(f2)(ss2)(FIND_SEC(f2)(".rela.text"))(va2)(resolve)(t2addr)(SECBYTES(f2)(t2sec)))
  )(APPLYRELS(f1)(ss1)(FIND_SEC(f1)(".rela.text"))(va1)(resolve)(TEXT_BASE)(SECBYTES(f1)(t1sec)))
  )(la want. (la a1. IF(NOT(lt(a1)(0)))
                       (la _. a1)
                       (la _. (la a2. IF(NOT(lt(a2)(0)))
                                        (la _. a2)
                                        (la _. error(concat("link: unresolved symbol: ")(want))))
                              (LOOKUP(f2)(ss2)(va2)(want))))
             (LOOKUP(f1)(ss1)(va1)(want)))
  )(la sec. VAOF(plan)(2)(sec))
  )(la sec. VAOF(plan)(1)(sec))
  )(VAOF(plan)(2)(t2sec))
  )(MKPLAN(f1)(f2))
  )(FIND_SEC(f2)(".rodata"))
  )(FIND_SEC(f2)(".text"))
  )(FIND_SEC(f1)(".text"))
  )(FIND_SEC(f2)(".symtab"))
  )(FIND_SEC(f1)(".symtab"))
  )(CHECKSECS(f2)("input 2"))
  )(CHECKSECS(f1)("input 1"))
  )(read_file("link_in2.o"))
  )(read_file("link_in1.o"))

glyph SEQ = la a. la b. b
