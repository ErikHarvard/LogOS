                                         dirty2(la _. frame(st2)(la bytes. la st3.
                                                    (la _. loop(st3)(done2))(display(bytes))))
                                               (la _. loop(st2)(done2))(C0)))(C0)))
                          (split(poll(join(fds))("-1")))))
                  (append(done(la _. nil)
                              (la _. sim(la _. jobs(la _. infds)(la a. la b. nil))(la _. infds)(C0))(C0))
                         (jobs)))
               (job_fds(st)))
            (C0))))(la loop.
      la st. loop(st)(FALSE))))))))
  (0)(la t. la f. t)(la t. la f. f)))))))

# ── Wiring ────────────────────────────────────────────────────────────────
# WM_BUILD(B)(X)(TL)(T)(R)(SH)(cfg)(io): build every part once, open the first
# window with the welcome text, and run the loop until the WM exits. TL, T, R,
# SH are the records of TILE_KIT, TERM_KIT, RENDER_KIT and SHELL_KIT.
