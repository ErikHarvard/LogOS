    LET(WM_CORE(B)(L)(X)(TL)(T)(SH)(W)(la s. s(sw)(sh0)(GAP)(cwd0)))(la core.
    LET(WM_FRAME(B)(L)(R)(TL)(W)(tile)(la s. s(sw)(sh0)(pitch)(GAP)(desk)))(la frame.
    LET(WM_LOOP(B)(L)(X)(J)(fold)(core)(frame)(io))(la run.
      core(la empty. la open_win. la handle. la on_output. la job_fds. la shutdown. la welcome.
        run(welcome(open_win(empty)))))))))))))))))))))))
