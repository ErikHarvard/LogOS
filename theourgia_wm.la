        (la _. go(focus)(tl_layout(tree)(gap)(gap)(aw)(ah)(gap))(nil)(wins)(la tiles. la wins2.
          la k. k(compose(sw)(sh0)(pitch)(desk)(tiles))
                 (mkst8(tree)(focus)(wins2)(nid)(mask)(quit)(FALSE)(lock)))))))))
  (2)(la t. la f. t)(la t. la f. f))))))))

# ── The loop ──────────────────────────────────────────────────────────────
# WM_LOOP(B)(L)(X)(J)(fold)(core)(frame)(io) -> run(st): loop until the WM exits
# io = la s. s(display)(infds)(insize)(sim): display(bytes) shows a frame;
# infds lists the input fds; insize is how much to read from one at a time
# ("24" = one event); sim is TRUE for the headless WM, which reads input only
# while no command runs, renders only on request (type-85 records), and stops
# when its input is exhausted and nothing is running.
# Each pass: poll the input fds and every running command's pipe at once, fold
# whatever is ready, and (live) present a new frame if anything changed. The
# recursive call is in tail position, so the VM's TCO keeps the dump bounded.
glyph WM_LOOP = la B. la L. la X. la J. la fold. la core. la frame. la io.
  B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  L(la nil. la cons. la map. la filter. la find. la append. la nrep. la len.
  X(la poll. la read. la close. la print. la write_file. la exit.
  J(la join. la split.
  core(la empty. la open_win. la handle. la on_output. la job_fds. la shutdown. la welcome.
  io(la display. la infds. la insize. la sim.
  (la C0. la TRUE. la FALSE.
    LET(la st. la n. frame(st)(la bytes. la st2.
        (la _. (la _. st2)(print(concat("wm: snap ")(int_to_str(n)))))
        (write_file(concat("wm_shot_")(concat(int_to_str(n))(".bin")))(bytes))))(la snap.
    LET(handle(snap))(la h.
    LET(la fd. find(la x. str_eq(x)(fd))(infds)(la _. FALSE)(la x. TRUE))(la is_input.
    # one(st)(done)(fd) -> la k. k(st')(done'): service one ready fd
    LET(la st. la done. la fd.
        is_input(fd)
          (la _. (la chunk. str_eq(chunk)("")
                    (la _. la k. k(st)(TRUE))
                    (la _. la k. k(fold(h)(chunk)(st))(done))(C0))
                 (read(fd)(insize)))
          (la _. la k. k(on_output(st)(fd)(read(fd)("65536")))(done))(C0))(la one.
    LET(Z(la each. la st. la done. la ready.
        ready(la _. la k. k(st)(done))
             (la fd. la rest. one(st)(done)(fd)(la st2. la done2. each(st2)(done2)(rest)))))(la each.
    LET(Z(la loop. la st. la done.
        st(la tree. la focus. la wins. la nid. la mask. la quit. la dirty. la lock.
          quit
            (la _. (la _. (la _. st)(print("wm: exit")))(shutdown(st)))
            (la _. (la jobs.
                (la fds.
                    fds(la _. (la _. st)(print("wm: input finished and nothing is running")))
                       (la f1. la frest.
                          (la ready.
                              each(st)(done)(ready)(la st2. la done2.
                                 sim(la _. loop(st2)(done2))
                                    (la _. st2(la t. la f. la w. la n. la m. la q. la dirty2. la lk.
                                         dirty2(la _. frame(st2)(la bytes. la st3.
                                                    (la _. loop(st3)(done2))(display(bytes))))
                                               (la _. loop(st2)(done2))(C0)))(C0)))
                          (split(poll(join(fds))("-1")))))
                  (append(done(la _. nil)
                              (la _. sim(la _. jobs(la _. infds)(la a. la b. nil))(la _. infds)(C0))(C0))
                         (jobs)))
               (job_fds(st)))
            (C0))))(la loop.
      la st. loop(st)(FALSE))))))))
  (0)(la t. la f. t)(la t. la f. f)))))))

# ── Wiring ────────────────────────────────────────────────────────────────
# WM_BUILD(B)(X)(TL)(T)(RK)(SH)(UI)(cfg)(io): build every part once, open the
# first window with the welcome text, and run the loop until the WM exits. TL,
# T, SH are the records of TILE_KIT, TERM_KIT and SHELL_KIT; RK is RENDER_KIT
# with everything but the scale applied (RK(scale) is its record: the WM uses
# it at the text scale and, for an app's zoom, at twice it); UI =
# la s. s(LK_KIT)(SETTINGS_APP)(lockcfg): the LogosKit constructor and the
# settings app (logoskit.la, lk_settings.la), built here in a light and a dark
# palette, and the lock screen: lockcfg is la n. la s. n(n) (none) or
# la n. la s. s(la k. k(LOGIN_APP)(sess)(start_locked)), with LOGIN_APP from
# lk_login.la and sess the session layer's la s. s(login)(lock)(unlock).
# cfg = la s. s(sw)(sh)(pitch)(scale)(cwd0); io as for WM_LOOP.
glyph WM_BUILD = la B. la X. la TL. la T. la RK. la SH. la UI. la cfg. la io.
  cfg(la sw. la sh0. la pitch. la scale. la cwd0.
  UI(la lk_kit. la settings_app. la lockcfg.
  (la R. la R2.
  R(la px. la run. la style. la band. la bands. la solid. la join. la compose.
  R2(la px2. la run2. la style2. la band2. la bands2. la solid2. la join2. la compose2.
    LET(6)(la GAP.
    LET(WM_LISTS(B))(la L.
    LET(la s. s(WM_JOIN(B)(L))(WM_SPLIT(B)(L)))(la J.
    LET(WM_WINS(B)(L))(la W.
    LET(WM_FOLD(B))(la fold.
    LET(px(16)(14)(28))(la desk.
    LET(px(10)(10)(16))(la termbg.
    LET(px(212)(175)(55))(la gold.
    LET(px(52)(52)(72))(la grey.
    LET(px(40)(40)(58))(la bar_u.
    LET(style(px(214)(214)(200))(termbg))(la st_text.
    LET(style(px(24)(18)(8))(gold))(la st_bar_f.
    LET(style(px(170)(170)(186))(bar_u))(la st_bar_u.
    # LogosKit's two palettes: normal, focused, title, dim
    LET(px(236)(232)(220))(la bg_l.
    LET(px(18)(18)(28))(la bg_d.
    LET(lk_kit(B)(L)(R)(scale)(la s. s(style(px(30)(30)(40))(bg_l))(style(px(250)(250)(250))(px(52)(90)(160)))
                                     (style(px(120)(70)(10))(bg_l))(style(px(110)(110)(120))(bg_l))))(la lk_light.
    LET(lk_kit(B)(L)(R)(scale)(la s. s(style(px(214)(214)(200))(bg_d))(style(px(24)(18)(8))(gold))
                                     (style(gold)(bg_d))(style(px(130)(130)(150))(bg_d))))(la lk_dark.
    # the same two palettes at twice the text scale, for an app's zoom
    LET(lk_kit(B)(L)(R2)(mul(2)(scale))(la s. s(style2(px(30)(30)(40))(bg_l))(style2(px(250)(250)(250))(px(52)(90)(160)))
                                     (style2(px(120)(70)(10))(bg_l))(style2(px(110)(110)(120))(bg_l))))(la lk_light2.
    LET(lk_kit(B)(L)(R2)(mul(2)(scale))(la s. s(style2(px(214)(214)(200))(bg_d))(style2(px(24)(18)(8))(gold))
                                     (style2(gold)(bg_d))(style2(px(130)(130)(150))(bg_d))))(la lk_dark2.
    LET(lk_light(la nodes. la measure. la paint. la a11y. la focusables. la key. la render.
          settings_app(B)(L)(nodes)(la init. la view. la update. la theme. la zoom.
            la s. s(init)(view)(update)(theme)("Settings")(zoom))))(la settings.
    LET(lockcfg(la _. la n. la s. n(n))
               (la lc. lc(la login_app. la sess. la start.
                  lk_light(la nodes. la measure. la paint. la a11y. la focusables. la key. la render.
                    la n. la s. s(la k. k(login_app(B)(L)(nodes)(sess))(start))))))(la lockui.
    # the lock window: 44 columns by 9 rows of text, at most the screen
    LET(mul(8)(scale))(la cw.
    LET((la w. lt(w)(sub(sw)(mul(2)(GAP)))(la _. w)(la _. sub(sw)(mul(2)(GAP)))("!"))(add(mul(44)(cw))(12)))(la lockw.
    LET((la h. lt(h)(sub(sh0)(mul(2)(GAP)))(la _. h)(la _. sub(sh0)(mul(2)(GAP)))("!"))(add(mul(10)(cw))(16)))(la lockh.
    LET(WM_TILE(B)(L)(R)(T)(SH)(scale)
          (la s. s(gold)(grey)(gold)(bar_u)(termbg)(st_text)(st_bar_f)(st_bar_u))
          (la s. s(lk_light)(lk_dark)(lk_light2)(lk_dark2)(bg_l)(bg_d)))(la tile.
    LET(WM_CORE(B)(L)(X)(TL)(T)(SH)(W)
          (lk_light(la nodes. la measure. la paint. la a11y. la focusables. la key. la render. la s. s(key)(focusables)(settings)(lockui)))
          (la s. s(sw)(sh0)(GAP)(cwd0)))(la core.
    LET(WM_FRAME(B)(L)(R)(TL)(W)(tile)(la s. s(sw)(sh0)(pitch)(GAP)(desk)(lockw)(lockh)))(la frame.
    LET(WM_LOOP(B)(L)(X)(J)(fold)(core)(frame)(io))(la run.
      core(la empty. la open_win. la handle. la on_output. la job_fds. la shutdown. la welcome.
        # a WM that starts locked opens its first terminal when it unlocks
        run(lockcfg(la _. welcome(open_win(empty)))
                   (la lc. lc(la a. la b. la start. start(la _. empty)(la _. welcome(open_win(empty)))("!"))))))))))))))))))))))))))))))))))))(RK(scale))(RK(mul(2)(scale)))))
