# ═══════════════════════════════════════════════════════════════════
#  theourgia_wm.la — Theourgia Stage 10: the tiling window manager.
#
#  Terminals tile the screen. Each window is a terminal (theourgia_term.la)
#  running a shell (logosh.la); the windows are leaves of a split tree
#  (theourgia_tile.la); each frame is composed by theourgia_render.la. This
#  module is the part that joins them: the state, the key bindings, the
#  windows' jobs, the tile renderer, and the one poll loop that waits on the
#  keyboard and every running command's output at once. It is the same loop
#  live (theourgia_wm_live.la: evdev in, drm present out) and headless
#  (theourgia_wm_sim.la: events from a file, frames to files). WM_DESIGN.md is
#  the contract it is written against.
#
#  ── KEYS ────────────────────────────────────────────────────────────
#  MOD is Super (LEFTMETA/RIGHTMETA) or Alt (LEFTALT/RIGHTALT).
#    MOD+Enter        new terminal: the focused window splits along its longer
#                     side, the new one takes the second half and the focus
#    MOD+q            close the focused window (its command gets SIGTERM)
#    MOD+arrows/hjkl  focus the neighbour   MOD+Shift+arrows/hjkl  swap with it
#    MOD+t            the focused window's split: side by side <-> stacked
#    MOD+- / MOD+=    shrink / grow the focused window by 5%
#    MOD+Tab          focus the next window   MOD+c  interrupt its command
#    MOD+s            open the settings panel (a LogosKit app, logoskit.la)
#    MOD+Esc          lock the screen (when the WM has a session layer)
#    MOD+Shift+e      exit
#  Anything else types into the focused window. In a terminal, Enter runs the line,
#  Backspace, Up/Down walk the history, Ctrl+U kills the line, Ctrl+L clears.
#  In an app window, LogosKit takes the key: Tab / Shift+Tab move the focus, and
#  Enter, Space, Up/Down, Backspace and typed characters become the app's
#  messages (logoskit.la).
#  While the screen is locked, every key goes to the login panel (lk_login.la)
#  and nothing else, MOD bindings included, until it unlocks. That is not a
#  boundary against the VT itself: under a live VT, Ctrl+C still ends the
#  whole session (below), which is the emergency exit.
#  While a window's command runs, its keys are ignored except MOD+c and Ctrl+C
#  (both interrupt it). Under a live VT, Ctrl+C never gets here: the VT turns it
#  into SIGINT for the whole session, which is the emergency exit.
#
#  ── STYLE: WHY EVERY FUNCTION TAKES ITS DEPENDENCIES ───────────────────
#  On the SECD VM, naming a builtin walks the whole program and naming a glyph
#  re-runs it (WM_DESIGN.md, "How fast the VM is"). So each function below is a
#  glyph whose PARAMETERS are the builtins, constants and other functions it
#  uses, and WM_BUILD applies them all ONCE at startup. After that the running
#  code finds every name in its environment. Builtins come in one record B and
#  list helpers in one record L, destructured once per function at startup.
#
#    B = la s. s(str_at)(ord)(str_to_int)(int_to_str)(concat)(str_eq)(str_len)
#                (add)(sub)(mul)(div)(mod)(lt)(int_eq)(band)(bor)
#    X = la s. s(poll)(read)(close)(print)(write_file)(exit)     (VM syscalls)
#    L = la s. s(nil)(cons)(map)(filter)(find)(append)(nrep)(len)
#
#  Lists are Scott lists (nil = la n. la c. n(n)); an option is the same shape
#  with `some(x)` for cons. Booleans are applied to two thunks and a dummy.
#
#  ── STATE ───────────────────────────────────────────────────────────
#  st  = la k. k(tree)(focus)(wins)(nextid)(mask)(quit)(dirty)(lock)
#  lock = la n. la s. n(n)  (no lock screen)  |  la n. la s. s(la k. k(login)
#         (lw)(showing)): the login app's record, the window (id 0) that holds
#         it, and whether the screen is locked now
#  win = la k. k(id)(term)(sh)(job)(bcache)(tkey)(trows)(ver)(app)
#  bcache = la k. k(cols)(cache): the renderer's band cache and the width
#        (in cells) it was drawn at; at any other width it starts again
#  app = la n. la s. n(n)  (a terminal)   |   la n. la s. s(a), a LogosKit app:
#        a = la k. k(lkapp)(state)(focus), lkapp = la s. s(init)(view)(update)
#        (theme)(title)(zoom): zoom(state) is the text scale the app asks to be
#        drawn at, 1 or 2 (an app window's term and sh are unused)
#  job = la n. la j. n(n)  (no command)   |   la n. la j. j(pid)(rfd)(cmd)
#  mask: held modifiers, bit 1 LSHIFT, 2 RSHIFT, 4 LCTRL, 8 RCTRL, 16 LALT,
#  32 RALT, 64 LMETA, 128 RMETA. ver counts a window's changes; tkey/trows cache
#  its last rendered tile, keyed by its rectangle, focus and ver.
# ═══════════════════════════════════════════════════════════════════

export WM_BUILD WM_NIL WM_CONS WM_MK WM_LISTS WM_SPLIT WM_JOIN WM_FOLD WM_WINS WM_TILE WM_CORE WM_FRAME WM_LOOP

glyph Z   = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph LET = la v. la k. k(v)

glyph WM_NIL  = la n. la c. n(n)
glyph WM_CONS = la h. la t. la n. la c. c(h)(t)

# ── Constructors for every long-lived record ──────────────────────────────
# On the VM a closure keeps its WHOLE environment alive, not just the names it
# uses. A record built inline inside a lambda that has the older record in
# scope (w(la id. ... la k. k(id)...)) therefore keeps the older record, which
# keeps the one before it: every version of every window and of the state
# stayed alive, and the WM ran out of heap after a few hundred frames. So every
# record that is STORED (a window, its band cache pair, an app value, a job, an
# option, the state) is built only through these constructors. A glyph runs in
# an empty environment, so they capture nothing but their own fields; each kit
# binds them once at startup with WM_MK(la mkw. la pair. la triple. la some.
# la mkjob. la mkst8. ...).
glyph WM_MK = la s. s
  (la id. la term. la sh. la job. la bc. la tk. la tr. la ver. la app. la k. k(id)(term)(sh)(job)(bc)(tk)(tr)(ver)(app))
  (la a. la b. la k. k(a)(b))
  (la a. la b. la c. la k. k(a)(b)(c))
  (la x. la n. la y. y(x))
  (la pid. la rfd. la cmd. la n. la j. j(pid)(rfd)(cmd))
  (la tree. la focus. la wins. la nid. la mask. la quit. la dirty. la lock. la k. k(tree)(focus)(wins)(nid)(mask)(quit)(dirty)(lock))

# ── List helpers (Scott lists) ─────────────────────────────────────────
glyph WM_LISTS = la B. B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  (la C0. la C1. la nil. la cons.
    LET(Z(la map. la f. la l. l(la _. nil)(la h. la t. cons(f(h))(map(f)(t)))))(la map.
    LET(Z(la filter. la p. la l.
        l(la _. nil)(la h. la t. p(h)(la _. cons(h)(filter(p)(t)))(la _. filter(p)(t))(C0))))(la filter.
    LET(Z(la find. la p. la l.
        l(la _. la none. la some. none(none))
         (la h. la t. p(h)(la _. la none. la some. some(h))(la _. find(p)(t))(C0))))(la find.
    LET(Z(la app. la a. la b. a(la _. b)(la h. la t. cons(h)(app(t)(b)))))(la append.
    LET(Z(la nrep. la n. la x. lt(C0)(n)(la _. cons(x)(nrep(sub(n)(C1))(x)))(la _. nil)(C0)))(la nrep.
    LET(Z(la len. la l. l(la _. C0)(la h. la t. add(C1)(len(t)))))(la len.
      la s. s(nil)(cons)(map)(filter)(find)(append)(nrep)(len))))))))
  (0)(1)(WM_NIL)(WM_CONS))

# ── poll's wire form: a list of fd strings <-> "a b c" ─────────────────────
glyph WM_JOIN = la B. la L. B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  L(la nil. la cons. la map. la filter. la find. la append. la nrep. la len.
    Z(la join. la l. l(la _. "")(la h. la t. t(la _. h)(la h2. la t2. concat(h)(concat(" ")(join(t))))))))
glyph WM_SPLIT = la B. la L. B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  L(la nil. la cons. la map. la filter. la find. la append. la nrep. la len.
    (la C0. la C1.
      (la go. la s. go(s)(C0)(str_to_int(str_len(s)))(""))
      (Z(la go. la s. la i. la n. la tok.
          int_eq(i)(n)
            (la _. str_eq(tok)("")(la _. nil)(la _. cons(tok)(nil))(C0))
            (la _. (la c. str_eq(c)(" ")
                (la _. str_eq(tok)("")
                          (la _. go(s)(add(i)(C1))(n)(""))
                          (la _. cons(tok)(go(s)(add(i)(C1))(n)("")))(C0))
                (la _. go(s)(add(i)(C1))(n)(concat(tok)(c)))(C0))(str_at(s)(i)))(C0))))
    (0)(1)))

# ── Events: fold a chunk of 24-byte input_event records ──────────────────
# FOLD(handle)(chunk)(st) applies handle(st)(type)(code)(value) to each whole
# record in order. value is read as u32 (key values are 0, 1, 2).
glyph WM_FOLD = la B. B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  (la C0. la C1. la C16. la C18. la C20. la C22. la C24. la C256. la C65536.
    (la byte.
      (la u16.
        (la go. la handle. la chunk. la st. go(handle)(chunk)(C0)(str_to_int(str_len(chunk)))(st))
        (Z(la go. la handle. la chunk. la off. la n. la st.
            lt(add(off)(C24))(add(n)(C1))
              (la _. go(handle)(chunk)(add(off)(C24))(n)
                  (handle(st)(u16(chunk)(add(off)(C16)))(u16(chunk)(add(off)(C18)))
                     (add(u16(chunk)(add(off)(C20)))(mul(u16(chunk)(add(off)(C22)))(C65536)))))
              (la _. st)(C0))))
      (la s. la o. add(byte(s)(o))(mul(byte(s)(add(o)(C1)))(C256))))
    (la s. la i. str_to_int(ord(str_at(s)(i)))))
  (0)(1)(16)(18)(20)(22)(24)(256)(65536))

# ── Windows ──────────────────────────────────────────────────────────────
# WM_WINS returns the window helpers:
#   la s. s(mkwin)(win_id)(find_win)(put_win)(del_win)(touch)
# mkwin(id)(term)(sh) is a fresh window with no job; put_win replaces the
# window with the same id; touch(w) bumps ver (forces a re-render).
glyph WM_WINS = la B. la L. B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  L(la nil. la cons. la map. la filter. la find. la append. la nrep. la len.
  WM_MK(la mkw. la pair. la triple. la some. la mkjob. la mkst8.
    (la C0. la C1. la nojob.
      # bc, the band cache, is la k. k(cols)(cache): the renderer's cache is only
      # good for the width it was drawn at. (nojob also serves as the empty app
      # option: both are la n. la x. n(n).)
      LET(la id. la term. la sh. mkw(id)(term)(sh)(nojob)(pair(C0)(nil))("")(nil)(C0)(nojob))(la mkwin.
      LET(la id. la app. mkw(id)("")("")(nojob)(pair(C0)(nil))("")(nil)(C0)(some(app)))(la mkapp.
      LET(la w. w(la id. la a. la b. la c. la d. la e. la f. la g. la h. id))(la win_id.
      LET(la wins. la id. find(la w. int_eq(win_id(w))(id))(wins))(la find_win.
      LET(la wins. la w. (la id. map(la v. int_eq(win_id(v))(id)(la _. w)(la _. v)(C0))(wins))(win_id(w)))(la put_win.
      LET(la wins. la id. filter(la v. int_eq(win_id(v))(id)(la _. la t. la f. f)(la _. la t. la f. t)(C0))(wins))(la del_win.
      LET(la w. w(la id. la term. la sh. la job. la bc. la tk. la tr. la ver. la app.
              mkw(id)(term)(sh)(job)(bc)(tk)(tr)(add(ver)(C1))(app)))(la touch.
        la s. s(mkwin)(win_id)(find_win)(put_win)(del_win)(touch)(mkapp)))))))))
    (0)(1)(la n. la j. n(n)))))


# ── Tile rendering ───────────────────────────────────────────────────────
# WM_TILE(B)(L)(R)(T)(SH)(scale)(pal)(ui) -> tile(focused)(w)(tw)(th)
#   -> la k. k(rows)(w'): the tile's th scanlines of 4*tw bytes, and the window
#   with its caches updated. R, T, SH are the render, terminal and shell
#   records. pal = la s. s(border_f)(border_u)(bar_f)(bar_u)(termbg)(st_text)
#   (st_bar_f)(st_bar_u): four border/bar pixels, the terminal background, and
#   the three text styles. ui = la s. s(lk_light)(lk_dark)(lk_light2)(lk_dark2)
#   (bg_light)(bg_dark): LogosKit kits (LK_KIT records) at the text scale and
#   at twice it, and the two background pixels; an app window is drawn with
#   the kit its own state's theme and zoom pick.
# A tile, top to bottom: BW border rows; the title bar (2 rows, one text row of
# 8*scale, 2 rows); PAD rows; the terminal's (or the app's) text rows; filler; PAD rows; BW
# border rows. Every scanline is border | PAD | text | filler | border. A tile
# too small for one row of text is drawn as a plain block of its border colour.
# The finished rows are cached in the window under a key made of the size, the
# focus and the window's version, so an unchanged window costs nothing.
glyph WM_TILE = la B. la L. la R. la T. la SH. la scale. la pal. la ui.
  B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  L(la nil. la cons. la map. la filter. la find. la append. la nrep. la len.
  R(la px. la run. la style. la band. la bands. la solid. la join. la compose.
  T(la t_new. la t_write. la t_flush. la t_key. la t_back. la t_kill. la t_submit.
    la t_prev. la t_next. la t_clear. la t_prompt. la t_rows. la t_keychar.
  SH(la sh_new. la sh_prompt. la sh_run. la sh_finish. la sh_int. la sh_hup.
  pal(la border_f. la border_u. la bar_f. la bar_u. la termbg. la st_text. la st_bar_f. la st_bar_u.
  ui(la lk_light. la lk_dark. la lk_light2. la lk_dark2. la bg_light. la bg_dark.
  WM_MK(la mkw. la pair. la triple. la some. la mkjob. la mkst8.
  (la C0. la C1. la C2. la C4. la C8. la BW. la PAD. la TRUE. la FALSE.
    LET(mul(C8)(scale))(la cw.
    # each(left)(right)(band): the band's scanlines, each framed left ++ s ++ right
    LET(Z(la each. la left. la right. la b.
        b(la _. nil)(la h. la t. cons(concat(left)(concat(h)(right)))(each(left)(right)(t)))))(la each.
    LET(Z(la frame. la left. la right. la bl.
        bl(la _. nil)(la b. la rest. append(each(left)(right)(b))(frame(left)(right)(rest)))))(la frame.
    # geom(tw)(th) -> la s. s(iw)(tcols)(ccols)(nrows)(filler)
    LET(la tw. la th.
        (la iw. (la avail.
            la s. s(iw)(div(iw)(cw))(div(sub(iw)(mul(C2)(PAD)))(cw))(div(avail)(cw))(mod(avail)(cw)))
          (sub(sub(sub(th)(mul(C2)(BW)))(add(cw)(C4)))(mul(C2)(PAD))))
        (sub(tw)(mul(C2)(BW))))(la geom.
    # fit(n)(rows): exactly n rows of an app's paint, cut or padded with empty rows
    LET(Z(la fit. la n. la rows. lt(C0)(n)
        (la _. rows(la _. cons(nil)(fit(sub(n)(C1))(nil)))(la r. la rest. cons(r)(fit(sub(n)(C1))(rest))))
        (la _. nil)(C0)))(la fit.
    LET(la w. w(la id. la term. la sh. la job. la bc. la tk. la tr. la ver. la app.
        app(la _. job(la _. concat(" ")(concat(int_to_str(id))(concat("  ")(sh_prompt(sh)))))
                     (la pid. la rfd. la cmd. concat(" ")(concat(int_to_str(id))(concat("  [running] ")(cmd)))))
           (la a. a(la lkapp. la ast. la afocus. lkapp(la init. la view. la update. la theme. la atitle. la azoom.
               # the lock screen's window (id 0) has no number
               lt(C0)(id)(la _. concat(" ")(concat(int_to_str(id))(concat("  ")(atitle))))(la _. concat(" ")(atitle))(C0))))))(la title.
    LET(la w. la focused. la tw. la th. w(la id. la term. la sh. la job. la bc. la tk. la tr. la ver. la app.
        concat(int_to_str(tw))(concat("x")(concat(int_to_str(th))
          (concat(focused(la _. "f")(la _. "u")(C0))(int_to_str(ver)))))))(la tkey.
    # draw(focused)(w)(tw)(th)(key): render the tile, uncached
    LET(la focused. la w. la tw. la th. la k0.
      geom(tw)(th)(la iw. la tcols. la ccols. la nrows. la filler.
      w(la id. la term. la sh. la job. la bc. la tk. la tr. la ver. la app.
        (la bcol. la barc. la bst.
          lt(nrows)(C1)(la _. la k. k(solid(tw)(th)(bcol))(w))(la _.
          lt(ccols)(C1)(la _. la k. k(solid(tw)(th)(bcol))(w))(la _.
            # body(k): k(the text area's bands, each a list of scanlines)(the band
            # cache to keep)(its background)
            (la body. body(la blist. la bc2. la bgc.
                (la brow. la barrow. la padrow. la tl. la tr2. la cl. la cr.
                  (la rows. la k. k(rows)(mkw(id)(term)(sh)(job)(bc2)(k0)(rows)(ver)(app)))
                  (append(nrep(BW)(brow))
                  (append(nrep(C2)(barrow))
                  (append(frame(tl)(tr2)(cons(band(bst)(title(w))(tcols))(nil)))
                  (append(nrep(C2)(barrow))
                  (append(nrep(PAD)(padrow))
                  (append(frame(cl)(cr)(blist))
                  (append(nrep(filler)(padrow))
                  (append(nrep(PAD)(padrow))
                         (nrep(BW)(brow)))))))))))
                (run(tw)(bcol))
                (concat(run(BW)(bcol))(concat(run(iw)(barc))(run(BW)(bcol))))
                (concat(run(BW)(bcol))(concat(run(iw)(bgc))(run(BW)(bcol))))
                (run(BW)(bcol))
                (concat(run(sub(iw)(mul(tcols)(cw)))(barc))(run(BW)(bcol)))
                (concat(run(BW)(bcol))(run(PAD)(bgc)))
                (concat(run(sub(sub(iw)(PAD))(mul(ccols)(cw)))(bgc))(run(BW)(bcol)))))
            (la k. app
              (la _. bands(st_text)(bc(la bcols. la cache. int_eq(bcols)(ccols)(la _. cache)(la _. nil)(C0)))
                         (t_rows(term)(ccols)(nrows)(job(la _. TRUE)(la p. la r. la c. FALSE)))(ccols)
                       (la blist. la bc2. k(blist)(pair(ccols)(bc2))(termbg)))
              (la a. a(la lkapp. la ast. la afocus. lkapp(la init. la view. la update. la theme. la atitle. la azoom.
                  # render gives one flat list of scanlines: the text area's single band.
                  # At zoom 2 (and room for at least 2x2 cells) the app is drawn with
                  # the kits at twice the text scale, in half the cells each way,
                  # and padded out to the text area with its background.
                  (la z2. (la zc. la zr. la bgc.
                    theme(ast)(z2(lk_dark2)(lk_dark))(z2(lk_light2)(lk_light))
                      (la nodes. la measure. la paint. la a11y. la focusables. la key. la render.
                        (la sl. k(cons(z2(la _. append(map(la l. concat(l)(run(mul(sub(ccols)(mul(C2)(zc)))(cw))(bgc)))(sl))
                                                    (nrep(mul(sub(nrows)(mul(C2)(zr)))(cw))(run(mul(ccols)(cw))(bgc))))
                                         (la _. sl)(C0))(nil))(bc)(bgc))
                        (render(fit(zr)(paint(view(ast))(afocus)))(zc))))
                    (z2(la _. div(ccols)(C2))(la _. ccols)(C0))(z2(la _. div(nrows)(C2))(la _. nrows)(C0))
                    (theme(ast)(bg_dark)(bg_light)))
                  (int_eq(azoom(ast))(C2)(lt(C1)(ccols)(lt(C1)(nrows))(FALSE))(FALSE)))))))(C0))(C0))
        (focused(la _. border_f)(la _. border_u)(C0))
        (focused(la _. bar_f)(la _. bar_u)(C0))
        (focused(la _. st_bar_f)(la _. st_bar_u)(C0)))))(la draw.
      la focused. la w. la tw. la th.
        (la k0. w(la id. la term. la sh. la job. la bc. la tk. la tr. la ver. la app.
            str_eq(k0)(tk)(la _. la k. k(tr)(w))(la _. draw(focused)(w)(tw)(th)(k0))(C0)))
        (tkey(w)(focused)(tw)(th)))))))))))
  (0)(1)(2)(4)(8)(2)(4)(la t. la f. t)(la t. la f. f)))))))))

# ── The core: state, key events, jobs ─────────────────────────────────────
# WM_CORE(B)(L)(X)(TL)(T)(SH)(W)(ui)(cfg)
#   -> la s. s(empty)(open_win)(handle)(on_output)(job_fds)(shutdown)(welcome)
# cfg = la s. s(sw)(sh)(gap)(cwd0): the screen size in pixels, the gap between
# tiles (and around them), and the directory new shells start in.
# ui = la s. s(lk_key)(lk_focusables)(settings)(lockui): LogosKit's key and
# focusables (from an LK_KIT record), the settings app MOD+s opens (la s.
# s(init)(view)(update)(theme)(title)), and the lock screen: lockui is
# la n. la s. n(n) (none: MOD+Esc does nothing) or la n. la s. s(la k.
# k(login)(start_locked)), login being LOGIN_APP's record (lk_login.la). When
# start_locked is TRUE the WM starts locked; whenever it unlocks with no
# windows, it opens the first terminal with the welcome text.
# handle(snap)(st)(type)(code)(value) folds one input event; snap(st)(n) is
# called for a type-85 record (the headless WM's "write frame n").
glyph WM_CORE = la B. la L. la X. la TL. la T. la SH. la W. la ui. la cfg.
  B(la str_at. la ord. la str_to_int. la int_to_str. la concat. la str_eq.
    la str_len. la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor.
  L(la nil. la cons. la map. la filter. la find. la append. la nrep. la len.
  X(la poll. la read. la close. la print. la write_file. la exit.
  TL(la tl_empty. la tl_insert. la tl_remove. la tl_layout. la tl_nb. la tl_swap.
     la tl_resize. la tl_toggle. la tl_leaves. la tl_next. la tl_has. la tl_count. la tl_show.
  T(la t_new. la t_write. la t_flush. la t_key. la t_back. la t_kill. la t_submit.
    la t_prev. la t_next. la t_clear. la t_prompt. la t_rows. la t_keychar.
  SH(la sh_new. la sh_prompt. la sh_run. la sh_finish. la sh_int. la sh_hup.
