# =====================================================================
#  asm.la — AN x86-64 ASSEMBLER IN LINGUA ADAMICA.
#
#  The first LA-native toolchain component: it closes the NASM seam for the
#  subset it covers. The boot ASSEMBLY is irreducibly machine-level — but the
#  TOOL THAT ASSEMBLES IT need not be foreign, and that is the seam.
#
#  ── WHY THIS IS NOT A TOY ───────────────────────────────────────────────────
#  The verification is byte-identity against the tool it replaces: assemble the
#  same source with asm.la and with `nasm -f bin`, and diff. There is no room to
#  be approximately right — the bytes match or they do not. (This is the same
#  drift-guard discipline secd.la already uses to keep secd.asm authoritative.)
#
#  ── WHAT BYTE-IDENTITY ACTUALLY DEMANDS ─────────────────────────────────────
#  Matching NASM means matching its ENCODING CHOICES, not merely emitting
#  something the CPU would accept. The sharp one:
#
#      mov rax, 1   ->   b8 01 00 00 00      (5 bytes)
#
#  That is `mov eax, 1`, NOT `movabs rax, 1` (48 b8 + 8-byte imm). A 32-bit
#  write to a 64-bit register ZERO-EXTENDS, so when the immediate fits in
#  unsigned 32 bits NASM takes the shorter form and drops REX.W entirely. An
#  assembler that emitted the "obvious" 10-byte movabs would be CORRECT and
#  still fail the diff. So this is encoded as NASM encodes it.
#
#  ── THE ENCODING RULES IMPLEMENTED ──────────────────────────────────────────
#    reg numbering : rax0 rcx1 rdx2 rbx3 rsp4 rbp5 rsi6 rdi7, r8..r15 = 8..15
#    REX (op r,r)  : 0x48 | (src>=8 ? 0x04 : 0) | (dst>=8 ? 0x01 : 0)
#    ModRM (op r,r): 0xC0 | ((src&7)<<3) | (dst&7)        -- reg=src, rm=dst
#    mov r,imm32   : [0x41 if r>=8] , 0xB8+(r&7) , imm32 little-endian
#    push/pop r    : [0x41 if r>=8] , 0x50+(r&7) / 0x58+(r&7)
#    syscall 0f 05 | ret c3 | nop 90
#
#  ── LABELS AND CONTROL FLOW (two passes) ────────────────────────────────────
#  A label is a line whose token ends in ":". PASS1 walks the lines accumulating
#  an offset and recording each label's address; PASS2 emits, now that every
#  address is known. rel32 is measured from the address of the NEXT instruction,
#  and a BACKWARD jump is negative — folded into the unsigned 32-bit range
#  (d + 2^32) before being split into bytes, since LA's div/mod on a negative
#  would be unreliable. `jz start` at offset 22 becomes 0f 84 e4 ff ff ff, which
#  is exactly what NASM emits.
#
#  SHORT JUMPS NEED A FIXED POINT. NASM emits the shortest jump that reaches:
#  `jmp a` -> eb rel8 (2 bytes) when the target is within a signed byte, else
#  e9 rel32 (5); `jz` -> 74 rel8 (2) or 0f 84 rel32 (6); `call` has NO short form
#  (always e8 rel32). Matching that is the last encoding-CHOICE mismatch, and it
#  is what lets a bare `jmp L` — idiomatic asm — be byte-identical rather than
#  requiring `near`.
#
#  It is the chicken-and-egg proper: a jump's SIZE depends on its target's
#  DISTANCE, which depends on the SIZES of everything between. So: start
#  OPTIMISTIC (every jump short; an unknown forward label is assumed reachable),
#  build the label table, recompute. A jump that no longer reaches is PROMOTED to
#  near — which GROWS the code, which can push another jump out of range — so
#  iterate. Promotion only ever grows the image, so total length is monotonic and
#  bounded: length unchanged <=> no promotion <=> the fixed point. That is the
#  convergence test, with a pass cap as a backstop.
#  The same shape as regen_selfhost.sh iterating the compiler image to ITS fixed
#  point — the project's standing discipline, one level down.
#  An explicit `near` still FORCES the long form (NASM honours it too), so
#  existing `jmp near L` sources stay byte-identical.
#
#  ── HONEST SCOPE ────────────────────────────────────────────────────────────
#  A REAL SUBSET, every instruction of it verified byte-identical against NASM:
#  mov/add/sub/xor (r64,r64), mov (r64,imm32), push/pop (r64), syscall, ret,
#  nop, r8-r15 via REX, labels and control flow (jmp/call/jz/je/jnz/jne) with
#  NASM's short/near selection reproduced via a fixed point,
#  and MEMORY OPERANDS for mov in both directions — [base], [base+disp],
#  [base-disp], with the rbp/r13 and rsp/r12 quirks and disp8/disp32 promotion.
#  elf.la's whole write+exit entry is inside it, as is any branching routine
#  over registers and the stack.
#
#  What it is NOT, stated plainly:
#    - memory operands cover a BASE + DISPLACEMENT only: no index/scale
#      ([rax+rcx*4]), no RIP-relative, and only for `mov` — add/sub/xor stay
#      register-to-register;
#    - no directives beyond `bits`, no sections, no data definitions, no
#      paging/GDT/IDT/segment forms, no immediates to memory;
#    - jcc covers jz/je/jnz/jne only — not the signed/unsigned comparison set
#      (jl/jg/jle/jge/jb/ja/...), which is the same encoding + a condition
#      nibble and is mechanical to extend.
#  So it CANNOT yet assemble boot.asm or secd.asm, and NASM remains in the
#  kernel build. The seam is closed for what is here and honestly open beyond
#  it; the byte-identity gate extends to each increment.
#
#  Pure generation (chr/concat/int arithmetic), so it is byte-identical on the
#  C host and the native VM, like elf.la.
# =====================================================================

export ASSEMBLE TOKS LINES REGNUM

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph TRUE = la t. la f. t
glyph FALSE = la t. la f. f
glyph OR   = la a. la b. a(TRUE)(b)
glyph AND  = la a. la b. a(b)(FALSE)
glyph NOT  = la b. b(FALSE)(TRUE)
glyph CONS = la h. la t. la n. la c. c(h)(t)
glyph NIL  = la n. la c. n
glyph PAIR = la a. la b. la f. f(a)(b)
glyph FST  = la p. p(la a. la b. a)
glyph SND  = la p. p(la a. la b. b)
glyph NONE = la s. la n. n
glyph SOME = la x. la s. la n. s(x)
glyph ISSOME = la o. o(la _. TRUE)(FALSE)
glyph OPTV = la o. o(la x. x)(0)

glyph B = la n. chr(int_to_str(n))
glyph LE4 = la n.
    concat(B(mod(n)(256)))
   (concat(B(mod(div(n)(256))(256)))
   (concat(B(mod(div(n)(65536))(256)))
          (B(mod(div(n)(16777216))(256)))))

# ── tokenizing: lines, then whitespace/comma-separated tokens ──
glyph ISSEP = la c. OR(str_eq(c)(" "))(OR(str_eq(c)(","))(str_eq(c)("	")))
glyph TOKS = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. IF(str_eq(cur)(""))(la _. NIL)(la _. CONS(cur)(NIL)))
      (la _. (la c.
          IF(ISSEP(c))
            (la _. IF(str_eq(cur)(""))(la _. self(str_tail(s))(""))
                                      (la _. CONS(cur)(self(str_tail(s))(""))))
            (la _. self(str_tail(s))(concat(cur)(c))))
        (str_head(s))))
glyph LINES = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. CONS(cur)(NIL))
      (la _. IF(str_eq(str_head(s))("\n"))
               (la _. CONS(cur)(self(str_tail(s))("")))
               (la _. self(str_tail(s))(concat(cur)(str_head(s))))))

glyph HD = la l. l("")(la h. la t. h)
glyph NTH = Z(la self. la n. la l. l("")(la h. la t. IF(int_eq(n)(0))(la _. h)(la _. self(sub(n)(1))(t))))
glyph LEN = Z(la self. la l. l(0)(la h. la t. add(1)(self(t))))

# ── labels: a line whose first token ends in ":" ──
glyph LASTCH  = Z(la self. la s. IF(str_eq(str_tail(s))(""))(la _. str_head(s))(la _. self(str_tail(s))))
glyph DROPLAST = Z(la self. la s. IF(str_eq(str_tail(s))(""))(la _. "")(la _. concat(str_head(s))(self(str_tail(s)))))
glyph ISLABEL = la t. IF(str_eq(t)(""))(la _. FALSE)(la _. str_eq(LASTCH(t))(":"))
glyph LABNAME = la t. DROPLAST(t)
#   NOTE (eager-evaluation trap): a Scott list `l(nil)(cons)` evaluates the NIL
#   branch EAGERLY, so an `error(...)` written there fires on EVERY lookup, not
#   just a miss — the same trap CLAUDE.md documents for Church booleans. So the
#   lookup returns an option and the failure is raised through IF, whose
#   branches are thunks and only the selected one is forced.
glyph LOOKLAB = Z(la self. la nm. la l.
    l(NONE)(la h. la t. IF(str_eq(FST(h))(nm))(la _. SOME(SND(h)))(la _. self(nm)(t))))
glyph LABADDR = la nm. la labs.
    (la o. IF(ISSOME(o))(la _. OPTV(o))
                        (la _. error(concat("asm: undefined label: ")(nm))))
    (LOOKLAB(nm)(labs))

#   A jump's operand is NTH 1, or NTH 2 when an explicit `near` is written.
glyph TARGET = la ts. IF(str_eq(NTH(1)(ts))("near"))(la _. NTH(2)(ts))(la _. NTH(1)(ts))

#   rel32 is relative to the address of the NEXT instruction, and is two's
#   complement when the target is behind us. LA's div/mod on a negative would be
#   unreliable, so a backward jump is folded into the unsigned 32-bit range
#   FIRST (d + 2^32) and only then split into bytes — e.g. -28 -> 4294967268
#   -> e4 ff ff ff, exactly what NASM emits for `jz start` above.
glyph REL32 = la labs. la nm. la next.
    (la d. IF(lt(d)(0))(la _. add(4294967296)(d))(la _. d))
    (sub(LABADDR(nm)(labs))(next))

# ── the register file: name -> number ──
glyph REGS =
  CONS(PAIR("rax")(0))(CONS(PAIR("rcx")(1))(CONS(PAIR("rdx")(2))(CONS(PAIR("rbx")(3))(
  CONS(PAIR("rsp")(4))(CONS(PAIR("rbp")(5))(CONS(PAIR("rsi")(6))(CONS(PAIR("rdi")(7))(
  CONS(PAIR("r8")(8))(CONS(PAIR("r9")(9))(CONS(PAIR("r10")(10))(CONS(PAIR("r11")(11))(
  CONS(PAIR("r12")(12))(CONS(PAIR("r13")(13))(CONS(PAIR("r14")(14))(CONS(PAIR("r15")(15))(
  NIL))))))))))))))))
glyph LOOKREG = Z(la self. la nm. la l.
    l(NONE)(la h. la t. IF(str_eq(FST(h))(nm))(la _. SOME(SND(h)))(la _. self(nm)(t))))
glyph ISREG  = la nm. ISSOME(LOOKREG(nm)(REGS))
glyph REGNUM = la nm. OPTV(LOOKREG(nm)(REGS))

# ── encodings ──
#   REX.W with the two extension bits; ModRM in register-direct form.
glyph REX   = la dst. la src.
    B(add(72)(add(IF(lt(src)(8))(la _. 0)(la _. 4))(IF(lt(dst)(8))(la _. 0)(la _. 1))))
glyph MODRM = la dst. la src. B(add(192)(add(mul(mod(src)(8))(8))(mod(dst)(8))))
glyph ALU   = la op. la dst. la src. concat(REX(dst)(src))(concat(B(op))(MODRM(dst)(src)))

#   NASM's choice: an immediate that fits in unsigned 32 bits uses the 32-bit
#   form (which zero-extends), so no REX.W — only REX.B when the register is
#   r8..r15. Matching this is what makes the diff pass.
glyph MOVIMM = la dst. la n.
    concat(IF(lt(dst)(8))(la _. "")(la _. B(65)))
   (concat(B(add(184)(mod(dst)(8))))(LE4(n)))

#   A LABEL as an immediate is NOT the same encoding as a NUMBER. NASM emits
#   `mov rsi, msg` (msg a label) as 48 be + imm64 — movabs, 10 bytes — while
#   `mov rax, 1` takes the 5-byte b8+imm32 form. The address would FIT in 32
#   bits, so this is a deliberate NASM choice about labels, not an arithmetic
#   necessity: matching it means distinguishing the two SYNTACTICALLY (all
#   digits -> number; otherwise -> label), which also lets SIZEL know the size
#   before any label address is known.
glyph LE8 = la n. concat(LE4(mod(n)(4294967296)))(LE4(div(n)(4294967296)))
glyph INSTR = Z(la self. la c. la s.
    IF(str_eq(s)(""))(la _. FALSE)
      (la _. IF(str_eq(str_head(s))(c))(la _. TRUE)(la _. self(c)(str_tail(s)))))
glyph ISDIGIT = la c. INSTR(c)("0123456789")
glyph ALLDIG = Z(la self. la s.
    IF(str_eq(s)(""))(la _. TRUE)(la _. AND(ISDIGIT(str_head(s)))(self(str_tail(s)))))
glyph ISNUM = la t. IF(str_eq(t)(""))(la _. FALSE)(la _. ALLDIG(t))
glyph MOVABS = la r. la n.
    concat(B(add(72)(IF(lt(r)(8))(la _. 0)(la _. 1))))
   (concat(B(add(184)(mod(r)(8))))(LE8(n)))

glyph PUSHPOP = la base. la r.
    concat(IF(lt(r)(8))(la _. "")(la _. B(65)))(B(add(base)(mod(r)(8))))

# ── MEMORY OPERANDS: [base] / [base+disp] / [base-disp] ─────────────────────
#   Three cases in the x86-64 encoding must be matched exactly or NASM's bytes
#   diverge, and each is a real hardware quirk rather than a NASM preference:
#     rbp / r13  (rm==5): mod=00 rm=101 is RIP-RELATIVE, so [rbp] CANNOT be
#                encoded with mod=00 — it is forced to mod=01 with disp8=0.
#                NASM: mov rax,[rbp] -> 48 8b 45 00
#     rsp / r12  (rm==4): mod=xx rm=100 means "a SIB byte follows", so [rsp]
#                needs SIB=0x24 (scale=0, index=none(100), base=100).
#                NASM: mov rax,[rsp] -> 48 8b 04 24
#     disp size : 0 -> mod=00 (no displacement bytes); fits in a signed byte ->
#                mod=01 + disp8; otherwise mod=10 + disp32.
#   A negative displacement is folded into range before splitting (LA's div/mod
#   on a negative is unreliable): -8 -> disp8 0xf8, matching NASM's [rbp-8].
glyph ISMEM   = la t. IF(str_eq(t)(""))(la _. FALSE)(la _. str_eq(str_head(t))("["))
glyph STRIPBRK = la t. DROPLAST(str_tail(t))
glyph SPLITSIGN = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. PAIR(cur)(0))
      (la _. (la c.
          IF(OR(str_eq(c)("+"))(str_eq(c)("-")))
            (la _. PAIR(cur)(IF(str_eq(c)("+"))
                               (la _. str_to_int(str_tail(s)))
                               (la _. sub(0)(str_to_int(str_tail(s))))))
            (la _. self(str_tail(s))(concat(cur)(c))))
        (str_head(s))))
glyph MEMPARTS = la t. SPLITSIGN(STRIPBRK(t))("")
glyph MEMBASE  = la t. REGNUM(FST(MEMPARTS(t)))
glyph MEMDISP  = la t. SND(MEMPARTS(t))

glyph FITS8 = la d. AND(NOT(lt(d)(sub(0)(128))))(lt(d)(128))
glyph MODOF = la b. la d.
    IF(AND(int_eq(mod(b)(8))(5))(int_eq(d)(0)))(la _. 1)(la _.
    IF(int_eq(d)(0))(la _. 0)(la _.
    IF(FITS8(d))(la _. 1)(la _. 2)))
glyph SIBOF  = la b. IF(int_eq(mod(b)(8))(4))(la _. B(36))(la _. "")
glyph DISPOF = la m. la d.
    IF(int_eq(m)(0))(la _. "")(la _.
    IF(int_eq(m)(1))(la _. B(IF(lt(d)(0))(la _. add(256)(d))(la _. d)))
                    (la _. LE4(IF(lt(d)(0))(la _. add(4294967296)(d))(la _. d))))
glyph MEMENC = la op. la reg. la b. la d.
    (la m.
      concat(REX(b)(reg))
     (concat(B(op))
     (concat(B(add(add(mul(m)(64))(mul(mod(reg)(8))(8)))(mod(b)(8))))
     (concat(SIBOF(b))(DISPOF(m)(d))))))
    (MODOF(b)(d))
glyph MEMSIZE = la b. la d.
    (la m. add(3)(add(IF(int_eq(mod(b)(8))(4))(la _. 1)(la _. 0))
                    (IF(int_eq(m)(0))(la _. 0)(la _. IF(int_eq(m)(1))(la _. 1)(la _. 4)))))
    (MODOF(b)(d))

# ── SHORT-JUMP OPTIMISATION: iterate to a fixed point ───────────────────────
#   NASM emits the SHORTEST jump that reaches: `jmp a` -> eb rel8 (2 bytes) when
#   the target is within a signed byte, else e9 rel32 (5). `jz` likewise: 74 rel8
#   (2) or 0f 84 rel32 (6). `call` has NO short form — always e8 rel32 (5).
#   Matching that is the last encoding-CHOICE mismatch, and it is what lets a
#   bare `jmp L` (idiomatic asm) be byte-identical rather than requiring `near`.
#
#   It needs a FIXED POINT, and this is the chicken-and-egg the near-only version
#   deliberately avoided: a jump's SIZE depends on its target's DISTANCE, which
#   depends on the SIZES of everything between. So: start OPTIMISTIC (every jump
#   short — an unknown forward label is assumed reachable), compute the label
#   table, and recompute. A jump that no longer reaches is PROMOTED to near,
#   which grows the code, which can push another jump out of range — so iterate.
#   Promotion only ever GROWS the image, so total length is monotonic and
#   bounded: length unchanged <=> no promotion happened <=> the fixed point. That
#   is the convergence test, with a pass cap as a backstop.
#   The same shape as regen_selfhost.sh iterating the compiler image to ITS fixed
#   point — the project's standing discipline, one level down.
#
#   An explicit `near` still FORCES the long form (NASM honours it too), so the
#   existing `jmp near L` sources stay byte-identical.
glyph ISJCC   = la op. OR(str_eq(op)("jz"))(OR(str_eq(op)("je"))(OR(str_eq(op)("jnz"))(str_eq(op)("jne"))))
glyph ISNEARK = la ts. str_eq(NTH(1)(ts))("near")
glyph JSHORT  = la labs. la off. la ts.
    IF(ISNEARK(ts))(la _. FALSE)
      (la _. (la o. IF(ISSOME(o))
                      (la _. FITS8(sub(OPTV(o))(add(off)(2))))
                      (la _. TRUE))
             (LOOKLAB(TARGET(ts))(labs)))
glyph REL8 = la labs. la off. la nm.
    (la d. IF(lt(d)(0))(la _. add(256)(d))(la _. d))
    (sub(LABADDR(nm)(labs))(add(off)(2)))

glyph MOVSIZE = la ts.
    IF(ISMEM(NTH(1)(ts)))
      (la _. MEMSIZE(MEMBASE(NTH(1)(ts)))(MEMDISP(NTH(1)(ts))))
      (la _. IF(ISMEM(NTH(2)(ts)))
               (la _. MEMSIZE(MEMBASE(NTH(2)(ts)))(MEMDISP(NTH(2)(ts))))
               (la _. IF(ISREG(NTH(2)(ts)))
                        (la _. 3)
                        (la _. IF(ISNUM(NTH(2)(ts)))
                                 (la _. IF(lt(REGNUM(NTH(1)(ts)))(8))(la _. 5)(la _. 6))
                                 (la _. 10))))

# ── SIZEL: bytes this line occupies, given what we currently know of labels ──
glyph SIZEL = la labs. la off. la ts.
  (la op.
    IF(str_eq(op)(""))(la _. 0)(la _.
    IF(OR(str_eq(op)("bits"))(str_eq(op)("org")))(la _. 0)(la _.
    IF(ISLABEL(op))(la _. 0)(la _.
    IF(str_eq(op)("syscall"))(la _. 2)(la _.
    IF(str_eq(op)("ret"))(la _. 1)(la _.
    IF(str_eq(op)("nop"))(la _. 1)(la _.
    IF(OR(str_eq(op)("push"))(str_eq(op)("pop")))
      (la _. IF(lt(REGNUM(NTH(1)(ts)))(8))(la _. 1)(la _. 2))(la _.
    IF(str_eq(op)("call"))(la _. 5)(la _.
    IF(str_eq(op)("jmp"))(la _. IF(JSHORT(labs)(off)(ts))(la _. 2)(la _. 5))(la _.
    IF(ISJCC(op))(la _. IF(JSHORT(labs)(off)(ts))(la _. 2)(la _. 6))(la _.
    IF(str_eq(op)("mov"))(la _. MOVSIZE(ts))(la _. 3))))))))))))
  (HD(ts))

# ── one instruction -> its bytes (off = this instruction's own address) ──
glyph ENC1 = la labs. la off. la ts.
  (la op.
    IF(str_eq(op)(""))(la _. "")(la _.
    IF(OR(str_eq(op)("bits"))(str_eq(op)("org")))(la _. "")(la _.
    IF(ISLABEL(op))(la _. "")(la _.
    IF(str_eq(op)("syscall"))(la _. concat(B(15))(B(5)))(la _.
    IF(str_eq(op)("ret"))(la _. B(195))(la _.
    IF(str_eq(op)("nop"))(la _. B(144))(la _.
    IF(str_eq(op)("push"))(la _. PUSHPOP(80)(REGNUM(NTH(1)(ts))))(la _.
    IF(str_eq(op)("pop"))(la _. PUSHPOP(88)(REGNUM(NTH(1)(ts))))(la _.
    IF(str_eq(op)("add"))(la _. ALU(1)(REGNUM(NTH(1)(ts)))(REGNUM(NTH(2)(ts))))(la _.
    IF(str_eq(op)("sub"))(la _. ALU(41)(REGNUM(NTH(1)(ts)))(REGNUM(NTH(2)(ts))))(la _.
    IF(str_eq(op)("xor"))(la _. ALU(49)(REGNUM(NTH(1)(ts)))(REGNUM(NTH(2)(ts))))(la _.
    IF(str_eq(op)("call"))(la _. concat(B(232))(LE4(REL32(labs)(TARGET(ts))(add(off)(5)))))(la _.
    IF(str_eq(op)("jmp"))
      (la _. IF(JSHORT(labs)(off)(ts))
               (la _. concat(B(235))(B(REL8(labs)(off)(TARGET(ts)))))
               (la _. concat(B(233))(LE4(REL32(labs)(TARGET(ts))(add(off)(5))))))(la _.
    IF(OR(str_eq(op)("jz"))(str_eq(op)("je")))
      (la _. IF(JSHORT(labs)(off)(ts))
               (la _. concat(B(116))(B(REL8(labs)(off)(TARGET(ts)))))
               (la _. concat(B(15))(concat(B(132))(LE4(REL32(labs)(TARGET(ts))(add(off)(6)))))))(la _.
    IF(OR(str_eq(op)("jnz"))(str_eq(op)("jne")))
      (la _. IF(JSHORT(labs)(off)(ts))
               (la _. concat(B(117))(B(REL8(labs)(off)(TARGET(ts)))))
               (la _. concat(B(15))(concat(B(133))(LE4(REL32(labs)(TARGET(ts))(add(off)(6)))))))(la _.
    IF(str_eq(op)("mov"))
      (la _. IF(ISMEM(NTH(1)(ts)))
               (la _. MEMENC(137)(REGNUM(NTH(2)(ts)))(MEMBASE(NTH(1)(ts)))(MEMDISP(NTH(1)(ts))))
               (la _. IF(ISMEM(NTH(2)(ts)))
                        (la _. MEMENC(139)(REGNUM(NTH(1)(ts)))(MEMBASE(NTH(2)(ts)))(MEMDISP(NTH(2)(ts))))
                        (la _. IF(ISREG(NTH(2)(ts)))
                                 (la _. ALU(137)(REGNUM(NTH(1)(ts)))(REGNUM(NTH(2)(ts))))
                                 (la _. IF(ISNUM(NTH(2)(ts)))
                                          (la _. MOVIMM(REGNUM(NTH(1)(ts)))(str_to_int(NTH(2)(ts))))
                                          (la _. MOVABS(REGNUM(NTH(1)(ts)))(LABADDR(NTH(2)(ts))(labs)))))))
      (la _. error(concat("asm: unsupported instruction: ")(op)))))))))))))))))))
  (HD(ts))

# ── one pass: walk the lines, recording each label at its current offset ──
glyph MKLABS = Z(la self. la ls. la labs. la off. la acc.
    ls(acc)(la h. la t.
      (la ts.
        IF(ISLABEL(HD(ts)))
          (la _. self(t)(labs)(off)(CONS(PAIR(LABNAME(HD(ts)))(off))(acc)))
          (la _. self(t)(labs)(add(off)(SIZEL(labs)(off)(ts)))(acc)))
      (TOKS(h)(""))))

glyph TOTLEN = Z(la self. la ls. la labs. la off.
    ls(off)(la h. la t.
      (la ts. self(t)(labs)(add(off)(SIZEL(labs)(off)(ts))))(TOKS(h)(""))))

# ── iterate to the fixed point: length unchanged <=> no promotion <=> stable ──
glyph FIXLABS = Z(la self. la ls. la labs. la n. la org.
    IF(int_eq(n)(0))
      (la _. labs)
      (la _. (la l2. IF(int_eq(TOTLEN(ls)(labs)(org))(TOTLEN(ls)(l2)(org)))
                       (la _. l2)
                       (la _. self(ls)(l2)(sub(n)(1))(org)))
             (MKLABS(ls)(labs)(org)(NIL))))

glyph PASS2 = Z(la self. la labs. la ls. la off.
    ls("")(la h. la t.
      (la ts. concat(ENC1(labs)(off)(ts))(self(labs)(t)(add(off)(SIZEL(labs)(off)(ts)))))
      (TOKS(h)(""))))

# ── ASSEMBLE(source text) -> machine code bytes ──
#   `org N` sets the base address, so labels are ABSOLUTE (what a -f bin image
#   with a load address needs, and what makes `mov rsi, msg` meaningful). Every
#   offset simply starts at N instead of 0; rel8/rel32 are DIFFERENCES, so they
#   are unaffected. `bits`/`org` emit nothing.
glyph ORGOF = Z(la self. la ls.
    ls(0)(la h. la t.
      (la ts. IF(str_eq(HD(ts))("org"))(la _. str_to_int(NTH(1)(ts)))(la _. self(t)))
      (TOKS(h)(""))))

glyph ASSEMBLE = la src.
    (la ls. (la org. PASS2(FIXLABS(ls)(NIL)(12)(org))(ls)(org))(ORGOF(ls)))(LINES(src)(""))

glyph MAIN =
  (la code.
    (la _.
      print(concat(concat("asm.la assembled ")(str_len(code)))(" bytes -> asm_out.bin")))
    (write_file("asm_out.bin")(code)))
  (ASSEMBLE(read_file("asm_in.asm")))
