# =====================================================================
#  asm.la — AN x86-64 ASSEMBLER IN LINGUA ADAMICA.
#
#  The first LA-native toolchain component: it closes the NASM seam for the
#  subset it covers. The boot ASSEMBLY is irreducibly machine-level — but the
#  TOOL THAT ASSEMBLES IT need not be foreign, and that is the seam.
#
#  ── WHY THIS IS NOT A TOY ───────────────────────────────────────────────────
#  The verification is byte-identity against the tool it replaces: assemble the
#  same source with asm.la and with `nasm -f bin`, and diff. There is no room to
#  be approximately right — the bytes match or they do not. (This is the same
#  drift-guard discipline secd.la already uses to keep secd.asm authoritative.)
#
#  ── WHAT BYTE-IDENTITY ACTUALLY DEMANDS ─────────────────────────────────────
#  Matching NASM means matching its ENCODING CHOICES, not merely emitting
#  something the CPU would accept. The sharp one:
#
#      mov rax, 1   ->   b8 01 00 00 00      (5 bytes)
#
#  That is `mov eax, 1`, NOT `movabs rax, 1` (48 b8 + 8-byte imm). A 32-bit
#  write to a 64-bit register ZERO-EXTENDS, so when the immediate fits in
#  unsigned 32 bits NASM takes the shorter form and drops REX.W entirely. An
#  assembler that emitted the "obvious" 10-byte movabs would be CORRECT and
#  still fail the diff. So this is encoded as NASM encodes it.
#
#  ── THE ENCODING RULES IMPLEMENTED ──────────────────────────────────────────
#    reg numbering : rax0 rcx1 rdx2 rbx3 rsp4 rbp5 rsi6 rdi7, r8..r15 = 8..15
#    REX (op r,r)  : 0x48 | (src>=8 ? 0x04 : 0) | (dst>=8 ? 0x01 : 0)
#    ModRM (op r,r): 0xC0 | ((src&7)<<3) | (dst&7)        -- reg=src, rm=dst
#    mov r,imm32   : [0x41 if r>=8] , 0xB8+(r&7) , imm32 little-endian
#    push/pop r    : [0x41 if r>=8] , 0x50+(r&7) / 0x58+(r&7)
#    syscall 0f 05 | ret c3 | nop 90
#
#  ── LABELS AND CONTROL FLOW (two passes) ────────────────────────────────────
#  A label is a line whose token ends in ":". PASS1 walks the lines accumulating
#  an offset and recording each label's address; PASS2 emits, now that every
#  address is known. rel32 is measured from the address of the NEXT instruction,
#  and a BACKWARD jump is negative — folded into the unsigned 32-bit range
#  (d + 2^32) before being split into bytes, since LA's div/mod on a negative
#  would be unreliable. `jz start` at offset 22 becomes 0f 84 e4 ff ff ff, which
#  is exactly what NASM emits.
#
#  SHORT JUMPS NEED A FIXED POINT. NASM emits the shortest jump that reaches:
#  `jmp a` -> eb rel8 (2 bytes) when the target is within a signed byte, else
#  e9 rel32 (5); `jz` -> 74 rel8 (2) or 0f 84 rel32 (6); `call` has NO short form
#  (always e8 rel32). Matching that is the last encoding-CHOICE mismatch, and it
#  is what lets a bare `jmp L` — idiomatic asm — be byte-identical rather than
#  requiring `near`.
#
#  It is the chicken-and-egg proper: a jump's SIZE depends on its target's
#  DISTANCE, which depends on the SIZES of everything between. So: start
#  OPTIMISTIC (every jump short; an unknown forward label is assumed reachable),
#  build the label table, recompute. A jump that no longer reaches is PROMOTED to
#  near — which GROWS the code, which can push another jump out of range — so
#  iterate. Promotion only ever grows the image, so total length is monotonic and
#  bounded: length unchanged <=> no promotion <=> the fixed point. That is the
#  convergence test, with a pass cap as a backstop.
#  The same shape as regen_selfhost.sh iterating the compiler image to ITS fixed
#  point — the project's standing discipline, one level down.
#  An explicit `near` still FORCES the long form (NASM honours it too), so
#  existing `jmp near L` sources stay byte-identical.
#
#  ── HONEST SCOPE ────────────────────────────────────────────────────────────
#  A REAL SUBSET, every instruction of it verified byte-identical against NASM:
#  mov/add/sub/xor (r64,r64), mov (r64,imm32), push/pop (r64), syscall, ret,
#  nop, r8-r15 via REX, labels and control flow (jmp/call/jz/je/jnz/jne) with
#  NASM's short/near selection reproduced via a fixed point, `org` + labels as
#  immediates (movabs), `db` (strings and bytes) so a source carries its own data,
#  and MEMORY OPERANDS for mov in both directions — [base], [base+disp],
#  [base-disp], with the rbp/r13 and rsp/r12 quirks and disp8/disp32 promotion.
#  elf.la's whole write+exit entry is inside it, as is any branching routine
#  over registers and the stack.
#
#  What it is NOT, stated plainly:
#    - memory operands cover a BASE + DISPLACEMENT only: no index/scale
#      ([rax+rcx*4]), no RIP-relative, and only for `mov` — add/sub/xor stay
#      register-to-register;
#    - directives are `bits`/`org`/`db` only — no sections, no dw/dd/dq, no
#      resb, no equ, no paging/GDT/IDT/segment forms, no immediates to memory;
#    - jcc covers jz/je/jnz/jne only — not the signed/unsigned comparison set
#      (jl/jg/jle/jge/jb/ja/...), which is the same encoding + a condition
#      nibble and is mechanical to extend.
#  So it CANNOT yet assemble boot.asm or secd.asm, and NASM remains in the
#  kernel build. The seam is closed for what is here and honestly open beyond
#  it; the byte-identity gate extends to each increment.
#
#  Pure generation (chr/concat/int arithmetic), so it is byte-identical on the
#  C host and the native VM, like elf.la.
# =====================================================================

export ASSEMBLE ASM_ELF TOKS LINES REGNUM

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph TRUE = la t. la f. t
glyph FALSE = la t. la f. f
glyph OR   = la a. la b. a(TRUE)(b)
glyph AND  = la a. la b. a(b)(FALSE)
glyph NOT  = la b. b(FALSE)(TRUE)
glyph CONS = la h. la t. la n. la c. c(h)(t)
glyph NIL  = la n. la c. n
glyph PAIR = la a. la b. la f. f(a)(b)
glyph FST  = la p. p(la a. la b. a)
glyph SND  = la p. p(la a. la b. b)
glyph NONE = la s. la n. n
glyph SOME = la x. la s. la n. s(x)
glyph ISSOME = la o. o(la _. TRUE)(FALSE)
glyph OPTV = la o. o(la x. x)(0)

glyph B = la n. chr(int_to_str(n))
#   A NEGATIVE immediate is folded into the unsigned 32-bit range before being
#   split, because LA's div/mod on a negative is unreliable. That rule was
#   already applied to rel32/rel8/disp; `MB_CHECK equ -(MB_MAGIC + MB_FLAGS)`
#   is the first NEGATIVE CONSTANT, so the same fold belongs here at the source
#   rather than at each call site.
glyph LE4 = la n0.
    (la n.
      concat(B(mod(n)(256)))
     (concat(B(mod(div(n)(256))(256)))
     (concat(B(mod(div(n)(65536))(256)))
            (B(mod(div(n)(16777216))(256))))))
    (IF(lt(n0)(0))(la _. add(4294967296)(n0))(la _. n0))

# ── tokenizing: lines, then whitespace/comma-separated tokens ──
#   ★ A COMMA IS A TOKEN, NOT A SEPARATOR. Treating it as whitespace made
#   `dw 1, 2` (TWO values) and `dw end - gdt64 - 1` (ONE expression) produce the
#   same flat token list, so nothing downstream could tell them apart —
#   `dw end - gdt64 - 1` emitted two words instead of one, the second being
#   `-gdt64-1` = -1. Operand boundaries have to survive tokenization.
glyph ISSEP = la c. OR(str_eq(c)(" "))(str_eq(c)("	"))
#   The tokenizer must be STRING-AWARE: `db "I AM THAT I AM", 10` splits on
#   spaces like everything else, which would shred the string into words. So a
#   quoted run is consumed whole into ONE token, kept with its opening quote so
#   the db emitter can tell a string from a number by its first character.
glyph SCANSTR = Z(la self. la s. la acc.
    IF(str_eq(s)(""))
      (la _. PAIR(acc)(""))
      (la _. IF(str_eq(str_head(s))("\""))
               (la _. PAIR(acc)(str_tail(s)))
               (la _. self(str_tail(s))(concat(acc)(str_head(s))))))
#   The tokenizer must also be BRACKET-AWARE. A memory operand is idiomatically
#   written with spaces — `mov word [rdi + 2], ax` — and every kernel .asm does
#   so, but spaces are the token separator, so `[rdi + 2]` would shred into
#   three tokens. A bracketed run is therefore consumed WHOLE into one token
#   with its interior separators dropped, normalising `[rdi + 2]` to `[rdi+2]`
#   — the form MEMPARTS already parses. An unterminated `[` halts loudly rather
#   than silently swallowing the rest of the line.
glyph SCANBRK = Z(la self. la s. la acc.
    IF(str_eq(s)(""))
      (la _. error("asm: unterminated [ in memory operand"))
      (la _. IF(str_eq(str_head(s))("]"))
               (la _. PAIR(concat(acc)("]"))(str_tail(s)))
               (la _. self(str_tail(s))
                          (IF(ISSEP(str_head(s)))(la _. acc)
                                                 (la _. concat(acc)(str_head(s)))))))
glyph TOKS = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. IF(str_eq(cur)(""))(la _. NIL)(la _. CONS(cur)(NIL)))
      (la _. (la c.
          IF(str_eq(c)("\""))
            (la _. (la p. CONS(concat("\"")(FST(p)))(self(SND(p))("")))
                   (SCANSTR(str_tail(s))("")))
            (la _. IF(str_eq(c)(","))
              (la _. IF(str_eq(cur)(""))
                       (la _. CONS(",")(self(str_tail(s))("")))
                       (la _. CONS(cur)(CONS(",")(self(str_tail(s))("")))))
              (la _. IF(str_eq(c)(";"))
              (la _. IF(str_eq(cur)(""))(la _. NIL)(la _. CONS(cur)(NIL)))
              (la _. IF(str_eq(c)("["))
              (la _. (la p. (la brk.
                       IF(str_eq(cur)(""))
                         (la _. CONS(brk)(self(SND(p))("")))
                         (la _. CONS(cur)(CONS(brk)(self(SND(p))("")))))
                     (concat("[")(FST(p))))
                     (SCANBRK(str_tail(s))("")))
              (la _. IF(ISSEP(c))
                     (la _. IF(str_eq(cur)(""))(la _. self(str_tail(s))(""))
                                               (la _. CONS(cur)(self(str_tail(s))(""))))
                     (la _. self(str_tail(s))(concat(cur)(c))))))))
        (str_head(s))))
glyph LINES = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. CONS(cur)(NIL))
      (la _. IF(str_eq(str_head(s))("\n"))
               (la _. CONS(cur)(self(str_tail(s))("")))
               (la _. self(str_tail(s))(concat(cur)(str_head(s))))))

glyph HD = la l. l("")(la h. la t. h)
glyph NTH = Z(la self. la n. la l. l("")(la h. la t. IF(int_eq(n)(0))(la _. h)(la _. self(sub(n)(1))(t))))
glyph LEN = Z(la self. la l. l(0)(la h. la t. add(1)(self(t))))

# ── labels: a line whose first token ends in ":" ──
glyph LASTCH  = Z(la self. la s. IF(str_eq(str_tail(s))(""))(la _. str_head(s))(la _. self(str_tail(s))))
glyph DROPLAST = Z(la self. la s. IF(str_eq(str_tail(s))(""))(la _. "")(la _. concat(str_head(s))(self(str_tail(s)))))
glyph ISLABEL = la t. IF(str_eq(t)(""))(la _. FALSE)(la _. str_eq(LASTCH(t))(":"))
glyph LABNAME = la t. DROPLAST(t)
#   NOTE (eager-evaluation trap): a Scott list `l(nil)(cons)` evaluates the NIL
#   branch EAGERLY, so an `error(...)` written there fires on EVERY lookup, not
#   just a miss — the same trap CLAUDE.md documents for Church booleans. So the
#   lookup returns an option and the failure is raised through IF, whose
#   branches are thunks and only the selected one is forced.
glyph LOOKLAB = Z(la self. la nm. la l.
    l(NONE)(la h. la t. IF(str_eq(FST(h))(nm))(la _. SOME(SND(h)))(la _. self(nm)(t))))
#   A jmp/call target may be a NUMERIC absolute address (`jmp 0x100000` —
#   boot7b_s2 jumps to the loaded image at its physical address), not a label.
#   TGTOPT resolves a number to its value, otherwise the label table.
glyph TGTOPT = la labs. la nm.
    IF(ISNUM(nm))(la _. SOME(NUMV(nm)))(la _. LOOKLAB(nm)(labs))
glyph LABADDR = la nm. la labs.
    (la o. IF(ISSOME(o))(la _. OPTV(o))
                        (la _. error(concat("asm: undefined label: ")(nm))))
    (TGTOPT(labs)(nm))

#   A jump's operand is NTH 1, or NTH 2 when an explicit `near` is written.
glyph TARGET = la ts. IF(str_eq(NTH(1)(ts))("near"))(la _. NTH(2)(ts))(la _. NTH(1)(ts))

#   rel32 is relative to the address of the NEXT instruction, and is two's
#   complement when the target is behind us. LA's div/mod on a negative would be
#   unreliable, so a backward jump is folded into the unsigned 32-bit range
#   FIRST (d + 2^32) and only then split into bytes — e.g. -28 -> 4294967268
#   -> e4 ff ff ff, exactly what NASM emits for `jz start` above.
glyph REL32 = la labs. la nm. la next.
    (la d. IF(lt(d)(0))(la _. add(4294967296)(d))(la _. d))
    (sub(LABADDR(nm)(labs))(next))
#   16-bit mode: near call/jmp use rel16 (2-byte offset), so a near jmp/call is
#   3 bytes (opcode+rel16) not 5, a near jcc 4 not 6. mode!=16 → rel32, byte-
#   identical. NEARSZ/NEARDISP parameterise by opclen (1 for call/jmp, 2 for jcc)
#   and keep SIZE and EMIT in lockstep (same next = off + opclen + disp-width).
glyph REL16 = la labs. la nm. la next.
    (la d. IF(lt(d)(0))(la _. add(65536)(d))(la _. d))
    (sub(LABADDR(nm)(labs))(next))
glyph NEARSZ = la mode. la opclen.
    IF(int_eq(mode)(16))(la _. add(opclen)(2))(la _. add(opclen)(4))
glyph NEARDISP = la mode. la labs. la nm. la off. la opclen.
    IF(int_eq(mode)(16))
      (la _. LE2(REL16(labs)(nm)(add(off)(add(opclen)(2)))))
      (la _. LE4(REL32(labs)(nm)(add(off)(add(opclen)(4)))))

# ── the register file: name -> (number, WIDTH in bytes) ─────────────────────
#   Width is not decoration — it selects the opcode, the prefix and the REX
#   byte, so it must travel with the register. The kernel .asm use all four
#   widths heavily (713 sub-64-bit register mentions against 451 64-bit ones),
#   so a 64-bit-only assembler reads almost none of the OS.
#
#   Held as a CONS list, NOT as the flat scanned literal this was first written
#   as. The flat-literal idiom (`theourgia_font.la` / `secd.la`) is right when a
#   table is DATA merely carried through codegen; it is wrong when the table is
#   HOT, because `str_tail` COPIES the remainder, so scanning a 568-char string
#   char-by-char is quadratic and every operand re-scans it on every
#   fixed-point pass. The list scan is pointer-chasing with no copying.
#
#   HONEST MEASUREMENT — and a caution about reasoning ahead of it. Assembling
#   N `mov rax, rcx` (CPU time) went roughly:
#       ~0.06-0.09 s/instruction  before the width slice
#       ~0.49       s/instruction  with the slice, unoptimised
#       ~0.25       s/instruction  after the optimisations below
#   ★ Stated as RANGES, not points, and that correction came from a freeze-day
#   re-measurement: the original figures were 0.09 and 0.26, and re-running the
#   identical benchmark later gave 0.062 and 0.247. The machine was running two
#   other agents' builds, so the absolute numbers move with load and only the
#   RATIO (~3-4x) is stable. Writing them as though they were exact was the same
#   over-precision this file warns about elsewhere.
#   The list-vs-flat-table argument above is sound but was NOT the bottleneck,
#   and neither was the operand plumbing WITHOPS fixes — both were changed on
#   plausible reasoning and neither moved the number. What actually dominated
#   was found only by MEASURING (stub out a suspect, re-time): every pass
#   re-tokenized every line, so the fix was to tokenize once (see MAPTOKS),
#   worth ~2x on its own. Sizing-by-encoding is the remaining ~39%, kept
#   deliberately because a second length implementation is how drift enters.
#   Two wrong hypotheses in a row is the lesson: a plausible cause is not a
#   measured one.
#
#   Note `ah/ch/dh/bh` (numbers 4-7) COLLIDE with `spl/bpl/sil/dil`
#   (also 4-7). They are not synonyms — the hardware distinguishes them by
#   whether a REX prefix is present at all, which is exactly why REX cannot be
#   decided from the register number alone. See REXOPT.
glyph REGS =
  CONS(PAIR("rax")(PAIR(0)(8)))(CONS(PAIR("rcx")(PAIR(1)(8)))(CONS(PAIR("rdx")(PAIR(2)(8)))(CONS(PAIR("rbx")(PAIR(3)(8)))(
  CONS(PAIR("rsp")(PAIR(4)(8)))(CONS(PAIR("rbp")(PAIR(5)(8)))(CONS(PAIR("rsi")(PAIR(6)(8)))(CONS(PAIR("rdi")(PAIR(7)(8)))(
  CONS(PAIR("r8")(PAIR(8)(8)))(CONS(PAIR("r9")(PAIR(9)(8)))(CONS(PAIR("r10")(PAIR(10)(8)))(CONS(PAIR("r11")(PAIR(11)(8)))(
  CONS(PAIR("r12")(PAIR(12)(8)))(CONS(PAIR("r13")(PAIR(13)(8)))(CONS(PAIR("r14")(PAIR(14)(8)))(CONS(PAIR("r15")(PAIR(15)(8)))(
  CONS(PAIR("eax")(PAIR(0)(4)))(CONS(PAIR("ecx")(PAIR(1)(4)))(CONS(PAIR("edx")(PAIR(2)(4)))(CONS(PAIR("ebx")(PAIR(3)(4)))(
  CONS(PAIR("esp")(PAIR(4)(4)))(CONS(PAIR("ebp")(PAIR(5)(4)))(CONS(PAIR("esi")(PAIR(6)(4)))(CONS(PAIR("edi")(PAIR(7)(4)))(
  CONS(PAIR("r8d")(PAIR(8)(4)))(CONS(PAIR("r9d")(PAIR(9)(4)))(CONS(PAIR("r10d")(PAIR(10)(4)))(CONS(PAIR("r11d")(PAIR(11)(4)))(
  CONS(PAIR("r12d")(PAIR(12)(4)))(CONS(PAIR("r13d")(PAIR(13)(4)))(CONS(PAIR("r14d")(PAIR(14)(4)))(CONS(PAIR("r15d")(PAIR(15)(4)))(
  CONS(PAIR("ax")(PAIR(0)(2)))(CONS(PAIR("cx")(PAIR(1)(2)))(CONS(PAIR("dx")(PAIR(2)(2)))(CONS(PAIR("bx")(PAIR(3)(2)))(
  CONS(PAIR("sp")(PAIR(4)(2)))(CONS(PAIR("bp")(PAIR(5)(2)))(CONS(PAIR("si")(PAIR(6)(2)))(CONS(PAIR("di")(PAIR(7)(2)))(
  CONS(PAIR("r8w")(PAIR(8)(2)))(CONS(PAIR("r9w")(PAIR(9)(2)))(CONS(PAIR("r10w")(PAIR(10)(2)))(CONS(PAIR("r11w")(PAIR(11)(2)))(
  CONS(PAIR("r12w")(PAIR(12)(2)))(CONS(PAIR("r13w")(PAIR(13)(2)))(CONS(PAIR("r14w")(PAIR(14)(2)))(CONS(PAIR("r15w")(PAIR(15)(2)))(
  CONS(PAIR("al")(PAIR(0)(1)))(CONS(PAIR("cl")(PAIR(1)(1)))(CONS(PAIR("dl")(PAIR(2)(1)))(CONS(PAIR("bl")(PAIR(3)(1)))(
  CONS(PAIR("spl")(PAIR(4)(1)))(CONS(PAIR("bpl")(PAIR(5)(1)))(CONS(PAIR("sil")(PAIR(6)(1)))(CONS(PAIR("dil")(PAIR(7)(1)))(
  CONS(PAIR("r8b")(PAIR(8)(1)))(CONS(PAIR("r9b")(PAIR(9)(1)))(CONS(PAIR("r10b")(PAIR(10)(1)))(CONS(PAIR("r11b")(PAIR(11)(1)))(
  CONS(PAIR("r12b")(PAIR(12)(1)))(CONS(PAIR("r13b")(PAIR(13)(1)))(CONS(PAIR("r14b")(PAIR(14)(1)))(CONS(PAIR("r15b")(PAIR(15)(1)))(
  CONS(PAIR("ah")(PAIR(4)(1)))(CONS(PAIR("ch")(PAIR(5)(1)))(CONS(PAIR("dh")(PAIR(6)(1)))(CONS(PAIR("bh")(PAIR(7)(1)))(
  NIL))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
glyph LOOKREG = Z(la self. la nm. la l.
    l(NONE)(la h. la t. IF(str_eq(FST(h))(nm))(la _. SOME(SND(h)))(la _. self(nm)(t))))
glyph RENT   = la nm. LOOKREG(nm)(REGS)
glyph ISREG  = la nm. ISSOME(RENT(nm))
#   An unknown register name HALTS rather than silently encoding as rax: the
#   old table returned 0 for a miss, so a typo'd operand assembled to a wrong
#   but plausible instruction — a silent-corruption path, the one thing the
#   loud-failure discipline forbids.
glyph REGENT = la nm.
    (la o. IF(ISSOME(o))(la _. OPTV(o))
                        (la _. error(concat("asm: unknown register: ")(nm))))
    (RENT(nm))
glyph REGNUM = la nm. FST(REGENT(nm))
glyph RWIDTH = la nm. SND(REGENT(nm))
#   spl/bpl/sil/dil are UNREACHABLE without a REX byte (with no REX those
#   encodings mean ah/ch/dh/bh), so they FORCE one even when it carries no
#   bits — NASM emits a bare 0x40. Conversely ah/ch/dh/bh are unreachable WITH
#   one, so any REX alongside them is an error, not a re-encoding.
glyph NEEDREX8 = la nm.
    OR(str_eq(nm)("spl"))(OR(str_eq(nm)("bpl"))(OR(str_eq(nm)("sil"))(str_eq(nm)("dil"))))
glyph ISHIGH8 = la nm.
    OR(str_eq(nm)("ah"))(OR(str_eq(nm)("ch"))(OR(str_eq(nm)("dh"))(str_eq(nm)("bh"))))
#   A register token only when it IS one — used to decide operand shape before
#   committing to an encoding.
glyph RFORCE = la nm. IF(ISREG(nm))(la _. NEEDREX8(nm))(la _. FALSE)
glyph RHIGH  = la nm. IF(ISREG(nm))(la _. ISHIGH8(nm))(la _. FALSE)

# ── encodings ────────────────────────────────────────────────────────────────
#   An instruction's bytes are, in this order:
#       [0x66] [REX] opcode modrm [sib] [disp] [imm]
#   The 0x66 operand-size prefix comes BEFORE the REX byte, not after — NASM
#   emits `mov r9w, ax` as 66 41 89 C1, and an encoder that ordered them the
#   other way would produce something the CPU decodes as a different
#   instruction entirely.
glyph MODRM = la dst. la src. B(add(192)(add(mul(mod(src)(8))(8))(mod(dst)(8))))

#   16-bit operands are the 32-bit encoding under a 0x66 prefix.
glyph P66 = la w. IF(int_eq(w)(2))(la _. B(102))(la _. "")
#   Mode-aware operand-size prefix. In 16-bit mode the default is 16-bit, so a
#   16-bit operand (w=2) needs NO 0x66 and a 32-bit operand (w=4) needs it — the
#   reverse of 32/64 mode. Only the prefix changes; opcode (OP8), immediate width
#   (IMMW), MODRM and REX are already correct for w=2. mode!=16 → plain P66, so
#   32/64-bit output is byte-identical.
glyph P66M = la mode. la w.
    IF(int_eq(mode)(16))
      (la _. IF(int_eq(w)(4))(la _. B(102))(la _. ""))
      (la _. P66(w))
#   String port I/O (ins/outs): insb 6C, insw/insd 6D, outsb 6E, outsw/outsd 6F.
#   The word/dword variants carry an operand-size prefix per mode (P66M), so
#   `insw` is 6D in 16-bit but 66 6D in 32-bit; insb/outsb (byte) never prefix.
glyph STRIOENC = la opc. la sz. la mode. concat(P66M(mode)(sz))(B(opc))

#   REX is OPTIONAL — this is the heart of the width slice. The old encoder
#   hard-coded 0x48 (REX.W) because every operand was 64-bit; at other widths
#   a REX byte must be emitted only when it carries information, since an
#   unnecessary one is not a no-op:
#     W = 1 only at width 8   (32-bit writes zero-extend, so REX.W is WRONG
#                              for them, not merely redundant)
#     R = reg field >= 8      B = rm/base field >= 8
#   `force` covers spl/bpl/sil/dil, which need a REX byte even when it carries
#   NO bits — NASM emits a bare 0x40 for `mov dil, 5`.
glyph REXOPT = la w. la r. la b. la force.
    (la v. IF(OR(NOT(int_eq(v)(64)))(force))(la _. B(v))(la _. ""))
    (add(64)(add(IF(int_eq(w)(8))(la _. 8)(la _. 0))
            (add(IF(lt(r)(8))(la _. 0)(la _. 4))
                (IF(lt(b)(8))(la _. 0)(la _. 1)))))

#   The 8-bit form of an r/m,r opcode is the 32-bit one MINUS ONE
#   (mov 89->88, add 01->00, sub 29->28, xor 31->30) — a regularity of the
#   opcode map, not a coincidence.
glyph OP8 = la op. la w. IF(int_eq(w)(1))(la _. sub(op)(1))(la _. op)

#   ah/ch/dh/bh and spl/bpl/sil/dil share register numbers 4-7 and are told
#   apart ONLY by whether a REX byte is present. So an instruction pairing a
#   high-byte register with anything that forces REX is not re-encodable — it
#   is unrepresentable, and silently emitting spl where ah was written is
#   exactly the corruption the loud-failure discipline exists to prevent.
glyph EXTREG = la nm. IF(ISREG(nm))(la _. NOT(lt(REGNUM(nm))(8)))(la _. FALSE)
glyph HIGH8OK = la a. la b.
    IF(OR(RHIGH(a))(RHIGH(b)))
      (la _. IF(OR(OR(RFORCE(a))(RFORCE(b)))(OR(EXTREG(a))(EXTREG(b))))
               (la _. error("asm: ah/ch/dh/bh cannot be encoded alongside a REX prefix"))
               (la _. TRUE))
      (la _. TRUE)

#   mov r, imm at each width. NASM's choice at width 8 is already documented
#   below (an immediate fitting unsigned 32 bits takes the zero-extending
#   32-bit form, so REX.W is dropped) — which is why width 8 routes through the
#   width-4 encoder here rather than having a case of its own.
glyph LE2 = la n0.
    (la n. concat(B(mod(n)(256)))(B(mod(div(n)(256))(256))))
    (IF(lt(n0)(0))(la _. add(65536)(n0))(la _. n0))
glyph MOVIMM = la w. la dst. la n. la force. la mode.
    IF(int_eq(w)(1))
      (la _. concat(REXOPT(1)(0)(dst)(force))
            (concat(B(add(176)(mod(dst)(8))))(B(n))))
      (la _. IF(int_eq(w)(2))
        (la _. concat(P66M(mode)(2))(concat(REXOPT(2)(0)(dst)(FALSE))
              (concat(B(add(184)(mod(dst)(8))))(LE2(n)))))
        (la _. concat(P66M(mode)(4))(concat(REXOPT(4)(0)(dst)(FALSE))
              (concat(B(add(184)(mod(dst)(8))))(LE4(n))))))

#   A LABEL as an immediate is NOT the same encoding as a NUMBER. NASM emits
#   `mov rsi, msg` (msg a label) as 48 be + imm64 — movabs, 10 bytes — while
#   `mov rax, 1` takes the 5-byte b8+imm32 form. The address would FIT in 32
#   bits, so this is a deliberate NASM choice about labels, not an arithmetic
#   necessity: matching it means distinguishing the two SYNTACTICALLY (all
#   digits -> number; otherwise -> label), which also lets SIZEL know the size
#   before any label address is known.
glyph LE8 = la n. concat(LE4(mod(n)(4294967296)))(LE4(div(n)(4294967296)))
glyph INSTR = Z(la self. la c. la s.
    IF(str_eq(s)(""))(la _. FALSE)
      (la _. IF(str_eq(str_head(s))(c))(la _. TRUE)(la _. self(c)(str_tail(s)))))
glyph ISDIGIT = la c. INSTR(c)("0123456789")
#   NASM folds mnemonic/directive case (BITS == bits). The op token is the
#   mnemonic AFTER STRIPLAB (labels are removed first, operands read the original
#   ts), so lowercasing it is safe and makes `BITS 64` etc. dispatch. Labels and
#   register operands keep their case.
glyph LOWER1 = la c.
    (la o. IF(AND(NOT(lt(o)(65)))(lt(o)(91)))(la _. chr(int_to_str(add(o)(32))))(la _. c))(str_to_int(ord(c)))
glyph LOWER = Z(la self. la s.
    IF(str_eq(s)(""))(la _. "")(la _. concat(LOWER1(str_head(s)))(self(str_tail(s)))))
glyph ALLDIG = Z(la self. la s.
    IF(str_eq(s)(""))(la _. TRUE)(la _. AND(ISDIGIT(str_head(s)))(self(str_tail(s)))))

# ── HEX LITERALS ────────────────────────────────────────────────────────────
#   Machine-level source is written in hex — the kernel .asm carry 271 `0x…`
#   literals against 642 decimal — so a decimal-only assembler cannot read its
#   own OS. `NUMV` is the ONE place a numeric token becomes an integer, so
#   every operand position (immediates AND displacements) accepts both forms.
glyph ISHEXDIG = la c. INSTR(c)("0123456789abcdefABCDEF")
glyph ALLHEX = Z(la self. la s.
    IF(str_eq(s)(""))(la _. TRUE)(la _. AND(ISHEXDIG(str_head(s)))(self(str_tail(s)))))
glyph HEXV1 = la c.
    (la o. IF(lt(o)(58))(la _. sub(o)(48))
             (la _. IF(lt(o)(71))(la _. sub(o)(55))(la _. sub(o)(87))))
    (str_to_int(ord(c)))
glyph HEXFOLD = Z(la self. la s. la acc.
    IF(str_eq(s)(""))(la _. acc)
      (la _. self(str_tail(s))(add(mul(acc)(16))(HEXV1(str_head(s))))))
glyph ISHEXPFX = la t.
    AND(str_eq(str_head(t))("0"))(str_eq(str_head(str_tail(t)))("x"))
glyph HEXBODY = la t. str_tail(str_tail(t))
#   NUMV halts NAMING the token. It used to fall through to the host's
#   `str_to_int: not a decimal integer`, which reports a real failure at the
#   wrong layer — the reader learns a string builtin was misused, not WHICH
#   operand the assembler could not read. Same defect as the earlier shl/test
#   diagnostics: halting loudly is not enough if the message sends you to the
#   wrong place.
glyph NUMV = la t.
    IF(ISHEXPFX(t))(la _. HEXFOLD(HEXBODY(t))(0))
      (la _. IF(ISNUM(t))
               (la _. str_to_int(t))
               (la _. error(concat("asm: not a number (undefined symbol?): ")(t))))
#   What makes a token a VALUE rather than a label: the `=` marker on a
#   resolved equ, `$`, any operator, a parenthesis, or a LEADING minus. The last
#   two were missing and `-(MB_MAGIC + MB_FLAGS)` fell through to the label
#   path, which is why it halted as an undefined symbol rather than evaluating.
glyph ISEXPRTOK = la t.
    OR(str_eq(str_head(t))("="))(OR(INSTR("-")(t))(OR(INSTR("+")(t))(OR(INSTR("(")(t))
   (OR(INSTR("$")(t))
   (OR(INSTR("*")(t))(OR(INSTR("/")(t))(OR(INSTR("|")(t))(OR(INSTR("&")(t))
   (OR(INSTR("^")(t))(OR(INSTR("<")(t))(OR(INSTR(">")(t))(INSTR("'")(t)))))))))))))
glyph ISNUM = la t.
    IF(str_eq(t)(""))(la _. FALSE)
      (la _. IF(ISHEXPFX(t))
               (la _. (la b. AND(NOT(str_eq(b)("")))(ALLHEX(b)))(HEXBODY(t)))
               (la _. ALLDIG(t)))
glyph MOVABS = la r. la n.
    concat(B(add(72)(IF(lt(r)(8))(la _. 0)(la _. 1))))
   (concat(B(add(184)(mod(r)(8))))(LE8(n)))

#   `push qword 0` — an IMMEDIATE, not a register. 6A + imm8 when it fits a
#   signed byte, else 68 + imm32; the `qword` keyword does not add a REX, the
#   push is 64-bit by default in long mode. idt.asm's ISR stubs push the vector
#   number this way, 32 times via a macro.
glyph PUSHIMM = la n.
    IF(FITS8(n))(la _. concat(B(106))(B(FOLD8(n))))
                (la _. concat(B(104))(LE4(n)))
glyph PUSHPOP = la base. la r.
    concat(IF(lt(r)(8))(la _. "")(la _. B(65)))(B(add(base)(mod(r)(8))))

# ── MEMORY OPERANDS: [base] / [base+disp] / [base-disp] ─────────────────────
#   Three cases in the x86-64 encoding must be matched exactly or NASM's bytes
#   diverge, and each is a real hardware quirk rather than a NASM preference:
#     rbp / r13  (rm==5): mod=00 rm=101 is RIP-RELATIVE, so [rbp] CANNOT be
#                encoded with mod=00 — it is forced to mod=01 with disp8=0.
#                NASM: mov rax,[rbp] -> 48 8b 45 00
#     rsp / r12  (rm==4): mod=xx rm=100 means "a SIB byte follows", so [rsp]
#                needs SIB=0x24 (scale=0, index=none(100), base=100).
#                NASM: mov rax,[rsp] -> 48 8b 04 24
#     disp size : 0 -> mod=00 (no displacement bytes); fits in a signed byte ->
#                mod=01 + disp8; otherwise mod=10 + disp32.
#   A negative displacement is folded into range before splitting (LA's div/mod
#   on a negative is unreliable): -8 -> disp8 0xf8, matching NASM's [rbp-8].
glyph ISMEM   = la t. IF(str_eq(t)(""))(la _. FALSE)(la _. str_eq(str_head(t))("["))
glyph STRIPBRK = la t. DROPLAST(str_tail(t))
glyph SPLITSIGN = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. PAIR(cur)(0))
      (la _. (la c.
          IF(OR(str_eq(c)("+"))(str_eq(c)("-")))
            (la _. PAIR(cur)(IF(str_eq(c)("+"))
                               (la _. NUMV(str_tail(s)))
                               (la _. sub(0)(NUMV(str_tail(s))))))
            (la _. self(str_tail(s))(concat(cur)(c))))
        (str_head(s))))
glyph MEMPARTS = la t. SPLITSIGN(STRIPBRK(t))("")
# ── SIB index/scale: `[base + index*scale (+ disp)]` ────────────────────────
#   The tokenizer strips spaces inside brackets, so STRIPBRK is e.g.
#   "rsi+r8*8" / "FREEBLOB+r8*8" / "rsi+r8" / "rax+rcx*4+8". The INDEX is the
#   second '+'-term (idiomatic base+index[*scale][+disp]); its register resolves
#   to 0 in MEMDISP's EVAL (unknown name -> 0, *scale -> 0), so MEMBASE/MEMDISP
#   already give the right base and disp — only the index+scale need extracting
#   and a SIB byte + REX.X emitting. No index -> every helper is a no-op sentinel.
glyph AFTERPLUS = Z(la self. la s.
    IF(str_eq(s)(""))(la _. "")(la _.
      IF(str_eq(str_head(s))("+"))(la _. str_tail(s))(la _. self(str_tail(s)))))
glyph UPTOSIGN = Z(la self. la s. la cur.
    IF(str_eq(s)(""))(la _. cur)(la _.
      (la c. IF(OR(str_eq(c)("+"))(str_eq(c)("-")))(la _. cur)(la _. self(str_tail(s))(concat(cur)(c))))(str_head(s))))
glyph UPTOSTAR = Z(la self. la s. la cur.
    IF(str_eq(s)(""))(la _. cur)(la _.
      IF(str_eq(str_head(s))("*"))(la _. cur)(la _. self(str_tail(s))(concat(cur)(str_head(s))))))
glyph AFTERSTAR = Z(la self. la s.
    IF(str_eq(s)(""))(la _. "")(la _.
      IF(str_eq(str_head(s))("*"))(la _. str_tail(s))(la _. self(str_tail(s)))))
glyph MEMIDXTOK = la t. UPTOSIGN(AFTERPLUS(STRIPBRK(t)))("")
glyph MEMIDXREG = la t. UPTOSTAR(MEMIDXTOK(t))("")
glyph MEMHASIDX = la t. ISREG(MEMIDXREG(t))
glyph MEMIDX = la t. IF(MEMHASIDX(t))(la _. REGNUM(MEMIDXREG(t)))(la _. sub(0)(1))
glyph SCALEB = la n.
    IF(int_eq(n)(1))(la _. 0)(la _. IF(int_eq(n)(2))(la _. 1)(la _.
    IF(int_eq(n)(4))(la _. 2)(la _. IF(int_eq(n)(8))(la _. 3)
    (la _. error(concat("asm: invalid SIB scale (must be 1/2/4/8): ")(int_to_str(n)))))))
glyph MEMSCALEB = la t.
    (la a. IF(str_eq(a)(""))(la _. 0)(la _. SCALEB(NUMV(a))))(AFTERSTAR(MEMIDXTOK(t)))
# ── RIP-relative `[rel label]` ──────────────────────────────────────────────
#   The tokenizer strips the space, so `[rel METAL_FLAG]` -> inner "relMETAL_FLAG".
#   A `rel` prefix marks RIP-relative: ModRM mod=00 rm=101 + disp32 where
#   disp32 = label - next_ip. next_ip (off + this instruction's length) is
#   threaded through the label table as "@next" (bound in ENC1, exactly as `$`
#   is via WITHDOLLAR), so no encoder signature changes — MEMBASE returns the
#   sentinel -2, MEMDISP returns the RIP disp, MEMTAILX emits the rm=101 form.
#   (Limitation: a bare bracket label literally starting with "rel" would be
#   misread; none in the -f bin targets.)
glyph HASRELPFX = la s.
    AND(str_eq(str_head(s))("r"))(AND(str_eq(str_head(str_tail(s)))("e"))(str_eq(str_head(str_tail(str_tail(s))))("l")))
glyph MEMRIP = la t. AND(ISMEM(t))(HASRELPFX(STRIPBRK(t)))
glyph RIPLAB = la t. str_tail(str_tail(str_tail(STRIPBRK(t))))
glyph RIPNEXT = la labs. (la o. IF(ISSOME(o))(la _. OPTV(o))(la _. 0))(LOOKLAB("@next")(labs))
glyph RIPDISP = la labs. la t. sub(EVAL(labs)(RIPLAB(t)))(RIPNEXT(labs))
#   ★ An ABSOLUTE address has no base register at all — `mov [0x300000], ebx`.
#   x86-64 spells "no base" as mod=00, rm=100 (SIB follows), SIB=0x25
#   (scale=0, index=none(100), base=none(101)), then a disp32. A base of -1 is
#   the sentinel for that shape; REXOPT already treats it correctly, since
#   lt(-1)(8) leaves REX.B clear, which is right — there is no base to extend.
glyph MEMABS   = la t. NOT(ISREG(FST(SPLITFIRST(STRIPBRK(t))("")))) 
glyph MEMBASE  = la t.
    IF(MEMRIP(t))(la _. sub(0)(2))
    (la _. IF(MEMABS(t))(la _. sub(0)(1))
                 (la _. REGNUM(FST(SPLITFIRST(STRIPBRK(t))("")))))
#   ★ A LABEL may BE the address: `mov [pml4], eax` — 136 such uses in
#   boot.asm. Resolving it needs the label table, which MEMDISP did not have,
#   so this threads `labs` through the memory-operand path.
#
#   ★★ WHY LAZY RESOLUTION IS SAFE HERE, and why it would NOT be in general.
#   During the fixed-point iteration the label table starts EMPTY, so an
#   unresolved symbol yields 0. That is only sound because an ABSOLUTE address
#   (no base register) always emits mod=00 + SIB + disp32 — a CONSTANT 6-byte
#   tail whatever the value is. So sizing with 0 and emitting with the real
#   address give the same LENGTH, and SIZEL cannot drift from ENC1.
#   For a base+displacement form the size DOES depend on the value (disp8 vs
#   disp32), so the same trick there would silently mis-size. That case is a
#   loud halt instead: boot.asm's three register-relative symbol uses are
#   `[r8 + PCB_SIZE + 16]`, which are equ constants inside a MULTI-TERM sum —
#   an expression-evaluator problem, not a label-resolution one.
# ── AN EXPRESSION EVALUATOR, C PRECEDENCE ───────────────────────────────────
#   boot.asm's real expression language, measured rather than guessed at
#   one-operator-per-run: `|` x37, `<<` x29, parentheses x29, char literals
#   x10, plus the `+ - * /` already handled. `or eax, (1 << 8) | (1 << 0)`
#   needs six precedence levels and grouping; two levels and no parens is not
#   a smaller version of that, it is a wrong one.
#
#       E1  |            (lowest)
#       E2  ^
#       E3  &
#       E4  << >>
#       E5  + -
#       E6  * /          (highest)
#       E7  primary: number, symbol, 'c', ( E1 )
#
#   Each level parses the level above, then folds while it sees its own
#   operators — standard recursive descent, one glyph per level. Each returns
#   PAIR(value)(rest) so a level can hand the unconsumed tail upward.
#
#   ★ THE BITWISE OPS ARE ASSEMBLE-TIME CONSTANT FOLDS, which is why Lingua
#   Adamica having no bitwise primitives does not block this. That measured
#   limit — ~5.6 ms per emulated 32-bit XOR, ~16 HOURS to hash a MiB — is fatal
#   for cryptography, where the operation is the inner loop over megabytes. Here
#   it is 37 uses of small constants at assembly time: a 32-iteration loop each,
#   microseconds in total. Same missing primitive, opposite verdict, because the
#   workload differs by six orders of magnitude.
#
#   Shifts need no loop at all: `a << b` is `a * 2^b` and `a >> b` is
#   `a / 2^b`.
glyph POW2 = Z(la self. la n. IF(int_eq(n)(0))(la _. 1)(la _. mul(2)(self(sub(n)(1)))))
glyph BITW = Z(la self. la kind. la a. la b. la p. la acc. la n.
    IF(int_eq(n)(0))(la _. acc)
      (la _. (la ab. (la bb.
          (la r. self(kind)(a)(b)(mul(p)(2))(add(acc)(mul(r)(p)))(sub(n)(1)))
          (IF(int_eq(kind)(0))
             (la _. mul(ab)(bb))
             (la _. IF(int_eq(kind)(1))
                      (la _. IF(int_eq(add(ab)(bb))(0))(la _. 0)(la _. 1))
                      (la _. mod(add(ab)(bb))(2)))))
        (mod(div(b)(p))(2)))
        (mod(div(a)(p))(2))))
#   ★ 63-BIT, NOT 32. BITW walks n bit positions; at 32 every bit from 32 up was
#   silently dropped, so `(1<<43)|(1<<44)` came out 0. boot.asm's GDT descriptors
#   are exactly this shape — `dq (1<<43)|(1<<44)|(1<<47)|(1<<53)` — so a 64-bit
#   constant assembled to zeros, and the only place it showed was the LINKED
#   image (the reloc metadata all matched; this is section CONTENT). 63 covers
#   bits 0..62 — the full positive signed-64 range, which is every assembler
#   constant — while stopping short of bit 63, whose value 2^63 is negative and
#   would break BITW's div/mod decomposition. `p` is doubled per step, not a POW2
#   lookup, so the wider walk costs 31 extra cheap iterations per bitwise op.
glyph BAND = la a. la b. BITW(0)(a)(b)(1)(0)(63)
glyph BOR  = la a. la b. BITW(1)(a)(b)(1)(0)(63)
glyph BXOR = la a. la b. BITW(2)(a)(b)(1)(0)(63)

glyph HD2 = la s. str_head(str_tail(s))
glyph ISQUOTE = la s. str_eq(str_head(s))("'")

#   E7 — primary. A parenthesised sub-expression re-enters at the LOWEST level,
#   which is what makes `(a | b) * c` group correctly.
glyph E7 = Z(la self. la labs. la s. la cur.
    IF(str_eq(s)(""))
      (la _. PAIR(MEMVAL(labs)(cur))(""))
      (la _. (la c.
        IF(AND(str_eq(cur)(""))(str_eq(c)("-")))
          (la _. (la p. PAIR(sub(0)(FST(p)))(SND(p)))(E7(labs)(str_tail(s))("")))
        (la _. IF(AND(str_eq(cur)(""))(str_eq(c)("(")))
          (la _. (la p. PAIR(FST(p))(str_tail(SND(p))))(E1(labs)(str_tail(s))))
          (la _. IF(AND(str_eq(cur)(""))(str_eq(c)("'")))
            (la _. PAIR(str_to_int(ord(HD2(s))))(str_tail(str_tail(str_tail(s)))))
            (la _. IF(ISTERM(c))
                     (la _. PAIR(MEMVAL(labs)(cur))(s))
                     (la _. self(labs)(str_tail(s))(concat(cur)(c)))))))
      (str_head(s))))
glyph ISTERM = la c.
    OR(str_eq(c)("|"))(OR(str_eq(c)("^"))(OR(str_eq(c)("&"))(OR(str_eq(c)("<"))
   (OR(str_eq(c)(">"))(OR(str_eq(c)("+"))(OR(str_eq(c)("-"))(OR(str_eq(c)("*"))
   (OR(str_eq(c)("/"))(str_eq(c)(")"))))))))))

#   An operand expression whose NET LABEL COEFFICIENT is non-zero is address-
#   valued, so a 64-bit destination must take the imm64 `movabs` form — exactly
#   as a BARE label does. NASM assembles `mov rax, idt + 8` like `mov rax, idt`
#   (48 b8 + imm64), NOT like a number that happens to fit 32 bits
#   (b8 + imm32). Before this, a label buried in an expression (has an operator,
#   so ISVAL routes it through EVAL) took the numeric b8 path — the wrong form
#   AND, because the size was then 5 not 10, a wrong label address fed back
#   through the fixed point (`idt+0x210` came out 0x215 instead of 0x21a).
#   equ symbols are substituted to their literal number BEFORE the passes, so
#   any maximal token that is NOT a number is a label (or `$`); the SIGNED SUM of
#   those over the additive terms (ADDRBAL, below) is the coefficient — a label
#   DIFFERENCE like `tail - head` nets to 0 and stays a b8 constant. That makes
#   the test purely SYNTACTIC — no label table needed — so MOVSIZE (which sizes
#   this case via MOVENC with an EMPTY label table) and the emit pass reach the
#   same verdict, and it is MONOTONE (movabs only GROWS the image), so it folds
#   into the length fixed point like jump promotion.
glyph EXBND = la c.
    OR(ISTERM(c))(OR(str_eq(c)("("))(OR(str_eq(c)(" "))(str_eq(c)("'"))))
#   "Contains a label token" is too broad: a label DIFFERENCE `tail - head` is a
#   relative CONSTANT (nasm emits b8+imm32), not an address, even though it names
#   two labels. The right test is nasm's: an expression is address-typed iff its
#   NET LABEL COEFFICIENT is non-zero — sum, over the top-level additive terms,
#   of +1 for a label term and -1 for a subtracted one. `idt + 8` -> +1 (address
#   -> movabs); `tail - head` -> +1-1 = 0 (constant -> b8); `0x100 + idt` -> +1.
#   FLUSHLAB folds a completed term (a non-number identifier token is the label)
#   into the running net with the term's sign; NEWSGN sets the next term's sign
#   from a top-level + or - (other operators keep it, since * / << bind tighter
#   than the additive split). A term with two labels (idt*jdt) or a scaled label
#   nasm rejects outright, so mis-counting those is a don't-care (no reference).
glyph FLUSHLAB = la cur. la sgn. la net.
    IF(AND(NOT(str_eq(cur)("")))(NOT(ISNUM(cur))))(la _. add(net)(sgn))(la _. net)
glyph NEWSGN = la c. la sgn.
    IF(str_eq(c)("+"))(la _. 1)(la _. IF(str_eq(c)("-"))(la _. sub(0)(1))(la _. sgn))
glyph ADDRBAL = Z(la self. la s. la cur. la sgn. la net.
    IF(str_eq(s)(""))
      (la _. FLUSHLAB(cur)(sgn)(net))
      (la _. (la c.
        IF(EXBND(c))
          (la _. self(str_tail(s))("")(NEWSGN(c)(sgn))(FLUSHLAB(cur)(sgn)(net)))
          (la _. self(str_tail(s))(concat(cur)(c))(sgn)(net)))
      (str_head(s))))
glyph EXPRHASLAB = la s. NOT(int_eq(ADDRBAL(s)("")(1)(0))(0))

glyph E6T = Z(la self. la labs. la acc. la s.
    IF(str_eq(s)(""))(la _. PAIR(acc)(s))
      (la _. (la c.
        IF(str_eq(c)("*"))
          (la _. (la p. self(labs)(mul(acc)(FST(p)))(SND(p)))(E7(labs)(str_tail(s))("")))
          (la _. IF(str_eq(c)("/"))
            (la _. (la p. self(labs)(div(acc)(FST(p)))(SND(p)))(E7(labs)(str_tail(s))("")))
            (la _. PAIR(acc)(s))))
      (str_head(s))))
glyph E6 = la labs. la s. (la p. E6T(labs)(FST(p))(SND(p)))(E7(labs)(s)(""))

glyph E5T = Z(la self. la labs. la acc. la s.
    IF(str_eq(s)(""))(la _. PAIR(acc)(s))
      (la _. (la c.
        IF(str_eq(c)("+"))
          (la _. (la p. self(labs)(add(acc)(FST(p)))(SND(p)))(E6(labs)(str_tail(s))))
          (la _. IF(str_eq(c)("-"))
            (la _. (la p. self(labs)(sub(acc)(FST(p)))(SND(p)))(E6(labs)(str_tail(s))))
            (la _. PAIR(acc)(s))))
      (str_head(s))))
glyph E5 = la labs. la s. (la p. E5T(labs)(FST(p))(SND(p)))(E6(labs)(s))

#   `<<` and `>>` are TWO characters, so the second is consumed explicitly;
#   reading only the first would leave a stray `<` and mis-parse the rest.
glyph E4T = Z(la self. la labs. la acc. la s.
    IF(str_eq(s)(""))(la _. PAIR(acc)(s))
      (la _. (la c.
        IF(AND(str_eq(c)("<"))(str_eq(HD2(s))("<")))
          (la _. (la p. self(labs)(mul(acc)(POW2(FST(p))))(SND(p)))
                 (E5(labs)(str_tail(str_tail(s)))))
          (la _. IF(AND(str_eq(c)(">"))(str_eq(HD2(s))(">")))
            (la _. (la p. self(labs)(div(acc)(POW2(FST(p))))(SND(p)))
                   (E5(labs)(str_tail(str_tail(s)))))
            (la _. PAIR(acc)(s))))
      (str_head(s))))
glyph E4 = la labs. la s. (la p. E4T(labs)(FST(p))(SND(p)))(E5(labs)(s))

glyph E3T = Z(la self. la labs. la acc. la s.
    IF(str_eq(s)(""))(la _. PAIR(acc)(s))
      (la _. IF(str_eq(str_head(s))("&"))
        (la _. (la p. self(labs)(BAND(acc)(FST(p)))(SND(p)))(E4(labs)(str_tail(s))))
        (la _. PAIR(acc)(s))))
glyph E3 = la labs. la s. (la p. E3T(labs)(FST(p))(SND(p)))(E4(labs)(s))

glyph E2T = Z(la self. la labs. la acc. la s.
    IF(str_eq(s)(""))(la _. PAIR(acc)(s))
      (la _. IF(str_eq(str_head(s))("^"))
        (la _. (la p. self(labs)(BXOR(acc)(FST(p)))(SND(p)))(E3(labs)(str_tail(s))))
        (la _. PAIR(acc)(s))))
glyph E2 = la labs. la s. (la p. E2T(labs)(FST(p))(SND(p)))(E3(labs)(s))

glyph E1T = Z(la self. la labs. la acc. la s.
    IF(str_eq(s)(""))(la _. PAIR(acc)(s))
      (la _. IF(str_eq(str_head(s))("|"))
        (la _. (la p. self(labs)(BOR(acc)(FST(p)))(SND(p)))(E2(labs)(str_tail(s))))
        (la _. PAIR(acc)(s))))
glyph E1 = la labs. la s. (la p. E1T(labs)(FST(p))(SND(p)))(E2(labs)(s))

glyph EVAL = la labs. la s. FST(E1(labs)(s))

glyph SPLITFIRST = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. PAIR(cur)(""))
      (la _. (la c.
          IF(OR(str_eq(c)("+"))(str_eq(c)("-")))
            (la _. PAIR(cur)(concat("0")(s)))
            (la _. self(str_tail(s))(concat(cur)(c))))
        (str_head(s))))

glyph MEMVAL = la labs. la t.
    IF(str_eq(str_head(t))("="))
      (la _. (la o. IF(ISSOME(o))(la _. OPTV(o))(la _. 0))(LOOKLAB(str_tail(t))(labs)))
      (la _. IF(ISNUM(t))(la _. NUMV(t))
        (la _. (la o. IF(ISSOME(o))(la _. OPTV(o))(la _. 0))(LOOKLAB(t)(labs))))
glyph MEMDISP  = la labs. la t.
    IF(MEMRIP(t))
      (la _. RIPDISP(labs)(t))
    (la _. IF(MEMABS(t))
      (la _. EVAL(labs)(STRIPBRK(t)))
      (la _. (la r. IF(str_eq(r)(""))(la _. 0)(la _. EVAL(labs)(r)))
             (SND(SPLITFIRST(STRIPBRK(t))("")))))

glyph FITS8 = la d. AND(NOT(lt(d)(sub(0)(128))))(lt(d)(128))
glyph MODOF = la b. la d.
    IF(AND(int_eq(mod(b)(8))(5))(int_eq(d)(0)))(la _. 1)(la _.
    IF(int_eq(d)(0))(la _. 0)(la _.
    IF(FITS8(d))(la _. 1)(la _. 2)))
glyph SIBOF  = la b. IF(int_eq(mod(b)(8))(4))(la _. B(36))(la _. "")
glyph DISPOF = la m. la d.
    IF(int_eq(m)(0))(la _. "")(la _.
    IF(int_eq(m)(1))(la _. B(IF(lt(d)(0))(la _. add(256)(d))(la _. d)))
                    (la _. LE4(IF(lt(d)(0))(la _. add(4294967296)(d))(la _. d))))
#   SIB byte = scale<<6 | index<<3 | base. MEMTAILX emits ModRM(rm=100)+SIB+disp
#   when an index is present; idx<0 falls back to the plain MEMTAIL (byte-
#   identical). Register base uses MODOF's disp/rbp-quirk rules; a label/absolute
#   base (b<0) becomes SIB base=5(none) with a mandatory disp32.
glyph FOLDD  = la d. IF(lt(d)(0))(la _. add(4294967296)(d))(la _. d)
#   rsp (index field 4, and NOT r12 whose REX.X makes 4 mean r12) cannot be a SIB
#   index — index=100 encodes "no index", so `[base+rsp*n]` would silently drop rsp.
glyph SIBBYTE = la scaleb. la idx. la basef.
    IF(int_eq(idx)(4))
      (la _. error("asm: rsp cannot be a SIB index register"))
      (la _. B(add(mul(scaleb)(64))(add(mul(mod(idx)(8))(8))(mod(basef)(8)))))
glyph MRMLBLD = la reg. la scaleb. la idx. la d.
    concat(B(add(mul(mod(reg)(8))(8))(4)))(concat(SIBBYTE(scaleb)(idx)(5))(LE4(FOLDD(d))))
glyph MRMREG = la reg. la b. la scaleb. la idx. la d.
    (la m. concat(B(add(add(mul(m)(64))(mul(mod(reg)(8))(8)))(4)))(concat(SIBBYTE(scaleb)(idx)(b))(DISPOF(m)(d))))(MODOF(b)(d))
glyph MEMTAILX = la reg. la b. la idx. la scaleb. la d. la mode.
    IF(int_eq(b)(sub(0)(2)))
      (la _. concat(B(add(mul(mod(reg)(8))(8))(5)))(LE4(FOLDD(d))))
      (la _. IF(lt(idx)(0))
        (la _. MEMTAIL(reg)(b)(d)(mode))
        (la _. IF(lt(b)(0))(la _. MRMLBLD(reg)(scaleb)(idx)(d))(la _. MRMREG(reg)(b)(scaleb)(idx)(d))))
#   REX for a memory operand, adding the X bit (index>=8) to REXOPT's W/R/B.
#   idx<0 -> X is 0 -> byte-identical to REXOPT, so this is safe everywhere.
glyph MREX = la w. la reg. la idx. la base. la force.
    (la v. IF(OR(NOT(int_eq(v)(64)))(force))(la _. B(v))(la _. ""))
    (add(64)(add(IF(int_eq(w)(8))(la _. 8)(la _. 0))
            (add(IF(lt(reg)(8))(la _. 0)(la _. 4))
            (add(IF(AND(NOT(lt(idx)(0)))(NOT(lt(idx)(8))))(la _. 2)(la _. 0))
                (IF(lt(base)(8))(la _. 0)(la _. 1))))))
glyph MEMENC = la op. la w. la reg. la b. la idx. la scaleb. la d. la force. la mode.
    concat(P66M(mode)(w))
   (concat(MREX(w)(reg)(idx)(b)(force))
   (concat(B(OP8(op)(w)))(MEMTAILX(reg)(b)(idx)(scaleb)(d)(mode))))

#   IMMEDIATE TO MEMORY (C6 /0 for a byte, C7 /0 otherwise). The reg field of
#   the ModRM byte is not a register here but the opcode extension /0, so the
#   REX.R bit is always clear. The immediate is the operand's own width EXCEPT
#   at width 8, where it stays a 32-bit value the CPU SIGN-extends — so
#   `mov qword [rdi], 0` is 48 C7 07 + four zero bytes, never eight.
glyph IMMW = la w. la n.
    IF(int_eq(w)(1))(la _. B(n))
      (la _. IF(int_eq(w)(2))(la _. LE2(n))(la _. LE4(n)))
glyph MEMIMM = la w. la b. la idx. la scaleb. la d. la n. la mode.
    concat(P66M(mode)(w))
   (concat(MREX(w)(0)(idx)(b)(FALSE))
   (concat(B(IF(int_eq(w)(1))(la _. 198)(la _. 199)))
   (concat(MEMTAILX(0)(b)(idx)(scaleb)(d)(mode))(IMMW(w)(n)))))

# ── OPERAND SIZE KEYWORDS ────────────────────────────────────────────────────
#   `mov dword [rdi + 8], 0` carries its width in a KEYWORD, because neither
#   operand is a register that could imply one. The keywords are not operands,
#   so they are stripped out of the operand list and read separately — every
#   instruction then asks IW for its one width, whether that came from a
#   register or from the keyword.
glyph SZKW = la t.
    IF(str_eq(t)("byte"))(la _. 1)(la _.
    IF(str_eq(t)("word"))(la _. 2)(la _.
    IF(str_eq(t)("dword"))(la _. 4)(la _.
    IF(str_eq(t)("qword"))(la _. 8)(la _. 0))))
glyph ISSZ   = la t. NOT(int_eq(SZKW(t))(0))
glyph DROPSZ = Z(la self. la l.
    l(NIL)(la h. la t. IF(ISSZ(h))(la _. self(t))(la _. CONS(h)(self(t)))))
glyph DECLSZ = Z(la self. la l.
    l(0)(la h. la t. IF(ISSZ(h))(la _. SZKW(h))(la _. self(t))))
#   ★ Inside brackets the tokenizer folds an expression into ONE token, but
#   OUTSIDE them it splits on spaces, so `mov ecx, 2 * PCB_SIZE / 8` arrives as
#   five separate operand tokens. If any bare operator appears among the
#   operands, everything after the first is re-joined into a single expression
#   string — which is exactly the form the evaluator already reads. Without an
#   operator present the list is untouched, so `imul rax, rax, 64` keeps its
#   three operands.
glyph ISOPTOK = la t.
    OR(str_eq(t)("*"))(OR(str_eq(t)("/"))(OR(str_eq(t)("+"))(OR(str_eq(t)("-"))
   (OR(str_eq(t)("|"))(OR(str_eq(t)("&"))(OR(str_eq(t)("^"))(OR(str_eq(t)("<<"))
          (str_eq(t)(">>")))))))))
glyph HASOP = Z(la self. la l.
    l(FALSE)(la h. la t. IF(ISOPTOK(h))(la _. TRUE)(la _. self(t))))
glyph CATALL = Z(la self. la l.
    l("")(la h. la t. concat(h)(self(t))))
#   Operands are the comma-delimited GROUPS of the tail, each group
#   concatenated into one expression string. This replaces the old
#   join-everything-after-the-first heuristic: `mov ecx, 2 * X / 8` and
#   `dw a - b - 1` and `dw 1, 2` now all fall out of the same rule instead of
#   needing three special cases.
glyph GROUPS = Z(la self. la l. la cur.
    l(IF(str_eq(cur)(""))(la _. NIL)(la _. CONS(cur)(NIL)))
     (la h. la t.
       IF(str_eq(h)(","))
         (la _. CONS(cur)(self(t)("")))
         (la _. self(t)(concat(cur)(h)))))
glyph JOINEXPR = la l. GROUPS(l)("")
glyph OPL = la ts. GROUPS(DROPSZ(TL2(ts)))("")
glyph A1  = la ts. NTH(0)(OPL(ts))
glyph A2  = la ts. NTH(1)(OPL(ts))

#   The instruction's width: a register operand states it, otherwise the
#   keyword does. Neither present is not a default — NASM refuses it too
#   ("operation size not specified"), because guessing would silently pick an
#   encoding the author did not write.
glyph IWIDTH = la ts.
    (la a. la b.
      IF(ISREG(a))(la _. RWIDTH(a))
        (la _. IF(ISREG(b))(la _. RWIDTH(b))(la _. DECLSZ(TL2(ts)))))
    (A1(ts))(A2(ts))
#   Operands are derived ONCE per instruction and handed to the encoder, rather
#   than each encoder re-deriving them. The obvious form — every helper calling
#   A1(ts)/A2(ts) as it needs them — re-walked the token list about six times
#   per instruction (twice in the encoder, twice for the high-byte check, twice
#   for the width), and each of those re-ran DROPSZ to rebuild the operand list.
#   WITHOPS computes the triple (width, first operand, second operand) once and
#   passes it in, so an encoder is a pure function of already-resolved operands.
#   This also makes the NEXT instruction family cheap to add: it receives w/a/b
#   and does not repeat the plumbing.
glyph IWOF = la ts. la a. la b.
    (la _. (la w. IF(int_eq(w)(0))
                    (la _. error(concat("asm: operation size not specified: ")(HD(ts))))
                    (la _. w))
           (IF(ISREG(a))(la _. RWIDTH(a))
              (la _. IF(ISREG(b))(la _. RWIDTH(b))(la _. DECLSZ(TL2(ts))))))
    (HIGH8OK(a)(b))
glyph WITHOPS = la ts. la k.
    (la a. (la b. k(IWOF(ts)(a)(b))(a)(b))(A2(ts)))(A1(ts))

# ── SHORT-JUMP OPTIMISATION: iterate to a fixed point ───────────────────────
#   NASM emits the SHORTEST jump that reaches: `jmp a` -> eb rel8 (2 bytes) when
#   the target is within a signed byte, else e9 rel32 (5). `jz` likewise: 74 rel8
#   (2) or 0f 84 rel32 (6). `call` has NO short form — always e8 rel32 (5).
#   Matching that is the last encoding-CHOICE mismatch, and it is what lets a
#   bare `jmp L` (idiomatic asm) be byte-identical rather than requiring `near`.
#
#   It needs a FIXED POINT, and this is the chicken-and-egg the near-only version
#   deliberately avoided: a jump's SIZE depends on its target's DISTANCE, which
#   depends on the SIZES of everything between. So: start OPTIMISTIC (every jump
#   short — an unknown forward label is assumed reachable), compute the label
#   table, and recompute. A jump that no longer reaches is PROMOTED to near,
#   which grows the code, which can push another jump out of range — so iterate.
#   Promotion only ever GROWS the image, so total length is monotonic and
#   bounded: length unchanged <=> no promotion happened <=> the fixed point. That
#   is the convergence test, with a pass cap as a backstop.
#   The same shape as regen_selfhost.sh iterating the compiler image to ITS fixed
#   point — the project's standing discipline, one level down.
#
#   An explicit `near` still FORCES the long form (NASM honours it too), so the
#   existing `jmp near L` sources stay byte-identical.
glyph ISNEARK = la ts. str_eq(NTH(1)(ts))("near")
glyph JSHORT  = la labs. la off. la ts.
    IF(ISNEARK(ts))(la _. FALSE)
      (la _. (la o. IF(ISSOME(o))
                      (la _. FITS8(sub(OPTV(o))(add(off)(2))))
                      (la _. TRUE))
             (TGTOPT(labs)(TARGET(ts))))
glyph REL8 = la labs. la off. la nm.
    (la d. IF(lt(d)(0))(la _. add(256)(d))(la _. d))
    (sub(LABADDR(nm)(labs))(add(off)(2)))

# ── the width-carrying instructions: one encoder, sizes MEASURED from it ─────
#   Every one of these forms has a length that depends on the operands in ways
#   the width slice made intricate (an optional 0x66, an optional REX, an
#   optional SIB, a 0/1/4-byte displacement, a 1/2/4-byte immediate). Computing
#   that length a SECOND time, in parallel with the encoder, is how a size/emit
#   drift bug gets in — and the fixed point silently converges on the wrong
#   image when it does. So the size is the LENGTH OF THE ENCODING: SIZEL and
#   ENC1 cannot disagree, by construction.
#   The one form that cannot be measured is a label immediate, whose address is
#   not yet known during the fixed-point iteration — it is a constant 10 bytes
#   (movabs), which is precisely why NASM's label rule is worth matching.
glyph RROP = la op. la w. la dst. la src. la force. la mode.
    concat(P66M(mode)(w))(concat(REXOPT(w)(src)(dst)(force))
   (concat(B(OP8(op)(w)))(MODRM(dst)(src))))
# ── CONTROL and SEGMENT registers ───────────────────────────────────────────
#   The paging-setup family: `mov cr3, rax` (27 uses in the kernel asm) and the
#   segment loads `mov ds, ax` (17). Neither lives in the general register file,
#   so both are intercepted before the ordinary mov paths — otherwise `cr3`
#   reaches REGNUM and halts as an unknown register, which is exactly how
#   boot.asm failed.
#
#   ★ Control-register moves are MODE-INDEPENDENT: `0F 22 /r` (to CR) and
#   `0F 20 /r` (from CR), with no REX and no 0x66, encoding identically in
#   32-bit and 64-bit mode — measured, not assumed. The operand is implicitly
#   the full register width, so `mov eax, cr0` in a bits-32 section and
#   `mov rax, cr0` in a bits-64 one produce the same bytes. That is what lets
#   this work without the assembler tracking CPU mode at all.
#
#   Segment loads are NOT symmetric: `mov ds, ax` is 8E with no prefix, but
#   `mov ax, ds` is 66 8C — the 0x66 appears only in the read direction,
#   because there the DESTINATION is a 16-bit general register.
glyph CRS =
  CONS(PAIR("cr0")(0))(CONS(PAIR("cr2")(2))(CONS(PAIR("cr3")(3))(
  CONS(PAIR("cr4")(4))(NIL))))
glyph SEGS =
  CONS(PAIR("es")(0))(CONS(PAIR("cs")(1))(CONS(PAIR("ss")(2))(
  CONS(PAIR("ds")(3))(CONS(PAIR("fs")(4))(CONS(PAIR("gs")(5))(NIL))))))
glyph ISCR   = la t. ISSOME(LOOKREG(t)(CRS))
glyph CRNUM  = la t. OPTV(LOOKREG(t)(CRS))
glyph ISSEG  = la t. ISSOME(LOOKREG(t)(SEGS))
glyph SEGNUM = la t. OPTV(LOOKREG(t)(SEGS))
glyph SPECMODRM = la sel. la r. B(add(192)(add(mul(sel)(8))(mod(r)(8))))

#   The A3/A1 moffs form applies only when EVERY condition holds: 32-bit mode
#   (in 64-bit the moffs operand is a full 64-bit address, a different form),
#   a bare absolute address with no index, the accumulator, and the native
#   32-bit width. Anything else must stay on the general path, so this is a
#   conjunction rather than a guess.
glyph MOFFSOK = la mode. la a. la w. la r.
    AND(int_eq(mode)(32))
      (AND(MEMABS(a))(AND(lt(MEMIDX(a))(0))
        (AND(int_eq(w)(4))(int_eq(REGNUM(r))(0)))))
glyph MOVENC = la labs. la w. la a. la b.
    IF(ISCR(a))
      (la _. concat(B(15))(concat(B(34))(SPECMODRM(CRNUM(a))(REGNUM(b)))))
    (la _. IF(ISCR(b))
      (la _. concat(B(15))(concat(B(32))(SPECMODRM(CRNUM(b))(REGNUM(a)))))
    (la _. IF(ISSEG(a))
      (la _. concat(B(142))(SPECMODRM(SEGNUM(a))(REGNUM(b))))
    (la _. IF(ISSEG(b))
      (la _. concat(B(102))(concat(B(140))(SPECMODRM(SEGNUM(b))(REGNUM(a)))))
    (la _. IF(ISMEM(a))
      (la _. IF(ISVAL(b))
               (la _. MEMIMM(w)(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(EVAL(labs)(b))(BITSMODE(labs)))
             (la _. IF(ISREG(b))
               (la _. IF(MOFFSOK(BITSMODE(labs))(a)(w)(b))
                 #   The accumulator has a one-byte form with no ModRM at all:
                 #   `mov [addr], eax` is A3 + moffs32 (5 bytes) where the
                 #   general path emits 7. nasm always takes it, so byte
                 #   identity requires it — and boot.asm opens .boot32 with
                 #   exactly this instruction, which is why an earlier note
                 #   calling the moffs form "not in the boot files" was wrong.
                 (la _. concat(B(163))(LE4(FOLDD(MEMDISP(labs)(a)))))
                 (la _. MEMENC(137)(w)(REGNUM(b))(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(RFORCE(b))(BITSMODE(labs))))
               #   `mov qword [rax], _start` — a LABEL immediate to memory. It used
               #   to fall into the register path above, where REGNUM read the label
               #   as a register name and halted `unknown register: _start`. Same
               #   MEMIMM encoding as a numeric immediate; only the value differs,
               #   and LABADDR is what MOVENC's reg-destination arm already uses.
               (la _. MEMIMM(w)(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(LABADDR(b)(labs))(BITSMODE(labs)))))
      (la _. IF(ISMEM(b))
        (la _. IF(MOFFSOK(BITSMODE(labs))(b)(w)(a))
          #   A1 is A3's load twin: `mov eax, [addr]` in 5 bytes.
          (la _. concat(B(161))(LE4(FOLDD(MEMDISP(labs)(b)))))
          (la _. MEMENC(139)(w)(REGNUM(a))(MEMBASE(b))(MEMIDX(b))(MEMSCALEB(b))(MEMDISP(labs)(b))(RFORCE(a))(BITSMODE(labs))))
        (la _. IF(ISREG(b))
          (la _. RROP(137)(w)(REGNUM(a))(REGNUM(b))(OR(RFORCE(a))(RFORCE(b)))(BITSMODE(labs)))
          (la _. IF(ISVAL(b))
            (la _. (la n. IF(AND(int_eq(w)(8))(OR(NOT(lt(n)(4294967296)))(EXPRHASLAB(b))))
                            (la _. MOVABS(REGNUM(a))(n))
                            (la _. MOVIMM(w)(REGNUM(a))(n)(RFORCE(a))(BITSMODE(labs))))
                   (EVAL(labs)(b)))
            (la _. IF(int_eq(w)(8))(la _. MOVABS(REGNUM(a))(LABADDR(b)(labs)))(la _. MOVIMM(w)(REGNUM(a))(LABADDR(b)(labs))(RFORCE(a))(BITSMODE(labs)))))))))))
glyph ALUENC = la op. la w. la a. la b.
    IF(ISREG(b))
      (la _. RROP(op)(w)(REGNUM(a))(REGNUM(b))(OR(RFORCE(a))(RFORCE(b)))(64))
      (la _. error(concat("asm: unsupported operand (register-to-register only): ")(b)))
# ── GROUP-1 ALU (add/or/and/sub/xor/cmp) — the reg,IMMEDIATE forms ──────────
#   Profiling the kernel .asm showed reg+imm is the DOMINANT shape (or 31 of
#   45 uses, shr 32 of 32, cmp 11 of 23, and 5 of 5) — and asm.la could not
#   encode it at all, its ALU being register-to-register only.
#
#   The six ops differ ONLY by a 3-bit "digit", which is a regularity of the
#   opcode map worth exploiting rather than writing six encoders:
#       reg,reg   opcode = digit*8 + 1     (add 01, or 09, and 21, sub 29, ...)
#       AL,imm    opcode = digit*8 + 4     (add 04, or 0C, and 24, cmp 3C, ...)
#       eAX,imm   opcode = digit*8 + 5     (add 05, or 0D, and 25, cmp 3D, ...)
#       reg,imm   81 /digit  (imm)   or   83 /digit (imm8, sign-extended)
#
#   ★ NASM'S CHOICE HIERARCHY, and it is not the obvious one. The SHORTEST
#   encoding wins, which means the sign-extended imm8 form is tried FIRST and
#   beats the accumulator form even for rax: `add rax, 8` is `48 83 C0 08`,
#   not `48 05 08000000`. Only when the immediate will not fit a signed byte
#   does the accumulator short form (which drops the ModRM byte entirely) win.
#   At width 1 the order INVERTS — `sub al, 9` is `2C 09` (2 bytes) rather than
#   `80 E8 09` (3), because there is no 8-bit sign-extension to save anything.
#   An encoder that merely emitted a form the CPU accepts would be correct and
#   still fail the diff.
glyph MODRMD = la digit. la r. B(add(192)(add(mul(digit)(8))(mod(r)(8))))
glyph FOLD8  = la n. IF(lt(n)(0))(la _. add(256)(n))(la _. n)
glyph G1IMM = la digit. la w. la r. la n. la force. la mode.
    IF(int_eq(w)(1))
      (la _. IF(int_eq(r)(0))
               (la _. concat(B(add(mul(digit)(8))(4)))(B(FOLD8(n))))
               (la _. concat(REXOPT(1)(0)(r)(force))
                     (concat(B(128))(concat(MODRMD(digit)(r))(B(FOLD8(n)))))))
      (la _. IF(FITS8(n))
        (la _. concat(P66M(mode)(w))(concat(REXOPT(w)(0)(r)(FALSE))
              (concat(B(131))(concat(MODRMD(digit)(r))(B(FOLD8(n)))))))
        (la _. IF(int_eq(r)(0))
          (la _. concat(P66M(mode)(w))(concat(REXOPT(w)(0)(0)(FALSE))
                (concat(B(add(mul(digit)(8))(5)))(IMMW(w)(n)))))
          (la _. concat(P66M(mode)(w))(concat(REXOPT(w)(0)(r)(FALSE))
                (concat(B(129))(concat(MODRMD(digit)(r))(IMMW(w)(n))))))))
#   ★ The DESTINATION may be MEMORY: `or dword [pml4], 0x04` (11 uses in
#   boot.asm). The opcodes are the SAME as the register forms — the only
#   difference is that ModRM/SIB/disp come from MEMTAIL, with the group digit
#   sitting in the reg field where a register number would otherwise go. That
#   is why this is a few lines rather than a second encoder: the opcode map
#   does not distinguish "to register" from "to memory", the ModRM byte does.
glyph G1MEMREG = la labs. la digit. la w. la a. la b.
    concat(P66M(BITSMODE(labs))(w))(concat(MREX(w)(REGNUM(b))(MEMIDX(a))(MEMBASE(a))(RFORCE(b)))
   (concat(B(OP8(add(mul(digit)(8))(1))(w)))
          (MEMTAILX(REGNUM(b))(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(BITSMODE(labs)))))
glyph G1MEMIMM = la labs. la digit. la w. la a. la n.
    concat(P66M(BITSMODE(labs))(w))(concat(MREX(w)(0)(MEMIDX(a))(MEMBASE(a))(FALSE))
   (IF(int_eq(w)(1))
     (la _. concat(B(128))(concat(MEMTAILX(digit)(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(BITSMODE(labs)))(B(FOLD8(n)))))
     (la _. IF(FITS8(n))
       (la _. concat(B(131))(concat(MEMTAILX(digit)(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(BITSMODE(labs)))(B(FOLD8(n)))))
       (la _. concat(B(129))(concat(MEMTAILX(digit)(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(BITSMODE(labs)))(IMMW(w)(n)))))))
# ALU reg, [mem] (memory SOURCE): the r,r/m form, opcode digit*8+3 (add 03,
# cmp 3B, …) — the reverse of G1MEMREG's digit*8+1. reg field = dest register,
# rm = memory (index-aware via MEMTAILX/MREX).
glyph G1REGMEM = la labs. la digit. la w. la a. la b.
    concat(P66M(BITSMODE(labs))(w))(concat(MREX(w)(REGNUM(a))(MEMIDX(b))(MEMBASE(b))(RFORCE(a)))
   (concat(B(OP8(add(mul(digit)(8))(3))(w)))
          (MEMTAILX(REGNUM(a))(MEMBASE(b))(MEMIDX(b))(MEMSCALEB(b))(MEMDISP(labs)(b))(BITSMODE(labs)))))
glyph G1ENC = la labs. la digit. la w. la a. la b.
    IF(ISMEM(a))
      (la _. IF(ISVAL(b))
               (la _. G1MEMIMM(labs)(digit)(w)(a)(EVAL(labs)(b)))
               (la _. G1MEMREG(labs)(digit)(w)(a)(b)))
      (la _. IF(ISMEM(b))
        (la _. G1REGMEM(labs)(digit)(w)(a)(b))
      (la _. IF(ISREG(b))
        (la _. RROP(add(mul(digit)(8))(1))(w)(REGNUM(a))(REGNUM(b))(OR(RFORCE(a))(RFORCE(b)))(BITSMODE(labs)))
        (la _. IF(ISVAL(b))
                 (la _. G1IMM(digit)(w)(REGNUM(a))(EVAL(labs)(b))(RFORCE(a))(BITSMODE(labs)))
                 (la _. error(concat("asm: unsupported ALU operand: ")(b))))))
glyph G1DIG = la op.
    IF(str_eq(op)("add"))(la _. 0)(la _.
    IF(str_eq(op)("or"))(la _. 1)(la _.
    IF(str_eq(op)("and"))(la _. 4)(la _.
    IF(str_eq(op)("sub"))(la _. 5)(la _.
    IF(str_eq(op)("xor"))(la _. 6)(la _. 7)))))
glyph ISG1 = la op.
    OR(str_eq(op)("add"))(OR(str_eq(op)("or"))(OR(str_eq(op)("and"))
   (OR(str_eq(op)("sub"))(OR(str_eq(op)("xor"))(str_eq(op)("cmp"))))))

# ── SHIFTS: C1 /digit ib, with the by-ONE special case D1 /digit ────────────
#   `shl rax, 1` is `48 D1 E0` (3 bytes), not `48 C1 E0 01` (4) — a distinct
#   opcode for a count of one, not an immediate that happens to be 1.
glyph SHDIG = la op.
    IF(str_eq(op)("rol"))(la _. 0)(la _.
    IF(str_eq(op)("ror"))(la _. 1)(la _.
    IF(str_eq(op)("shl"))(la _. 4)(la _.
    IF(str_eq(op)("shr"))(la _. 5)(la _. 7))))
glyph ISSH = la op.
    OR(str_eq(op)("shl"))(OR(str_eq(op)("shr"))(OR(str_eq(op)("sar"))
   (OR(str_eq(op)("rol"))(str_eq(op)("ror")))))
glyph SHENC = la digit. la mode. la w. la a. la b.
    IF(NOT(ISVAL(b)))
      (la _. error(concat("asm: shift count must be an immediate (shl/shr reg,CL not implemented): ")(b)))
      (la _.
    (la r. la n.
      IF(int_eq(n)(1))
        (la _. concat(P66M(mode)(w))(concat(REXOPT(w)(0)(r)(RFORCE(a)))
              (concat(B(OP8(209)(w)))(MODRMD(digit)(r)))))
        (la _. concat(P66M(mode)(w))(concat(REXOPT(w)(0)(r)(RFORCE(a)))
              (concat(B(OP8(193)(w)))(concat(MODRMD(digit)(r))(B(FOLD8(n))))))))
    (REGNUM(a))(NUMV(b)))

# ── inc/dec (FF /0, FF /1) and test (85 /r; F7 /0; A9 accumulator) ──────────
#   ★ `test` has NO imm8 form — `test rdx, 8` is `48 F7 C2 08 00 00 00`, a full
#   imm32 for a value that fits a byte. Reusing group-1's imm8 shortcut here
#   would produce a shorter encoding NASM never emits.
#   inc/dec of r16/r32 is the 1-byte 0x40+r (inc) / 0x48+r (dec) form in 16/32-bit
#   mode; in 64-bit those bytes are REX prefixes, so it is FF /0, FF /1 there (and
#   for r8 in every mode). digit 0 = inc (0x40), 1 = dec (0x48).
glyph IDENC = la digit. la w. la a. la mode.
    (la r.
      IF(AND(NOT(int_eq(mode)(64)))(NOT(int_eq(w)(1))))
        (la _. concat(P66M(mode)(w))(B(add(IF(int_eq(digit)(0))(la _. 64)(la _. 72))(mod(r)(8)))))
        (la _. concat(P66M(mode)(w))(concat(REXOPT(w)(0)(r)(RFORCE(a)))
              (concat(B(OP8(255)(w)))(MODRMD(digit)(r))))))
    (REGNUM(a))
glyph TSTENC = la w. la a. la b.
    IF(ISREG(b))
      (la _. RROP(133)(w)(REGNUM(a))(REGNUM(b))(OR(RFORCE(a))(RFORCE(b)))(64))
      (la _. IF(NOT(ISNUM(b)))
        (la _. error(concat("asm: test operand must be a register or an immediate: ")(b)))
        (la _. (la r. la n.
                IF(int_eq(r)(0))
                  (la _. concat(P66(w))(concat(REXOPT(w)(0)(0)(FALSE))
                        (concat(B(OP8(169)(w)))(IMMW(w)(n)))))
                  (la _. concat(P66(w))(concat(REXOPT(w)(0)(r)(RFORCE(a)))
                        (concat(B(OP8(247)(w)))(concat(MODRMD(0)(r))(IMMW(w)(n)))))))
             (REGNUM(a))(NUMV(b))))

# ── lea: the same ModRM/SIB/disp machinery as mov, opcode 8D, never 8-bit ───
glyph LEAENC = la labs. la w. la a. la b.
    MEMENC(141)(w)(REGNUM(a))(MEMBASE(b))(MEMIDX(b))(MEMSCALEB(b))(MEMDISP(labs)(b))(RFORCE(a))(BITSMODE(labs))

# ── no-operand instructions ────────────────────────────────────────────────
glyph NOARGS =
  CONS(PAIR("cli")("250"))(CONS(PAIR("sti")("251"))(CONS(PAIR("hlt")("244"))(
  CONS(PAIR("cld")("252"))(CONS(PAIR("popfq")("157"))(CONS(PAIR("pushfq")("156"))(
  CONS(PAIR("movsb")("164"))(CONS(PAIR("stosb")("170"))(
  CONS(PAIR("lodsb")("172"))(CONS(PAIR("stosd")("171"))(CONS(PAIR("int3")("204"))(
  NIL)))))))))))
#   Two-byte and REX.W-carrying forms are spelled out rather than squeezed into
#   the single-byte table: iretq is 48 CF, stosq/movsq carry REX.W, and the 0F
#   escape family (wrmsr/rdmsr/ud2/sysret) is a second opcode map entirely.
glyph NOARG2 =
  CONS(PAIR("iretq")("72 207"))(CONS(PAIR("stosq")("72 171"))(CONS(PAIR("movsq")("72 165"))(
  CONS(PAIR("wrmsr")("15 48"))(CONS(PAIR("rdmsr")("15 50"))(CONS(PAIR("ud2")("15 11"))(
  CONS(PAIR("sysret")("15 7"))(CONS(PAIR("cqo")("72 153"))(
  NIL))))))))
glyph BYTESOF = Z(la self. la s. la cur.
    IF(str_eq(s)(""))
      (la _. IF(str_eq(cur)(""))(la _. "")(la _. B(str_to_int(cur))))
      (la _. IF(str_eq(str_head(s))(" "))
               (la _. concat(B(str_to_int(cur)))(self(str_tail(s))("")))
               (la _. self(str_tail(s))(concat(cur)(str_head(s))))))
glyph ISNOARG = la op. OR(ISSOME(LOOKREG(op)(NOARGS)))(ISSOME(LOOKREG(op)(NOARG2)))
glyph NOARG = la op.
    (la o. IF(ISSOME(o))(la _. B(str_to_int(OPTV(o))))
      (la _. BYTESOF(OPTV(LOOKREG(op)(NOARG2)))("")))
    (LOOKREG(op)(NOARGS))

#   ★ An EXPRESSION is a value, not a label, and SIZEL must agree with ENC1
#   about that: classify `2*128/8` as a label and MOVSIZE reports 10 bytes
#   while MOVENC emits 5 — a size/emit drift that silently misplaces every
#   later address. One predicate, used by both.
glyph ISVAL  = la t. OR(ISNUM(t))(ISEXPRTOK(t))
# A label immediate is what b is when it is none of the operand kinds MOVENC
# dispatches on BEFORE its label fallthrough: not memory, not a GP register, not
# a control/segment register, not a value. The CR/SEG exclusions were missing —
# so `mov rax, cr3` and `mov ax, ds` (a CR/SEG in the b position) were sized as
# 10/4-byte label-movs while MOVENC correctly emitted the 3-byte 0F20/8C form.
# Latent: byte-identity vs nasm passed because no label's address surfaced the
# miscount; the SIZEDRIFT guard in ASSEMBLE caught it. Same class as the MOVSIZE
# hardcoded-10 bug — MOVLBL must agree with MOVENC's dispatch, exactly.
#   ★ The "b is a label" test is FACTORED OUT, and that is the point. There are
#   now TWO mov forms whose source is a label — `mov reg, lbl` and
#   `mov qword [mem], lbl` — and they are sized by different branches. Two
#   copies of this five-way exclusion would be two things that must agree
#   forever; one predicate cannot drift from itself. (The comment above records
#   what a drift here already cost once: MOVLBL disagreeing with MOVENC's
#   dispatch sized a 3-byte 0F20 as a 10-byte movabs.)
glyph BISLBL = la b.
    AND(NOT(ISMEM(b)))(AND(NOT(ISREG(b)))
      (AND(NOT(ISCR(b)))(AND(NOT(ISSEG(b)))(NOT(ISVAL(b))))))
glyph MOVLBL = la a. la b. AND(NOT(ISMEM(a)))(BISLBL(b))
#   The memory-destination twin: `mov qword [rax], _start`. nasm emits
#   C7 /0 with a 32-bit immediate holding the address, which in an object file
#   is where an R_X86_64_32S relocation lands — so this form is not an
#   ornament, it is one of the three reloc sites r3.asm exists to exercise.
glyph MEMLBL = la a. la b. AND(ISMEM(a))(BISLBL(b))
glyph LENOF  = la s. str_to_int(str_len(s))
#   ★ The label branch MEASURES too, and must. It used to answer a hardcoded
#   `10` — correct only while every label immediate was a movabs. Once MOVENC
#   learned to follow the DESTINATION width, sizing kept saying 10 for a
#   `mov esp, tgt` the encoder emitted in 5, so the label table placed `tgt` at
#   the pre-fix total (0x37) while the image itself was the correct 36 bytes.
#   FIXLABS converged CLEANLY onto that wrong table: 10 is value-independent, so
#   the signature was stable from the second pass on. A fixpoint is only as
#   sound as the function it iterates — a stable answer is not a right one.
#   LABADDR errors on an unresolved label, which is why the original could not
#   simply call MOVENC here; the placeholder 0 sidesteps that, and is exact
#   because MOVABS (REX+op+LE8) and MOVIMM (B/LE2/LE4, no short form) both have
#   value-INDEPENDENT lengths — verified, not assumed.
#   The memory-destination label form sizes by the same placeholder trick and
#   for the same reason: MEMIMM's length is value-INDEPENDENT (MEMTAILX is a
#   function of the DISPLACEMENT, and IMMW is B/LE2/LE4 — a fixed width per w),
#   so encoding with 0 measures the real instruction exactly. It cannot go
#   through the MOVENC branch below, because that branch passes an EMPTY label
#   table and LABADDR errors on an unresolved label — which is the whole reason
#   the label forms are sized separately in the first place.
glyph MOVSIZE = la mode. la ts.
    WITHOPS(ts)(la w. la a. la b.
      IF(MEMLBL(a)(b))
        (la _. LENOF(MEMIMM(w)(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))
                            (MEMDISP(WITHBITS(NIL)(mode))(a))(0)(mode)))
      (la _. IF(MOVLBL(a)(b))
        (la _. IF(int_eq(w)(8))
                 (la _. LENOF(MOVABS(REGNUM(a))(0)))
                 (la _. LENOF(MOVIMM(w)(REGNUM(a))(0)(RFORCE(a))(mode))))
        (la _. LENOF(MOVENC(WITHBITS(NIL)(mode))(w)(a)(b)))))

# ── db: define bytes. Operands are quoted strings (emitted verbatim) or
#    numbers (one byte each) — `db "I AM THAT I AM", 10`. This is what lets the
#    .asm carry its OWN data instead of a wrapper appending it afterwards.
glyph TL2 = la l. l(NIL)(la h. la t. t)
glyph ISSTRTOK = la t. IF(str_eq(t)(""))(la _. FALSE)(la _. str_eq(str_head(t))("\""))
glyph DBEMIT = Z(la self. la l.
    l("")(la h. la t. concat(IF(ISSTRTOK(h))(la _. str_tail(h))(la _. B(NUMV(h))))(self(t))))
glyph DBSIZE = Z(la self. la l.
    l(0)(la h. la t. add(IF(ISSTRTOK(h))(la _. str_to_int(str_len(str_tail(h))))(la _. 1))(self(t))))

# ── PORT I/O, MSRs, SYSTEM OPS, STRING OPS, PREFIXES, FULL JCC ─────────────
#   The opcode tail: everything boot.asm still needs that is not the
#   preprocessor. `out` alone is 37 uses, the largest remaining family.
#
#   Port I/O has no ModRM at all — the operands are IMPLIED (always DX and the
#   accumulator), so the whole instruction is one opcode byte, with the width
#   coming from which accumulator was named: `out dx, ax` is 66 EF, `out dx,
#   eax` is EF. The imm8-port forms are a different opcode (E6/E7), not an
#   addressing mode.
glyph OUTENC = la a. la b.
    (la w. IF(ISREG(a))
      (la _. concat(P66(w))(B(IF(int_eq(w)(1))(la _. 238)(la _. 239))))
      (la _. concat(P66(w))(concat(B(IF(int_eq(w)(1))(la _. 230)(la _. 231)))(B(NUMV(a))))))
    (RWIDTH(b))
glyph INENC = la a. la b.
    (la w. IF(ISREG(b))
      (la _. concat(P66(w))(B(IF(int_eq(w)(1))(la _. 236)(la _. 237))))
      (la _. concat(P66(w))(concat(B(IF(int_eq(w)(1))(la _. 228)(la _. 229)))(B(NUMV(b))))))
    (RWIDTH(a))

#   `ltr ax` is 0F 00 D8 with NO 0x66 prefix, even though the operand is 16-bit:
#   the instruction takes r/m16 by definition, so the size needs no announcing.
#   ★ THE FAR JUMP — and an honest choice about mode tracking.
#   `jmp gdt64.code:long_start` is how boot.asm enters long mode: it loads CS
#   from a GDT selector. It encodes `EA` + offset32 + selector16 and exists ONLY
#   in 32-bit mode — NASM refuses it under `bits 64` outright.
#
#   That contradicts a claim made earlier in this file's history: that treating
#   `bits` as a no-op is "accidentally correct for boot.asm" because none of its
#   70 bits-32 lines use a 64-bit register. The test asked about OPERANDS and
#   the real risk was a mode-specific OPCODE, which it could not see.
#
#   ★ What is implemented is SYNTACTIC detection, not mode tracking. A `seg:off`
#   operand is unambiguous — no other form has a colon there — and since the
#   instruction only exists in 32-bit mode, its presence implies the mode. That
#   is sound FOR THIS INSTRUCTION and is not general mode tracking: `bits` is
#   still a no-op, and any OTHER construct that encodes differently in 32-bit
#   mode would still be wrong. Named here rather than left implied, because the
#   previous version of this note was the thing that was wrong.
glyph HASCOLON = la t. INSTR(":")(t)
glyph SPLITCOLON = Z(la self. la s. la cur.
    IF(str_eq(s)(""))(la _. PAIR(cur)(""))
      (la _. IF(str_eq(str_head(s))(":"))
               (la _. PAIR(cur)(str_tail(s)))
               (la _. self(str_tail(s))(concat(cur)(str_head(s))))))
#   Far jmp: ptr16:16 (EA off16 seg16, 5 bytes) in 16-bit mode, ptr16:32
#   (EA off32 seg16, 7 bytes) in 32/64. Only the OFFSET width changes.
glyph FARJMP = la labs. la t.
    (la p. concat(B(234))
          (concat(IF(int_eq(BITSMODE(labs))(16))(la _. LE2(EVAL(labs)(SND(p))))(la _. LE4(EVAL(labs)(SND(p)))))
                 (LE2(EVAL(labs)(FST(p))))))
    (SPLITCOLON(t)(""))
glyph INDJMP = la digit. la a.
    concat(REXOPT(4)(0)(REGNUM(a))(FALSE))
   (concat(B(255))(MODRMD(digit)(REGNUM(a))))
glyph LTRENC = la a. concat(B(15))(concat(B(0))(MODRMD(3)(REGNUM(a))))
#   lgdt needs the ModRM/SIB/disp tail WITHOUT the REX+opcode that MEMENC bakes
#   in, so the addressing machinery is factored out and shared.
#   16-bit mode: a direct address is mod=00 rm=110 + disp16 (no SIB), not the
#   [disp32]-via-SIB form. Register-based 16-bit addressing ([bx+si] …) uses a
#   different ModRM table the boot sectors don't need, so it halts loudly rather
#   than silently emitting 32/64-mode bytes. mode!=16 → the two original branches,
#   byte-identical.
glyph MEMTAIL = la reg. la b. la d. la mode.
    IF(int_eq(mode)(16))
      (la _. IF(lt(b)(0))
               (la _. concat(B(add(mul(mod(reg)(8))(8))(6)))(LE2(d)))
               (la _. error("asm: 16-bit register-based addressing not supported (only direct [disp16])")))
      (la _. IF(lt(b)(0))
               #   ★ ABSOLUTE [disp32] IS MODE-DEPENDENT, and the 64-bit form is
               #   the ODD one. In 64-bit mode ModRM mod=00 rm=101 means
               #   RIP-relative, so an absolute address must go the long way
               #   round through a SIB byte (rm=100, SIB=0x25) — which is what
               #   this always emitted. In 32-bit mode rm=101 IS absolute
               #   disp32, so the SIB byte is a wasted byte and nasm does not
               #   emit it. Measured on boot.asm's .boot32 (a `bits 32`
               #   section): nasm `89 1d <disp32>` vs ours `89 1c 25 <disp32>`.
               #   One byte per access, compounding to +8 across the prologue
               #   and shifting every later label and relocation.
               (la _. IF(int_eq(mode)(64))
                        (la _. concat(B(add(mul(mod(reg)(8))(8))(4)))(concat(B(37))(LE4(d))))
                        (la _. concat(B(add(mul(mod(reg)(8))(8))(5)))(LE4(d))))
               (la _. (la m. concat(B(add(add(mul(m)(64))(mul(mod(reg)(8))(8)))(mod(b)(8))))
                            (concat(SIBOF(b))(DISPOF(m)(d))))
                      (MODOF(b)(d))))
glyph LGDTENC = la labs. la b.
    concat(B(15))(concat(B(1))(MEMTAIL(2)(MEMBASE(b))(MEMDISP(labs)(b))(BITSMODE(labs))))
#   lidt [mem]: 0F 01 /3 — same as lgdt (/2), one ModRM digit apart.
glyph LIDTENC = la labs. la b.
    concat(B(15))(concat(B(1))(MEMTAIL(3)(MEMBASE(b))(MEMDISP(labs)(b))(BITSMODE(labs))))
glyph DIVENC = la w. la a.
    concat(P66(w))(concat(REXOPT(w)(0)(REGNUM(a))(RFORCE(a)))
   (concat(B(OP8(247)(w)))(MODRMD(6)(REGNUM(a)))))
#   Group-3 unary (F7 /digit, register): div=/6, idiv=/7, neg=/3 — same shape,
#   only the ModRM reg digit differs. G3ENC factors it so a new group-3 op is one
#   digit, not a re-derived encoder (div stays via its own glyph, byte-verified).
glyph G3ENC = la dig. la w. la a.
    concat(P66(w))(concat(REXOPT(w)(0)(REGNUM(a))(RFORCE(a)))
   (concat(B(OP8(247)(w)))(MODRMD(dig)(REGNUM(a)))))
glyph NEGENC  = G3ENC(3)
glyph IDIVENC = G3ENC(7)
#   cmovcc dest, src (reg,reg): 0F 40+cc /r, reg=dest, rm=src, REX.W for r64.
glyph CMOVENC = la cc. la w. la a. la b.
    concat(P66(w))(concat(REXOPT(w)(REGNUM(a))(REGNUM(b))(FALSE))
   (concat(B(15))(concat(B(add(64)(cc)))(MODRM(REGNUM(b))(REGNUM(a))))))
#   Two-operand imul dest, src (reg,reg): 0F AF /r, reg=dest, rm=src, REX.W.
glyph IMUL2 = la w. la a. la b.
    concat(P66(w))(concat(REXOPT(w)(REGNUM(a))(REGNUM(b))(FALSE))
   (concat(B(15))(concat(B(175))(MODRM(REGNUM(b))(REGNUM(a))))))
#   movzx/movsxd: DEST width drives REX.W/0x66; SRC width drives the opcode.
#   The rm field is a register OR a simple base/disp memory operand (SIB
#   index/scale is a later slice — matches secd.asm's [reg]/[reg+d] movzx forms).
glyph RMNUM  = la b. IF(ISREG(b))(la _. REGNUM(b))(la _. MEMBASE(b))
glyph RMIDX = la b. IF(ISMEM(b))(la _. MEMIDX(b))(la _. sub(0)(1))
glyph RMTAIL = la labs. la reg. la b.
    IF(ISREG(b))(la _. MODRM(REGNUM(b))(reg))(la _. MEMTAILX(reg)(MEMBASE(b))(MEMIDX(b))(MEMSCALEB(b))(MEMDISP(labs)(b))(BITSMODE(labs)))
glyph SRCW = la ts. (la b. IF(ISREG(b))(la _. RWIDTH(b))(la _. DECLSZ(TL2(ts))))(A2(ts))
#   movzx: 0F B6 (byte src, 182) / 0F B7 (word src, 183). reg=dest, rm=src.
#   The source MUST be byte or word — a 32/64-bit src (e.g. `movzx rax, rax`) is
#   not a real movzx (nasm rejects it), so halt loudly rather than emit a nonsense
#   B7 over a 64-bit rm that the CPU would misread.
glyph MOVZXOP = la srcw.
    IF(int_eq(srcw)(1))(la _. 182)(la _. IF(int_eq(srcw)(2))(la _. 183)
      (la _. error(concat("asm: movzx source must be byte or word, got width ")(int_to_str(srcw)))))
glyph MOVZXENC = la labs. la destw. la srcw. la a. la b.
    concat(P66(destw))(concat(MREX(destw)(REGNUM(a))(RMIDX(b))(RMNUM(b))(FALSE))
   (concat(B(15))(concat(B(MOVZXOP(srcw)))(RMTAIL(labs)(REGNUM(a))(b)))))
#   movsxd: 63 /r — dest always r64 (REX.W), src r/m32; no 0F, no 0x66.
glyph MOVSXDENC = la labs. la a. la b.
    (la emit.
      IF(ISREG(b))
        (la _. IF(int_eq(RWIDTH(b))(4))(la _. emit)
                 (la _. error("asm: movsxd source must be a 32-bit r/m")))
        (la _. emit))
    (concat(MREX(8)(REGNUM(a))(RMIDX(b))(RMNUM(b))(FALSE))
           (concat(B(99))(RMTAIL(labs)(REGNUM(a))(b))))
#   bsr dest, src (reg,reg): 0F BD /r, reg=dest, rm=src.
glyph BSRENC = la w. la a. la b.
    concat(P66(w))(concat(REXOPT(w)(REGNUM(a))(REGNUM(b))(FALSE))
   (concat(B(15))(concat(B(189))(MODRM(REGNUM(b))(REGNUM(a))))))
#   bt/bts [mem], reg: 0F A3 (bt, 163) / 0F AB (bts, 171); reg=bit-index, rm=mem.
glyph BTENC = la labs. la opc. la w. la a. la b.
    concat(P66M(BITSMODE(labs))(w))(concat(MREX(w)(REGNUM(b))(MEMIDX(a))(MEMBASE(a))(RFORCE(b)))
   (concat(B(15))(concat(B(opc))(MEMTAILX(REGNUM(b))(MEMBASE(a))(MEMIDX(a))(MEMSCALEB(a))(MEMDISP(labs)(a))(BITSMODE(labs))))))
#   Three-operand imul: 6B /r ib when the immediate fits a signed byte, else
#   69 /r id. The ModRM reg field is the DESTINATION here, rm the source.
glyph IMUL3 = la w. la a. la b. la n.
    concat(P66(w))(concat(REXOPT(w)(REGNUM(a))(REGNUM(b))(FALSE))
   (IF(FITS8(n))
     (la _. concat(B(107))(concat(MODRM(REGNUM(b))(REGNUM(a)))(B(FOLD8(n)))))
     (la _. concat(B(105))(concat(MODRM(REGNUM(b))(REGNUM(a)))(IMMW(w)(n))))))

#   THE FULL JCC CONDITION SET. Every conditional jump is one opcode family
#   plus a 4-bit condition: short 0x70+cc, near 0F 80+cc. The old code hardcoded
#   jz/je/jnz/jne as four separate cases; the aliases (jc==jb, jnc==jae, jz==je)
#   are the SAME condition, so they must encode identically — `jc` and `jb` both
#   emit 0x72. A CONS list, not a scanned string: ISJCC is tested for every line
#   on every pass, so lookup is hot.
glyph JCCS =
  CONS(PAIR("jo")(0))(CONS(PAIR("jno")(1))(CONS(PAIR("jb")(2))(CONS(PAIR("jc")(2))(
  CONS(PAIR("jnae")(2))(CONS(PAIR("jae")(3))(CONS(PAIR("jnb")(3))(CONS(PAIR("jnc")(3))(
  CONS(PAIR("je")(4))(CONS(PAIR("jz")(4))(CONS(PAIR("jne")(5))(CONS(PAIR("jnz")(5))(
  CONS(PAIR("jbe")(6))(CONS(PAIR("jna")(6))(CONS(PAIR("ja")(7))(CONS(PAIR("jnbe")(7))(
  CONS(PAIR("js")(8))(CONS(PAIR("jns")(9))(CONS(PAIR("jp")(10))(CONS(PAIR("jnp")(11))(
  CONS(PAIR("jl")(12))(CONS(PAIR("jnge")(12))(CONS(PAIR("jge")(13))(CONS(PAIR("jnl")(13))(
  CONS(PAIR("jle")(14))(CONS(PAIR("jng")(14))(CONS(PAIR("jg")(15))(CONS(PAIR("jnle")(15))(
  NIL))))))))))))))))))))))))))))
glyph JCCOPT = la op. LOOKREG(op)(JCCS)
glyph ISJCC  = la op. ISSOME(JCCOPT(op))
glyph JCCC   = la op. OPTV(JCCOPT(op))
# cmovcc: 0F 40+cc /r — SAME condition nibble as jcc, dest in reg, src in rm.
glyph CMOVS =
  CONS(PAIR("cmovo")(0))(CONS(PAIR("cmovno")(1))(CONS(PAIR("cmovb")(2))(CONS(PAIR("cmovc")(2))(
  CONS(PAIR("cmovnae")(2))(CONS(PAIR("cmovae")(3))(CONS(PAIR("cmovnb")(3))(CONS(PAIR("cmovnc")(3))(
  CONS(PAIR("cmove")(4))(CONS(PAIR("cmovz")(4))(CONS(PAIR("cmovne")(5))(CONS(PAIR("cmovnz")(5))(
  CONS(PAIR("cmovbe")(6))(CONS(PAIR("cmovna")(6))(CONS(PAIR("cmova")(7))(CONS(PAIR("cmovnbe")(7))(
  CONS(PAIR("cmovs")(8))(CONS(PAIR("cmovns")(9))(CONS(PAIR("cmovp")(10))(CONS(PAIR("cmovnp")(11))(
  CONS(PAIR("cmovl")(12))(CONS(PAIR("cmovnge")(12))(CONS(PAIR("cmovge")(13))(CONS(PAIR("cmovnl")(13))(
  CONS(PAIR("cmovle")(14))(CONS(PAIR("cmovng")(14))(CONS(PAIR("cmovg")(15))(CONS(PAIR("cmovnle")(15))(
  NIL))))))))))))))))))))))))))))
glyph CMOVOPT = la op. LOOKREG(op)(CMOVS)
glyph ISCMOV  = la op. ISSOME(CMOVOPT(op))
glyph CMOVCC  = la op. OPTV(CMOVOPT(op))

# ── DATA DEFINITION + LAYOUT: dw/dd/dq, resb/resq, align ───────────────────
#   62 of boot.asm's remaining lines are these. Pure generation, but two of the
#   `-f bin` semantics are NOT what they look like, and both were pinned by
#   assembling with NASM and reading the bytes back rather than reasoning:
#
#   ★ `align` PADS WITH 0x90 (NOP), NOT ZEROS. NASM pads a CODE section with
#     no-ops, so `align 8` at offset 0x39 emits seven 0x90 bytes. Zero-padding
#     would be the obvious guess and would silently produce a different image.
#     (A data section pads with zeros — but sections are not modelled yet, and
#     `-f bin` puts everything in .text, so NOP is the correct behaviour here.
#     This must be revisited WITH sections, not before.)
#
#   ★ `resb`/`resq` EMIT ZEROS here rather than merely advancing. NASM warns
#     ("uninitialized space declared in .text section: zeroing") and emits the
#     bytes; only a reservation at the very END of the image is truncated.
#
#   A data value may be a NUMBER or a LABEL, and a label is absolute — with
#   `org 0x400000`, `dq start` is 0x400000, not 0. Same rule the movabs form
#   already follows, so DVAL routes both through the existing LABADDR.
#   ★ REPEAT BY DOUBLING, not by a right fold. `REPB` builds the zero-fill for
#   `resb`, `align` and section padding, and the obvious
#   `concat(b)(self(n-1)(b))` copies the growing tail once per BYTE — O(n²) in
#   the run length, and boot.asm reserves tens of thousands of bytes.
#   Halving gives n/2 + n/4 + ... total copying: linear, not quadratic.
#
#   ★ FOUND BY MEASURING, AFTER TWO WRONG GUESSES. I first blamed the output
#   assembly in PASS2 (a right fold over line pieces, genuinely O(total²)) and
#   replaced it with a divide-and-conquer join — which measured NO faster, and
#   was reverted. The distinguishing test was a source with FEW lines and a
#   LARGE image: 4 lines producing 60001 bytes took 6.81 s, which no
#   per-line or per-piece cost can explain. That isolated it here.
#   Result: 6.81 s -> 0.56 s on that case, a 12x gain, output byte-identical.
glyph REPB = Z(la self. la n. la b.
    IF(int_eq(n)(0))(la _. "")
      (la _. IF(int_eq(n)(1))(la _. b)
        (la _. (la half.
                 IF(int_eq(mod(n)(2))(0))
                   (la _. concat(half)(half))
                   (la _. concat(half)(concat(half)(b))))
               (self(div(n)(2))(b)))))
glyph LEW = la w. la n.
    IF(int_eq(w)(2))(la _. LE2(n))
      (la _. IF(int_eq(w)(4))(la _. LE4(n))(la _. LE8(n)))
glyph DWIDTH = la op.
    IF(str_eq(op)("dw"))(la _. 2)(la _. IF(str_eq(op)("dd"))(la _. 4)(la _. 8))
glyph ISDATA = la op.
    OR(str_eq(op)("dw"))(OR(str_eq(op)("dd"))(str_eq(op)("dq")))
glyph DVAL = la labs. la t. EVAL(labs)(t)
glyph DEMIT = la labs. la w. la l.
    Z(la self. la ll.
        ll("")(la h. la t. concat(LEW(w)(DVAL(labs)(h)))(self(t))))(l)
glyph DSIZE = la w. la l. mul(w)(LEN(l))
glyph ISRES = la op. OR(str_eq(op)("resb"))(str_eq(op)("resq"))
#   `times COUNT db 0`: the COUNT is an EXPRESSION that may span several tokens
#   when it has spaces (`times 510 - ($ - $$) db 0` in the MBR). Collect tokens
#   up to the data directive (db/dw/dd/dq/resb/resq) as the count string; the rest
#   is the repeated instruction. A single-token count (`times 8 db 0`) is the
#   degenerate case.
glyph ISTIMESINSTR = la t. OR(str_eq(t)("db"))(OR(ISDATA(t))(ISRES(t)))
glyph TIMESCOUNT = Z(la self. la l. la acc.
    l(acc)(la h. la t. IF(ISTIMESINSTR(h))(la _. acc)(la _. self(t)(concat(acc)(h)))))
glyph TIMESREST = Z(la self. la l.
    l(NIL)(la h. la t. IF(ISTIMESINSTR(h))(la _. l)(la _. self(t))))
#   A single-operand directive's WHOLE operand list is the expression, unlike
#   `mov dst, expr` where the first operand is a destination. JOINEXPR keeps the
#   first token separate for that reason, so directives join everything instead.
glyph EVALALL = la labs. la ts. EVAL(labs)(CATALL(DROPSZ(TL2(ts))))
glyph RESN  = la labs. la op. la ts.
    mul(EVALALL(labs)(ts))(IF(str_eq(op)("resb"))(la _. 1)(la _. 8))
#   Padding is measured from the CURRENT offset, which is org-inclusive — the
#   same counter the label table is built from, so alignment means the same
#   thing to `align` as it does to a label's address.
glyph ALIGNPAD = la off. la n. mod(sub(n)(mod(off)(n)))(n)

# ── SIZEL: bytes this line occupies, given what we currently know of labels ──
glyph SIZEL0 = la labs. la off. la ts.
  (la op.
    IF(str_eq(op)(""))(la _. 0)(la _.
    IF(OR(str_eq(op)("bits"))(str_eq(op)("org")))(la _. 0)(la _.
    IF(ISLABEL(op))(la _. 0)(la _.
    IF(str_eq(op)("db"))(la _. DBSIZE(JOINEXPR(TL2(ts))))(la _.
    IF(str_eq(op)("syscall"))(la _. 2)(la _.
    IF(str_eq(op)("ret"))(la _. 1)(la _.
    IF(str_eq(op)("nop"))(la _. 1)(la _.
    IF(AND(str_eq(op)("push"))(ISVAL(A1(ts))))
      (la _. LENOF(PUSHIMM(EVAL(labs)(A1(ts)))))(la _.
    IF(OR(str_eq(op)("push"))(str_eq(op)("pop")))
      (la _. IF(lt(REGNUM(A1(ts)))(8))(la _. 1)(la _. 2))(la _.
    IF(str_eq(op)("call"))(la _. NEARSZ(BITSMODE(labs))(1))(la _.
    IF(AND(str_eq(op)("jmp"))(HASCOLON(A1(ts))))(la _. IF(int_eq(BITSMODE(labs))(16))(la _. 5)(la _. 7))(la _.
    IF(AND(str_eq(op)("jmp"))(ISREG(A1(ts))))(la _. LENOF(INDJMP(4)(A1(ts))))(la _.
    IF(AND(str_eq(op)("call"))(ISREG(A1(ts))))(la _. LENOF(INDJMP(2)(A1(ts))))(la _.
    IF(str_eq(op)("jmp"))(la _. IF(JSHORT(labs)(off)(ts))(la _. 2)(la _. NEARSZ(BITSMODE(labs))(1)))(la _.
    IF(ISJCC(op))(la _. IF(JSHORT(labs)(off)(ts))(la _. 2)(la _. NEARSZ(BITSMODE(labs))(2)))(la _.
    IF(str_eq(op)("mov"))(la _. MOVSIZE(BITSMODE(labs))(ts))(la _.
    IF(OR(str_eq(op)("global"))(OR(str_eq(op)("extern"))(OR(str_eq(op)("equ"))(ISEQU(ts)))))(la _. 0)(la _.
    IF(str_eq(op)("section"))(la _. SECPAD(off))(la _.
    IF(str_eq(op)("incbin"))(la _. LENOF(INCBIN(ts)))(la _.
    IF(str_eq(op)("rep"))(la _. add(1)(SIZEL(labs)(add(off)(1))(TL2(ts))))(la _.
    IF(str_eq(op)("o64"))(la _. add(1)(SIZEL(labs)(add(off)(1))(TL2(ts))))(la _.
    IF(str_eq(op)("out"))(la _. LENOF(OUTENC(A1(ts))(A2(ts))))(la _.
    IF(str_eq(op)("in"))(la _. LENOF(INENC(A1(ts))(A2(ts))))(la _.
    IF(str_eq(op)("ltr"))(la _. LENOF(LTRENC(A1(ts))))(la _.
    IF(str_eq(op)("lgdt"))(la _. LENOF(LGDTENC(labs)(A1(ts))))(la _.
    IF(str_eq(op)("lidt"))(la _. LENOF(LIDTENC(labs)(A1(ts))))(la _.
    IF(str_eq(op)("int"))(la _. 2)(la _.
    IF(str_eq(op)("insb"))(la _. LENOF(STRIOENC(108)(1)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("insw"))(la _. LENOF(STRIOENC(109)(2)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("insd"))(la _. LENOF(STRIOENC(109)(4)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("outsb"))(la _. LENOF(STRIOENC(110)(1)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("outsw"))(la _. LENOF(STRIOENC(111)(2)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("outsd"))(la _. LENOF(STRIOENC(111)(4)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("div"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(DIVENC(w)(a))))(la _.
    IF(str_eq(op)("neg"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(NEGENC(w)(a))))(la _.
    IF(str_eq(op)("idiv"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(IDIVENC(w)(a))))(la _.
    IF(ISCMOV(op))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(CMOVENC(CMOVCC(op))(w)(a)(b))))(la _.
    IF(str_eq(op)("imul"))(la _. IF(str_eq(NTH(2)(OPL(ts)))(""))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(IMUL2(w)(a)(b))))(la _. LENOF(IMUL3(RWIDTH(A1(ts)))(A1(ts))(A2(ts))(NUMV(NTH(2)(OPL(ts)))))))(la _.
    IF(str_eq(op)("movzx"))(la _. LENOF(MOVZXENC(labs)(RWIDTH(A1(ts)))(SRCW(ts))(A1(ts))(A2(ts))))(la _.
    IF(str_eq(op)("movsxd"))(la _. LENOF(MOVSXDENC(labs)(A1(ts))(A2(ts))))(la _.
    IF(str_eq(op)("bsr"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(BSRENC(w)(a)(b))))(la _.
    IF(str_eq(op)("bt"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(BTENC(labs)(163)(w)(a)(b))))(la _.
    IF(str_eq(op)("bts"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(BTENC(labs)(171)(w)(a)(b))))(la _.
    IF(ISDATA(op))(la _. DSIZE(DWIDTH(op))(JOINEXPR(TL2(ts))))(la _.
    IF(ISRES(op))(la _. RESN(labs)(op)(ts))(la _.
    IF(str_eq(op)("align"))(la _. ALIGNPAD(off)(NUMV(NTH(1)(ts))))(la _.
    IF(str_eq(op)("times"))(la _. mul(EVAL(labs)(TIMESCOUNT(TL2(ts))("")))(SIZEL(labs)(off)(TIMESREST(TL2(ts)))))(la _.
    IF(ISNOARG(op))(la _. LENOF(NOARG(op)))(la _.
    IF(ISG1(op))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(G1ENC(labs)(G1DIG(op))(w)(a)(b))))(la _.
    IF(ISSH(op))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(SHENC(SHDIG(op))(BITSMODE(labs))(w)(a)(b))))(la _.
    IF(str_eq(op)("inc"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(IDENC(0)(w)(a)(BITSMODE(labs)))))(la _.
    IF(str_eq(op)("dec"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(IDENC(1)(w)(a)(BITSMODE(labs)))))(la _.
    IF(str_eq(op)("test"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(TSTENC(w)(a)(b))))(la _.
    IF(str_eq(op)("lea"))(la _. WITHOPS(ts)(la w. la a. la b. LENOF(LEAENC(labs)(w)(a)(b))))
      (la _. error(concat("asm: unsupported instruction: ")(op)))))))))))))))))))))))))))))))))))))))))))))))))))))))))
  (LOWER(HD(ts)))

# ── one instruction -> its bytes (off = this instruction's own address) ──
glyph ENC10 = la labs. la off. la ts.
  (la op.
    IF(str_eq(op)(""))(la _. "")(la _.
    IF(OR(str_eq(op)("bits"))(str_eq(op)("org")))(la _. "")(la _.
    IF(ISLABEL(op))(la _. "")(la _.
    IF(str_eq(op)("db"))(la _. DBEMIT(JOINEXPR(TL2(ts))))(la _.
    IF(str_eq(op)("syscall"))(la _. concat(B(15))(B(5)))(la _.
    IF(str_eq(op)("ret"))(la _. B(195))(la _.
    IF(str_eq(op)("nop"))(la _. B(144))(la _.
    IF(AND(str_eq(op)("push"))(ISVAL(A1(ts))))(la _. PUSHIMM(EVAL(labs)(A1(ts))))(la _.
    IF(str_eq(op)("push"))(la _. PUSHPOP(80)(REGNUM(A1(ts))))(la _.
    IF(str_eq(op)("pop"))(la _. PUSHPOP(88)(REGNUM(A1(ts))))(la _.
    IF(OR(str_eq(op)("global"))(OR(str_eq(op)("extern"))(OR(str_eq(op)("equ"))(ISEQU(ts)))))(la _. "")(la _.
    IF(str_eq(op)("section"))(la _. REPB(SECPAD(off))(B(0)))(la _.
    IF(str_eq(op)("incbin"))(la _. INCBIN(ts))(la _.
    IF(str_eq(op)("rep"))(la _. concat(B(243))(ENC1(labs)(add(off)(1))(TL2(ts))))(la _.
    IF(str_eq(op)("o64"))(la _. concat(B(72))(ENC1(labs)(add(off)(1))(TL2(ts))))(la _.
    IF(str_eq(op)("out"))(la _. OUTENC(A1(ts))(A2(ts)))(la _.
    IF(str_eq(op)("in"))(la _. INENC(A1(ts))(A2(ts)))(la _.
    IF(str_eq(op)("ltr"))(la _. LTRENC(A1(ts)))(la _.
    IF(str_eq(op)("lgdt"))(la _. LGDTENC(labs)(A1(ts)))(la _.
    IF(str_eq(op)("lidt"))(la _. LIDTENC(labs)(A1(ts)))(la _.
    IF(str_eq(op)("int"))(la _. concat(B(205))(B(EVAL(labs)(A1(ts)))))(la _.
    IF(str_eq(op)("insb"))(la _. STRIOENC(108)(1)(BITSMODE(labs)))(la _.
    IF(str_eq(op)("insw"))(la _. STRIOENC(109)(2)(BITSMODE(labs)))(la _.
    IF(str_eq(op)("insd"))(la _. STRIOENC(109)(4)(BITSMODE(labs)))(la _.
    IF(str_eq(op)("outsb"))(la _. STRIOENC(110)(1)(BITSMODE(labs)))(la _.
    IF(str_eq(op)("outsw"))(la _. STRIOENC(111)(2)(BITSMODE(labs)))(la _.
    IF(str_eq(op)("outsd"))(la _. STRIOENC(111)(4)(BITSMODE(labs)))(la _.
    IF(str_eq(op)("div"))(la _. WITHOPS(ts)(la w. la a. la b. DIVENC(w)(a)))(la _.
    IF(str_eq(op)("neg"))(la _. WITHOPS(ts)(la w. la a. la b. NEGENC(w)(a)))(la _.
    IF(str_eq(op)("idiv"))(la _. WITHOPS(ts)(la w. la a. la b. IDIVENC(w)(a)))(la _.
    IF(ISCMOV(op))(la _. WITHOPS(ts)(la w. la a. la b. CMOVENC(CMOVCC(op))(w)(a)(b)))(la _.
    IF(str_eq(op)("imul"))(la _. IF(str_eq(NTH(2)(OPL(ts)))(""))(la _. WITHOPS(ts)(la w. la a. la b. IMUL2(w)(a)(b)))(la _. IMUL3(RWIDTH(A1(ts)))(A1(ts))(A2(ts))(NUMV(NTH(2)(OPL(ts))))))(la _.
    IF(str_eq(op)("movzx"))(la _. MOVZXENC(labs)(RWIDTH(A1(ts)))(SRCW(ts))(A1(ts))(A2(ts)))(la _.
    IF(str_eq(op)("movsxd"))(la _. MOVSXDENC(labs)(A1(ts))(A2(ts)))(la _.
    IF(str_eq(op)("bsr"))(la _. WITHOPS(ts)(la w. la a. la b. BSRENC(w)(a)(b)))(la _.
    IF(str_eq(op)("bt"))(la _. WITHOPS(ts)(la w. la a. la b. BTENC(labs)(163)(w)(a)(b)))(la _.
    IF(str_eq(op)("bts"))(la _. WITHOPS(ts)(la w. la a. la b. BTENC(labs)(171)(w)(a)(b)))(la _.
    IF(ISDATA(op))(la _. DEMIT(labs)(DWIDTH(op))(JOINEXPR(TL2(ts))))(la _.
    IF(ISRES(op))(la _. REPB(RESN(labs)(op)(ts))(B(0)))(la _.
    IF(str_eq(op)("align"))(la _. REPB(ALIGNPAD(off)(NUMV(NTH(1)(ts))))(B(144)))(la _.
    IF(str_eq(op)("times"))(la _. REPB(EVAL(labs)(TIMESCOUNT(TL2(ts))("")))(ENC1(labs)(off)(TIMESREST(TL2(ts)))))(la _.
    IF(ISNOARG(op))(la _. NOARG(op))(la _.
    IF(ISG1(op))(la _. WITHOPS(ts)(G1ENC(labs)(G1DIG(op))))(la _.
    IF(ISSH(op))(la _. WITHOPS(ts)(SHENC(SHDIG(op))(BITSMODE(labs))))(la _.
    IF(str_eq(op)("inc"))(la _. WITHOPS(ts)(la w. la a. la b. IDENC(0)(w)(a)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("dec"))(la _. WITHOPS(ts)(la w. la a. la b. IDENC(1)(w)(a)(BITSMODE(labs))))(la _.
    IF(str_eq(op)("test"))(la _. WITHOPS(ts)(TSTENC))(la _.
    IF(str_eq(op)("lea"))(la _. WITHOPS(ts)(LEAENC(labs)))(la _.
    IF(str_eq(op)("call"))(la _. concat(B(232))(NEARDISP(BITSMODE(labs))(labs)(TARGET(ts))(off)(1)))(la _.
    IF(AND(str_eq(op)("jmp"))(HASCOLON(A1(ts))))
      (la _. FARJMP(labs)(A1(ts)))(la _.
    IF(AND(str_eq(op)("jmp"))(ISREG(A1(ts))))
      (la _. INDJMP(4)(A1(ts)))(la _.
    IF(AND(str_eq(op)("call"))(ISREG(A1(ts))))
      (la _. INDJMP(2)(A1(ts)))(la _.
    IF(str_eq(op)("jmp"))
      (la _. IF(JSHORT(labs)(off)(ts))
               (la _. concat(B(235))(B(REL8(labs)(off)(TARGET(ts)))))
               (la _. concat(B(233))(NEARDISP(BITSMODE(labs))(labs)(TARGET(ts))(off)(1))))(la _.
    IF(ISJCC(op))
      (la _. IF(JSHORT(labs)(off)(ts))
               (la _. concat(B(add(112)(JCCC(op))))(B(REL8(labs)(off)(TARGET(ts)))))
               (la _. concat(B(15))(concat(B(add(128)(JCCC(op))))(NEARDISP(BITSMODE(labs))(labs)(TARGET(ts))(off)(2)))))(la _.
    IF(str_eq(op)("mov"))(la _. WITHOPS(ts)(MOVENC(labs)))
      (la _. error(concat("asm: unsupported instruction: ")(op))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
  (LOWER(HD(ts)))

#   Every line is tokenized ONCE, up front, and the passes consume token lists
#   rather than raw text. Each pass used to call TOKS(line) itself, so a source
#   line was re-scanned character-by-character on every walk — the label pass,
#   each fixed-point length pass, and the emit pass — for no gain, since
#   tokenizing is a pure function of the line and nothing between passes can
#   change it. This is the same generation/recognition discipline the rest of
#   the project keeps: tokenizing is GENERATION, done once; the passes only
#   RECOGNIZE what it produced.
glyph MAPTOKS = Z(la self. la ls. ls(NIL)(la h. la t. CONS(TOKS(h)(""))(self(t))))


#   A line may carry a LABEL AND AN INSTRUCTION — `w1: dw 0x1234`, which is how
#   boot.asm writes most of its data. The passes used to treat any line whose
#   first token ended in ":" as a label and NOTHING ELSE, silently discarding
#   the rest of the line: the label landed at the right address but its data
#   was never emitted, so the image came out short with everything after it
#   misplaced. It went unnoticed because every existing test program put labels
#   on their own lines. Stripping the label and dispatching on what remains
#   makes the two forms identical — a bare label line strips to nothing and
#   falls through to the empty case at size 0, exactly as before.
glyph STRIPLAB = la ts. IF(ISLABEL(HD(ts)))(la _. TL2(ts))(la _. ts)
#   `$` is the CURRENT ADDRESS, so it is bound into the label table for the
#   duration of one line. Doing it here rather than threading an `off` argument
#   through every evaluator means `$` works in every operand position at once.
glyph WITHDOLLAR = la labs. la off. CONS(PAIR("$")(off))(labs)
# ── BITS mode (16-bit real mode) ────────────────────────────────────────────
#   `bits N` sets the current CPU mode; it is POSITIONAL (changes mid-file), so
#   the pass loops (MKLABS/TOTLEN/PASS2) carry a `mode` accumulator updated on
#   each bits line, and bind it into the label channel as "@bits" (exactly how
#   WITHDOLLAR binds `$`). asm.la's op-size model is already 32-bit-default, so
#   modes 32 and 64 are identical here — only mode==16 differs, and every
#   mode-aware branch is a NO-OP unless BITSMODE==16, keeping 32/64 byte-identical.
glyph NEXTMODE = la mode. la ts.
    IF(str_eq(LOWER(HD(STRIPLAB(ts))))("bits"))(la _. NUMV(NTH(1)(STRIPLAB(ts))))(la _. mode)
glyph WITHBITS = la labs. la mode. CONS(PAIR("@bits")(mode))(labs)
#   ★ `align` PADS WITH 0x90 IN EVERY SECTION — including non-executable ones.
#   MEASURED on `nasm -f elf64`, in a .rodata section: the fill is `90 90 90 90
#   90 90`, not zeros. This settles the long-standing note below, which guessed
#   that "a data section pads with zeros" and honestly labelled itself as
#   reasoning rather than measurement. It was wrong, and the guess is seductive
#   enough that I rebuilt it: on first writing the ELF path I threaded a
#   per-section pad byte (0x90 when executable, 0 otherwise) through the label
#   channel, and the r6 fixture failed against nasm's NOPs. The deferred
#   divergence never existed; 144 is simply correct, in both formats.
glyph BITSMODE = la labs. (la o. IF(ISSOME(o))(la _. OPTV(o))(la _. 64))(LOOKLAB("@bits")(labs))
glyph SIZEL = la labs. la off. la ts. SIZEL0(WITHDOLLAR(labs)(off))(off)(STRIPLAB(ts))
#   @next = off + this instruction's length, so a RIP-relative disp (target-@next)
#   resolves without threading off/len through every encoder — the same label-
#   channel trick WITHDOLLAR uses for `$`. SIZEL is RIP-length-correct (the mem
#   part is a fixed 5 bytes) so @next needs no @next itself (no circularity).
glyph ENC1  = la labs. la off. la ts.
    ENC10(CONS(PAIR("@next")(add(off)(SIZEL(labs)(off)(ts))))(WITHDOLLAR(labs)(off)))(off)(STRIPLAB(ts))

# ── section / global / incbin ───────────────────────────────────────────────
#   The last three directives boot.asm uses.
#
#   `incbin` splices a binary file's bytes verbatim — boot.asm uses it to embed
#   the LA image (`native_codegen3_out`) into `.la_image`, which is what makes
#   the kernel and the host binary literally the same bytes.
#
#   `global` exports a symbol. In a FLAT image there is no symbol table to
#   export into, so it emits nothing; it becomes meaningful only with an ELF
#   object writer, where it sets the symbol's binding to GLOBAL.
#
#   ★ `section` is accepted and EMITS NOTHING, and that is a deliberate scope
#   decision rather than an oversight. Multi-section `-f bin` LAYOUT is a real
#   feature — measured: a section's start is zero-padded to its own alignment,
#   which NASM takes as the MAXIMUM `align` appearing inside it, defaulting to
#   4 — but it is the WRONG TARGET. boot.asm is assembled `-f elf64` and laid
#   out by `ld -T kernel/kernel.ld`; in that path section placement is the
#   LINKER's job, not the assembler's. Implementing `-f bin` layout would be
#   building the wrong half of the problem. What `section` must do here is
#   parse without choking, which it now does.
#
#   (Also measured, and it corrected an assumption: `align` pads with 0x90 in
#   .rodata and .data too, not only in .text. The zero-fill visible between
#   sections is section-start padding, a DIFFERENT mechanism. The earlier note
#   claiming data sections pad with zeros was reasoning, not measurement.)
#
#   What IS implemented is the DEFAULT section-start alignment: a section begins
#   on a 4-byte boundary, zero-filled (measured: .text of 1/5/9/17 bytes puts
#   the next section at 4/8/12/20). NOT implemented: NASM raises a section's
#   start alignment to the LARGEST `align` appearing inside it, so a section
#   containing `align 8` starts on an 8-boundary. That affects multi-section
#   `-f bin` images only — never the `-f elf64` path boot.asm takes, where the
#   linker script places sections — and it is named here rather than left as a
#   silent divergence.
glyph SECPAD = la off. mod(sub(4)(mod(off)(4)))(4)
glyph INCBIN = la ts. read_file(INCNAME(ts))

# ── THE PREPROCESSOR: %define / %ifdef / %ifndef / %else / %elifdef /
#    %endif / %include ────────────────────────────────────────────────────────
#   This is the last 12% of boot.asm, and it is a DIFFERENT SUBSYSTEM from
#   everything above: a text layer that runs BEFORE the tokenizer, deciding
#   which lines the assembler ever sees. It matters because the `%ifdef` guards
#   are how every kernel variant (K2, K5a, HAL2B, RING3, HH1_HIGHMAP) is
#   selected out of ONE source file — without it, boot.asm cannot be assembled
#   at all, whatever the opcode coverage.
#
#   Scoped by measuring boot.asm first: NO function-like %define (zero take
#   arguments), most are valueless FLAGS existing only to be tested by %ifdef,
#   conditionals nest to depth 4 and are balanced, and there are 4 %includes.
#   So macro EXPANSION is not needed — only definition, conditional selection,
#   and file splicing.
#
#   %include SPLICES the file's lines into the stream and keeps going, rather
#   than recursing into a separate pass. That falls out of the design and is
#   also what NASM does: the included file INHERITS the enclosing conditional
#   state (kbdirq.asm is entirely inside `%ifdef HAL2B` in the parent) and any
#   %define it makes stays visible AFTER the include ends. Both are verified.
#
#   The condition stack holds PAIR(active)(taken) per level. `active` is
#   ABSOLUTE — already ANDed with the enclosing level — so "are we emitting?"
#   is just the top of the stack, and `taken` records whether any branch at
#   this level has fired yet, which is what makes %else and %elifdef correct
#   when several branches could match.
glyph APPEND = Z(la self. la a. la b.
    a(b)(la h. la t. CONS(h)(self(t)(b))))
glyph PPEMIT   = la st. st(TRUE)(la h. la t. FST(h))
glyph PPTAKEN  = la st. st(FALSE)(la h. la t. SND(h))
glyph PPPARENT = la st. st(TRUE)(la h. la t. t(TRUE)(la h2. la t2. FST(h2)))
glyph PPPOP    = la st. st(NIL)(la h. la t. t)
glyph PPUSH    = la st. la cond.
    (la act. CONS(PAIR(act)(act))(st))(AND(PPEMIT(st))(cond))
glyph PPELSE   = la st.
    (la par. la tk. CONS(PAIR(AND(par)(NOT(tk)))(TRUE))(PPPOP(st)))
    (PPPARENT(st))(PPTAKEN(st))
glyph PPELIF   = la st. la cond.
    (la par. la tk.
      (la act. CONS(PAIR(act)(OR(tk)(act)))(PPPOP(st)))
      (AND(AND(par)(NOT(tk)))(cond)))
    (PPPARENT(st))(PPTAKEN(st))
glyph DEFINED  = la nm. la ds. ISSOME(LOOKREG(nm)(ds))
glyph PPVAL    = la ts. NTH(2)(ts)
glyph INCNAME  = la ts. str_tail(NTH(1)(ts))
#   ── %macro / %endmacro ──────────────────────────────────────────────────
#   idt.asm defines two single-parameter macros and invokes them 32 times to
#   generate the ISR stubs. Expansion is LINE-LEVEL and must happen before
#   tokenizing, because `%1` appears INSIDE tokens — `isr%1:` becomes `isr0:`,
#   a label whose NAME is built by substitution. Token-level substitution could
#   never produce that.
#
#   A macro body is collected verbatim between `%macro NAME n` and `%endmacro`,
#   then spliced at each invocation with `%1`..`%9` replaced textually. Splicing
#   into the line stream (rather than recursing) means an expanded body is
#   preprocessed like any other lines — so a macro may contain conditionals, and
#   its labels enter the ordinary label pass.
glyph REPLACE = Z(la self. la s. la pat. la rep.
    IF(str_eq(s)(""))(la _. "")
      (la _. IF(STARTSW(s)(pat))
               (la _. concat(rep)(self(DROPN2(s)(LENOF(pat)))(pat)(rep)))
               (la _. concat(str_head(s))(self(str_tail(s))(pat)(rep)))))
glyph STARTSW = Z(la self. la s. la p.
    IF(str_eq(p)(""))(la _. TRUE)
      (la _. IF(str_eq(s)(""))(la _. FALSE)
        (la _. AND(str_eq(str_head(s))(str_head(p)))
                  (self(str_tail(s))(str_tail(p))))))
glyph DROPN2 = Z(la self. la s. la n.
    IF(int_eq(n)(0))(la _. s)(la _. self(str_tail(s))(sub(n)(1))))
glyph SUBARGS = Z(la self. la line. la args. la i.
    args(line)(la h. la t.
      self(REPLACE(line)(concat("%")(int_to_str(i)))(h))(t)(add(i)(1))))
glyph EXPANDM = Z(la self. la body. la args.
    body(NIL)(la h. la t. CONS(SUBARGS(h)(args)(1))(self(t)(args))))
#   collect a macro body: everything up to %endmacro
glyph MBODY = Z(la self. la ls. la acc.
    ls(PAIR(acc)(NIL))(la h. la t.
      IF(str_eq(HD(TOKS(h)("")))("%endmacro"))
        (la _. PAIR(acc)(t))
        (la _. (la r. PAIR(CONS(h)(FST(r)))(SND(r)))(self(t)(NIL)))))
glyph LOOKMAC = Z(la self. la nm. la l.
    l(NONE)(la h. la t. IF(str_eq(FST(h))(nm))(la _. SOME(SND(h)))(la _. self(nm)(t))))

glyph PP = Z(la self. la ls. la ds. la st. la ms.
  ls(PAIR(NIL)(ds))(la line. la rest.
    (la ts.
      (la d.
        IF(str_eq(d)("%macro"))
          (la _. (la r. self(SND(r))(ds)(st)
                          (CONS(PAIR(NTH(1)(ts))(FST(r)))(ms)))
                 (MBODY(rest)(NIL)))
        (la _. IF(ISSOME(LOOKMAC(d)(ms)))
          (la _. IF(PPEMIT(st))
                   (la _. self(APPEND(EXPANDM(OPTV(LOOKMAC(d)(ms)))(TL2(ts)))(rest))(ds)(st)(ms))
                   (la _. self(rest)(ds)(st)(ms)))
        (la _. IF(str_eq(d)("%define"))
          (la _. IF(PPEMIT(st))
                   (la _. self(rest)(CONS(PAIR(NTH(1)(ts))(PPVAL(ts)))(ds))(st)(ms))
                   (la _. self(rest)(ds)(st)(ms)))
          (la _. IF(str_eq(d)("%ifdef"))
            (la _. self(rest)(ds)(PPUSH(st)(DEFINED(NTH(1)(ts))(ds)))(ms))
            (la _. IF(str_eq(d)("%ifndef"))
              (la _. self(rest)(ds)(PPUSH(st)(NOT(DEFINED(NTH(1)(ts))(ds))))(ms))
              (la _. IF(str_eq(d)("%elifdef"))
                (la _. self(rest)(ds)(PPELIF(st)(DEFINED(NTH(1)(ts))(ds)))(ms))
                (la _. IF(str_eq(d)("%else"))
                  (la _. self(rest)(ds)(PPELSE(st))(ms))
                  (la _. IF(str_eq(d)("%endif"))
                    (la _. self(rest)(ds)(PPPOP(st))(ms))
                    (la _. IF(str_eq(d)("%include"))
                      (la _. IF(PPEMIT(st))
                               (la _. self(APPEND(LINES(read_file(INCNAME(ts)))(""))(rest))(ds)(st)(ms))
                               (la _. self(rest)(ds)(st)(ms)))
                      (la _. IF(PPEMIT(st))
                        (la _. (la r. PAIR(CONS(line)(FST(r)))(SND(r)))(self(rest)(ds)(st)(ms)))
                        (la _. self(rest)(ds)(st)(ms))))))))))))
      (HD(ts)))
    (TOKS(line)(""))))

# ── `equ` — SYMBOLIC CONSTANTS ──────────────────────────────────────────────
#   boot.asm defines ~25 of these (`COM1 equ 0x3F8`, `K6C_SLOTSZ equ 288`).
#
#   ★ AN EQU SYMBOL IS A NUMBER; A LABEL IS AN ADDRESS. The syntax is identical
#   at the use site and NASM encodes them DIFFERENTLY: `mov rax, SLOTSZ` is
#   `b8` + imm32 (5 bytes), while `mov rax, start` is a 10-byte movabs. An
#   assembler that treated equ symbols as labels would emit a correct-looking
#   image with every constant five bytes too long and every subsequent address
#   wrong. This is the whole reason the slice exists.
#
#   Implemented as TOKEN SUBSTITUTION, done once between tokenizing and the
#   passes: an equ value is a constant, so replacing the symbol with its literal
#   text makes every downstream path — immediates, displacements, data
#   definitions, `org` — work unchanged, with no table threaded through them and
#   no risk of one operand position forgetting to consult it. The definition
#   line itself substitutes to NOTHING, so it falls through to the empty case at
#   size 0 like a bare label.
#
#   Honest scope: whole-token matching only. A symbol appearing INSIDE a bracket
#   token (`[rdi+COM1]`) is not substituted, because the tokenizer already
#   folded the brackets into one token — that needs expression parsing, which is
#   the same machinery `idt + 0x21 * 16` will need and belongs with it.
#   ★ TWO KINDS OF equ, and conflating them silently corrupts the image.
#   A CONSTANT-valued equ (`COM1 equ 0x3F8`, 15 of 33 here) can be substituted
#   as text before anything else runs — that is the original design and it is
#   right for those. An ADDRESS-valued one (`hh_msg_len equ $ - hh_msg`, 16
#   uses; `IMAGE_LEN equ la_image_end - la_image_start`, 2) CANNOT: `$` means
#   THE ADDRESS AT THE EQU LINE, so substituting the text `$-hh_msg` into each
#   use site evaluates `$` THERE — a different address entirely. The program
#   assembles cleanly and every string length comes out wrong.
#
#   So address-valued equs are resolved WHERE THEY ARE DEFINED, during the
#   label pass, and their use sites get a marked token `=name` that the
#   evaluator resolves from the label table.
#
#   ★★ THE MARKER IS NOT COSMETIC. Measured: `mov edx, msglen` is a 5-byte
#   IMMEDIATE while `mov rax, msg` is a 10-byte movabs — an equ symbol encodes
#   as a VALUE even when its value was computed FROM addresses. The kind of the
#   symbol decides the encoding, not the provenance of its number. Storing these
#   in the label table unmarked would make every one of them a movabs: five
#   bytes too long, and every later address shifted.
#
#   `name:` with a colon is NASM's local-label form of the same thing
#   (`.code: equ $ - gdt64`, 5 uses). The colon is part of the NAME, not a label
#   definition — reading it as one strips it and leaves `equ` as the mnemonic,
#   which is exactly how boot.asm failed.
glyph ISEQU = la ts. str_eq(NTH(1)(ts))("equ")
glyph EQUNAME = la ts.
    (la h. IF(ISLABEL(h))(la _. LABNAME(h))(la _. h))(HD(ts))
glyph EQUBODY = la ts. CATALL(TL2(TL2(ts)))
#   Address-valued iff the body mentions `$` or any letter that is not part of
#   a hex literal — i.e. it depends on something not yet known.
glyph HASDOLLAR = la s. INSTR("$")(s)
glyph ISADDREQU = la ts.
    (la v. OR(HASDOLLAR(v))(NOT(ISNUM(v))))(EQUBODY(ts))
glyph MKEQUS = Z(la self. la tls. la acc. la scope.
    tls(acc)(la ts. la t.
      IF(AND(ISEQU(ts))(NOT(ISADDREQU(ts))))
        (la _. self(t)(CONS(PAIR(QUALIFY(scope)(EQUNAME(ts)))(EQUBODY(ts)))(acc))(scope))
        (la _. IF(ISEQU(ts))
          (la _. (la q. self(t)(CONS(PAIR(q)(concat("=")(q)))(acc))(scope))
                 (QUALIFY(scope)(EQUNAME(ts))))
          (la _. IF(ISLABEL(HD(ts)))
            (la _. (la nm. self(t)(acc)
                     (IF(str_eq(str_head(nm))("."))(la _. scope)(la _. nm)))
                   (LABNAME(HD(ts))))
            (la _. self(t)(acc)(scope))))))
glyph SUBTOK1 = la equs. la t.
    (la o. IF(ISSOME(o))
             (la _. (la v. IF(str_eq(v)(""))(la _. t)(la _. v))(OPTV(o)))
             (la _. t))
    (LOOKREG(t)(equs))
#   ★ A symbol can be buried inside a token, not just be one. `-(MB_MAGIC`
#   CONTAINS the symbol but is not equal to it, so whole-token substitution
#   misses it — the same shape as `[MBI_SAVE]` did, arriving through a
#   different door once expressions existed. So substitution splits on ANY
#   non-identifier character, replaces each identifier run, and puts the
#   separators back. Identifier characters include `.` (local labels like
#   `gdt64.code`) and `$`, which must survive to the evaluator.
glyph ISIDENT = la c.
    OR(INSTR(c)("abcdefghijklmnopqrstuvwxyz"))
      (OR(INSTR(c)("ABCDEFGHIJKLMNOPQRSTUVWXYZ"))
      (OR(INSTR(c)("0123456789"))(OR(str_eq(c)("_"))(OR(str_eq(c)("."))(str_eq(c)("$"))))))
glyph SUBEXPR = Z(la self. la equs. la s. la cur.
    IF(str_eq(s)(""))
      (la _. SUBTOK1(equs)(cur))
      (la _. (la c.
          IF(ISIDENT(c))
            (la _. self(equs)(str_tail(s))(concat(cur)(c)))
            (la _. concat(SUBTOK1(equs)(cur))
                         (concat(c)(self(equs)(str_tail(s))(""))))) 
        (str_head(s))))
glyph SUBTOK = la equs. la t.
    IF(ISMEM(t))
      (la _. concat("[")(concat(SUBEXPR(equs)(STRIPBRK(t))(""))("]")))
      (la _. SUBEXPR(equs)(t)(""))
glyph SUBLINE = la equs.
    Z(la self. la l. l(NIL)(la h. la t. CONS(SUBTOK(equs)(h))(self(t))))
#   A CONSTANT equ line disappears — its work is done by substitution. An
#   ADDRESS-valued one SURVIVES into the passes, because it has to be evaluated
#   at its own offset; it simply emits no bytes.
glyph SUBALL = la equs.
    Z(la self. la tls.
        tls(NIL)(la ts. la t.
          CONS(IF(AND(ISEQU(ts))(NOT(ISADDREQU(ts))))
                 (la _. NIL)
                 (la _. IF(ISEQU(ts))
                          (la _. CONS(HD(ts))(CONS("equ")
                                     (SUBLINE(equs)(TL2(TL2(ts))))))
                          (la _. SUBLINE(equs)(ts))))(self(t))))

#   ★ LOCAL LABEL REFERENCES, not just definitions. `je .sys_write` inside
#   `sys_write_impl:`'s scope means `sys_write_impl.sys_write`. Qualifying only
#   DEFINITIONS (as MKLABS does) leaves every USE unresolved — boot.asm jumps to
#   `.fill_pd`, `.w_done`, `.sys_write` and others this way.
#
#   Done as a pass over the token lists, tracking the same scope MKLABS does, so
#   both sides agree by construction rather than by two implementations happening
#   to match.
#
#   ★ DIRECTIVE OPERANDS ARE EXEMPT. `section .text` has a leading-dot operand
#   that is a SECTION NAME, not a local label — qualifying it would produce
#   `something.text` and break the layout. The exclusion is by directive, not by
#   guessing from the name.
glyph ISDIRECTIVE = la op.
    OR(str_eq(op)("section"))(OR(str_eq(op)("global"))(str_eq(op)("extern")))
glyph QUALTOK = la scope. la t.
    IF(AND(str_eq(str_head(t))("."))(NOT(ISLABEL(t))))
      (la _. concat(scope)(t))(la _. t)
glyph QUALLINE = la scope. Z(la self. la l.
    l(NIL)(la h. la t. CONS(QUALTOK(scope)(h))(self(t))))
glyph QUALALL = Z(la self. la tls. la scope.
    tls(NIL)(la ts. la t.
      (la hd.
        IF(ISDIRECTIVE(hd))
          (la _. CONS(ts)(self(t)(scope)))
          (la _. IF(AND(ISLABEL(hd))(NOT(str_eq(str_head(hd))("."))))
            (la _. CONS(ts)(self(t)(LABNAME(hd))))
            (la _. CONS(CONS(hd)(QUALLINE(scope)(TL2(ts))))(self(t)(scope)))))
      (HD(ts))))

# ── one pass: walk the lines, recording each label at its current offset ──
#   ★ ISEQU is tested BEFORE ISLABEL, and the order is load-bearing.
#   `.code: equ $ - gdt64` has a name ending in a colon, so it LOOKS like a
#   label definition; recording it as one would place a label at that offset and
#   never evaluate the expression. The colon belongs to the NAME.
#
#   An address-valued equ is evaluated HERE, at its own offset, with `$` bound
#   to that offset — which is the whole reason it could not be substituted as
#   text earlier. Its value lands in the same table labels use, but its use
#   sites carry the `=name` marker so they still encode as immediates.
#   ★ LOCAL LABELS. A name beginning with `.` belongs to the most recent
#   NON-local label, so `.code:` after `gdt64:` is really `gdt64.code` — which
#   is exactly how boot.asm refers to it (`lgdt [gdt64.ptr]`, `mov ax,
#   gdt64.data`). The scope is threaded through the pass and updated whenever a
#   non-local label is defined. Qualifying at DEFINITION is enough here because
#   every use site in boot.asm writes the full name.
glyph QUALIFY = la scope. la nm.
    IF(str_eq(str_head(nm))("."))(la _. concat(scope)(nm))(la _. nm)
glyph MKLABS = Z(la self. la ls. la labs. la off. la acc. la scope. la mode.
    ls(acc)(la ts. la t.
      (la md. (la lm.
        IF(ISEQU(ts))
          (la _. self(t)(labs)(add(off)(SIZEL(lm)(off)(ts)))
                     (CONS(PAIR(QUALIFY(scope)(EQUNAME(ts)))
                               (EVAL(WITHDOLLAR(lm)(off))(EQUBODY(ts))))(acc))
                     (scope)(md))
        (la _. IF(ISLABEL(HD(ts)))
          (la _. (la nm.
                   self(t)(labs)(add(off)(SIZEL(lm)(off)(ts)))
                       (CONS(PAIR(QUALIFY(scope)(nm))(off))(acc))
                       (IF(str_eq(str_head(nm))("."))(la _. scope)(la _. nm))(md))
                 (LABNAME(HD(ts))))
          (la _. self(t)(labs)(add(off)(SIZEL(lm)(off)(ts)))(acc)(scope)(md))))
       (WITHBITS(labs)(md)))
      (NEXTMODE(mode)(ts))))

glyph TOTLEN = Z(la self. la ls. la labs. la off. la mode.
    ls(off)(la ts. la t. (la md. self(t)(labs)(add(off)(SIZEL(WITHBITS(labs)(md))(off)(ts)))(md))(NEXTMODE(mode)(ts))))

# ── iterate to the fixed point: length unchanged <=> no promotion <=> stable ──
#   The previous iteration's total length is CARRIED rather than recomputed.
#   The old form evaluated TOTLEN twice per iteration — once for the incoming
#   label table and once for the new one — but the first of those is exactly
#   what the previous iteration already computed for the second. Since every
#   TOTLEN is a full walk that re-tokenizes and re-sizes every line, dropping
#   it removes a third of the fixed point's work with no change of meaning:
#   the comparison is the same two numbers.
#   ★ THE CONVERGENCE TEST HAD TO CHANGE, and the reason is subtle enough to
#   record. It compared total LENGTH: unchanged length ⟺ no jump was promoted
#   ⟺ stable. That was sound while the table held only label ADDRESSES, since
#   every address feeds some instruction's size. It is NOT sound once the table
#   holds address-valued equ VALUES: on the first pass the table is empty, so
#   `msglen equ $ - msg` computes against msg=0 and comes out as an absolute
#   address rather than a length — and `mov edx, msglen` is five bytes either
#   way. The length converged immediately while the VALUE was still wrong, and
#   the image assembled cleanly with a wrong constant in it.
#
#   So convergence now compares the TABLE, not its consequence. A signature of
#   every name and value is compared between passes; unchanged means nothing
#   moved, which is what stability actually means. Length stability is implied
#   by it rather than standing in for it.
glyph LABSIG = Z(la self. la l.
    l("")(la h. la t. concat(FST(h))(concat(":")(concat(int_to_str(SND(h)))
                     (concat(";")(self(t)))))))
glyph FIXLABS = Z(la self. la ls. la labs. la prev. la n. la org.
    IF(int_eq(n)(0))
      (la _. labs)
      (la _. (la l2.
               (la sig2. IF(str_eq(prev)(sig2))
                           (la _. l2)
                           (la _. self(ls)(l2)(sig2)(sub(n)(1))(org)))
               (LABSIG(l2)))
             (MKLABS(ls)(labs)(org)(CONS(PAIR("$$")(org))(NIL))("")(64))))

#   The emitted bytes ARE the size, so the line is encoded ONCE. The old form
#   called ENC1 and then SIZEL, and since SIZEL now runs the encoder to measure
#   (see MOVSIZE), that meant assembling every line twice on the final pass.
#   This is the same invariant MOVSIZE rests on — len(ENC1) = SIZEL — used in
#   the one place where the labels are known and so ENC1 is safe to run.
glyph PASS2 = Z(la self. la labs. la ls. la off. la mode.
    ls("")(la ts. la t. (la md.
      (la e. concat(e)(self(labs)(t)(add(off)(LENOF(e)))(md)))
      (ENC1(WITHBITS(labs)(md))(off)(ts)))
      (NEXTMODE(mode)(ts))))

# ── ASSEMBLE(source text) -> machine code bytes ──
#   `org N` sets the base address, so labels are ABSOLUTE (what a -f bin image
#   with a load address needs, and what makes `mov rsi, msg` meaningful). Every
#   offset simply starts at N instead of 0; rel8/rel32 are DIFFERENCES, so they
#   are unaffected. `bits`/`org` emit nothing.
glyph ORGOF = Z(la self. la ls.
    ls(0)(la ts. la t.
      IF(str_eq(HD(ts))("org"))(la _. NUMV(NTH(1)(ts)))(la _. self(t))))

# ── size/emit drift guard: the sizing pass and the emit pass must AGREE ──
#   asm.la's stated invariant is len(ENC1) = SIZEL — asserted in comments (l.993,
#   l.1684) and, until this guard, checked NOWHERE. 4d39c74's stale-label bug was
#   exactly this drift: MOVSIZE reported 10 where MOVENC emitted 5, so the label
#   table (accumulated from SIZEL) ended 20 bytes past the emitted image, and
#   FIXLABS converged CLEANLY onto that wrong total (10 is value-independent). A
#   fixpoint is only as sound as the function it iterates. This makes the claimed
#   invariant load-bearing: TOTLEN is the sizing pass's total, str_len(code) the
#   emit pass's — they must be equal or the image is silently misplaced.
#   HONEST SCOPE: catches drift in the TOTAL. Two compensating per-line errors
#   (one +N, one -N in the same program) would still pass; per-line is stronger.
glyph SIZEDRIFT = la sized. la emitted.
    error(concat("asm: INTERNAL size/emit drift — sizing pass accounted ")
      (concat(int_to_str(sized))
        (concat(" bytes, emitter produced ")
          (concat(int_to_str(emitted))
            (" — a SIZEL case disagrees with its encoder; labels are misplaced")))))

glyph ASSEMBLE = la src.
    (la pp.
      (la tls0.
        (la equs.
          (la tls. (la org.
                     (la labs.
                       (la code.
                         (la sized.
                           IF(int_eq(sized)(LENOF(code)))
                             (la _. code)
                             (la _. SIZEDRIFT(sized)(LENOF(code))))
                         (sub(TOTLEN(tls)(labs)(org)(64))(org)))
                       (PASS2(labs)(tls)(org)(64)))
                     (FIXLABS(tls)(NIL)("")(12)(org)))
                   (ORGOF(tls)))
          (QUALALL(SUBALL(equs)(tls0))("")))
        (APPEND(MKEQUS(tls0)(NIL)(""))(SND(pp))))
      (MAPTOKS(FST(pp))))
    (PP(LINES(src)(""))(NIL)(NIL)(NIL))

# ═══════════════════════════════════════════════════════════════════════════
# ELF64 OBJECT EMISSION (`-f elf64`) — the LISTS, not the container
# ═══════════════════════════════════════════════════════════════════════════
#   `elfobj.la` writes the ELF64 relocatable-object CONTAINER, but until now the
#   section/symbol/reloc lists it consumes were extracted from nasm's own `boot.o`
#   by a dev scaffold. That proved the WRITER correct while leaving nasm in the
#   chain. This is the other half: the lists derived FROM SOURCE.
#
#   ★ ADDITIVE BY CONSTRUCTION. Nothing here is reachable from ASSEMBLE or MAIN.
#   The `-f bin` path's glyphs are CALLED (PP/MAPTOKS/SUBALL/QUALALL/SIZEL/PASS2
#   are reused verbatim) and never CHANGED, so the 24-program byte-identity gate
#   cannot regress through this file — one assembler, two output formats, one
#   encoder. If the two formats ever disagree about an instruction's bytes, they
#   disagree because the encoder is wrong, not because a second one drifted.
#
#   ★ CONSTRUCTORS ARE INJECTED. asm.la does not import elfobj.la; the caller
#   passes SDESC/SREC/RINFO/RREC and a cons/nil pair. asm.la builds every list in
#   its OWN Scott encoding and converts once, at the boundary (TOX*), so it needs
#   to know nothing about how elfobj represents a list. The two modules stay
#   independently testable, which is the only reason this could be gated at all.
#
#   ★ THE PLACEHOLDER IN THE FIELD DOES NOT MATTER — measured, not reasoned.
#   A reference to label L emits a reloc against the SECTION symbol of L's
#   section with `addend = L's offset within it` (nasm's convention, read off
#   real output: a ref to `b` at .data+8 gives sym=.data, addend=8). The bytes
#   PASS2 leaves in the instruction field are therefore redundant, and for RELA
#   they are also IGNORED: ld computes S+A and OVERWRITES the field. Verified by
#   clobbering a linked object's field with DEADBEEF — the linked output was
#   byte-identical. So there is no need to zero the field ranges, and the plan's
#   feared "correct only when the target's offset is 0" limitation is not one.
#   (Our `.o` differs from nasm's in those bytes; the gate is ld(ours)==ld(nasm),
#   one level up, exactly because an object's internal layout is convention.)
#
#   HONEST SCOPE of this slice: sections must be declared explicitly (no implicit
#   .text); `.bss`/NOBITS is not emitted (it needs `resb` reservation semantics);
#   an address-valued `equ` contributes its VALUE to the label table but gets no
#   symbol-table entry; and the reloc classifier covers the sites that actually
#   occur — `mov reg,label`, `mov [mem],label`, and `dw`/`dd`/`dq label`.

# ── splitting the line stream into sections ─────────────────────────────────
glyph ISSECLINE = la ts. str_eq(LOWER(HD(STRIPLAB(ts))))("section")
glyph SECNAMEOF = la ts. NTH(1)(STRIPLAB(ts))
#   TAKESEC returns PAIR(this section's lines)(the rest, starting at the NEXT
#   `section` line) so SECSPLIT never has to look ahead twice.
glyph TAKESEC = Z(la self. la ls.
    ls(PAIR(NIL)(NIL))(la ts. la t.
      IF(ISSECLINE(ts))
        (la _. PAIR(NIL)(ls))
        (la _. (la p. PAIR(CONS(ts)(FST(p)))(SND(p)))(self(t)))))
glyph SECFRAGS = Z(la self. la ls.
    ls(NIL)(la ts. la t.
      IF(ISSECLINE(ts))
        (la _. (la p. CONS(PAIR(SECNAMEOF(ts))(FST(p)))(self(SND(p))))(TAKESEC(t)))
        (la _. self(t))))
#   ★ RE-ENTERING A SECTION APPENDS TO IT — it does not start a new one.
#   boot.asm declares five sections, but its %includes declare more: idt.asm
#   re-enters .boot32/.rodata/.bss and timer.asm and kbdirq.asm each re-enter
#   .boot32, so `section .boot32` appears four times in the spliced stream.
#   Emitting one section per DIRECTIVE produced 16 sections against nasm's 11,
#   with .boot32/.rodata/.bss each duplicated.
#
#   MEASURED semantics, on a fixture built for the purpose rather than recalled:
#   a re-entry resumes at the section's CURRENT END, and an `align` inside the
#   continuation pads from the MERGED section-local offset — `.text` holding
#   3 nops then a re-entered `align 16` pads 13 bytes to reach 16. So merging is
#   plain concatenation of the fragments' lines, and the existing per-section
#   offset threading then does the rest unchanged. That is also why the wrong
#   version was CLOSE but not equal: each fragment restarted at offset 0, so
#   every align inside a continuation rounded against the wrong base.
#
#   Order is FIRST APPEARANCE, which is nasm's section order.
#   HONEST SCOPE — `bits` is a SOURCE-ORDER property, not a section one, so a
#   section re-entered under a different CPU mode than it was left in would be
#   mis-threaded here. boot.asm is safe (every `bits` sits inside .boot32 and
#   all three re-entries are `bits 64`, the mode .boot32 already ends in) and it
#   is named rather than silently assumed.
glyph SAMENAME = la nm. Z(la self. la fr.
    fr(NIL)(la sp. la t.
      IF(str_eq(FST(sp))(nm))(la _. APPEND(SND(sp))(self(t)))(la _. self(t))))
glyph DROPNAME = la nm. Z(la self. la fr.
    fr(NIL)(la sp. la t.
      IF(str_eq(FST(sp))(nm))(la _. self(t))(la _. CONS(sp)(self(t)))))
glyph SECMERGE = Z(la self. la fr.
    fr(NIL)(la sp. la t.
      (la nm. CONS(PAIR(nm)(APPEND(SND(sp))(SAMENAME(nm)(t))))(self(DROPNAME(nm)(t))))
      (FST(sp))))
glyph SECSPLIT = la ls. SECMERGE(SECFRAGS(ls))
#   Lines before the first `section` are not part of any section, but a `bits`
#   among them still sets the mode every section inherits — so the preamble is
#   dropped for BYTES and folded for MODE.
glyph PREMODE = Z(la self. la ls. la mode.
    ls(mode)(la ts. la t.
      IF(ISSECLINE(ts))(la _. mode)(la _. self(t)(NEXTMODE(mode)(ts)))))
glyph SECMODEEND = Z(la self. la mode. la ls.
    ls(mode)(la ts. la t. self(NEXTMODE(mode)(ts))(t)))

# ── `global` marks a symbol's BINDING, which is where it finally means something ──
#   In a flat `-f bin` image `global` emits nothing (there is no symbol table to
#   export into). Here it selects st_info 16 (GLOBAL) over 0 (LOCAL).
glyph GLOBALSOF = Z(la self. la ls.
    ls(NIL)(la ts. la t.
      IF(str_eq(LOWER(HD(ts)))("global"))
        (la _. CONS(NTH(1)(ts))(self(t)))
        (la _. self(t))))
glyph INNAMES = Z(la self. la nm. la l.
    l(FALSE)(la h. la t. IF(str_eq(h)(nm))(la _. TRUE)(la _. self(nm)(t))))
#   ── externs: names declared `extern`, undefined HERE, resolved by the linker ──
#   The mirror of GLOBALSOF: a `global` names a label this object DEFINES and
#   exports; an `extern` names one it USES but another object defines. An extern
#   becomes an SHN_UNDEF symbol (shndx 0, GLOBAL bind, value 0) and a relocation
#   against it points at that symbol directly with addend 0 — not at a section
#   symbol + in-section offset, which is how a LOCAL reference relocates. This is
#   the single missing piece for MULTI-OBJECT linking: link.la already resolves a
#   cross-object undefined symbol, but nothing could DECLARE one until now.
glyph EXTERNSOF = Z(la self. la ls.
    ls(NIL)(la ts. la t.
      IF(str_eq(LOWER(HD(ts)))("extern"))
        (la _. CONS(NTH(1)(ts))(self(t)))
        (la _. self(t))))
#   Each extern's symtab index is fixed once the local symbols are laid out:
#   0 null, 1 FILE, then |secs| section symbols, then |locs| defined labels, so
#   the first extern sits at |secs| + 2 + |locs| (the SAME layout TSYM's LOCSEC+1
#   arithmetic already assumes). XIDX numbers the extern names from that base;
#   XLOOK resolves a name to SOME(index) or NONE.
glyph XIDX = Z(la self. la names. la i.
    names(NIL)(la h. la t. CONS(PAIR(h)(i))(self(t)(add(i)(1)))))
glyph XLOOK = Z(la self. la nm. la xs.
    xs(NONE)(la h. la t.
      IF(str_eq(FST(h))(nm))(la _. SOME(SND(h)))(la _. self(nm)(t))))
#   The byte EMITTER resolves a label operand to its value to fill the immediate
#   field (`mov rax, greet` writes an 8-byte field). An extern has no value here —
#   the linker supplies it — so its field is a PLACEHOLDER the RELA overwrites
#   (ld computes S+A-P and ignores the field). Injecting each extern into the
#   encoder's label table makes LABADDR return that placeholder instead of halting
#   "undefined label", WITHOUT adding it to `locs` (built from actual `label:`
#   definitions, not this table) — so it stays an UNDEF symbol, never a defined one.
#
#   ★ THE PLACEHOLDER IS A LARGE POSITIVE VALUE, ON PURPOSE. A near `jmp` picks a
#   SHORT (rel8) encoding when its target is within ±127 (JSHORT/FITS8). An extern
#   jmp MUST be near (rel8 has no room for a PLT32 reloc, and can't reach an
#   unknown symbol), so the placeholder must be far enough that FITS8 fails for
#   any instruction offset off>=0: `V-(off+2) > 127`. A big positive V guarantees
#   that. It must be POSITIVE (not a large negative, which would be equally "far")
#   because a `dq greet` emits this value through LE8, whose div/mod split is
#   unreliable on a negative. The value is otherwise inert: it only fills fields
#   ld overwrites and it changes NO instruction's SIZE (a label operand is imm64 /
#   e8 rel32 regardless of value). Honest bound: correct for a section shorter
#   than EXTPLACE-130 bytes (~1 GiB); a larger .text is not a thing here.
glyph EXTPLACE = 1073741824
glyph EXTLABS = Z(la self. la names.
    names(NIL)(la h. la t. CONS(PAIR(h)(EXTPLACE))(self(t))))

# ── a label's LOCATION: which section, and where in it ──────────────────────
#   `-f bin` needs one number per label (its absolute address). An object file
#   needs two — the section and the offset within it — because the address does
#   not exist yet; the linker supplies it. That is the whole representational
#   difference between the two formats, and it is why this pass exists at all.
#   shndx 0 is the ABSOLUTE marker for an `equ` (real sections are 1-based); it
#   becomes SHN_ABS (65521) at emission. An equ IS a symbol — nasm emits all 21
#   of boot.asm's as LOCAL ABS, interleaved with the labels in strict SOURCE
#   order (`gdt64.code` sits between `gdt64` and `gdt64.ptr`), so they cannot be
#   appended as a group afterwards.
glyph LOCREC  = la nm. la shndx. la val. PAIR(nm)(PAIR(shndx)(val))
glyph LOCNAME = la r. FST(r)
glyph LOCSEC  = la r. FST(SND(r))
glyph LOCVAL  = la r. SND(SND(r))
#   Source order, and deliberately NOT via MKLABS — MKLABS accumulates onto the
#   front and so reverses, which is invisible when the result is only ever looked
#   up by name but fatal here, where nasm's symbol ORDER is part of the target.
#   Scope is threaded exactly as MKLABS threads it so a local `.foo` qualifies to
#   the same name both passes produce.
#   Returns PAIR(records)(the scope at the end), because a local label's scope
#   is a SOURCE-ORDER property spanning fragments: `.w_done` inside a re-entered
#   .boot32 belongs to the last non-local label seen, which may have been
#   defined in an earlier fragment of a different file. Returning the scope
#   rather than recomputing it in a second fold keeps one implementation — the
#   thing this file has already been bitten by twice.
glyph SECLABS = Z(la self. la mlabs. la lines. la off. la shndx. la scope. la mode.
    lines(PAIR(NIL)(scope))(la ts. la t.
      (la md. (la lm.
        (la sz.
          IF(ISEQU(ts))
            (la _. (la r. PAIR(CONS(LOCREC(QUALIFY(scope)(EQUNAME(ts)))(0)
                                          (EVAL(WITHDOLLAR(lm)(off))(EQUBODY(ts))))(FST(r)))(SND(r)))
                   (self(mlabs)(t)(add(off)(sz))(shndx)(scope)(md)))
            (la _. IF(ISLABEL(HD(ts)))
              (la _. (la nm.
                       (la r. PAIR(CONS(LOCREC(QUALIFY(scope)(nm))(shndx)(off))(FST(r)))(SND(r)))
                       (self(mlabs)(t)(add(off)(sz))(shndx)
                             (IF(str_eq(str_head(nm))("."))(la _. scope)(la _. nm))(md)))
                     (LABNAME(HD(ts))))
              (la _. self(mlabs)(t)(add(off)(sz))(shndx)(scope)(md))))
        (SIZEL(lm)(off)(ts)))
       (WITHBITS(mlabs)(md)))
      (NEXTMODE(mode)(ts))))
#   ★ SYMBOL ORDER IS SOURCE ORDER, NOT MERGED-SECTION ORDER. Merging the
#   fragments is right for BYTES but wrong for the symbol table: nasm lists a
#   label at the point its DEFINITION appears in the source, so a `.data` label
#   written between two `.text` fragments comes out between their labels. The
#   r7 fixture caught exactly this — headers and relocations already matched and
#   only the order of `val` and `tail` was swapped.
#
#   So this walks the FRAGMENTS in source order while giving each label the
#   offset it has in its MERGED section: `offs` carries the running end offset
#   per section name, so a re-entered fragment resumes where that section left
#   off, and `shndx` is the section's index in the merged order. Scope and CPU
#   mode thread across fragments for the same source-order reason.
glyph SECIDX = la nm. Z(la self. la secs. la i.
    secs(0)(la sp. la t. IF(str_eq(FST(sp))(nm))(la _. i)(la _. self(t)(add(i)(1)))))
glyph OFFOF = la nm. Z(la self. la offs.
    offs(0)(la p. la t. IF(str_eq(FST(p))(nm))(la _. SND(p))(la _. self(t))))
glyph SECWALK = Z(la self. la secs. la fr. la mlabs. la offs. la scope. la mode.
    fr(NIL)(la sp. la t.
      (la nm. (la lines. (la off0. (la r.
        APPEND(FST(r))
              (self(secs)(t)(mlabs)
                   (CONS(PAIR(nm)(TOTLEN(lines)(mlabs)(off0)(mode)))(offs))
                   (SND(r))(SECMODEEND(mode)(lines))))
        (SECLABS(mlabs)(lines)(off0)(SECIDX(nm)(secs)(1))(scope)(mode)))
        (OFFOF(nm)(offs)))
        (SND(sp)))
      (FST(sp))))
#   ★ THE PREAMBLE CARRIES SYMBOLS. Lines before the first `section` emit no
#   bytes, so the byte passes rightly ignore them — but 21 of boot.asm's 23 equs
#   are declared there, and each is a symbol. Dropping the preamble (which is
#   correct for CODE) silently dropped a fifth of the symbol table. Walked at
#   shndx 0 = ABS; a label there would be meaningless and nasm rejects it, so
#   only equs can appear.
glyph PRELINES = Z(la self. la ls.
    ls(NIL)(la ts. la t. IF(ISSECLINE(ts))(la _. NIL)(la _. CONS(ts)(self(t)))))
glyph ALLLOCS = la tls. la secs. la mlabs. la mode.
    APPEND(FST(SECLABS(mlabs)(PRELINES(tls))(0)(0)("")(mode)))
          (SECWALK(secs)(SECFRAGS(tls))(mlabs)(NIL)("")(mode))

# ── the same fixed point ASSEMBLE runs, over section-relative offsets ───────
#   Sizes can depend on label values (jump promotion, MOVSIZE), so the table has
#   to be iterated to stability here too. It compares the TABLE's signature, not
#   a total length — for the reason FIXLABS records: a stable answer is not a
#   right one, and length converged while a value was still wrong.
glyph FLATLABS = Z(la self. la locs.
    locs(NIL)(la r. la t. CONS(PAIR(LOCNAME(r))(LOCVAL(r)))(self(t))))
glyph LOCSIG = Z(la self. la l.
    l("")(la h. la t. concat(LOCNAME(h))(concat(":")(concat(int_to_str(LOCVAL(h)))
                     (concat("/")(concat(int_to_str(LOCSEC(h)))(concat(";")(self(t)))))))))
glyph ELFFIX = Z(la self. la tls. la secs. la mlabs. la prev. la n. la mode.
    IF(int_eq(n)(0))
      (la _. mlabs)
      (la _. (la locs.
               (la sig. IF(str_eq(prev)(sig))
                          (la _. FLATLABS(locs))
                          (la _. self(tls)(secs)(FLATLABS(locs))(sig)(sub(n)(1))(mode)))
               (LOCSIG(locs)))
             (ALLLOCS(tls)(secs)(mlabs)(mode))))

# ── section descriptors: nasm's defaults, READ OFF nasm's own output ────────
#   .text AX align 16, .data WA align 4, .rodata A align 4 — from `readelf -SW`
#   on a real `nasm -f elf64` object, not from memory. An unrecognised section
#   halts loudly rather than guessing an alignment that would silently relocate
#   everything after it.
#   An UNRECOGNISED name is not an error — nasm has a default for it, and
#   boot.asm relies on it three times: `.multiboot`, `.boot32` and `.la_image`
#   all come out PROGBITS, ALLOC, align 1, and notably NOT executable even
#   though .boot32 is full of code. nasm decides exec from the NAME, not the
#   contents, so following it is the whole job here.
glyph SECATTR = la nm.
    IF(str_eq(nm)(".text"))(la _. PAIR(1)(PAIR(6)(16)))
   (la _. IF(str_eq(nm)(".data"))(la _. PAIR(1)(PAIR(3)(4)))
   (la _. IF(str_eq(nm)(".rodata"))(la _. PAIR(1)(PAIR(2)(4)))
   (la _. IF(str_eq(nm)(".bss"))(la _. PAIR(8)(PAIR(3)(4)))
   (la _. PAIR(1)(PAIR(2)(1))))))
#   ★ A SECTION'S ALIGNMENT IS RAISED BY THE `align`s INSIDE IT. The per-name
#   default is only a floor: boot.asm's .rodata comes out 8 (not the default 4)
#   because it contains `align 8`, and .bss comes out 4096. Measured on nasm's
#   own boot.o — assuming the name defaults alone would have mis-aligned every
#   section that carries an align, and a linker script would then place them
#   somewhere the code does not expect.
glyph MAXOF = la a. la b. IF(lt(a)(b))(la _. b)(la _. a)
glyph MAXALIGN = Z(la self. la lines. la acc.
    lines(acc)(la ts. la t.
      (la st.
        IF(str_eq(LOWER(HD(st)))("align"))
          (la _. self(t)(MAXOF(acc)(NUMV(NTH(1)(st)))))
          (la _. self(t)(acc)))
      (STRIPLAB(ts))))
glyph SC   = la nm. la ty. la fl. la al. la by. la sz.
    PAIR(PAIR(nm)(PAIR(ty)(fl)))(PAIR(al)(PAIR(by)(sz)))
glyph SCNM = la s. FST(FST(s))
glyph SCTY = la s. FST(SND(FST(s)))
glyph SCFL = la s. SND(SND(FST(s)))
glyph SCAL = la s. FST(SND(s))
glyph SCBY = la s. FST(SND(SND(s)))
glyph SCSZ = la s. SND(SND(SND(s)))
#   NOBITS (.bss) takes a header slot and a byte COUNT but contributes no file
#   bytes. asm.la's `resb` emits real zeros for `-f bin` (where a reservation
#   must occupy the image), so the size is simply the length of what PASS2
#   produced and the content is then thrown away — one pass, both meanings.
glyph ISNOBITS = la ty. int_eq(ty)(8)
glyph BUILDSECS = Z(la self. la mlabs. la mode. la secs.
    secs(NIL)(la sp. la t.
      (la lines. (la at. (la ty. (la by.
        CONS(SC(FST(sp))(ty)(FST(SND(at)))(MAXOF(SND(SND(at)))(MAXALIGN(lines)(1)))
               (IF(ISNOBITS(ty))(la _. "")(la _. by))(LENOF(by)))
            (self(mlabs)(SECMODEEND(mode)(lines))(t)))
        (PASS2(mlabs)(lines)(0)(mode)))
        (FST(at)))
        (SECATTR(FST(sp))))
      (SND(sp))))

# ── symbols, in nasm's order — the order is part of the target ──────────────
#   FILE, then one SECTION symbol per section, then every LOCAL label in source
#   order, then every GLOBAL. Locals precede globals across the WHOLE object,
#   not per section (verified on r3: `a`,`b` from .data precede `_start` from
#   .text). sh_info of .symtab is the count of locals, which elfobj derives.
glyph SD     = la nm. la info. la shndx. la val. PAIR(PAIR(nm)(info))(PAIR(shndx)(val))
glyph SDNM   = la s. FST(FST(s))
glyph SDINFO = la s. SND(FST(s))
glyph SDSEC  = la s. FST(SND(s))
glyph SDVAL  = la s. SND(SND(s))
glyph SECSYMS = Z(la self. la secs. la i.
    secs(NIL)(la sp. la t. CONS(SD("")(3)(i)(0))(self(t)(add(i)(1)))))
#   The internal ABS marker (0) becomes SHN_ABS at emission. Kept distinct so
#   the walk can use plain 1-based section indices and one reserved slot, rather
#   than carrying 65521 through the arithmetic.
glyph SHNABS  = 65521
glyph OUTSEC  = la s. IF(int_eq(s)(0))(la _. SHNABS)(la _. s)
glyph BINDSYMS = la gs. la want. la info. Z(la self. la locs.
    locs(NIL)(la r. la t.
      IF(IF(want)(la _. INNAMES(LOCNAME(r))(gs))(la _. NOT(INNAMES(LOCNAME(r))(gs))))
        (la _. CONS(SD(LOCNAME(r))(info)(OUTSEC(LOCSEC(r)))(LOCVAL(r)))(self(t)))
        (la _. self(t))))
#   An extern is a GLOBAL-bind (info 16) NOTYPE symbol at SHN_UNDEF (shndx 0,
#   kept raw — NOT run through OUTSEC, which would turn 0 into SHN_ABS: an equ's
#   0 means "absolute", an extern's 0 means "undefined"). value 0. They follow
#   the defined globals so their indices match XIDX's base (|secs|+2+|locs|), and
#   being global they do not change sh_info (the local count elfobj derives).
glyph EXTSYMS = Z(la self. la names.
    names(NIL)(la h. la t. CONS(SD(h)(16)(0)(0))(self(t))))
glyph BUILDSYMS = la fname. la secs. la locs. la gs. la xnames.
    CONS(SD(fname)(4)(65521)(0))
        (APPEND(SECSYMS(secs)(1))
               (APPEND(BINDSYMS(gs)(FALSE)(0)(locs))
                      (APPEND(BINDSYMS(gs)(TRUE)(16)(locs))(EXTSYMS(xnames)))))

# ── relocations: one per label reference, classified by the ENCODING it lands in ──
#   The reloc's offset is the field's position, so it is derived from the line's
#   own length rather than tracked separately — `mov rax,lbl` is 10 bytes ending
#   in an 8-byte field (len-8), the 32-bit forms end in a 4-byte field (len-4).
#   Using SIZEL for that length is what keeps this honest: it is the SAME measure
#   the emitter agrees with by construction (len(ENC1) = SIZEL), so a reloc can
#   never point somewhere the bytes did not go.
glyph RD    = la off. la sym. la typ. la ad. PAIR(PAIR(off)(sym))(PAIR(typ)(ad))
glyph RDOFF = la r. FST(FST(r))
glyph RDSYM = la r. SND(FST(r))
glyph RDTYP = la r. FST(SND(r))
glyph RDADD = la r. SND(SND(r))
glyph LOOKLOC = Z(la self. la nm. la locs.
    locs(NONE)(la h. la t.
      IF(str_eq(LOCNAME(h))(nm))(la _. SOME(h))(la _. self(nm)(t))))
#   A section's SECTION symbol sits at index shndx+1 (0 null, 1 FILE, then the
#   sections in order), and the addend carries the label's offset within it.
glyph TLOC = la nm. la locs.
    (la o. IF(ISSOME(o))(la _. OPTV(o))
             (la _. error(concat("asm: -f elf64: relocation against a symbol neither defined here nor declared extern: ")(nm))))
    (LOOKLOC(nm)(locs))
#   ★ An extern relocates against its OWN symbol (XLOOK's index), addend 0 — the
#   linker supplies the address. A local relocates against its SECTION symbol
#   (LOCSEC+1) with the in-section offset as addend. A well-formed name is in at
#   most one table: XLOOK is consulted first, and any name that is genuinely a
#   local label is absent from the extern list, so it falls through to the local
#   path. (A name both DEFINED here and declared `extern` is malformed; it would
#   emit an UNDEF reloc, which ld still resolves via the definition.)
glyph TSYM = la nm. la locs. la xs.
    (la o. IF(ISSOME(o))(la _. OPTV(o))
             (la _. add(LOCSEC(TLOC(nm)(locs)))(1)))
    (XLOOK(nm)(xs))
glyph TADD = la nm. la locs. la xs.
    (la o. IF(ISSOME(o))(la _. 0)
             (la _. LOCVAL(TLOC(nm)(locs))))
    (XLOOK(nm)(xs))
glyph DRTYPE = la w.
    IF(int_eq(w)(8))(la _. 1)(la _. IF(int_eq(w)(4))(la _. 10)(la _. 12))
#   A `dq`/`dd`/`dw` operand list places element i at i*w from the line's start.
#   Width 1 (`db`) is EXCLUDED on purpose: its operands may be quoted strings,
#   which are not label references and would be misread as one.
glyph DATARELS = Z(la self. la locs. la xs. la secoff. la w. la els. la i.
    els(NIL)(la e. la t.
      IF(BISLBL(e))
        (la _. CONS(RD(add(secoff)(mul(i)(w)))(TSYM(e)(locs)(xs))(DRTYPE(w))(TADD(e)(locs)(xs)))
                   (self(locs)(xs)(secoff)(w)(t)(add(i)(1))))
        (la _. self(locs)(xs)(secoff)(w)(t)(add(i)(1)))))
#   ★ A LABEL CAN BE THE ADDRESS, NOT JUST THE VALUE — and that is a relocation
#   too. `mov [pml4], eax` puts the label in the DISPLACEMENT; the classifier
#   only looked at the source operand, so 7 of boot.asm's 19 .boot32 relocations
#   were simply absent. It is deliberately NOT a `mov` special case: `lgdt
#   [gdt64.ptr]` and `lidt [idt_ptr]` carry one too, so the rule is about the
#   OPERAND SHAPE, not the mnemonic.
#
#   The displacement is the last four bytes of the instruction unless a trailing
#   immediate follows it, so its position is (length − immediate − 4) — derived
#   from SIZEL, the same measure the emitter agrees with by construction.
#
#   TYPE FOLLOWS THE MODE, measured on nasm's boot.o: 32-bit code gets
#   R_X86_64_32 (the field is zero-extended), 64-bit gets R_X86_64_32S (sign-
#   extended). Both appear in the one file, so guessing either would be wrong
#   half the time.
#   ★ THE ADDRESS MAY BE label+offset, NOT JUST label. `mov dword [pml4+4], 0`
#   is a relocation against pml4 with 4 folded into the addend; requiring the
#   bracket contents to BE a label missed every such site. The label is the
#   FIRST term (the same split MEMBASE uses to find a base register), and the
#   addend is simply MEMDISP — which EVALs the whole bracket expression against
#   the label table and so already yields label_offset + numeric. That makes the
#   bare [label] case fall out of the same expression rather than needing its
#   own arm, which is why this replaces TADD here instead of special-casing.
glyph MEMLBLNAME = la t. FST(SPLITFIRST(STRIPBRK(t))(""))
#   ★ A RIP-relative `[rel label]` is EXCLUDED here: MEMABS is true for it (no
#   base register), so without this it would be read as an ABSOLUTE-memory label
#   and MEMLBLNAME would return "rellabel" (the `rel` prefix unstripped), emitting
#   a reloc against a nonexistent symbol. RIP operands are handled by MEMRIPRELS,
#   which strips `rel` and emits R_X86_64_PC32 — a distinct relocation from the
#   absolute R_X86_64_32/32S this path produces.
glyph HASMEMLBL = la t. AND(ISMEM(t))(AND(MEMABS(t))(AND(NOT(MEMRIP(t)))(BISLBL(MEMLBLNAME(t)))))
glyph MDTYPE  = la mode. IF(int_eq(mode)(64))(la _. 11)(la _. 10)
#   The width is asked for ONLY when there actually is an immediate. `lgdt
#   [desc]` has one operand and no width to infer, so IWOF halts loudly on it —
#   correctly. Computing the width up front turned that correct diagnostic into
#   a failure on a legal instruction, so it is resolved inside the branch that
#   needs it (IF's arms are thunks, so the call does not run otherwise).
glyph IMMTAIL = la st.
    (la a2. IF(str_eq(a2)(""))(la _. 0)
      (la _. IF(OR(ISREG(a2))(ISMEM(a2)))(la _. 0)
        (la _. (la w. IF(lt(w)(4))(la _. w)(la _. 4))(IWOF(st)(A1(st))(a2)))))
    (A2(st))
glyph MEMTOKOF = la st.
    IF(HASMEMLBL(A1(st)))(la _. A1(st))
      (la _. IF(HASMEMLBL(A2(st)))(la _. A2(st))(la _. ""))
#   NOTE (scope): the addend here is MEMDISP, which EVALs the bracket against the
#   LOCAL label table — so a label in an ABSOLUTE memory operand (`[greet]`) must
#   be local; an absolute-memory extern would take EXTPLACE as its addend and is
#   not supported. The RIP-relative memory extern (`[rel greet]`) IS supported —
#   see MEMRIPRELS below (R_X86_64_PC32). The other extern paths are register-
#   immediate (`mov rax, greet`), data (`dq greet`), and PC-relative call/jmp.
#   NOTE (scope): an ABSOLUTE memory extern (`mov rax, [greet]`) is NOT supported.
#   The instruction + reloc are producible correctly (measured: the R_X86_64_32S
#   against greet with addend 0 matches nasm byte-for-byte, and greet resolves to
#   the right absolute address — `MEMDISP − EXTPLACE` recovers the offset), but the
#   LINKED byte-identity gate then trips on symbol-TABLE ordering (a difference in
#   metadata, not code), which is a separate concern from the reloc. Modern code
#   references external data RIP-relatively (`[rel greet]`, MEMRIPRELS above), which
#   IS supported, so this absolute form is left out rather than chased into the
#   symbol-order weeds. A local label uses MEMDISP directly (its value is the
#   in-section offset the section-symbol relocation needs).
glyph MEMDRELS = la mlabs. la locs. la xs. la mode. la secoff. la linelen. la st.
    (la mt. IF(str_eq(mt)(""))
             (la _. NIL)
             (la _. CONS(RD(add(secoff)(sub(sub(linelen)(IMMTAIL(st)))(4)))
                           (TSYM(MEMLBLNAME(mt))(locs)(xs))(MDTYPE(mode))(MEMDISP(mlabs)(mt)))(NIL)))
    (MEMTOKOF(st))
#   ── RIP-relative reference to an EXTERN: `mov rax, [rel greet]` -> R_X86_64_PC32.
#   The modern way to reference external DATA. For a LOCAL `[rel label]` the disp32
#   is the label minus the next IP, computed at assembly time — no reloc (XLOOK
#   NONE). For an extern it must be relocated: R_X86_64_PC32 (type 2) at the disp32
#   field (the same linelen−IMMTAIL−4 position MEMDRELS uses) with addend −4 (RIP
#   points at the next instruction, so S+A−P = target−4−P = target−next). RIPLAB
#   strips the `rel` prefix to recover the real symbol name. The placeholder disp
#   the encoder wrote (EXTPLACE − next) is overwritten by ld, so the linked result
#   matches nasm's.
glyph MEMRIPTOK = la st.
    IF(MEMRIP(A1(st)))(la _. A1(st))
      (la _. IF(MEMRIP(A2(st)))(la _. A2(st))(la _. ""))
glyph MEMRIPRELS = la locs. la xs. la secoff. la linelen. la st.
    (la mt. IF(str_eq(mt)(""))
             (la _. NIL)
             (la _. (la o. IF(ISSOME(o))
                             (la _. CONS(RD(add(secoff)(sub(sub(linelen)(IMMTAIL(st)))(4)))(OPTV(o))(2)(sub(0)(4)))(NIL))
                             (la _. NIL))
                    (XLOOK(RIPLAB(mt))(xs))))
    (MEMRIPTOK(st))
#   ★ THE FAR JUMP'S OFFSET IS NOT THE LAST FIELD. `jmp gdt64.code:long_start`
#   encodes EA + off32 + sel16, so the relocation sits at length−6, not the
#   length−4 every other displacement uses — the 2-byte SELECTOR trails it.
#   Guarded to non-16-bit mode, where the offset is LE2 and the arithmetic
#   differs again; the boot sectors' 16-bit far jumps target no relocatable
#   symbol, so that arm is named rather than silently assumed correct.
glyph FARTGT = la st. SND(SPLITCOLON(A1(st))(""))
glyph FARRELS = la locs. la xs. la mode. la secoff. la linelen. la op. la st.
    IF(AND(str_eq(op)("jmp"))(AND(NOT(int_eq(mode)(16)))(NOT(str_eq(FARTGT(st))("")))))
      (la _. (la tgt. IF(BISLBL(tgt))
                        (la _. CONS(RD(add(secoff)(sub(linelen)(6)))
                                      (TSYM(tgt)(locs)(xs))(MDTYPE(mode))(TADD(tgt)(locs)(xs)))(NIL))
                        (la _. NIL))
             (FARTGT(st)))
      (la _. NIL)
#   ★ A near `call` or `jmp` to an EXTERN symbol is the one PC-RELATIVE relocation
#   asm.la emits — every other reloc it makes is absolute. To a LOCAL label both
#   are self-contained: the rel32 (or rel8) is computed at assembly time and needs
#   NO reloc. To an extern neither can be — the target address is unknown here — so
#   each emits R_X86_64_PLT32 (type 4) at the rel32 field (linelen−4) with addend
#   −4 (rel32 is measured from the next instruction, P+4, so S+A−P = target−4−P is
#   exactly target−next). The field bytes are irrelevant (RELA: ld computes S+A−P
#   and OVERWRITES the field), so the placeholder rel32 does not matter and the
#   LINKED result still matches nasm's byte-for-byte. Only externs get a reloc:
#   XLOOK NONE ⇒ local ⇒ none.
#
#   Both are NEAR (e8/e9 rel32, 5 bytes ⇒ field at linelen−4). `call` has no short
#   form, so it is always near. A `jmp` to an extern is forced near by EXTPLACE
#   (the far placeholder makes JSHORT reject the rel8 form) — see EXTLABS. The far
#   `jmp seg:off` and the `near`-keyword forms are not extern targets here (a colon
#   target is not BISLBL; the keyword case is redundant since externs are already
#   forced near), so A1(st) is the plain target in the cases this fires.
glyph PCRELS = la locs. la xs. la mode. la secoff. la linelen. la op. la st.
    IF(AND(OR(str_eq(op)("call"))(str_eq(op)("jmp")))(NOT(int_eq(mode)(16))))
      (la _. (la tgt.
               (la o. IF(AND(BISLBL(tgt))(ISSOME(o)))
                        (la _. CONS(RD(add(secoff)(sub(linelen)(4)))(OPTV(o))(4)(sub(0)(4)))(NIL))
                        (la _. NIL))
               (XLOOK(tgt)(xs)))
             (A1(st)))
      (la _. NIL)
glyph RELLINE = la mlabs. la locs. la xs. la mode. la secoff. la ts.
  (la st.
    (la op.
      (la linelen.
       APPEND(PCRELS(locs)(xs)(mode)(secoff)(linelen)(op)(st))(APPEND(MEMRIPRELS(locs)(xs)(secoff)(linelen)(st))(APPEND(FARRELS(locs)(xs)(mode)(secoff)(linelen)(op)(st))(APPEND(MEMDRELS(mlabs)(locs)(xs)(mode)(secoff)(linelen)(st))(
        IF(str_eq(op)("mov"))
          (la _. (la a. (la b.
                   IF(BISLBL(b))
                     (la _. IF(ISMEM(a))
                       (la _. CONS(RD(add(secoff)(sub(linelen)(4)))(TSYM(b)(locs)(xs))(11)(TADD(b)(locs)(xs)))(NIL))
                       (la _. IF(int_eq(RWIDTH(a))(8))
                         (la _. CONS(RD(add(secoff)(sub(linelen)(8)))(TSYM(b)(locs)(xs))(1)(TADD(b)(locs)(xs)))(NIL))
                         (la _. CONS(RD(add(secoff)(sub(linelen)(4)))(TSYM(b)(locs)(xs))(10)(TADD(b)(locs)(xs)))(NIL))))
                     (la _. NIL))
                 (A2(st)))(A1(st)))
          (la _. IF(AND(ISDATA(op))(NOT(int_eq(DWIDTH(op))(1))))
            (la _. DATARELS(locs)(xs)(secoff)(DWIDTH(op))(JOINEXPR(TL2(st)))(0))
            (la _. NIL)))))))
      (SIZEL(WITHBITS(mlabs)(mode))(secoff)(ts)))
    (LOWER(HD(st))))
  (STRIPLAB(ts))
glyph SECRELS = Z(la self. la mlabs. la locs. la xs. la mode. la lines. la secoff.
    lines(NIL)(la ts. la t.
      (la md.
        APPEND(RELLINE(mlabs)(locs)(xs)(md)(secoff)(ts))
              (self(mlabs)(locs)(xs)(md)(t)(add(secoff)(SIZEL(WITHBITS(mlabs)(md))(secoff)(ts)))))
      (NEXTMODE(mode)(ts))))
#   nasm emits no `.rela.<name>` for a section with no relocations, so an empty
#   list must be DROPPED rather than emitted empty — an extra section header
#   would shift every later index and the linked output with it.
glyph NULLP = la l. l(TRUE)(la h. la t. FALSE)
glyph BUILDRELA = Z(la self. la mlabs. la locs. la xs. la mode. la secs. la i.
    secs(NIL)(la sp. la t.
      (la lines. (la rs. (la rest.
        IF(NULLP(rs))(la _. rest)(la _. CONS(PAIR(PAIR(FST(sp))(i))(rs))(rest)))
        (self(mlabs)(locs)(xs)(SECMODEEND(mode)(lines))(t)(add(i)(1))))
        (SECRELS(mlabs)(locs)(xs)(mode)(lines)(0)))
      (SND(sp))))

# ── the boundary: asm.la's own lists -> the caller's constructors ───────────
glyph TOXSECS = la XSDESC. la XCONS. la XNIL. Z(la self. la l.
    l(XNIL)(la s. la t.
      XCONS(XSDESC(SCNM(s))(SCTY(s))(SCFL(s))(SCAL(s))(0)(0)(0)(SCBY(s))(SCSZ(s)))
           (self(t))))
#   st_value is 64 bits and elfobj carries it as two 32-bit halves, because an
#   equ's value routinely exceeds LA's signed-int lexer limit — boot.asm's
#   HIGH_BASE is 0xFFFFFFFF80000000 and MB_CHECK is 0xFFFFFFFFE4524FFC, both of
#   which arrive here as NEGATIVE LA integers. LA's div/mod on a negative are
#   documented unreliable in this file, so the negative case is folded into the
#   unsigned range by addition instead of divided. Values below -2^32 halt
#   loudly rather than silently emitting a wrong high half.
glyph TWO32  = 4294967296
glyph SYMLO = la v.
    IF(lt(v)(0))
      (la _. IF(lt(v)(sub(0)(TWO32)))
               (la _. error(concat("asm: -f elf64: symbol value below -2^32: ")(int_to_str(v))))
               (la _. add(v)(TWO32)))
      (la _. mod(v)(TWO32))
glyph SYMHI = la v.
    IF(lt(v)(0))(la _. sub(TWO32)(1))(la _. div(v)(TWO32))
glyph TOXSYMS = la XSREC. la XCONS. la XNIL. Z(la self. la l.
    l(XNIL)(la s. la t.
      (la v. XCONS(XSREC(SDNM(s))(SDINFO(s))(SDSEC(s))(SYMLO(v))(SYMHI(v)))(self(t)))
      (SDVAL(s))))
glyph TOXRECS = la XRREC. la XCONS. la XNIL. Z(la self. la l.
    l(XNIL)(la r. la t.
      XCONS(XRREC(RDOFF(r))(RDSYM(r))(RDTYP(r))(RDADD(r)))(self(t))))
glyph TOXRELA = la XRINFO. la XRREC. la XCONS. la XNIL. Z(la self. la l.
    l(XNIL)(la e. la t.
      XCONS(XRINFO(FST(FST(e)))(SND(FST(e)))(TOXRECS(XRREC)(XCONS)(XNIL)(SND(e))))(self(t))))

# ── SUBALL2: substitute the equs but KEEP their lines ──────────────────────
#   `-f bin` DELETES a numeric equ's line once its uses have been substituted —
#   correct there, since an equ contributes no bytes and nothing downstream
#   needs it. An object file does need it: the line is the only record of where
#   the symbol sits in SOURCE ORDER, and nasm's symbol table is ordered by it.
#   Keeping the line is free for the byte passes — SIZEL already answers 0 for
#   an equ and PASS2 already emits "" — so the same PASS2 serves both formats
#   with no special case. Only the SUBALL variant differs, which is why this is
#   a sibling glyph rather than a flag threaded through the original.
glyph SUBALL2 = la equs.
    Z(la self. la tls.
        tls(NIL)(la ts. la t.
          CONS(IF(ISEQU(ts))
                 (la _. CONS(HD(ts))(CONS("equ")(SUBLINE(equs)(TL2(TL2(ts))))))
                 (la _. SUBLINE(equs)(ts)))(self(t))))

# ── ASM_ELF(src)(fname)(SDESC)(SREC)(RINFO)(RREC)(CONS)(NIL)(k) ────────────
#   -> k(content)(symlist)(relainfo), which is exactly EMIT_OBJ_N's shape, so a
#   driver passes EMIT_OBJ_N as k and gets the finished object back.
#   The front half is ASSEMBLE's, verbatim: preprocess, tokenize, substitute the
#   text equs, qualify local labels. Only from `tls` on do the two formats part.
glyph ASM_ELF = la src. la fname. la XSDESC. la XSREC. la XRINFO. la XRREC. la XCONS. la XNIL. la k.
    (la pp.
      (la tls0.
        (la equs.
          (la tls.
            (la secs.
              IF(NULLP(secs))
                (la _. error("asm: -f elf64: no `section` directive — an object file has no implicit .text"))
                (la _.
                  (la mode0.
                   (la xnames.
                    (la mlabs.
                     (la mlabsx.
                      (la locs.
                        (la gs.
                          (la xidx.
                            k(TOXSECS(XSDESC)(XCONS)(XNIL)(BUILDSECS(mlabsx)(mode0)(secs)))
                             (TOXSYMS(XSREC)(XCONS)(XNIL)(BUILDSYMS(fname)(secs)(locs)(gs)(xnames)))
                             (TOXRELA(XRINFO)(XRREC)(XCONS)(XNIL)(BUILDRELA(mlabsx)(locs)(xidx)(mode0)(secs)(1))))
                          (XIDX(xnames)(add(add(LEN(secs))(2))(LEN(locs)))))
                        (GLOBALSOF(tls)))
                      (ALLLOCS(tls)(secs)(mlabsx)(mode0)))
                     (APPEND(mlabs)(EXTLABS(xnames))))
                    (ELFFIX(tls)(secs)(NIL)("")(12)(mode0)))
                   (EXTERNSOF(tls)))
                  (PREMODE(tls)(64))))
            (SECSPLIT(tls)))
          (QUALALL(SUBALL2(equs)(tls0))("")))
        (APPEND(MKEQUS(tls0)(NIL)(""))(SND(pp))))
      (MAPTOKS(FST(pp))))
    (PP(LINES(src)(""))(NIL)(NIL)(NIL))

glyph MAIN =
  (la code.
    (la _.
      print(concat(concat("asm.la assembled ")(str_len(code)))(" bytes -> asm_out.bin")))
    (write_file("asm_out.bin")(code)))
  (ASSEMBLE(read_file("asm_in.asm")))
