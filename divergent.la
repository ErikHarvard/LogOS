# ════════════════════════════════════════════════════════════════
#  divergent.la — DO GENUINELY DIFFERENT COMPRESSIONS CONVERGE ON κ? **NO.** (Erik's cross-branch option B)
#
#  THE EXPERIMENT. §46 found the cross-branch collapse true BY CONSTRUCTION — eighteen branches calling one
#  sealer — and Erik chose the option that could earn the interesting claim instead: *"Construct test
#  branches whose local compression operations are NOT the sealer. Test whether they converge on κ. If they
#  do, the interesting claim is earned. If they don't, the collapse is bounded to the sealer, and that
#  becomes the finding."*  Six compressions are constructed over one fixed parent pair (κ and 𝓜):
#      SEALER   ⊗(a,b)        merge, both parents retained — the control
#      DELETION a             compress by LOSS: keep the first, discard the second
#      SWAP     ⊗(b,a)        merge, reversed
#      NEST     ⊂(a,b)        containment instead of tensor
#      FOLD     ↻(⊗(a,b))     merge, then metacursive fold
#      FUSE     ⊕(a,b)        co-presence instead of tensor
#
#  ★★ THE FINDING, IN THREE PARTS, AND IT IS A NEGATIVE ONE:
#   (1) NO AGREEMENT AT THE OUTPUT LEVEL — six operations, SIX DISTINCT κ-forms on the same parents.
#   (2) NO CONVERGENCE UNDER ITERATION — iterating xₖ₊₁ = OP(xₖ, b), **five of the six NEVER REACH A FIXED
#       POINT.** They grow without bound (the κ-string lengthens by a constant each step, forever).
#   (3) THE ONE THAT DOES COME TO REST IS **DELETION**, and it rests because it THROWS THE SECOND PARENT
#       AWAY. So there is exactly one fixed point among the six, and it belongs to the operation that
#       compresses by LOSS.
#
#  ⇒ **THE DIVERGENT OPERATIONS DO NOT CONVERGE ON κ. THE COLLAPSE IS BOUNDED TO THE SEALER.** §46's [B]
#  is therefore principled, not incidental: it is not that we happened to write one sealer, it is that
#  alternatives do not come back together even in the limit.
#
#  ★★★ AND THE DEEPER READING, which is the real result: **CONVERGENCE AND RETENTION ARE IN TENSION.**
#  Every operation that RETAINS both parents fails to come to rest; the only one that comes to rest does
#  so by DISCARDING. A compression that both retains everything and terminates is not among these six —
#  and §42 already measured why: retaining costs +1 node per collapse, forever. Rest is bought with loss.
#
#  ★ THE CONTROL THAT KEEPS (2) FROM BEING A PROPERTY OF THE SEALER: the sealer is NOT fixed-point-free.
#  It has EXACTLY ONE fixed point — the Archē, ⊗(∃,∃) → ∃ (§45 gates that this belongs to ∃ alone). So
#  "does not converge" is a fact about ordinary glyphs under these operations, not an artefact of the
#  operation being unable to rest anywhere.
#
#  GATE (gate_registers.sh §48)  six distinct outputs; how many of the six reach a fixed point within a
#        bounded search; that the one that does is DELETION; and the Archē control.
#        RED PATHS: (1) the fixed-point detector made constant-true — everything "stabilises" and the
#        finding evaporates; (2) two operations made identical — the distinct-output count drops, which is
#        what shows the test counts real divergence rather than just counting six names.
#  ★ EVIDENTIAL: [W] all four; [B] the iteration is bounded at 8 steps — "never reaches a fixed point" is
#     witnessed as "does not within 8, while growing monotonically", which is evidence and not a proof of
#     non-termination.
#  ⚖ RECLASSIFIED 2026-09-18 against the standing rule (FREEZE-TRACKF.md F35): of this module's 3 pinned witnesses — red-proven 2 · exact & independently derived 1. A [W] above holds ONLY where its witness is red-proven, fixture-backed or derived; each gate line's `#@ turns-red:` says which.
#  Pure strings + κ walks ⇒ byte-identical on the C host and the SECD VM.
# ════════════════════════════════════════════════════════════════
import("recdepth.la")

export DV_OPS DV_FIX DV_STABLE

glyph DV_B = la b. b("T")("F")
# Px comes from recdepth.la (a local copy was dead under tiny_host — FREEZE-TRACKF.md F8, removed 2026-09-18)
glyph DV_JOIN = Z(la self. la l. l("")(la h. la t. concat(h)(self(t))))
glyph DV_A = KAPPA
glyph DV_P = REVAL

glyph DV_OPS =
  CONSc(PAIRc("SEALER")(la a. la b. SYN(a)(b)))(
  CONSc(PAIRc("DELETION")(la a. la b. a))(
  CONSc(PAIRc("SWAP")(la a. la b. SYN(b)(a)))(
  CONSc(PAIRc("NEST")(la a. la b. CONT(a)(b)))(
  CONSc(PAIRc("FOLD")(la a. la b. MC(SYN(a)(b))))(
  CONSc(PAIRc("FUSE")(la a. la b. CON(a)(b)))(
  NILc))))))

# ── (1) outputs on ONE fixed parent pair ──
glyph DV_OUT = la op. NORMK(op(DV_A)(DV_P))
glyph DV_UNIQ = Z(la self. la l. l(NILc)(la h. la t. (la rest. IF(RD_FOLD(la x. la acc. OR(acc)(str_eq(x)(h)))(FALSE)(rest))(la _. rest)(la _. CONSc(h)(rest)))(self(t))))
glyph DV_OUTS = RD_FOLD(la e. la acc. CONSc(DV_OUT(SNDc(e)))(acc))(NILc)(DV_OPS)
glyph DV_DISTINCT = LEN(DV_UNIQ(DV_OUTS))

# ── (2) iterate xₖ₊₁ = OP(xₖ, b) and look for a fixed point within a BOUNDED search ──
glyph DV_FIX = la op. Z(la self. la k. la x. IF(int_eq(k)(0))(la _. "")(la _.
   IF(str_eq(NORMK(op(x)(DV_P)))(NORMK(x)))(la _. NORMK(x))(la _. self(sub(k)(1))(op(x)(DV_P)))))(8)(DV_A)
glyph DV_STABLE = la op. NOT(str_eq(DV_FIX(op))(""))
glyph DV_NSTABLE = RD_FOLD(la e. la acc. add(acc)(IF(DV_STABLE(SNDc(e)))(la _. 1)(la _. 0)))(0)(DV_OPS)
glyph DV_WHICH = RD_FOLD(la e. la acc. IF(DV_STABLE(SNDc(e)))(la _. FSTc(e))(la _. acc))("")(DV_OPS)

# ── the control: the sealer IS NOT fixed-point-free — it rests at the Archē, and §45 gates that this is ∃’s alone ──
glyph DV_ARCHE_FIX = str_eq(NORMK(SYN(Px("∃"))(Px("∃"))))(NORMK(Px("∃")))

glyph REPORT =
  DV_JOIN(
  CONSc("DIVERGENT six constructed compressions over one parent pair — distinct κ-outputs: ")(
  CONSc(int_to_str(DV_DISTINCT))(
  CONSc(" of ")(
  CONSc(int_to_str(LEN(DV_OPS)))(
  CONSc(" — NO agreement at the output level:")(
  CONSc(DV_B(int_eq(DV_DISTINCT)(LEN(DV_OPS))))(
  CONSc("\nDIVERGENT iterated xₖ₊₁=OP(xₖ,b), bounded search of 8 — reach a FIXED POINT: ")(
  CONSc(int_to_str(DV_NSTABLE))(
  CONSc(" of ")(
  CONSc(int_to_str(LEN(DV_OPS)))(
  CONSc(" | the ONLY one that comes to rest is ")(
  CONSc(DV_WHICH)(
  CONSc(" ★ and it rests by THROWING THE SECOND PARENT AWAY:")(
  CONSc(DV_B(str_eq(DV_WHICH)("DELETION")))(
  CONSc(" | its fixed point = ")(
  CONSc(DV_FIX(la a. la b. a))(
  CONSc("\nDIVERGENT ★ CONTROL — the sealer is NOT fixed-point-free: ⊗(∃,∃)→∃ rests at the Archē:")(
  CONSc(DV_B(DV_ARCHE_FIX))(
  CONSc(" (§45 gates that ⊗-idempotence is ∃’s ALONE), so “does not converge” is a fact about ordinary glyphs, not an artefact of an operation that can never rest")(
  CONSc("\nDIVERGENT ★★ VERDICT: THE DIVERGENT OPERATIONS DO NOT CONVERGE ON κ — THE COLLAPSE IS BOUNDED TO THE SEALER. §46’s [B] is principled, not incidental. ★★★ AND THE DEEPER RESULT: CONVERGENCE AND RETENTION ARE IN TENSION — every operation that RETAINS both parents fails to come to rest, and the only one that rests DISCARDS. §42 measured why: retention costs +1 node per collapse, forever. Rest is bought with loss. [B] bounded search of 8 steps: “never” is witnessed as “not within 8 while growing monotonically”")(
  NILc)))))))))))))))))))))
glyph MAIN = print(REPORT)
