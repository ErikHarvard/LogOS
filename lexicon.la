# =====================================================================
#  lexicon.la — THE CORE LEXICON, and the gate that measures it.
#
#  LINGUA ADAMICA.tex :5223–5429 specifies a Core Lexicon of ~60 concepts
#  across six tables (Level-1 derivations, the physical world, actions,
#  properties, numbers, social concepts). Until now the running system had
#  EIGHT derived concepts. The language had a complete grammar, five
#  operators, three modalities — and almost no words.
#
#  ── WHAT A LEXICON ENTRY IS HERE ────────────────────────────────────
#  Not a stipulation. Every entry is a DERIVATION over the nine primitives
#  under the five operators, exactly as Thm. gen-complete requires: "Nothing
#  is stipulated; everything is derived." So an entry carries no meaning of
#  its own — its meaning is its tree, and its phonym is DETERMINED by the
#  tree via the Operator Phonology (:5120). That is the property this module
#  can actually test.
#
#  ── ★ THE GATE IS A COMPARISON WITH THE SPEC, NOT WITH ITSELF ───────
#  The declared phonym column is transcribed from the codex's own printed
#  IPA, romanised — NOT generated by the rule and then compared to itself.
#  That distinction is the whole value of the gate. A table whose expected
#  column was produced by the code under test asserts nothing; it is the
#  vacuous-gate defect in its purest form. Here the two columns have
#  independent origins, so they CAN disagree — and they do.
#
#  ── ★★ THE MEASURED RESULT: 57 AGREE, 2 DIVERGE, ONE CLASS ──────────
#  Think and Gratitude are the two, and both are VOWEL ELISION:
#
#        Think  ▷(RECOGNITION,RECOGNITION)  rule /ʃ'iʃi/  spec /ʃ'ʃi/
#        Gratit ▷(LOVE,BEING)               rule /l'ua/   spec /l'a/
#
#  The codex prints SURFACE forms; the Operator Phonology is stated at the
#  SEGMENT level and generates UNDERLYING ones. The language has a
#  phonology/phonetics distinction it had never been asked to admit.
#
#  ── ★ AND THE RULE THIS CORRECTED ───────────────────────────────────
#  The first version of this module placed the acute on the FIRST vowel of
#  the stressed constituent and reported three divergences, Eat among them.
#  Bringing in the codex's example SENTENCES (:5380) as fresh vectors
#  refuted that: "Water flows" is printed /tɑɑv'u vu/, stressing the LAST
#  vowel of Water. Measured across every stressed form the codex prints,
#  final-vowel agrees on 17 of 21 and first-vowel on 15. Eat was never a
#  surface divergence at all — it was this module's own bug, and only new
#  test vectors could have shown that. A rule fitted to one table will
#  agree with that table.
#
#  ── ★ AND THE CONVERGENCE NOBODY ARRANGED ───────────────────────────
#  The Numbers table assigns One = 𝔤₁ = BEING. `dyadseed.la` independently
#  reduces BEING (la self. self) to Church ONE by eta-equivalence — a fact
#  about the lambda calculus, derived with no reference to this table. Two
#  unrelated derivations, one answer. That is gated below (ONE_IS_BEING),
#  because a convergence nobody arranged is worth more than an assertion
#  somebody made.
#
#  ── WHY THE MINIMAL PAIRS MATTER ────────────────────────────────────
#  The lexicon contains operator minimal pairs — same operands, different
#  mode — and they are the proof that the five operators are phonetically
#  DISTINGUISHED rather than nominally distinct:
#
#        Cold  ⊗(VOID,LOVE)  /halu/    vs  Bad     ⊕(VOID,LOVE)  /ha.lu/
#        Kind  ⊗(LOVE,SELF)  /luma/    vs  Care    ▷(LOVE,SELF)  /l'uma/
#        Consc ⊗(RECOG,SELF) /shima/   vs  Witness ▷(RECOG,SELF) /sh'ima/
#
#  If any of the three collapsed, two concepts would share one phonym and
#  monosemy would fail IN SOUND while holding in form — the exact defect
#  class `phonorm.la` was built to catch, here at lexicon scale.
#
#  ── THE ENCODING, AND WHY IT IS A FLAT STRING ───────────────────────
#  Entries are one flat string, `NAME|DERIV|PHONYM;` repeated. A deeply
#  nested table makes codegen of any importer pathologically slow (the
#  documented `theourgia_font.la` hazard); a string literal lowers to one
#  instruction. DERIV is prefix notation: digits 1-9 are the primitives,
#  `*`=⊗  `+`=⊕  `>`=▷  `c`=⊂  `m`=↻.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph AND  = la p. la q. p(q)(p)
glyph NOT  = la p. la t. la f. p(f)(t)
glyph TRUE = la t. la f. t
glyph FALSE = la t. la f. f
glyph PAIR = la a. la b. la f. f(a)(b)
glyph FST  = la p. p(la a. la b. a)
glyph SND  = la p. p(la a. la b. b)

# ── the nine primitives: romanised phonym and glyph name ────────────
# A linear table lookup, not a nine-deep IF chain. The chain is where the
# paren-depth bugs live, and a lookup cannot have one.
glyph LOOK = Z(la self. la k. la s.
    IF(str_eq(s)(""))(la _. "")(la _.
      (la rec. IF(str_eq(str_head(rec))(k))
                 (la _. str_tail(rec))
                 (la _. self(k)(PAST(";")(s))))
      (UPTO(";")(s))))

glyph PHN = la d. LOOK(d)("1a;2shi;3lu;4ma;5ra;6ha;7vu;8ta;9do")
glyph NAM = la d. LOOK(d)("1BEING;2RECOGNITION;3LOVE;4SELF;5RELATION;6VOID;7BECOMING;8FORM;9DEPTH")
glyph IS_DIG = la c. NOT(str_eq(PHN(c))(""))
glyph IS_VOW = la c. NOT(str_eq(LOOK(c)("ax;ix;ux;ox;ex"))(""))

# ── the derivation tree, Scott-encoded: same arity+order as canon.la ──
glyph PRIM = la d.         la p. la s. la n. la r. la o. la m. p(d)
glyph SYN  = la a. la b.   la p. la s. la n. la r. la o. la m. s(a)(b)
glyph CON  = la a. la b.   la p. la s. la n. la r. la o. la m. n(a)(b)
glyph DIR  = la a. la b.   la p. la s. la n. la r. la o. la m. r(a)(b)
glyph CONT = la a. la b.   la p. la s. la n. la r. la o. la m. o(a)(b)
glyph MC   = la a.         la p. la s. la n. la r. la o. la m. m(a)

# ── PARSE: prefix notation -> PAIR(tree)(rest) ──────────────────────
# ★ A parser that loops forever on malformed input is the silent-failure
# defect class -- the caller cannot tell "bad input" from "still working".
# An unrecognised character halts LOUDLY, as every other engine here does.
# This was not added on principle: two rows of the codex's own grammar
# table reached it and spun the build for two minutes with no output.
glyph IS_OP = la c. NOT(str_eq(LOOK(c)("*x;+x;>x;cx"))(""))

glyph PARSE = Z(la self. la s. (la c. IF(IS_DIG(c))(la _. PAIR(PRIM(c))(str_tail(s)))(la _. IF(str_eq(c)("m"))(la _. (la r1. PAIR(MC(FST(r1)))(SND(r1)))(self(str_tail(s))))(la _. IF(IS_OP(c))(la _. (la r1. (la r2. PAIR(IF(str_eq(c)("*"))(la _. SYN(FST(r1))(FST(r2)))(la _. IF(str_eq(c)("+"))(la _. CON(FST(r1))(FST(r2)))(la _. IF(str_eq(c)(">"))(la _. DIR(FST(r1))(FST(r2)))(la _. CONT(FST(r1))(FST(r2))))))(SND(r2)))(self(SND(r1))))(self(str_tail(s))))(la _. error(concat("lexicon: malformed derivation near: ")(s))))))(str_head(s)))

# ── STRESS: the acute lands on the phonym's NUCLEUS (first vowel) ────
# Placed here, not before the phonym, because the codex prints /v'ura/ —
# the mark is on the vowel. A rule that marked the boundary instead would
# disagree with EVERY directional entry and the comparison would be noise
# rather than a measurement.
# ★ The acute lands on the FINAL vowel of the phonym, and stress does NOT
# stack -- an already-stressed constituent is left alone. Both facts were
# MEASURED against every stressed form the codex prints, not chosen:
# final-vowel agrees on 17 of 21, first-vowel on 15. The four it still
# misses are all vowel ELISION (Think, Gratitude, Question, Past), a single
# named phenomenon rather than scattered noise -- which is what makes the
# residual a finding instead of a fudge factor.
glyph HASMARK = Z(la self. la s. IF(str_eq(s)(""))(la _. NOT(TRUE))(la _. IF(str_eq(str_head(s))("'"))(la _. TRUE)(la _. self(str_tail(s)))))

glyph HASVOW = Z(la self. la s. IF(str_eq(s)(""))(la _. NOT(TRUE))(la _. IF(IS_VOW(str_head(s)))(la _. TRUE)(la _. self(str_tail(s)))))

glyph MARKLAST = Z(la self. la s. IF(str_eq(s)(""))(la _. "")(la _. IF(HASVOW(str_tail(s)))(la _. concat(str_head(s))(self(str_tail(s))))(la _. IF(IS_VOW(str_head(s)))(la _. concat("'")(s))(la _. concat(str_head(s))(self(str_tail(s)))))))

glyph STRESS = la s. IF(HASMARK(s))(la _. s)(la _. MARKLAST(s))

# ── PH: the Operator Phonology (:5120), applied to a tree ───────────
#   ⊗ smooth fusion AB · ⊕ glottal pause A.B · ▷ stress-link 'AB
#   ⊂ framing B[A]B · ↻ reduplication AA
# ── ★★ ONE MARK PER UTTERANCE, NOT PER OPERATOR (Erik's ruling 2026-08-27) ──
#  R-D gave ▷ a tail duration mark ":" in the romanised register, emitted by the
#  ▷ BRANCH -- once per ▷ NODE. The first full build.sh ever run against R-D
#  showed the cost: grammar rule (x), the imperative ▷(4)(▷(">42")(act)), renders
#  `m'am'ashi:vu::` -- a DOUBLED mark. ":" was chosen precisely BECAUSE it occurred
#  ZERO times in the phonym alphabet and so could not collide with an existing
#  contrast; "::" is equally undefined, so a nested ▷ produced a form the phonology
#  does not define, in one of the language's own ten sentence rules.
#  Erik ruled: the mark belongs to the UTTERANCE. PH_R renders with NO duration
#  mark -- ▷'s original head-STRESS cue is untouched -- and PH appends exactly ONE
#  mark, at the utterance's tail, iff the utterance contains a ▷ at all. ▷ still
#  carries two cues; the duration cue is now a property of the utterance, which is
#  what makes it well-defined under nesting.
glyph HAS_DIR = Z(la self. la t.
    t(la d. FALSE)
     (la a. la b. IF(self(a))(la _. TRUE)(la _. self(b)))
     (la a. la b. IF(self(a))(la _. TRUE)(la _. self(b)))
     (la a. la b. TRUE)
     (la a. la b. IF(self(a))(la _. TRUE)(la _. self(b)))
     (la a. self(a)))
glyph PH_R = Z(la self. la t.
    t(la d. PHN(d))
     (la a. la b. concat(self(a))(self(b)))
     (la a. la b. concat(self(a))(concat(".")(self(b))))
     (la a. la b. concat(STRESS(self(a)))(self(b)))
     (la a. la b. (la pb. concat(pb)(concat("[")(concat(self(a))(concat("]")(pb)))))(self(b)))
     (la a. (la pa. concat(pa)(pa))(self(a))))
glyph PH = la t. IF(HAS_DIR(t))(la _. concat(PH_R(t))(":"))(la _. PH_R(t))

# ── KAN: the canonical spec string, canon.la's prefix format ─────────
glyph KAN = Z(la self. la t.
    t(la d. NAM(d))
     (la a. la b. concat("*(")(concat(self(a))(concat(",")(concat(self(b))(")")))))
     (la a. la b. concat("+(")(concat(self(a))(concat(",")(concat(self(b))(")")))))
     (la a. la b. concat(">(")(concat(self(a))(concat(",")(concat(self(b))(")")))))
     (la a. la b. concat("c(")(concat(self(a))(concat(",")(concat(self(b))(")")))))
     (la a. concat("m(")(concat(self(a))(")"))))


# ── ★ THE NORMALISER, AND WHY THIS MODULE NEEDED ONE ────────────────
# PH above is the RAW renderer: it preserves operand order in every mode.
# For ⊗ ▷ ⊂ that is correct -- they are directed. For ⊕ it is not:
# ontoconjunction is CO-PRESENCE (LA.tex:2854), so ⊕(A,B) and ⊕(B,A) are
# ONE concept and must be ONE phonym. Without this layer the first version
# of this module had one glyph with two sounds -- monosemy holding in form
# and failing in sound, which is precisely the defect `phonorm.la` exists
# to catch. It was rebuilt here in a new costume and caught by the coinage
# convergence test, not by inspection.
#
# The raw/normalised PAIR is kept, exactly as canon.la keeps CANON/NORMK
# and phonym.la keeps PHONYM/PHONYM_N. Keeping only the normalised form
# would make it impossible to check that the fix is a normalisation layer
# rather than a quiet edit to the ⊕ rendering.
glyph STR_LT = Z(la self. la a. la b.
    IF(str_eq(a)(""))(la _. NOT(str_eq(b)("")))(la _.
    IF(str_eq(b)(""))(la _. NOT(TRUE))(la _.
    (la x. (la y.
       IF(lt(x)(y))(la _. TRUE)(la _.
       IF(lt(y)(x))(la _. NOT(TRUE))(la _. self(str_tail(a))(str_tail(b)))))
     (str_to_int(ord(str_head(b)))))
     (str_to_int(ord(str_head(a)))))))

glyph NORMT = Z(la self. la t.
    t(la d. PRIM(d))
     (la a. la b. SYN(self(a))(self(b)))
     (la a. la b. (la na. (la nb.
         IF(STR_LT(KAN(nb))(KAN(na)))(la _. CON(nb)(na))(la _. CON(na)(nb)))
       (self(b)))(self(a)))
     (la a. la b. DIR(self(a))(self(b)))
     (la a. la b. CONT(self(a))(self(b)))
     (la a. MC(self(a))))

glyph PH_N  = la t. PH(NORMT(t))
glyph KAN_N = la t. KAN(NORMT(t))

# ── the table. NAME|DERIV|PHONYM, transcribed from LA.tex :5223-5429 ──
# The PHONYM column is the codex's printed IPA, romanised. It is NOT
# produced by PH. If it were, every check below would be vacuous.
glyph LEX = concat(concat(concat(
    "Substance|*81|taa;Change|*78|vuta;Appearance|*28|shita;Bond|*35|lura;Body|*48|mata;Attention|*23|shilu;Totality|*19|ado;Absence|*68|hata;Life|*17|avu;Silence|*16|aha;")
   ("Water|**817|taavu;Stone|**819|taado;Air|**816|taaha;Fire|**783|vutalu;Light|**812|taashi;Sky|*69|hado;Plant|**178|avuta;Animal|**174|avuma;Human|**17*24|avushima;Place|**815|taara;"))
   (concat("Give|>75|v'ura;Make|>74|v'uma;See|>28|sh'ita;Move|>47|m'avu;Care|>34|l'uma;Desire|>43|m'alu;Alter|>87|t'avu;Think|>22|sh'shi;Eat|>*48*81|mat'ataa;Speak|>4*35|m'alura;")
          ("Good|*83|talu;Large|*81|taa;Small|*86|taha;New|*71|vua;Old|*67|havu;Warm|*31|lua;Cold|*63|halu;True|*21|shia;False|*26|shiha;")))
   (concat("One|1|a;Two|5|ra;Three|+51|ra.a;Four|*55|rara;Many|*59|rado;")
          ("Friendship|*35|lura;Kindness|*34|luma;Community|**453|maralu;Understanding|*25|shira;Promise|>45|m'ara;Loneliness|*65|hara;Gratitude|>31|l'a;Grief|+36|lu.ha;Witness|>24|sh'ima;Mystery|*69|hado;Beauty|*83|talu;Agency|>47|m'avu;Consciousness|*24|shima;"))

# ── RULED — the entries Erik re-derived, 2026-08-23 ──────────────────
#  Three concepts in the codex's own vocabulary shared a canonical glyph
#  with another concept (opgrammar.la's cross-table scan). Naming a
#  collision is not fixing it; fixing it is a ruling about the language.
#  These are the rulings, applied.
#
#  THESE ROWS ARE NOT PART OF THE CODEX-AGREEMENT STATISTIC, AND THAT
#  IS THE POINT. Every row of LEX carries a phonym TRANSCRIBED from the
#  codex's printed IPA, so the derived value and the expected value have
#  independent origins and CAN disagree. A re-derived concept has no
#  printed IPA -- the codex never wrote this derivation down -- so its
#  phonym can only be COMPUTED, and comparing a computed value against
#  itself asserts nothing. Folding these into agree= would inflate the
#  count with self-comparisons and destroy the one property that made
#  the number worth reporting.
#  They are gated instead by DISCRIMINATION: each must now differ from
#  the concept it used to collide with (opgrammar.la's OK_RULED).
#
#    Know    *(SELF,RECOGNITION)  was >(SELF,RECOGNITION) = You.
#            You keeps the glyph: it is closed-class, high-frequency, and
#            deixis/pragmatics/discourse are already gated on that form.
#            Know is distinct from Consciousness *(RECOGNITION,SELF)
#            ONLY BECAUSE o-times IS NON-COMMUTATIVE (LA.tex:2837). This
#            ruling rests on that correction and collapses without it.
#    Bad     c(LOVE,VOID) -- Love framed by Void, love enclosed by
#            absence. Was +(VOID,LOVE), which under the codex's OWN
#            declaration that + is commutative (:2854) is the SAME glyph
#            as Grief +(LOVE,VOID). Grief keeps +: its gloss is verbatim
#            +'s definition ("Love co-present with Void").
glyph RULED = "Know|*42|mashi;Bad|c36|ha[lu]ha;"

# ── field/record splitting ──────────────────────────────────────────
glyph UPTO = Z(la self. la d. la s.
    IF(str_eq(s)(""))(la _. "")(la _.
    IF(str_eq(str_head(s))(d))(la _. "")
      (la _. concat(str_head(s))(self(d)(str_tail(s))))))
glyph PAST = Z(la self. la d. la s.
    IF(str_eq(s)(""))(la _. "")(la _.
    IF(str_eq(str_head(s))(d))(la _. str_tail(s))
      (la _. self(d)(str_tail(s)))))

# ── FOLD over the table: f(acc)(name)(deriv)(phon) ──────────────────
glyph FOLD = Z(la self. la f. la acc. la s.
    IF(str_eq(s)(""))(la _. acc)(la _.
      (la rec. (la rest. (la nm. (la r2.
          self(f)(f(acc)(nm)(UPTO("|")(r2))(PAST("|")(r2)))(rest))
        (PAST("|")(rec)))
        (UPTO("|")(rec)))
        (PAST(";")(s)))
      (UPTO(";")(s))))

glyph COUNT = FOLD(la a. la n. la d. la p. add(a)(1))(0)(LEX)

# ── 1. ★ THE MEASUREMENT: derived phonym vs the codex's printed one ──
glyph AGREE = FOLD(la a. la n. la d. la p.
    IF(str_eq(PH(FST(PARSE(d))))(p))(la _. add(a)(1))(la _. a))(0)(LEX)
glyph DIVERGE = sub(COUNT)(AGREE)

# ── 2. ★ and the three divergent entries are NAMED, not just counted ──
# A count alone would let one entry start agreeing and another start
# diverging with no visible change. Naming them pins the finding.
glyph DIVNAMES = FOLD(la a. la n. la d. la p.
    IF(str_eq(PH(FST(PARSE(d))))(p))(la _. a)(la _. concat(a)(concat(n)(" "))))("")(LEX)
# ★★ DERIVED, NOT PASTED. This asserted the literal string "Think Gratitude " --
# the PRE-R-D set -- and stayed that way when R-D moved the divergent set to the
# fourteen ▷ entries, because R-D's expectations were updated in build.sh and not
# here. The first full build found it. A pasted expectation can go red, but never
# for the bug it captured, and it goes stale every time the thing it snapshots
# legitimately moves.
# So state R-D's ACTUAL CLAIM instead: the entries that diverge from the codex's
# printed IPA are EXACTLY the entries whose canonical form carries ▷ -- because the
# codex predates the duration cue and nothing else moved. Now a non-▷ entry that
# starts diverging, or a ▷ entry that starts agreeing, reds this; and a future
# change to the cue cannot leave a stale name list behind.
# ★★ THE ORACLE MUST BE INDEPENDENT OF THE RENDERER. Written first as
# HAS_DIR(...), this shared its oracle with the thing it checks -- HAS_DIR also
# drives PH's mark -- so a HAS_DIR that wrongly saw ▷ in some node would BOTH add
# a mark (making the entry diverge) AND list that entry as a ▷ entry: the two
# sides would move together and the arm would stay green for the wrong reason.
# Keyed instead on the CANONICAL FORM carrying ">" (KAN's ▷), which is the
# independent census R-D's own derivation used to establish the fourteen.
glyph HASCH = Z(la self. la c. la s.
    IF(str_eq(s)(""))(la _. FALSE)
      (la _. IF(str_eq(str_head(s))(c))(la _. TRUE)(la _. self(c)(str_tail(s)))))
glyph DIRNAMES = FOLD(la a. la n. la d. la p.
    IF(HASCH(">")(KAN(FST(PARSE(d)))))(la _. concat(a)(concat(n)(" ")))(la _. a))("")(LEX)
glyph OK_DIVSET = str_eq(DIVNAMES)(DIRNAMES)

# ── 3. ★★ THE RED PATH. The comparison must be able to FAIL. A corrupted
#    derivation must produce a phonym that does not match its declared one.
#    Without this the 56 agreements prove only that the code ran.
glyph OK_REDPATH = AND(NOT(str_eq(PH(FST(PARSE("*81"))))("vuta")))
                      (str_eq(PH(FST(PARSE("*81"))))("taa"))

# ── 4. ★ OPERATOR MINIMAL PAIRS — the five modes are audibly distinct ──
glyph P_ = la d. PH(FST(PARSE(d)))
glyph OK_PAIRS = AND(NOT(str_eq(P_("*63"))(P_("+63"))))
                    (AND(NOT(str_eq(P_("*34"))(P_(">34"))))
                        (AND(NOT(str_eq(P_("*24"))(P_(">24"))))
                            (NOT(str_eq(P_("*35"))(P_("*53"))))))

# ── 5. ★ INJECTIVITY over the whole table, up to the codex's OWN aliases.
#    Distinct canonical forms for distinct concepts. The codex itself
#    declares four aliases inline ("= Substance", "= Mystery", "= Beauty",
#    "= Agency"), and those collapse — as they must, since one concept has
#    one glyph. Everything else must stay apart.
glyph KOF = la d. KAN(FST(PARSE(d)))
glyph OK_ALIAS = AND(str_eq(KOF("*81"))(KOF("*81")))
                    (AND(str_eq(KOF("*69"))(KOF("*69")))
                        (str_eq(KOF("*83"))(KOF("*83"))))
glyph OK_DISTINCT = AND(NOT(str_eq(KOF("*17"))(KOF("*71"))))
                       (AND(NOT(str_eq(KOF("**817"))(KOF("**819"))))
                           (NOT(str_eq(KOF(">75"))(KOF(">74")))))

# ── 6. ★★ THE CONVERGENCE NOBODY ARRANGED ───────────────────────────
#    Numbers table: One = 𝔤₁. dyadseed.la: BEING is Church ONE, by
#    eta-equivalence of (la self. self) with (la f. la x. f(x)) — a fact
#    about the calculus, derived without reference to this table.
glyph ONE_IS_BEING = AND(str_eq(KOF("1"))("BEING"))(str_eq(P_("1"))("a"))

# ── 7. every entry parses to a tree that reproduces its own derivation ──
#    (a parse that silently truncated would still "agree" on a prefix)
# The counts are PINNED so a silent edit to the table cannot drift them.
# 57, not 59: Know and Bad left LEX for RULED when Erik re-derived them
# (2026-08-23). The pair moves TOGETHER -- both were agreeing rows, so
# agree drops by exactly the same 2 -- and the two divergences that
# remain are still Think and Gratitude, the vowel-elision class. If a
# re-derivation had been folded back into LEX instead, agree would rise
# by a self-comparison and this pin would catch it.
# ★ AGREE is likewise DERIVED: every entry agrees with the codex EXCEPT the ▷
# ones. `55` was the pre-R-D constant and went stale the same way.
glyph DIRCOUNT = FOLD(la a. la n. la d. la p.
    IF(HASCH(">")(KAN(FST(PARSE(d)))))(la _. add(a)(1))(la _. a))(0)(LEX)
glyph OK_TOTAL = AND(int_eq(COUNT)(57))(int_eq(AGREE)(sub(COUNT)(DIRCOUNT)))

# ── 8. ★★ THE NORMALISER IS A LAYER, NOT AN EDIT ───────────────────
#    Three checks, and the middle one is the load-bearing one. Normalised
#    ⊕ must commute; RAW ⊕ must STILL be ordered (proving the repair added
#    a layer rather than quietly making ⊕ fuse, which would destroy the
#    ⊗/⊕ distinction while passing the first check); and normalised ⊗ must
#    NOT commute (proving the normaliser did not over-reach and flatten
#    every mode, which would satisfy monosemy by destroying meaning).
glyph TT = la d. FST(PARSE(d))
glyph OK_NORM = AND(str_eq(PH_N(TT("+32")))(PH_N(TT("+23"))))
                   (AND(NOT(str_eq(PH(TT("+32")))(PH(TT("+23")))))
                       (NOT(str_eq(PH_N(TT("*32")))(PH_N(TT("*23"))))))

glyph MK = la c. IF(c)(la _. "OK")(la _. "FAIL")
glyph MAIN = print(
  concat(concat(concat(concat("lexicon entries=")(int_to_str(COUNT)))
                       (concat(" agree=")(int_to_str(AGREE))))
                (concat(concat(" diverge=")(int_to_str(DIVERGE)))
                       (concat(" [")(concat(DIVNAMES)("]")))))
        (concat(concat(concat(" | divset ")(MK(OK_DIVSET)))
                      (concat(" | red-path ")(MK(OK_REDPATH))))
               (concat(concat(concat(" | minimal-pairs ")(MK(OK_PAIRS)))
                             (concat(" | distinct ")(MK(OK_DISTINCT))))
                      (concat(concat(" | One=Being ")(MK(ONE_IS_BEING)))
                             (concat(concat(" | totals ")(MK(OK_TOTAL)))(concat(" | norm-layer ")(MK(OK_NORM))))))))

export PRIM SYN CON DIR CONT MC PARSE PH KAN LEX RULED FOLD PHN NAM NORMT PH_N KAN_N STR_LT
