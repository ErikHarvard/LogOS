# =====================================================================
#  ata_ctrl.la — RED-PATH CONTROL for HAL.3c. Do not "fix" this file.
#
#  This is kernel/ata.la as it stood BEFORE the bounded wait (2026-08-18),
#  kept verbatim so gate_hal3c.sh can prove the bound is load-bearing. Its
#  WAITDRQ has no fuel: on a channel that never becomes ready it recurses
#  until it runs off into unmapped memory and the kernel dies with
#  EXCEPTION 0d, no diagnosis naming the disk.
#
#  A gate that only shows the FIXED driver behaving well cannot tell you the
#  fix did anything. This control is what makes the assertion discriminate.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

# issue a single-sector READ (cmd 0x20) of a 28-bit LBA on the primary master
glyph ISSUE = la lba.
    SEQ(outb(502)(add(224)(mod(div(lba)(16777216))(16))))    # drive/head: 0xE0 | LBA[27:24]
    (SEQ(outb(498)(1))                                        # sector count = 1
    (SEQ(outb(499)(mod(lba)(256)))                            # LBA[7:0]
    (SEQ(outb(500)(mod(div(lba)(256))(256)))                 # LBA[15:8]
    (SEQ(outb(501)(mod(div(lba)(65536))(256)))               # LBA[23:16]
    (outb(503)(32))))))                                       # command: READ SECTORS

# spin on the status port until BSY clears and DRQ sets (data ready)
glyph WAITDRQ = Z(la self. la _.
    (la st.
      IF(int_eq(mod(div(st)(128))(2))(1))(la _. self("!"))       # BSY set -> keep waiting
      (la _. IF(int_eq(mod(div(st)(8))(2))(1))(la _. "!")        # DRQ set -> ready
             (la _. self("!"))))                                  # neither -> keep waiting
    (inb(503)))

# a 32-bit data word -> its 4 bytes as a string, disk order (little-endian)
glyph B4 = la v.
    concat(chr(int_to_str(mod(v)(256))))
    (concat(chr(int_to_str(mod(div(v)(256))(256))))
    (concat(chr(int_to_str(mod(div(v)(65536))(256))))
            (chr(int_to_str(mod(div(v)(16777216))(256))))))

# drain 128 dwords (= 512 bytes = one sector) from the data port, accumulating
glyph READSEC = Z(la self. la n. la acc.
    IF(int_eq(n)(0))(la _. acc)(la _.
      self(sub(n)(1))(concat(acc)(B4(inl(496))))))

glyph MAIN =
    SEQ(print("ata:"))
    (SEQ(ISSUE(1))                       # read LBA 1
    (SEQ(WAITDRQ("!"))                   # wait for the sector to be ready
    (SEQ(print(READSEC(128)("")))        # read + reconstruct 512 bytes, echo
    (print("ata done")))))
