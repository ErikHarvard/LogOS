# =====================================================================
#  LogOS HAL.4f — A TYPEWRITER ON THE METAL, in LA.
#
#  HAL.4e rastered a FIXED string ("LOGOS") into a window and moved it with the
#  keyboard. The roadmap calls that "the foundation of a terminal" — but a
#  terminal is one you can TYPE INTO. HAL.4f is that step: a scancode becomes a
#  CHARACTER, the character is appended to a live buffer, and the buffer is
#  re-rastered into the window every keystroke, with a cursor after the last
#  character.
#
#    poll a key -> scancode -> ASCII -> append to buffer -> recompose -> present,
#    forever, until ENTER.
#
#  Everything below the input decode is HAL.4e's, verbatim and deliberately so:
#  SETMODE, RECT, BLOCK, the flat-index glyph walk, SCENE, PRESENT = one memcpy,
#  PIX, and HAL.2's polling i8042 reader. What is NEW is only KEYCH (the SET-1
#  scancode -> character map) and DRAWS (draw N chars of a RUNTIME string, where
#  HAL.4e's DRAWT drew a compile-time constant).
#
#  DELIBERATELY FLAT + IMPORT-FREE, like every kernel driver here, and the
#  keymap is packed as ONE flat string for the same reason FONTSTR is: a string
#  literal lowers to a single instruction, so a 58-entry table costs nothing to
#  compile, where a nested assoc-list would be pathological.
#
#  WHAT THIS DOES NOT DO (named, so silence is not read as a claim):
#    - NO SHIFT, so no lower case and no symbols. The font has only A-Z, 0-9 and
#      space, so shift would have nothing to render; the keymap is upper-case.
#    - NO BACKSPACE. Scancode 14 is mapped to the ignore character. Deleting
#      needs a take-n-1 rebuild of the buffer, which is a real O(n) walk this
#      slice does not carry.
#    - NO SCROLLING and NO WRAP. The buffer is capped at MAXCH and further input
#      is DISCARDED, not wrapped — a 200px-wide window fits 7 cells at SCALE 3.
#    - NO WINDOW MOVEMENT. HAL.4e owns that (WASD now types letters instead, so
#      the two cannot coexist in one program). comp_text.la remains the movable
#      -window gate; this is the typing one.
#    - The window does NOT scroll off, so the cursor is the only affordance.
#
#  The witness the gate reads is the SERIAL line, and it is load-bearing in both
#  directions, exactly as HAL.4e's is:
#    - "term buf=LOGOS" — the buffer really accumulated the typed characters
#      (a decode that dropped or duplicated keys shows a different string);
#    - (201,141) is 'L' row 0 col 0 -> must be WHITE (the char really rastered)
#    - (222,141) is 'L' row 0 col 7 -> must be GREEN (window B showing through
#      INSIDE the same cell, so what drew is a GLYPH SHAPE, not a filled block)
#  Either probe alone is passable by a broken renderer — a dead draw leaves both
#  green, a runaway fill leaves both white. The PAIR is what pins it.
#  ENTER ends the loop; MAIN returns; exit(0) -> isa-debug-exit -> QEMU exit 33.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b
glyph FALSE = la t. la f. f
glyph AND   = la a. la b. a(b)(FALSE)

# XRGB8888 little-endian: a dword lays bytes B,G,R,X = V&255, V>>8, V>>16
glyph DESK = 128                 # desktop  B=128  (dim blue)
glyph WINA = 16711680            # window A R=255  (red)
glyph WINB = 65280               # window B G=255  (green)
glyph FG   = 16777215            # text     B=G=R=255 (white)

glyph BB   = 268435456           # 0x10000000 — backbuffer in plain RAM
glyph SH   = 480                 # screen height

# window A is the occlusion reference; window B holds the text and is FIXED
# (HAL.4e moved it; here the keys type instead).
glyph AX = 80
glyph AY = 60
glyph WW = 200
glyph WH = 150
glyph BX = 180
glyph BY = 120

# ── the text buffer living inside window B ──
glyph FW    = 8                  # font cell width
glyph FH    = 8                  # font cell height
glyph SCALE = 3                  # each font pixel -> a SCALE x SCALE block
glyph TXTOX = 20                 # text origin, RELATIVE to the window
glyph TXTOY = 20
glyph MAXCH = 7                  # (WW - TXTOX) / (FW*SCALE) = 180/24 = 7 cells

# probes: 'L' row 0 is 15 = cols 0..3 set, col 7 clear (bit 0 = leftmost)
glyph PONX = 201                 # BX+TXTOX + (0*8+0)*SCALE + 1  -> on  a stroke
glyph PONY = 141                 # BY+TXTOY + 0*SCALE + 1
glyph POFFX = 222                # BX+TXTOX + (0*8+7)*SCALE + 1  -> off a stroke
glyph POFFY = 141

# ── PCI config read: reg at (bus 0, dev, off) via 0xCF8/0xCFC ──
glyph CFG = la dev. la off.
    SEQ(outl(3320)(add(add(2147483648)(mul(dev)(2048)))(off)))
       (inl(3324))
glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 0)(la _.
      IF(int_eq(CFG(dev)(0))(286331444))(la _. dev)(la _.
        self(add(dev)(1)))))

# ── Bochs VBE dispi (index 0x1CE=462, data 0x1CF=463) ──
glyph DISPI  = la idx. la val. SEQ(outw(462)(idx))(outw(463)(val))
glyph RDISPI = la idx. SEQ(outw(462)(idx))(inw(463))
glyph SETMODE =
    SEQ(DISPI(4)(0))          # disable while configuring
    (SEQ(DISPI(1)(640))       # XRES
    (SEQ(DISPI(2)(480))       # YRES
    (SEQ(DISPI(3)(32))        # BPP
    (DISPI(4)(65)))))         # ENABLE = enabled | LFB

# ── font plumbing, lifted verbatim from theourgia_font.la ──
glyph DROP = Z(la self. la n. la s. IF(int_eq(n)(0))(la _. s)(la _.
    self(sub(n)(1))(str_tail(s))))
glyph BYTE_AT = la s. la i. str_head(DROP(i)(s))
glyph ORDI    = la c. str_to_int(ord(c))
glyph BYTES_GO = Z(la self. la rest. la tok.
    IF(str_eq(rest)(""))(la _.
        IF(str_eq(tok)(""))(la _. "")(la _. chr(tok)))
    (la _.
    IF(str_eq(str_head(rest))(" "))(la _.
        IF(str_eq(tok)(""))(la _. self(str_tail(rest))(""))
            (la _. concat(chr(tok))(self(str_tail(rest))(""))))
    (la _. self(str_tail(rest))(concat(tok)(str_head(rest))))))
glyph BYTES = la s. BYTES_GO(s)("")

# The font: 37 glyphs x 8 rows, packed in INDEX order (space, A-Z, 0-9). Decoded
# ONCE in MAIN and threaded as a parameter — a `glyph FONT = BYTES(...)` would
# re-decode 296 bytes on every lookup.
glyph INDEX = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
glyph FONTSTR = "0 0 0 0 0 0 0 0 12 30 51 51 63 51 51 0 63 102 102 62 102 102 63 0 60 102 3 3 3 102 60 0 31 54 102 102 102 54 31 0 127 70 22 30 22 70 127 0 127 70 22 30 22 6 15 0 60 102 3 3 115 102 124 0 51 51 51 63 51 51 51 0 30 12 12 12 12 12 30 0 120 48 48 48 51 51 30 0 103 102 54 30 54 102 103 0 15 6 6 6 70 102 127 0 99 119 127 127 107 99 99 0 99 103 111 123 115 99 99 0 28 54 99 99 99 54 28 0 63 102 102 62 6 6 15 0 30 51 51 51 59 30 56 0 63 102 102 62 54 102 103 0 30 51 7 14 56 51 30 0 63 12 12 12 12 12 12 0 51 51 51 51 51 51 63 0 51 51 51 51 51 30 12 0 99 99 99 107 127 119 99 0 99 99 54 28 28 54 99 0 51 51 51 30 12 12 30 0 127 99 49 24 76 102 127 0 62 99 115 123 111 103 62 0 12 14 12 12 12 12 63 0 30 51 48 28 6 51 63 0 30 51 48 28 48 51 30 0 56 60 54 51 127 48 120 0 63 3 31 48 48 51 30 0 28 6 3 31 51 51 30 0 127 51 48 24 12 12 12 0 30 51 51 30 51 51 30 0 30 51 51 62 48 24 14 0"
glyph INDEXOF = Z(la self. la s. la c. la i.
    IF(str_eq(s)(""))(la _. 0)(la _.
    IF(str_eq(str_head(s))(c))(la _. i)(la _. self(str_tail(s))(c)(add(i)(1)))))
glyph GLYPH_INDEX = la c. INDEXOF(INDEX)(c)(0)
glyph POW2 = Z(la self. la k. IF(int_eq(k)(0))(la _. 1)(la _. mul(2)(self(sub(k)(1)))))
glyph BITSET = la b. la col. int_eq(mod(div(b)(POW2(col)))(2))(1)

# ── THE KEYMAP: SET-1 make-code -> character, as ONE flat 58-byte string ──
#   Index IS the scancode. '~' means "no character here" (ESC, TAB, CTRL, the
#   shifts, backspace, the bracket/punctuation keys the font cannot render).
#   Index 57 is SPACE, the one non-alphanumeric the font does carry.
#   Layout, for the reader:  2-11 digits | 16-25 QWERTYUIOP | 30-38 ASDFGHJKL
#                            44-50 ZXCVBNM | 57 space
glyph KEYMAP = "~~1234567890~~~~QWERTYUIOP~~~~ASDFGHJKL~~~~~ZXCVBNM~~~~~~ "
glyph KMLEN  = 58
# A RELEASE code is make+0x80 (>=128), and any scancode past the table has no
# character. Both must be rejected BEFORE the lookup: DROP past the end of a
# string returns "", and str_head("") is "", which would append an empty
# character and silently corrupt the buffer length. So the bound is load-bearing,
# not defensive decoration.
glyph KEYCH = la sc.
    IF(lt(sc)(KMLEN))(la _. BYTE_AT(KEYMAP)(sc))(la _. "~")

# ── a surface: one fill() per row (rows contiguous, pitch-strided) ──
glyph RECT = Z(la self. la pitch. la x. la y. la w. la h. la col.
    IF(int_eq(h)(0))(la _. "!")(la _.
      SEQ(fill(add(BB)(add(mul(y)(pitch))(mul(x)(4))))(w)(col))
         (self(pitch)(x)(add(y)(1))(w)(sub(h)(1))(col))))

# ── one scaled font pixel: a SCALE-tall stack of SCALE-wide fills ──
glyph BLOCK = Z(la self. la pitch. la px. la py. la k.
    IF(int_eq(k)(0))(la _. "!")(la _.
      SEQ(fill(add(BB)(add(mul(py)(pitch))(mul(px)(4))))(SCALE)(FG))
         (self(pitch)(px)(add(py)(1))(sub(k)(1)))))

# ── the buffer: ONE flat loop over n*FH*FW pixel-tests ──
#   HAL.4e's DRAWT drew a compile-time constant; DRAWS draws a RUNTIME string,
#   so the character comes from `buf` and the count from `n`. Same single-index
#   walk, because native_codegen3's codegen is superlinear in nesting depth:
#   i -> char div(i)(FH*FW), row mod(div(i)(FW))(FH), col mod(i)(FW)
glyph DRAWS = Z(la self. la font. la pitch. la x. la y. la buf. la n. la i.
    IF(int_eq(i)(mul(n)(mul(FH)(FW))))(la _. "!")(la _.
      (la ci.
        (la rr.
          (la cc.
            (la rb.
              SEQ(IF(BITSET(rb)(cc))
                    (la _. BLOCK(pitch)
                             (add(x)(mul(add(mul(ci)(FW))(cc))(SCALE)))
                             (add(y)(mul(rr)(SCALE)))
                             (SCALE))
                    (la _. "!"))
                 (self(font)(pitch)(x)(y)(buf)(n)(add(i)(1))))
            (ORDI(BYTE_AT(font)(add(mul(GLYPH_INDEX(BYTE_AT(buf)(ci)))(FH))(rr)))))
          (mod(i)(FW)))
        (mod(div(i)(FW))(FH)))
      (div(i)(mul(FH)(FW)))))

# ── the cursor: a solid bar under the next cell, so the caret is visible even
#    when the buffer is empty (an empty window would otherwise look dead) ──
glyph CURSOR = la pitch. la x. la y. la n.
    BLOCK(pitch)(add(x)(mul(mul(n)(FW))(SCALE)))(add(y)(mul(FH)(SCALE)))(SCALE)

# ── compose the whole frame off-screen: desktop, A, B ON TOP, then B's TEXT ──
#   Paint order IS z-order; the text is laid last, so it sits ON its window.
glyph SCENE = la font. la pitch. la buf. la n.
    SEQ(fill(BB)(mul(SH)(div(pitch)(4)))(DESK))
    (SEQ(RECT(pitch)(AX)(AY)(WW)(WH)(WINA))
    (SEQ(RECT(pitch)(BX)(BY)(WW)(WH)(WINB))
    (SEQ(DRAWS(font)(pitch)(add(BX)(TXTOX))(add(BY)(TXTOY))(buf)(n)(0))
        (CURSOR(pitch)(add(BX)(TXTOX))(add(BY)(TXTOY))(n)))))

# ── present: the ENTIRE composed frame to the LFB in ONE memcpy ──
glyph PRESENT = la base. la pitch. memcpy(base)(BB)(mul(SH)(pitch))

# ── read a pixel back out of the LFB as "B,G,R" ──
glyph PIX = la base. la pitch. la x. la y.
    (la p. concat(concat(concat(concat(int_to_str(peek(p)))(","))
                              (int_to_str(peek(add(p)(1)))))(","))
                 (int_to_str(peek(add(p)(2)))))
    (add(base)(add(mul(y)(pitch))(mul(x)(4))))

# ── the two-directional glyph witness: ON a stroke, and OFF one ──
glyph TWIT = la base. la pitch.
    SEQ(print(concat("term on=")(PIX(base)(pitch)(PONX)(PONY))))
       (print(concat("term off=")(PIX(base)(pitch)(POFFX)(POFFY))))

# ── i8042 polling keyboard (HAL.2): read one SET-1 scancode ──
glyph OBF    = la st. int_eq(mod(st)(2))(1)             # bit 0: output buffer full
glyph NOTAUX = la st. int_eq(mod(div(st)(32))(2))(0)    # bit 5 clear: not the mouse
glyph READY  = la st. AND(OBF(st))(NOTAUX(st))
glyph POLL = Z(la self. la _.
    (la st. IF(READY(st))(la _. inb(96))(la _. self("!")))
      (inb(100)))

# ── the inner loop: poll -> append -> recompose -> present, until ENTER ──
#   A key that maps to '~' (release code, modifier, unrenderable) and a buffer
#   already at MAXCH both leave the buffer UNCHANGED and skip the frame, so a
#   held key does not spin the compositor.
glyph LOOP = Z(la self. la font. la base. la pitch. la buf. la n.
    (la sc.
      IF(int_eq(sc)(28))
        (la _. print("term done"))                  # ENTER: leave the loop
        (la _.
          (la c.
            IF(str_eq(c)("~"))
              (la _. self(font)(base)(pitch)(buf)(n))      # no character: ignore
              (la _.
              IF(int_eq(n)(MAXCH))
                (la _. self(font)(base)(pitch)(buf)(n))    # full: discard
                (la _.
                (la nbuf.
                  (la nn.
                    SEQ(SCENE(font)(pitch)(nbuf)(nn))(
                    SEQ(PRESENT(base)(pitch))(
                    SEQ(print(concat("term buf=")(nbuf)))(
                    SEQ(TWIT(base)(pitch))(
                    self(font)(base)(pitch)(nbuf)(nn))))))
                  (add(n)(1)))
                 (concat(buf)(c))))))
            (KEYCH(sc)))
      (POLL("!")))

glyph MAIN =
    (la font.
      (la dev.
        (la bar.
          (la base.
            SEQ(SETMODE)
            ((la pitch.
                SEQ(print(concat(concat("term lfb=")(int_to_str(base)))(concat(" pitch=")(int_to_str(pitch)))))
                (SEQ(SCENE(font)(pitch)("")(0))          # initial frame: empty buffer + cursor
                (SEQ(PRESENT(base)(pitch))
                (SEQ(print("term ready"))
                (LOOP(font)(base)(pitch)("")(0))))))
             (mul(RDISPI(6))(4))))         # pitch = VIRT_WIDTH * 4 bytes
          (sub(bar)(mod(bar)(16))))         # LFB base = BAR0 & ~0xF
        (CFG(dev)(16)))                     # BAR0
      (FIND(0)))
    (BYTES(FONTSTR))
