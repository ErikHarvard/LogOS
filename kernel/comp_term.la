# =====================================================================
#  LogOS HAL.4e — A TERMINAL WINDOW IN THE COMPOSITOR, on the metal, in LA.
#
#  HAL.4d drove the compositor's inner loop with the keyboard and MOVED a
#  window. This puts TEXT inside one: a character grid you type into, at ring 0,
#  with real glyphs rastered from the 8x8 bitmap font.
#
#    poll a key -> decode SET-1 -> raster the glyph into the backbuffer at the
#    cursor cell -> present -> advance the cursor. ESC ends the session.
#
#  ── WHY IT DRAWS INCREMENTALLY ──────────────────────────────────────
#  The window chrome is composed ONCE. Each keystroke then rasters exactly one
#  8x8 cell and presents. It does NOT re-render the whole text buffer per key:
#  that would be O(chars) work per keystroke, and at 64 pixel-tests per glyph
#  the loop would visibly stall after a line or two. Drawing the delta is both
#  cheaper and what a real terminal does.
#
#  ── FLAT AND IMPORT-FREE, like comp.la / comp_session.la ────────────
#  The font is INLINED rather than imported from theourgia_font.la. Kernel-side
#  modules stay flat because the import-mangler makes codegen of a deeply-nested
#  importer pathologically slow (theourgia_font.la's own header records this).
#  FONTDATA below is byte-identical to that module's; if one changes the other
#  must, and this comment is the only thing binding them -- a known duplicate,
#  stated rather than hidden.
#
#  ── THE WITNESS ─────────────────────────────────────────────────────
#  Serial, per keystroke: the decoded character, the cursor cell it landed in,
#  and a PIX read of a pixel INSIDE that cell taken back out of the LFB. The
#  pixel proves a glyph was actually rastered and presented, not merely that the
#  cursor advanced. ESC prints the final cursor and exits 0 -> QEMU exit 33.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b
# ── ★ SEQT — SEQUENCING THAT IS ACTUALLY A TAIL CALL ─────────────────
# SEQ(effect)(rest) READS as "do the effect, then continue" and is NOT a tail
# call: the language is call-by-value, so `rest` is evaluated AS AN ARGUMENT,
# before SEQ is ever applied. Any recursion inside `rest` therefore runs with
# every enclosing SEQ frame still live, and the dump grows per iteration.
#
# This loop had a four-deep SEQ chain per keystroke with the recursive call in
# the innermost argument. It rendered five glyphs and a newline correctly and
# then #GP'd at the top of the VM region on roughly the seventh input --
# ~6 frames, which is exactly what the nesting predicts.
#
# SEQT takes its continuation as a THUNK, so the recursion is never an
# argument: `k("!")` is an application in tail position, which the VM's TCO
# reuses the frame for. secd.asm already runs bounded-depth iteration
# indefinitely when the call is genuinely tail; the loop was not using it.
#
# ★ The defect is not that SEQ is wrong -- SEQ is correct for sequencing two
# VALUES. It is that "reads like a tail call" and "is a tail call" came apart,
# and nothing in the syntax marks the difference. That is the same trap as an
# AND that reads like a short-circuit and evaluates both arms.
glyph SEQT = la a. la k. k("!")
glyph TRUE  = la t. la f. t
glyph FALSE = la t. la f. f
glyph AND   = la a. la b. a(b)(FALSE)
glyph NOT   = la c. c(FALSE)(TRUE)

# ── palette: XRGB8888 little-endian, a dword lays B,G,R,X ──
glyph DESK  = 128                # dim blue desktop
glyph FRAME = 8421504            # grey window frame
glyph TITLE = 12582912           # dark red title bar
glyph PAPER = 2105376            # near-black terminal ground
glyph TEXTC = 3394611            # green-white glyph colour

glyph BB = 268435456             # 0x10000000 backbuffer, plain RAM
glyph SH = 480

# ── the terminal window ──
glyph TX = 64                    # window origin
glyph TY = 48
glyph TW = 512                   # 64 columns of 8px
glyph TH = 344                   # title(16) + 40 rows... clamped below
glyph BORD = 2
glyph TITH = 16
glyph COLS = 62
glyph ROWS = 38
glyph CX0 = 72                   # text origin = TX + BORD + 6
glyph CY0 = 70                   # TY + TITH + BORD + 4

# ── PCI config read at (bus 0, dev, off) via 0xCF8/0xCFC ──
glyph CFG = la dev. la off.
    SEQ(outl(3320)(add(add(2147483648)(mul(dev)(2048)))(off)))
       (inl(3324))
glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 0)(la _.
      IF(int_eq(CFG(dev)(0))(286331444))(la _. dev)(la _.
        self(add(dev)(1)))))

# ── Bochs VBE dispi ──
glyph DISPI  = la idx. la val. SEQ(outw(462)(idx))(outw(463)(val))
glyph RDISPI = la idx. SEQ(outw(462)(idx))(inw(463))
glyph SETMODE =
    SEQ(DISPI(4)(0))
    (SEQ(DISPI(1)(640))
    (SEQ(DISPI(2)(480))
    (SEQ(DISPI(3)(32))
    (DISPI(4)(65)))))

# ── one filled rectangle, a fill() per row ──
glyph RECT = Z(la self. la pitch. la x. la y. la w. la h. la col.
    IF(int_eq(h)(0))(la _. "!")(la _.
      SEQ(fill(add(BB)(add(mul(y)(pitch))(mul(x)(4))))(w)(col))
         (self(pitch)(x)(add(y)(1))(w)(sub(h)(1))(col))))

# ── the font: 37 glyphs x 8 rows, packed. Byte-identical to theourgia_font.la ──
glyph DROP = Z(la self. la n. la s. IF(int_eq(n)(0))(la _. s)(la _.
    self(sub(n)(1))(str_tail(s))))
glyph BYTE_AT = la s. la i. str_head(DROP(i)(s))
glyph ORDI    = la c. str_to_int(ord(c))
glyph BYTES_GO = Z(la self. la rest. la tok.
    IF(str_eq(rest)(""))(la _.
        IF(str_eq(tok)(""))(la _. "")(la _. chr(tok)))
    (la _.
    IF(str_eq(str_head(rest))(" "))(la _.
        IF(str_eq(tok)(""))(la _. self(str_tail(rest))(""))
            (la _. concat(chr(tok))(self(str_tail(rest))(""))))
    (la _. self(str_tail(rest))(concat(tok)(str_head(rest))))))
glyph BYTES = la s. BYTES_GO(s)("")
glyph FONTDATA = BYTES("0 0 0 0 0 0 0 0 12 30 51 51 63 51 51 0 63 102 102 62 102 102 63 0 60 102 3 3 3 102 60 0 31 54 102 102 102 54 31 0 127 70 22 30 22 70 127 0 127 70 22 30 22 6 15 0 60 102 3 3 115 102 124 0 51 51 51 63 51 51 51 0 30 12 12 12 12 12 30 0 120 48 48 48 51 51 30 0 103 102 54 30 54 102 103 0 15 6 6 6 70 102 127 0 99 119 127 127 107 99 99 0 99 103 111 123 115 99 99 0 28 54 99 99 99 54 28 0 63 102 102 62 6 6 15 0 30 51 51 51 59 30 56 0 63 102 102 62 54 102 103 0 30 51 7 14 56 51 30 0 63 12 12 12 12 12 12 0 51 51 51 51 51 51 63 0 51 51 51 51 51 30 12 0 99 99 99 107 127 119 99 0 99 99 54 28 28 54 99 0 51 51 51 30 12 12 30 0 127 99 49 24 76 102 127 0 62 99 115 123 111 103 62 0 12 14 12 12 12 12 63 0 30 51 48 28 6 51 63 0 30 51 48 28 48 51 30 0 56 60 54 51 127 48 120 0 63 3 31 48 48 51 30 0 28 6 3 31 51 51 30 0 127 51 48 24 12 12 12 0 30 51 51 30 51 51 30 0 30 51 51 62 48 24 14 0")
glyph INDEX = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
glyph INDEXOF = Z(la self. la s. la c. la i.
    IF(str_eq(s)(""))(la _. 0)(la _.
    IF(str_eq(str_head(s))(c))(la _. i)(la _. self(str_tail(s))(c)(add(i)(1)))))
glyph GLYPH_INDEX = la c. INDEXOF(INDEX)(c)(0)
glyph GLYPH_ROW = la c. la r. ORDI(BYTE_AT(FONTDATA)(add(mul(GLYPH_INDEX(c))(8))(r)))
glyph POW2 = Z(la self. la k. IF(int_eq(k)(0))(la _. 1)(la _. mul(2)(self(sub(k)(1)))))
glyph BIT = la b. la col. int_eq(mod(div(b)(POW2(col)))(2))(1)

# ── raster ONE glyph cell at pixel (px,py): 8 rows x 8 columns ──
glyph PUTCOL = Z(la self. la pitch. la px. la py. la rb. la c.
    IF(int_eq(c)(8))(la _. "!")(la _.
      SEQ(IF(BIT(rb)(c))
            (la _. fill(add(BB)(add(mul(py)(pitch))(mul(add(px)(c))(4))))(1)(TEXTC))
            (la _. "!"))
         (self(pitch)(px)(py)(rb)(add(c)(1)))))
glyph PUTROW = Z(la self. la pitch. la px. la py. la ch. la r.
    IF(int_eq(r)(8))(la _. "!")(la _.
      SEQ(PUTCOL(pitch)(px)(add(py)(r))(GLYPH_ROW(ch)(r))(0))
         (self(pitch)(px)(py)(ch)(add(r)(1)))))
# clear the cell first, so overwriting a cell does not leave the old glyph behind
glyph PUTCHAR = la pitch. la col. la row. la ch.
    (la px. (la py.
        SEQ(RECT(pitch)(px)(py)(8)(8)(PAPER))
           (PUTROW(pitch)(px)(py)(ch)(0)))
      (add(CY0)(mul(row)(8))))
    (add(CX0)(mul(col)(8)))

# ── compose the window chrome ONCE: desktop, frame, title bar, paper ──
glyph CHROME = la pitch.
    SEQ(fill(BB)(mul(SH)(div(pitch)(4)))(DESK))
    (SEQ(RECT(pitch)(TX)(TY)(TW)(TH)(FRAME))
    (SEQ(RECT(pitch)(add(TX)(BORD))(add(TY)(BORD))(sub(TW)(mul(BORD)(2)))(TITH)(TITLE))
        (RECT(pitch)(add(TX)(BORD))(add(add(TY)(BORD))(TITH))
             (sub(TW)(mul(BORD)(2)))(sub(sub(TH)(mul(BORD)(2)))(TITH))(PAPER))))

# ── clear just the text area (used when the page fills) ──
glyph CLEARTEXT = la pitch.
    RECT(pitch)(add(TX)(BORD))(add(add(TY)(BORD))(TITH))
        (sub(TW)(mul(BORD)(2)))(sub(sub(TH)(mul(BORD)(2)))(TITH))(PAPER)

glyph PRESENT = la base. la pitch. memcpy(base)(BB)(mul(SH)(pitch))

# ── read one pixel back out of the LFB as "B,G,R" ──
glyph PIX = la base. la pitch. la x. la y.
    (la p. concat(concat(concat(concat(int_to_str(peek(p)))(","))
                              (int_to_str(peek(add(p)(1)))))(","))
                 (int_to_str(peek(add(p)(2)))))
    (add(base)(add(mul(y)(pitch))(mul(x)(4))))

# ── i8042 polling keyboard (HAL.2) ──
glyph OBF    = la st. int_eq(mod(st)(2))(1)
glyph NOTAUX = la st. int_eq(mod(div(st)(32))(2))(0)
glyph READY  = la st. AND(OBF(st))(NOTAUX(st))
glyph POLL = Z(la self. la _.
    (la st. IF(READY(st))(la _. inb(96))(la _. self("!")))
      (inb(100)))

# ── SET-1 make code -> character. Position IS the scancode; 0..57. ──
#    Only glyphs the font carries (A-Z, 0-9, space) map to anything; every
#    other key lands on a space, which the font renders blank.
glyph KEYMAP = "  1234567890    QWERTYUIOP    ASDFGHJKL     ZXCVBNM       "
glyph DECODE = la sc.
    IF(lt(sc)(58))(la _. str_head(DROP(sc)(KEYMAP)))(la _. " ")

glyph ESCK = 1
glyph ENTK = 28
glyph BSPK = 14

# ── the session loop ──
#   col/row are the cursor. ENTER newlines, BACKSPACE steps back and blanks the
#   cell, a printable rasters and advances. Running off the right edge wraps;
#   running off the bottom clears the page and returns to the top -- a PAGE
#   terminal, not a scrolling one. Scrolling needs the text retained off-screen,
#   which this module deliberately does not keep. Stated, not hidden.
glyph LOOP = Z(la self. la base. la pitch. la col. la row.
    (la sc.
      IF(int_eq(sc)(ESCK))
        (la _. print(concat(concat("term done col=")(int_to_str(col)))
                            (concat(" row=")(int_to_str(row)))))
        (la _.
        IF(int_eq(sc)(ENTK))
          (la _. (la nrow.
                   IF(int_eq(nrow)(ROWS))
                     (la _. SEQT(CLEARTEXT(pitch))(la _. SEQT(PRESENT(base)(pitch))(la _.
                            SEQT(print("term page"))(la _. self(base)(pitch)(0)(0)))))
                     (la _. SEQT(print(concat("term nl row=")(int_to_str(nrow))))
                            (la _. self(base)(pitch)(0)(nrow))))
                 (add(row)(1)))
          (la _.
        IF(AND(int_eq(sc)(BSPK))(NOT(int_eq(col)(0))))
          (la _. (la ncol.
                   SEQT(PUTCHAR(pitch)(ncol)(row)(" "))(la _.
                   SEQT(PRESENT(base)(pitch))(la _.
                   SEQT(print(concat("term bs col=")(int_to_str(ncol))))(la _.
                       self(base)(pitch)(ncol)(row)))))
                 (sub(col)(1)))
          (la _.
        IF(lt(sc)(58))
          (la _. (la ch.
                   SEQT(PUTCHAR(pitch)(col)(row)(ch))(la _.
                   SEQT(PRESENT(base)(pitch))(la _.
                   SEQT(print(concat(concat(concat("term ch=")(ch))
                                    (concat(" col=")(int_to_str(col))))
                                    (concat(" row=")(int_to_str(row)))))(la _.
                   SEQT(print(concat("term pix=")
                        (PIX(base)(pitch)(add(add(CX0)(mul(col)(8)))(1))
                                          (add(add(CY0)(mul(row)(8)))(1)))))(la _.
                   ((la ncol.
                      IF(int_eq(ncol)(COLS))
                        (la _. (la nrow.
                                 IF(int_eq(nrow)(ROWS))
                                   (la _. SEQT(CLEARTEXT(pitch))(la _. SEQT(PRESENT(base)(pitch))(la _.
                                          self(base)(pitch)(0)(0))))
                                   (la _. self(base)(pitch)(0)(nrow)))
                               (add(row)(1)))
                        (la _. self(base)(pitch)(ncol)(row)))
                    (add(col)(1))))))))
                 (DECODE(sc)))
          (la _. self(base)(pitch)(col)(row))))))
      (POLL("!")))

glyph MAIN =
    (la dev.
      (la bar.
        (la base.
          SEQ(SETMODE)
          ((la pitch.
              SEQ(print(concat(concat("term lfb=")(int_to_str(base)))
                              (concat(" pitch=")(int_to_str(pitch)))))
              (SEQ(CHROME(pitch))
              (SEQ(PRESENT(base)(pitch))
              (SEQ(print(concat("term paper=")(PIX(base)(pitch)(add(CX0)(4))(add(CY0)(4)))))
              (SEQ(print("term ready"))
              (LOOP(base)(pitch)(0)(0)))))))
           (mul(RDISPI(6))(4))))
        (sub(bar)(mod(bar)(16))))
      (CFG(dev)(16)))
    (FIND(0))
