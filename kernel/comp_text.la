# =====================================================================
#  LogOS HAL.4e — A MOVABLE TEXT WINDOW ON THE METAL, in LA.
#
#  HAL.4d moved a coloured rectangle with the keyboard. What the ROADMAP pivot
#  names as the next concrete compositor step is a movable TEXT window — the
#  foundation of a terminal. This is that: HAL.4d's session with an 8x8 bitmap
#  font rendered INTO window B, so the text moves with the window it lives in.
#
#    read a key -> move window B -> recompose (desktop, A, B, TEXT) -> present,
#    forever, until ENTER.
#
#  It is the metal twin of theourgia_text_live.la (Stage 8/9), minus Linux DRM:
#    - HAL.4c/4d comp_session.la: SETMODE, RECT per row, SCENE z-ordered,
#      PRESENT = one memcpy, POLL = the i8042 polling reader;
#    - theourgia_font.la:         FONTDATA verbatim (37 glyphs x 8 rows, packed
#      as ONE flat decimal string — a string literal lowers to a single
#      instruction, so the font costs nothing to compile).
#
#  DELIBERATELY FLAT + IMPORT-FREE, like every kernel driver here: the font is
#  copied in rather than import()ed, because a kernel .la must not drag the
#  import-mangler (and theourgia_text.la's surface path is a list of row strings,
#  O(n^2) per row — unusable on the metal).
#
#  ONE FLAT LOOP, not three nested. The natural shape is char -> row -> col, but
#  native_codegen3's codegen is SUPERLINEAR in nesting depth (comp_session.la
#  alone compiles in ~13 min), so DRAWT walks a SINGLE index i over
#  NCH*FH*FW pixel-tests and recovers (char,row,col) by div/mod. Only the
#  SCALE block-fill is a second loop.
#
#  The witness the gate reads is on the SERIAL line (comp.la's PIX peek pattern),
#  and it is load-bearing in BOTH directions — a probe ON a glyph stroke and a
#  probe OFF one, inside the same window:
#    - (201,141) is 'L' row 0 col 0  -> must be WHITE   (the text really drew)
#    - (222,141) is 'L' row 0 col 7  -> must be GREEN   (window B showing through,
#                                       so it is a GLYPH, not a filled block)
#  After 3x right, window B (and its text) has moved 120px off both probes, and
#  (201,141) shows window A's RED through — a real recompose, not a static frame.
#  ENTER ends the loop; MAIN returns; exit(0) -> isa-debug-exit -> QEMU exit 33.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b
glyph FALSE = la t. la f. f
glyph AND   = la a. la b. a(b)(FALSE)

# XRGB8888 little-endian: a dword lays bytes B,G,R,X = V&255, V>>8, V>>16
glyph DESK = 128                 # desktop  B=128  (dim blue)
glyph WINA = 16711680            # window A R=255  (red)
glyph WINB = 65280               # window B G=255  (green)
glyph FG   = 16777215            # text     B=G=R=255 (white)

glyph BB   = 268435456           # 0x10000000 — backbuffer in plain RAM
glyph SH   = 480                 # screen height

# window A fixed (the occlusion reference); window B moves
glyph AX = 80
glyph AY = 60
glyph WW = 200
glyph WH = 150
glyph BX0 = 180                  # window B initial position (overlaps A)
glyph BY0 = 120

glyph STEP = 40                  # pixels moved per keypress
glyph MAXX = 440                 # 640 - WW: keep B fully on screen
glyph MAXY = 330                 # 480 - WH

# ── the text living inside window B ──
glyph TXT   = "LOGOS"
glyph NCH   = 5                  # str_len(TXT), as an int (LA str_len is a string)
glyph FW    = 8                  # font cell width
glyph FH    = 8                  # font cell height
glyph SCALE = 3                  # each font pixel -> a SCALE x SCALE block
glyph TXTOX = 20                 # text origin, RELATIVE to the window
glyph TXTOY = 20

# probes: 'L' row 0 is 15 = cols 0..3 set, col 7 clear (bit 0 = leftmost)
glyph PONX = 201                 # BX0+TXTOX + (0*8+0)*SCALE + 1  -> on  a stroke
glyph PONY = 141                 # BY0+TXTOY + 0*SCALE + 1
glyph POFFX = 222                # BX0+TXTOX + (0*8+7)*SCALE + 1  -> off a stroke
glyph POFFY = 141

# ── PCI config read: reg at (bus 0, dev, off) via 0xCF8/0xCFC ──
glyph CFG = la dev. la off.
    SEQ(outl(3320)(add(add(2147483648)(mul(dev)(2048)))(off)))
       (inl(3324))
glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 0)(la _.
      IF(int_eq(CFG(dev)(0))(286331444))(la _. dev)(la _.
        self(add(dev)(1)))))

# ── Bochs VBE dispi (index 0x1CE=462, data 0x1CF=463) ──
glyph DISPI  = la idx. la val. SEQ(outw(462)(idx))(outw(463)(val))
glyph RDISPI = la idx. SEQ(outw(462)(idx))(inw(463))
glyph SETMODE =
    SEQ(DISPI(4)(0))          # disable while configuring
    (SEQ(DISPI(1)(640))       # XRES
    (SEQ(DISPI(2)(480))       # YRES
    (SEQ(DISPI(3)(32))        # BPP
    (DISPI(4)(65)))))         # ENABLE = enabled | LFB

# ── font plumbing, lifted verbatim from theourgia_font.la ──
glyph DROP = Z(la self. la n. la s. IF(int_eq(n)(0))(la _. s)(la _.
    self(sub(n)(1))(str_tail(s))))
glyph BYTE_AT = la s. la i. str_head(DROP(i)(s))
glyph ORDI    = la c. str_to_int(ord(c))
glyph BYTES_GO = Z(la self. la rest. la tok.
    IF(str_eq(rest)(""))(la _.
        IF(str_eq(tok)(""))(la _. "")(la _. chr(tok)))
    (la _.
    IF(str_eq(str_head(rest))(" "))(la _.
        IF(str_eq(tok)(""))(la _. self(str_tail(rest))(""))
            (la _. concat(chr(tok))(self(str_tail(rest))(""))))
    (la _. self(str_tail(rest))(concat(tok)(str_head(rest))))))
glyph BYTES = la s. BYTES_GO(s)("")

# The font: 37 glyphs x 8 rows, packed in INDEX order (space, A-Z, 0-9). Decoded
# ONCE in MAIN and threaded as a parameter — a `glyph FONT = BYTES(...)` would
# re-decode 296 bytes on every lookup (320 lookups per frame).
glyph INDEX = " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
glyph FONTSTR = "0 0 0 0 0 0 0 0 12 30 51 51 63 51 51 0 63 102 102 62 102 102 63 0 60 102 3 3 3 102 60 0 31 54 102 102 102 54 31 0 127 70 22 30 22 70 127 0 127 70 22 30 22 6 15 0 60 102 3 3 115 102 124 0 51 51 51 63 51 51 51 0 30 12 12 12 12 12 30 0 120 48 48 48 51 51 30 0 103 102 54 30 54 102 103 0 15 6 6 6 70 102 127 0 99 119 127 127 107 99 99 0 99 103 111 123 115 99 99 0 28 54 99 99 99 54 28 0 63 102 102 62 6 6 15 0 30 51 51 51 59 30 56 0 63 102 102 62 54 102 103 0 30 51 7 14 56 51 30 0 63 12 12 12 12 12 12 0 51 51 51 51 51 51 63 0 51 51 51 51 51 30 12 0 99 99 99 107 127 119 99 0 99 99 54 28 28 54 99 0 51 51 51 30 12 12 30 0 127 99 49 24 76 102 127 0 62 99 115 123 111 103 62 0 12 14 12 12 12 12 63 0 30 51 48 28 6 51 63 0 30 51 48 28 48 51 30 0 56 60 54 51 127 48 120 0 63 3 31 48 48 51 30 0 28 6 3 31 51 51 30 0 127 51 48 24 12 12 12 0 30 51 51 30 51 51 30 0 30 51 51 62 48 24 14 0"
glyph INDEXOF = Z(la self. la s. la c. la i.
    IF(str_eq(s)(""))(la _. 0)(la _.
    IF(str_eq(str_head(s))(c))(la _. i)(la _. self(str_tail(s))(c)(add(i)(1)))))
glyph GLYPH_INDEX = la c. INDEXOF(INDEX)(c)(0)
glyph POW2 = Z(la self. la k. IF(int_eq(k)(0))(la _. 1)(la _. mul(2)(self(sub(k)(1)))))
glyph BITSET = la b. la col. int_eq(mod(div(b)(POW2(col)))(2))(1)

# ── a surface: one fill() per row (rows contiguous, pitch-strided) ──
glyph RECT = Z(la self. la pitch. la x. la y. la w. la h. la col.
    IF(int_eq(h)(0))(la _. "!")(la _.
      SEQ(fill(add(BB)(add(mul(y)(pitch))(mul(x)(4))))(w)(col))
         (self(pitch)(x)(add(y)(1))(w)(sub(h)(1))(col))))

# ── one scaled font pixel: a SCALE-tall stack of SCALE-wide fills ──
glyph BLOCK = Z(la self. la pitch. la px. la py. la k.
    IF(int_eq(k)(0))(la _. "!")(la _.
      SEQ(fill(add(BB)(add(mul(py)(pitch))(mul(px)(4))))(SCALE)(FG))
         (self(pitch)(px)(add(py)(1))(sub(k)(1)))))

# ── the text: ONE flat loop over NCH*FH*FW pixel-tests ──
#   i -> char div(i)(FH*FW), row mod(div(i)(FW))(FH), col mod(i)(FW)
glyph DRAWT = Z(la self. la font. la pitch. la x. la y. la i.
    IF(int_eq(i)(mul(NCH)(mul(FH)(FW))))(la _. "!")(la _.
      (la ci.
        (la rr.
          (la cc.
            (la rb.
              SEQ(IF(BITSET(rb)(cc))
                    (la _. BLOCK(pitch)
                             (add(x)(mul(add(mul(ci)(FW))(cc))(SCALE)))
                             (add(y)(mul(rr)(SCALE)))
                             (SCALE))
                    (la _. "!"))
                 (self(font)(pitch)(x)(y)(add(i)(1))))
            (ORDI(BYTE_AT(font)(add(mul(GLYPH_INDEX(BYTE_AT(TXT)(ci)))(FH))(rr)))))
          (mod(i)(FW)))
        (mod(div(i)(FW))(FH)))
      (div(i)(mul(FH)(FW)))))

# ── compose the whole frame off-screen: desktop, A, B ON TOP, then B's TEXT ──
#   Paint order IS z-order; the text is laid last, so it sits ON its window.
glyph SCENE = la font. la pitch. la bx. la by.
    SEQ(fill(BB)(mul(SH)(div(pitch)(4)))(DESK))
    (SEQ(RECT(pitch)(AX)(AY)(WW)(WH)(WINA))
    (SEQ(RECT(pitch)(bx)(by)(WW)(WH)(WINB))
        (DRAWT(font)(pitch)(add(bx)(TXTOX))(add(by)(TXTOY))(0))))

# ── present: the ENTIRE composed frame to the LFB in ONE memcpy ──
glyph PRESENT = la base. la pitch. memcpy(base)(BB)(mul(SH)(pitch))

# ── read a pixel back out of the LFB as "B,G,R" ──
glyph PIX = la base. la pitch. la x. la y.
    (la p. concat(concat(concat(concat(int_to_str(peek(p)))(","))
                              (int_to_str(peek(add(p)(1)))))(","))
                 (int_to_str(peek(add(p)(2)))))
    (add(base)(add(mul(y)(pitch))(mul(x)(4))))

# ── the two-directional text witness: ON a stroke, and OFF one ──
glyph TWIT = la base. la pitch.
    SEQ(print(concat("text on=")(PIX(base)(pitch)(PONX)(PONY))))
       (print(concat("text off=")(PIX(base)(pitch)(POFFX)(POFFY))))

# ── i8042 polling keyboard (HAL.2): read one SET-1 scancode ──
glyph OBF    = la st. int_eq(mod(st)(2))(1)             # bit 0: output buffer full
glyph NOTAUX = la st. int_eq(mod(div(st)(32))(2))(0)    # bit 5 clear: not the mouse
glyph READY  = la st. AND(OBF(st))(NOTAUX(st))
glyph POLL = Z(la self. la _.
    (la st. IF(READY(st))(la _. inb(96))(la _. self("!")))
      (inb(100)))

# ── movement decode: WASD scancodes -> delta. w=17 a=30 s=31 d=32 ──
glyph DX = la sc. IF(int_eq(sc)(32))(la _. STEP)(la _.
             IF(int_eq(sc)(30))(la _. sub(0)(STEP))(la _. 0))
glyph DY = la sc. IF(int_eq(sc)(31))(la _. STEP)(la _.
             IF(int_eq(sc)(17))(la _. sub(0)(STEP))(la _. 0))
glyph CLAMP = la v. la hi.
    IF(lt(v)(0))(la _. 0)(la _. IF(lt(hi)(v))(la _. hi)(la _. v))

# ── the inner loop: poll -> move B -> recompose -> present, until ENTER ──
glyph LOOP = Z(la self. la font. la base. la pitch. la bx. la by.
    (la sc.
      IF(int_eq(sc)(28))
        (la _. print("text done"))                  # ENTER: leave the loop
        (la _.
          (la nbx.
            (la nby.
              SEQ(SCENE(font)(pitch)(nbx)(nby))(
              SEQ(PRESENT(base)(pitch))(
              SEQ(print(concat(concat("text bx=")(int_to_str(nbx)))(concat(" by=")(int_to_str(nby)))))(
              SEQ(TWIT(base)(pitch))(
              self(font)(base)(pitch)(nbx)(nby))))))
              (CLAMP(add(by)(DY(sc)))(MAXY)))
            (CLAMP(add(bx)(DX(sc)))(MAXX))))
      (POLL("!")))

glyph MAIN =
    (la font.
      (la dev.
        (la bar.
          (la base.
            SEQ(SETMODE)
            ((la pitch.
                SEQ(print(concat(concat("text lfb=")(int_to_str(base)))(concat(" pitch=")(int_to_str(pitch)))))
                (SEQ(SCENE(font)(pitch)(BX0)(BY0))          # initial frame
                (SEQ(PRESENT(base)(pitch))
                (SEQ(TWIT(base)(pitch))
                (SEQ(print("text ready"))
                (LOOP(font)(base)(pitch)(BX0)(BY0)))))))
             (mul(RDISPI(6))(4))))         # pitch = VIRT_WIDTH * 4 bytes
          (sub(bar)(mod(bar)(16))))         # LFB base = BAR0 & ~0xF
        (CFG(dev)(16)))                     # BAR0
      (FIND(0)))
    (BYTES(FONTSTR))
