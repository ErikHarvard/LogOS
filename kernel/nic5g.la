# =====================================================================
#  LogOS HAL.5g — an ICMP ECHO RESPONDER over RTL8139, in LA.
#
#  The RECEIVE-side twin of HAL.5c: 5c PINGED the gateway and read the reply;
#  5g answers a ping sent TO US. An external pinger (kernel/ping_harness.py,
#  over a QEMU `socket` netdev — SLIRP won't deliver an inbound ICMP) unicasts
#  an ICMP echo REQUEST to our MAC; the LA kernel at ring 0 receives it, builds
#  the matching ICMP echo REPLY, and transmits it — a real inbound service, the
#  kernel answering the network rather than initiating.
#
#  The reply is built FROM the received request (no static frame): COPYN the
#  whole request frame out of the RX ring, then mutate in place, reading the
#  originals straight from the ring (so swaps need no temporary):
#    - eth dst := request eth SRC (the pinger)      [ring 10..15 -> buf 0..5]
#    - eth src := request eth DST (us)              [ring 4..9  -> buf 6..11]
#    - ip  src := request ip DST (us)               [ring 34..37 -> buf 26..29]
#    - ip  dst := request ip SRC (the pinger)       [ring 30..33 -> buf 30..33]
#    - icmp type := 0 (echo reply)                  [buf 34]
#    - icmp cksum += 0x0800 (end-around carry)      [buf 36..37]
#  The IP header checksum is UNCHANGED — swapping src and dst leaves the header
#  sum identical (addition is commutative). The ICMP checksum needs only the
#  one-word delta: the first ICMP word (type<<8|code) drops by 0x0800 when type
#  goes 8->0, so the one's-complement checksum rises by 0x0800 (verified: a
#  request cksum f7fd becomes fffd). All arithmetic — no bitwise ops (LA lacks
#  them). Fires the reply on TSD0, min length 60.
#
#  Witnesses prove the service: "nic icmp req type=08 from=<pinger MAC>" is the
#  request identity read from the ring; the pinger separately confirms it got a
#  valid ICMP echo REPLY back. Fully self-contained (the pinger is the only
#  peer) and deterministic. Reuses 5b/5c's bring-up verbatim; flat +
#  import-free; needs -m 512. Six-second-safe: one bounded RX spin + a ~60-byte
#  copy; the pinger retries so the request lands soon after RX is enabled.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

glyph HEXD = la d.
    IF(lt(d)(10))(la _. chr(int_to_str(add(48)(d))))
                 (la _. chr(int_to_str(add(87)(d))))
glyph HEX2 = la b. concat(HEXD(div(b)(16)))(HEXD(mod(b)(16)))

glyph ADDR = la dev. la off. add(add(2147483648)(mul(dev)(2048)))(off)
glyph CFG  = la dev. la off. SEQ(outl(3320)(ADDR(dev)(off)))(inl(3324))
glyph CFGW = la dev. la off. la val. SEQ(outl(3320)(ADDR(dev)(off)))(outl(3324)(val))

glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 32)(la _.
      (la r.
        IF(int_eq(mod(r)(65536))(4332))(la _.
          IF(int_eq(div(r)(65536))(33081))(la _. dev)(la _. self(add(dev)(1))))
        (la _. self(add(dev)(1))))
      (CFG(dev)(0))))

glyph OB = la base. la off. la v. outb(add(base)(off))(v)
glyph OW = la base. la off. la v. outw(add(base)(off))(v)
glyph OL = la base. la off. la v. outl(add(base)(off))(v)
glyph IB = la base. la off. inb(add(base)(off))
glyph IL = la base. la off. inl(add(base)(off))

glyph RXBUF = 268435456     # 0x10000000 — 8 KiB RX ring
glyph TXBUF = 268447744     # 0x10003000 — TX buffer (the ICMP echo reply, TSD0)

# copy n bytes from a peek-able src addr to a poke-able dst addr (bounded, no bitwise)
glyph COPYN = Z(la self. la dst. la src. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      SEQ(poke(dst)(peek(src)))(self(add(dst)(1))(add(src)(1))(sub(n)(1)))))

glyph WAITRST = Z(la self. la base.
    IF(int_eq(mod(div(IB(base)(55))(16))(2))(1))(la _. self(base))(la _. base))
# wait for TOK (bit15) on a TSD at byte offset off (16=TSD0)
glyph WAITTX = Z(la self. la base. la off.
    IF(int_eq(mod(div(IL(base)(off))(32768))(2))(1))(la _. base)(la _. self(base)(off)))
glyph WAITRX = Z(la self. la base. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      IF(int_eq(mod(IB(base)(55))(2))(0))(la _. 1)(la _. self(base)(sub(n)(1)))))

# RX packet total length from its 4-byte ring header (bytes 2..3, incl. CRC)
glyph RXLEN = add(peek(add(RXBUF)(2)))(mul(peek(add(RXBUF)(3)))(256))
# byte at ring offset off in the received packet (frame byte off-4)
glyph RB = la off. peek(add(RXBUF)(off))
# byte at offset off in the reply TX buffer
glyph TB = la off. peek(add(TXBUF)(off))
# end-around-carry 16-bit add (for the ICMP checksum delta)
glyph EAC = la s. IF(lt(s)(65536))(la _. s)(la _. sub(s)(65535))

glyph SETUP = la dev. la base.
    SEQ(CFGW(dev)(4)(7))
    (SEQ(OB(base)(82)(0))
    (SEQ(OB(base)(55)(16))
    (SEQ(WAITRST(base))
    (SEQ(OL(base)(48)(RXBUF))
    (SEQ(OW(base)(60)(0))
    (SEQ(OW(base)(62)(65535))
    (SEQ(OL(base)(68)(59151))
    (SEQ(OW(base)(56)(65520))
    (OB(base)(55)(12))))))))))
glyph FROMWIT = concat("nic icmp req type=")(concat(HEX2(RB(38)))(concat(" from=")(concat(HEX2(RB(10)))(concat(HEX2(RB(11)))(concat(HEX2(RB(12)))(concat(HEX2(RB(13)))(concat(HEX2(RB(14)))(HEX2(RB(15))))))))))
glyph RESPOND = la base. la framelen. SEQ(COPYN(TXBUF)(add(RXBUF)(4))(framelen))(SEQ(COPYN(TXBUF)(add(RXBUF)(10))(6))(SEQ(COPYN(add(TXBUF)(6))(add(RXBUF)(4))(6))(SEQ(COPYN(add(TXBUF)(26))(add(RXBUF)(34))(4))(SEQ(COPYN(add(TXBUF)(30))(add(RXBUF)(30))(4))(SEQ(poke(add(TXBUF)(34))(0))(SEQ((la nc. SEQ(poke(add(TXBUF)(36))(div(nc)(256)))(poke(add(TXBUF)(37))(mod(nc)(256))))(EAC(add(add(mul(TB(36))(256))(TB(37)))(2048))))(SEQ(OL(base)(32)(TXBUF))(SEQ((la tl. OL(base)(16)(tl))(IF(lt(framelen)(60))(la _. 60)(la _. framelen)))(SEQ(WAITTX(base)(16))(SEQ(print("nic icmp reply sent"))(print("nic done"))))))))))))
glyph MAIN = SEQ(print("nic5g:"))(((la dev. IF(int_eq(dev)(32))(la _. print("nic not found"))(la _. ((la base. SEQ(SETUP(dev)(base))(SEQ(print("nic setup ok"))(IF(int_eq(WAITRX(base)(20000000))(0))(la _. print("nic rx timeout"))(la _. SEQ(print(FROMWIT))(RESPOND(base)(sub(RXLEN)(4)))))))(sub(CFG(dev)(16))(mod(CFG(dev)(16))(4))))))(FIND(0))))
