# =====================================================================
#  LogOS HAL.3b — ATA (IDE) disk WRITE, written in Lingua Adamica.
#
#  The write-twin of HAL.3 (ata.la read): the kernel now PERSISTS data to its
#  own disk, not just reads it. Pure LA on the HAL.1 port-I/O primitives — no
#  new builtin, no regen, no boot.asm change. On the primary IDE bus an LA
#  program at ring 0:
#    1. issues WRITE SECTORS (cmd 0x30) for a 28-bit LBA (same LBA/count/drive
#       register setup as the read, only the command byte differs);
#    2. waits BSY-clear + DRQ-set (the drive is ready to accept data);
#    3. pushes one 512-byte sector as 128 little-endian 32-bit `outl` writes to
#       the data register 0x1F0 (the write-mirror of the read's 128 `inl`s —
#       32-bit PIO moves two words per access, disk/little-endian order);
#    4. issues CACHE FLUSH (cmd 0xE7) and waits BSY-clear, so the sector is
#       committed to the backing store, not just the drive cache;
#    5. reads the sector back (the proven HAL.3 read path) and echoes it, so the
#       serial shows the round-trip — and the gate independently checks the disk
#       image file to prove the bytes reached persistent storage.
#  The sector is a printable signature + NUL padding to 512 (ZEROS is a small
#  Z-loop, bounded compile depth). Flat + import-free, like ata/nic.la.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

# ── spin on status: BSY=bit7=(st/128)mod2, DRQ=bit3=(st/8)mod2 (port 0x1F7=503) ──
# ── BOUNDED waits. Both return 1 ready / 0 timed out.
#
#  ★ BOTH OF THESE WERE UNBOUNDED, the same latent crash HAL.3c fixed in
#  ata.la: on a channel that never becomes ready the old `self("!")` recursed
#  until it ran off into unmapped memory — EXCEPTION 0d, no diagnosis naming
#  the disk. Reproduced on the read path with no drive attached and again with
#  a present-but-empty CD-ROM; the status byte is 0 and 0x41 respectively, so
#  BSY and DRQ are both CLEAR and it is the "neither -> keep waiting" branch
#  that spins. No gate saw it because every ATA gate attaches a working disk.
#
#  The WRITE path is worse exposed than the read path: it waits THREE times
#  (DRQ before pushing the sector, BSY after the cache flush, DRQ again on the
#  read-back), so a wedged channel had three ways to kill the kernel instead of
#  one — and the flush wait sits AFTER 512 bytes have already been pushed, i.e.
#  at the point where dying without a word is most costly.
#
#  A number, not a string: str_eq is not in the kernel builtin subset.
glyph DRQFUEL = 100000
glyph BSYFUEL = 100000
glyph WAITDRQ = Z(la self. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
    (la st.
      IF(int_eq(mod(div(st)(128))(2))(1))(la _. self(sub(n)(1)))
      (la _. IF(int_eq(mod(div(st)(8))(2))(1))(la _. 1)
             (la _. self(sub(n)(1)))))
    (inb(503))))
glyph WAITBSY = Z(la self. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
    IF(int_eq(mod(div(inb(503))(128))(2))(1))(la _. self(sub(n)(1)))(la _. 1)))

# Name the organ, the STAGE, and the status byte that never became ready. The
# stage matters: "which of the three waits gave up" is the difference between a
# drive that never accepted the write and one that never flushed it.
glyph DIAG = la what.
    SEQ(print(concat("ata3b ")(concat(what)(concat(" timeout st=")(int_to_str(inb(503)))))))
       (print("ata3b dead"))

# ── issue WRITE SECTORS (cmd 0x30=48) / READ SECTORS (cmd 0x20=32) of a 28-bit LBA ──
glyph LBASET = la lba. la cmd.
    SEQ(outb(502)(add(224)(mod(div(lba)(16777216))(16))))    # drive/head: 0xE0 | LBA[27:24]
    (SEQ(outb(498)(1))                                        # sector count = 1
    (SEQ(outb(499)(mod(lba)(256)))                            # LBA[7:0]
    (SEQ(outb(500)(mod(div(lba)(256))(256)))                 # LBA[15:8]
    (SEQ(outb(501)(mod(div(lba)(65536))(256)))               # LBA[23:16]
    (outb(503)(cmd))))))                                      # command byte
glyph ISSUEW = la lba. LBASET(lba)(48)
glyph ISSUER = la lba. LBASET(lba)(32)

# ── first byte of s as an int (ord returns a decimal STRING) ──
glyph B0 = la s. str_to_int(ord(str_head(s)))
# ── write a 512-byte sector: 128 little-endian dwords via outl to 0x1F0(496) ──
glyph WSEC = Z(la self. la s.
    IF(str_eq(s)(""))(la _. "!")(la _.
      (la t1. (la t2. (la t3.
        SEQ(outl(496)(add(B0(s))(add(mul(B0(t1))(256))(add(mul(B0(t2))(65536))(mul(B0(t3))(16777216))))))
           (self(str_tail(t3))))
        (str_tail(t2)))
        (str_tail(t1)))
        (str_tail(s))))

# ── read-back path (verbatim HAL.3): dword -> 4 bytes, drain 128 dwords ──
glyph B4 = la v.
    concat(chr(int_to_str(mod(v)(256))))
    (concat(chr(int_to_str(mod(div(v)(256))(256))))
    (concat(chr(int_to_str(mod(div(v)(65536))(256))))
            (chr(int_to_str(mod(div(v)(16777216))(256))))))
glyph READSEC = Z(la self. la n. la acc.
    IF(int_eq(n)(0))(la _. acc)(la _.
      self(sub(n)(1))(concat(acc)(B4(inl(496))))))

# ── the sector to write: a printable signature + NUL padding to 512 bytes ──
glyph ZEROS = Z(la self. la n.
    IF(int_eq(n)(0))(la _. "")(la _. concat(chr(int_to_str(0)))(self(sub(n)(1)))))
glyph SIG    = "LOGOS-WROTE-THIS-HAL3B"
glyph SECTOR = concat(SIG)(ZEROS(490))
glyph FLUSH  = SEQ(outb(503)(231))(WAITBSY(BSYFUEL)) # cmd 0xE7 = cache flush, then bounded wait BSY

glyph MAIN =
    SEQ(print("ata3b:"))
    (SEQ(ISSUEW(2))                     # WRITE SECTORS to LBA 2
    ((la wdrq.                          # (1) drive ready to accept data?
      IF(int_eq(wdrq)(1))(la _.
        SEQ(WSEC(SECTOR))               # push the 512-byte sector
        ((la wbsy.                      # (2) cache flush completed?
          IF(int_eq(wbsy)(1))(la _.
            SEQ(print("ata write done"))
            (SEQ(ISSUER(2))             # read LBA 2 back
            ((la rdrq.                  # (3) data ready on the read-back?
              IF(int_eq(rdrq)(1))(la _.
                SEQ(print(concat("ata rb=")(READSEC(128)(""))))
                (print("ata3b done")))
              (la _. DIAG("readback drq"))
             )(WAITDRQ(DRQFUEL)))))
          (la _. DIAG("flush bsy"))
         )(FLUSH)))
      (la _. DIAG("write drq"))
     )(WAITDRQ(DRQFUEL))))
