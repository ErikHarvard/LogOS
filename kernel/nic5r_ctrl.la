# =====================================================================
#  HAL.5r RED-PATH CONTROL (nic5r_ctrl) — nic5r.la with the RX REPAIR REMOVED.
#  On the bounded WAITRX timeout it DIAGNOSES ('nic rx wedged cr=XX') and STOPS:
#  no RE re-enable, no retry. No frame is received, pinger gets NO reply -> RED.
#  ('nic rx recovered' remains unreachable in the MATCH branch.) Generated from
#  nic5r.la (nested).
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

glyph HEXD = la d.
    IF(lt(d)(10))(la _. chr(int_to_str(add(48)(d))))
                 (la _. chr(int_to_str(add(87)(d))))
glyph HEX2 = la b. concat(HEXD(div(b)(16)))(HEXD(mod(b)(16)))

glyph ADDR = la dev. la off. add(add(2147483648)(mul(dev)(2048)))(off)
glyph CFG  = la dev. la off. SEQ(outl(3320)(ADDR(dev)(off)))(inl(3324))
glyph CFGW = la dev. la off. la val. SEQ(outl(3320)(ADDR(dev)(off)))(outl(3324)(val))

glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 32)(la _.
      (la r.
        IF(int_eq(mod(r)(65536))(4332))(la _.
          IF(int_eq(div(r)(65536))(33081))(la _. dev)(la _. self(add(dev)(1))))
        (la _. self(add(dev)(1))))
      (CFG(dev)(0))))

glyph OB = la base. la off. la v. outb(add(base)(off))(v)
glyph OW = la base. la off. la v. outw(add(base)(off))(v)
glyph OL = la base. la off. la v. outl(add(base)(off))(v)
glyph IB = la base. la off. inb(add(base)(off))
glyph IL = la base. la off. inl(add(base)(off))

glyph RXBUF = 268435456
glyph TXBUF = 268447744

glyph COPYN = Z(la self. la dst. la src. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      SEQ(poke(dst)(peek(src)))(self(add(dst)(1))(add(src)(1))(sub(n)(1)))))

glyph WAITRST = Z(la self. la base.
    IF(int_eq(mod(div(IB(base)(55))(16))(2))(1))(la _. self(base))(la _. base))
# ★ BOUNDED transmit wait: fuel n; returns 1 if TOK (TSD bit15) sets, 0 if fuel
# runs out (the wedged-TX sentinel). The fix for WAITTX's unbounded spin.
glyph WAITTXB = Z(la self. la base. la off. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      IF(int_eq(mod(div(IL(base)(off))(32768))(2))(1))(la _. 1)(la _. self(base)(off)(sub(n)(1)))))
glyph WAITRX = Z(la self. la base. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      IF(int_eq(mod(IB(base)(55))(2))(0))(la _. 1)(la _. self(base)(sub(n)(1)))))

glyph RXFUEL = 200000
glyph RXLEN2 = la o. add(RB2(o)(2))(mul(RB2(o)(3))(256))
glyph RB2 = la o. la off. peek(add(add(RXBUF)(o))(off))
glyph TB = la off. peek(add(TXBUF)(off))
glyph EAC = la s. IF(lt(s)(65536))(la _. s)(la _. sub(s)(65535))

glyph ALIGN4 = la x. mul(div(add(x)(3))(4))(4)
glyph NEXTOFF = la o. ALIGN4(add(o)(add(4)(RXLEN2(o))))
glyph IHL2   = la o. mod(RB2(o)(18))(16)
glyph L4OFF2 = la o. add(14)(mul(IHL2(o))(4))
glyph ISIP   = la o. IF(int_eq(RB2(o)(16))(8))(la _. IF(int_eq(RB2(o)(17))(0))(la _. 1)(la _. 0))(la _. 0)
glyph OKIHL  = la o. IF(lt(IHL2(o))(5))(la _. 0)(la _. 1)
glyph ISICMP = la o. IF(int_eq(RB2(o)(27))(1))(la _. 1)(la _. 0)
glyph MATCH  = la o. IF(int_eq(ISIP(o))(1))(la _. IF(int_eq(OKIHL(o))(1))(la _. ISICMP(o))(la _. 0))(la _. 0)

glyph SETUP = la dev. la base.
    SEQ(CFGW(dev)(4)(7))
    (SEQ(OB(base)(82)(0))
    (SEQ(OB(base)(55)(16))
    (SEQ(WAITRST(base))
    (SEQ(OL(base)(48)(RXBUF))
    (SEQ(OW(base)(60)(0))
    (SEQ(OW(base)(62)(65535))
    (SEQ(OL(base)(68)(59151))
    (SEQ(OW(base)(56)(65520))
    (OB(base)(55)(12))))))))))
glyph SKIPWIT = la o. concat("nic skip et=")(concat(HEX2(RB2(o)(16)))(HEX2(RB2(o)(17))))
glyph FROMWIT = la o. la u. concat("nic icmp req ihl=")(concat(HEX2(IHL2(o)))(concat(" type=")(concat(HEX2(RB2(o)(add(u)(4))))(concat(" from=")(concat(HEX2(RB2(o)(10)))(concat(HEX2(RB2(o)(11)))(concat(HEX2(RB2(o)(12)))(concat(HEX2(RB2(o)(13)))(concat(HEX2(RB2(o)(14)))(HEX2(RB2(o)(15))))))))))))
glyph RESPOND = la base. la o. la framelen. la u. (la ra. SEQ(COPYN(TXBUF)(add(ra)(4))(framelen))(SEQ(COPYN(TXBUF)(add(ra)(10))(6))(SEQ(COPYN(add(TXBUF)(6))(add(ra)(4))(6))(SEQ(COPYN(add(TXBUF)(26))(add(ra)(34))(4))(SEQ(COPYN(add(TXBUF)(30))(add(ra)(30))(4))(SEQ(poke(add(TXBUF)(u))(0))(SEQ((la nc. SEQ(poke(add(TXBUF)(add(u)(2)))(div(nc)(256)))(poke(add(TXBUF)(add(u)(3)))(mod(nc)(256))))(EAC(add(add(mul(TB(add(u)(2)))(256))(TB(add(u)(3))))(2048))))(SEQ((la r1. IF(int_eq(r1)(1))(la _. print("nic tx ok"))(la _. SEQ(print(concat("nic tx wedged tsd=")(concat(HEX2(div(IL(base)(16))(256)))(HEX2(mod(IL(base)(16))(256))))))(SEQ(OB(base)(55)(12))((la r2. IF(int_eq(r2)(1))(la _. print("nic tx recovered"))(la _. print("nic tx dead")))((la fl. SEQ(OL(base)(32)(TXBUF))(SEQ((la tl. OL(base)(16)(tl))(IF(lt(fl)(60))(la _. 60)(la _. fl)))(WAITTXB(base)(16)(200000))))(framelen))))))((la fl. SEQ(OL(base)(32)(TXBUF))(SEQ((la tl. OL(base)(16)(tl))(IF(lt(fl)(60))(la _. 60)(la _. fl)))(WAITTXB(base)(16)(200000))))(framelen)))(SEQ(print("nic icmp reply sent"))(print("nic done")))))))))))(add(RXBUF)(o))
glyph SCAN = Z(la self. la base. la o. la fuel. la rep.
    IF(int_eq(fuel)(0))(la _. print("nic no match"))(la _.
      IF(int_eq(WAITRX(base)(RXFUEL))(0))(la _. print(concat("nic rx wedged cr=")(HEX2(IB(base)(55)))))(la _.
        IF(int_eq(MATCH(o))(1))(la _. SEQ(IF(int_eq(rep)(1))(la _. print("nic rx recovered"))(la _. 0))((la u. SEQ(print(FROMWIT(o)(u)))(RESPOND(base)(o)(sub(RXLEN2(o))(4))(u)))(L4OFF2(o))))(la _. SEQ(print(SKIPWIT(o)))((la n. SEQ(OW(base)(56)(sub(n)(16)))(self(base)(n)(sub(fuel)(1))(rep)))(NEXTOFF(o)))))))
glyph MAIN = SEQ(print("nic5r_ctrl:"))(((la dev. IF(int_eq(dev)(32))(la _. print("nic not found"))(la _. ((la base. SEQ(SETUP(dev)(base))(SEQ(OB(base)(55)(4))(SEQ(print("nic setup ok (re-off fault injected)"))(SCAN(base)(0)(8)(0)))))(sub(CFG(dev)(16))(mod(CFG(dev)(16))(4))))))(FIND(0))))
