# =====================================================================
#  LogOS HAL.5c — an ICMP ECHO round-trip (ping) over RTL8139, in LA.
#  DONE + gated (2026-07-20). Verified: "nic rx et=0800 proto=01 icmp=00".
#  NOTE: native_codegen3 takes ~12 min on this program (NIC-sized, like HAL.4h's
#  fused build), so gate_nic5k.sh's rebuild is long — when iterating, build once
#  then run QEMU manually rather than through a short gate wrapper.
#
#  HAL.5b did the layer-2/3 ARP round-trip; HAL.5c goes one layer up — a
#  real IP-layer exchange: the kernel PINGS the SLIRP gateway (10.0.2.2)
#  and receives the echo reply, all in Lingua Adamica at ring 0. It reuses
#  HAL.5b's NIC bring-up verbatim (PCI find, bus-master, reset, RX ring +
#  TX buffer in the identity map, RCR/CR) and changes only the payload and
#  the reply check.
#
#  The 42-byte ICMP echo REQUEST is staged as a flat decimal string with
#  the IP and ICMP header checksums PRECOMPUTED (offline, one's-complement
#  16-bit) and baked in — the same discipline HAL.5b used for its ARP
#  frame, and the reason the driver needs no bitwise ops (LA has none):
#    eth: dst 52:55:0a:00:02:02 (gateway MAC, from 5b) | src 52:54:00:12:34:56 | 0800
#    ip : 45 00 00 1c .. 40 01 [62 d1] 10.0.2.15 -> 10.0.2.2   (proto 1 = ICMP)
#    icmp: 08 00 [f7 fd] id 0001 seq 0001   (type 8 = echo request)
#  SLIRP answers pings to its own gateway internally (no host privilege). BUT a
#  naive single-shot ping fails: to unicast the echo reply SLIRP needs our MAC,
#  so it first ARPs for 10.0.2.15 — that ARP lands as the FIRST RX packet and we
#  never see the echo reply (found the hard way). The fix here is to SEED SLIRP's
#  ARP cache first: we transmit a GRATUITOUS ARP REPLY (opcode 2, sender =
#  target = 10.0.2.15/our MAC). SLIRP's arp_input caches the sender from a reply
#  and sends nothing back, so afterwards it already knows our MAC — the echo
#  reply then arrives as the ONLY RX packet, no ARP responder / ring-advance
#  needed. So: TX gratuitous ARP (TSD0) -> TX ICMP echo (TSD1) -> RX the reply,
#  verified straight out of the DMA ring with peek: ethertype 0x0800, IP proto 1,
#  ICMP type 0 (echo reply). Flat + import-free, like nic5b.la. Needs -m 512.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

glyph HEXD = la d.
    IF(lt(d)(10))(la _. chr(int_to_str(add(48)(d))))
                 (la _. chr(int_to_str(add(87)(d))))
glyph HEX2 = la b. concat(HEXD(div(b)(16)))(HEXD(mod(b)(16)))

glyph ADDR = la dev. la off. add(add(2147483648)(mul(dev)(2048)))(off)
glyph CFG  = la dev. la off. SEQ(outl(3320)(ADDR(dev)(off)))(inl(3324))
glyph CFGW = la dev. la off. la val. SEQ(outl(3320)(ADDR(dev)(off)))(outl(3324)(val))

glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 32)(la _.
      (la r.
        IF(int_eq(mod(r)(65536))(4332))(la _.
          IF(int_eq(div(r)(65536))(33081))(la _. dev)(la _. self(add(dev)(1))))
        (la _. self(add(dev)(1))))
      (CFG(dev)(0))))

glyph OB = la base. la off. la v. outb(add(base)(off))(v)
glyph OW = la base. la off. la v. outw(add(base)(off))(v)
glyph OL = la base. la off. la v. outl(add(base)(off))(v)
glyph IB = la base. la off. inb(add(base)(off))
glyph IL = la base. la off. inl(add(base)(off))

glyph RXBUF = 268435456     # 0x10000000 — 8 KiB RX ring
glyph TXBUF = 268447744     # 0x10003000 — TX buffer 0 (gratuitous ARP)
glyph TXBUF2 = 268451840    # 0x10004000 — TX buffer 1 (ICMP echo)

# ── the 42-byte ICMP echo request (checksums precomputed offline) ──
glyph FRAMEDATA = "82 85 10 0 2 2 82 84 0 18 52 86 8 0 69 0 0 28 0 0 0 0 64 1 98 209 10 0 2 15 10 0 2 2 8 0 247 253 0 1 0 1"
# ── a gratuitous ARP REPLY (oper 2, spa=tpa=10.0.2.15/our MAC) to seed SLIRP ──
glyph GARPDATA = "255 255 255 255 255 255 82 84 0 18 52 86 8 6 0 1 8 0 6 4 0 2 82 84 0 18 52 86 10 0 2 15 82 84 0 18 52 86 10 0 2 15"

glyph D2I = la c. sub(str_to_int(ord(c)))(48)
glyph PUTBYTES = Z(la self. la addr. la s. la acc.
    IF(str_eq(s)(""))(la _. SEQ(poke(addr)(acc))(add(addr)(1)))(la _.
      (la c.
        IF(str_eq(c)(" "))(la _. SEQ(poke(addr)(acc))(self(add(addr)(1))(str_tail(s))(0)))
        (la _. self(addr)(str_tail(s))(add(mul(acc)(10))(D2I(c)))))
      (str_head(s))))

glyph WAITRST = Z(la self. la base.
    IF(int_eq(mod(div(IB(base)(55))(16))(2))(1))(la _. self(base))(la _. base))
# wait for TOK on TSD1 (offset 0x14=20) — single-arg to keep codegen cheap
glyph WAITTX = Z(la self. la base.
    IF(int_eq(mod(div(IL(base)(20))(32768))(2))(1))(la _. base)(la _. self(base)))
glyph WAITRX = Z(la self. la base. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      IF(int_eq(mod(IB(base)(55))(2))(0))(la _. 1)(la _. self(base)(sub(n)(1)))))

# RX byte at ring offset off (RB(off) == frame byte off-4, past the 4-byte RX header)
glyph RB = la off. peek(add(RXBUF)(off))

# HAL.5k/5l: the IP header length, READ FROM THE PACKET rather than assumed.
# Frame byte 14 (ring 18) is version<<4|ihl; the low nibble is mod 16, and the
# header is that many 32-bit words. L4OFF is where the L4 header actually starts.
glyph IHL   = mod(RB(18))(16)
glyph L4OFF = add(14)(mul(IHL)(4))


glyph SETUP = la dev. la base.
    SEQ(CFGW(dev)(4)(7))
    (SEQ(OB(base)(82)(0))
    (SEQ(OB(base)(55)(16))
    (SEQ(WAITRST(base))
    (SEQ(OL(base)(48)(RXBUF))
    (SEQ(OW(base)(60)(0))
    (SEQ(OW(base)(62)(65535))
    (SEQ(OL(base)(68)(59151))
    (SEQ(OW(base)(56)(65520))
    (OB(base)(55)(12))))))))))

glyph MAIN =
    SEQ(print("nic5k:"))
    ((la dev.
       IF(int_eq(dev)(32))(la _. print("nic not found"))(la _.
         (la base.
           SEQ(SETUP(dev)(base))
           (SEQ(PUTBYTES(TXBUF)(GARPDATA)(0))      # gratuitous ARP -> TXBUF
           (SEQ(PUTBYTES(TXBUF2)(FRAMEDATA)(0))    # ICMP echo -> TXBUF2
           (SEQ(OL(base)(32)(TXBUF))               # TSAD0 = TXBUF
           (SEQ(OL(base)(16)(60))                  # TSD0 -> fire gratuitous ARP (seed SLIRP)
           (SEQ(OL(base)(36)(TXBUF2))              # TSAD1 = TXBUF2
           (SEQ(OL(base)(20)(60))                  # TSD1 -> fire ICMP echo
           (SEQ(WAITTX(base))                      # wait TOK on TSD1 (both frames sent)
           (SEQ(print("nic tx ok"))
           (IF(int_eq(WAITRX(base)(20000000))(0))(la _. print("nic rx timeout"))(la _.
             SEQ(print(concat("nic rx ihl=")(concat(HEX2(IHL))(concat(" et=")(concat(HEX2(RB(16)))(concat(HEX2(RB(17)))(concat(" proto=")(concat(HEX2(RB(27)))(concat(" icmp=")(HEX2(RB(add(L4OFF)(4)))))))))))))
                (print("nic done")))))))))))))
         (sub(CFG(dev)(16))(mod(CFG(dev)(16))(4)))))
     (FIND(0)))
