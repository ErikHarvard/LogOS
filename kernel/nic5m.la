# =====================================================================
#  LogOS HAL.5m — a frame-CLASSIFYING ICMP echo responder with RX-RING
#  ADVANCE, in Lingua Adamica.
#
#  Every 5x kernel up to 5l did WAITRX then parsed whatever landed first as its
#  own protocol, reading ring slot 0 and nothing else. That was MEASURED to
#  fail on the shipped HAL.5j: sent an ARP broadcast followed by a real ICMP
#  echo request, 5j printed "nic icmp req ihl=00 type=00", built a reply out of
#  the ARP frame, transmitted it, and never saw the ping. On a real LAN, ARP
#  broadcasts arrive constantly, so this is not a corner case.
#
#  5m fixes all three parts of that:
#    1. CLASSIFY — ethertype must be 0800 AND proto must be 1 (ICMP);
#    2. BOUND THE IHL — ihl >= 5, because a real IPv4 header cannot be shorter.
#       Without it an ARP frame parsed as IP gives ihl=0, i.e. L4OFF=14, an
#       offset pointing back INTO THE ETHERNET HEADER. That is precisely the
#       ihl=00 the 5j ELF printed.
#    3. ADVANCE AND RETRY — on a non-match, move CAPR past the packet and look
#       at the NEXT one, instead of giving up on slot 0.
#
#  The advance is HAL.5e's mechanism, reused rather than reinvented:
#    RXLEN2(o) = ring[o+2] + 256*ring[o+3]      (length INCLUDING the 4-byte CRC)
#    NEXTOFF(o) = align4(o + 4 + RXLEN2(o))
#    CAPR := NEXTOFF(o) - 16                    (the RTL8139 -0x10 quirk)
#  A frame byte k of the packet based at o sits at ring offset o+4+k, which is
#  why every read goes through RB2(o)(k+4). All arithmetic — no bitwise ops.
#
#  At o=0 with a matching first packet, RESPOND is HAL.5j's reply construction
#  unchanged, so 5j's behaviour (including its IHL generality) is preserved.
#
#  BOUNDED: SCAN carries FUEL (8 frames). It cannot spin forever on a ring full
#  of noise; it reports "nic no match" and stops. A guard that can loop forever
#  is not a guard.
#
#  Witnesses: "nic skip et=0806" for each frame classified out, then
#  "nic icmp req ihl=05 type=08 from=<mac>" for the one it answers — so the
#  serial shows the DECISION, not just the outcome. The pinger independently
#  verifies the echo, so this gate is two-witness like 5i/5j (unlike 5k/5l).
#
#  HONEST SCOPE: no ring WRAP handling — NEXTOFF walks forward and the 8 KiB
#  ring is never wrapped by the handful of small frames a gate sends (5e's note
#  carries the same limit). Classification is ethertype+proto+ihl only; it does
#  NOT check that the frame is addressed to us (the NIC's promiscuous RCR
#  accepts anything), nor the ICMP type, nor the IP checksum.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

glyph HEXD = la d.
    IF(lt(d)(10))(la _. chr(int_to_str(add(48)(d))))
                 (la _. chr(int_to_str(add(87)(d))))
glyph HEX2 = la b. concat(HEXD(div(b)(16)))(HEXD(mod(b)(16)))

glyph ADDR = la dev. la off. add(add(2147483648)(mul(dev)(2048)))(off)
glyph CFG  = la dev. la off. SEQ(outl(3320)(ADDR(dev)(off)))(inl(3324))
glyph CFGW = la dev. la off. la val. SEQ(outl(3320)(ADDR(dev)(off)))(outl(3324)(val))

glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 32)(la _.
      (la r.
        IF(int_eq(mod(r)(65536))(4332))(la _.
          IF(int_eq(div(r)(65536))(33081))(la _. dev)(la _. self(add(dev)(1))))
        (la _. self(add(dev)(1))))
      (CFG(dev)(0))))

glyph OB = la base. la off. la v. outb(add(base)(off))(v)
glyph OW = la base. la off. la v. outw(add(base)(off))(v)
glyph OL = la base. la off. la v. outl(add(base)(off))(v)
glyph IB = la base. la off. inb(add(base)(off))
glyph IL = la base. la off. inl(add(base)(off))

glyph RXBUF = 268435456     # 0x10000000 — 8 KiB RX ring
glyph TXBUF = 268447744     # 0x10003000 — TX buffer (the ICMP echo reply, TSD0)

glyph COPYN = Z(la self. la dst. la src. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      SEQ(poke(dst)(peek(src)))(self(add(dst)(1))(add(src)(1))(sub(n)(1)))))

glyph WAITRST = Z(la self. la base.
    IF(int_eq(mod(div(IB(base)(55))(16))(2))(1))(la _. self(base))(la _. base))
glyph WAITTX = Z(la self. la base. la off.
    IF(int_eq(mod(div(IL(base)(off))(32768))(2))(1))(la _. base)(la _. self(base)(off)))
glyph WAITRX = Z(la self. la base. la n.
    IF(int_eq(n)(0))(la _. 0)(la _.
      IF(int_eq(mod(IB(base)(55))(2))(0))(la _. 1)(la _. self(base)(sub(n)(1)))))

glyph TB = la off. peek(add(TXBUF)(off))
glyph EAC = la s. IF(lt(s)(65536))(la _. s)(la _. sub(s)(65535))

# ── the ring, addressed by PACKET OFFSET (HAL.5e's mechanism) ──────────────
glyph ALIGN4 = la x. mul(div(add(x)(3))(4))(4)
# byte at offset off within the packet based at ring offset o (frame byte off-4)
glyph RB2    = la o. la off. peek(add(add(RXBUF)(o))(off))
# that packet's total length from its own 4-byte header (INCLUDING the CRC)
glyph RXLEN2 = la o. add(RB2(o)(2))(mul(RB2(o)(3))(256))
# where the NEXT packet begins
glyph NEXTOFF = la o. ALIGN4(add(o)(add(4)(RXLEN2(o))))

# ── classification ────────────────────────────────────────────────────────
glyph IHL2   = la o. mod(RB2(o)(18))(16)
glyph L4OFF2 = la o. add(14)(mul(IHL2(o))(4))
# ethertype 0800 (frame bytes 12,13 -> ring 16,17)
glyph ISIP   = la o. IF(int_eq(RB2(o)(16))(8))(la _. IF(int_eq(RB2(o)(17))(0))(la _. 1)(la _. 0))(la _. 0)
# a real IPv4 header is never shorter than 5 words — this is the bound whose
# absence let an ARP frame yield L4OFF=14
glyph OKIHL  = la o. IF(lt(IHL2(o))(5))(la _. 0)(la _. 1)
# IP proto 1 = ICMP (frame byte 23 -> ring 27; independent of ihl)
glyph ISICMP = la o. IF(int_eq(RB2(o)(27))(1))(la _. 1)(la _. 0)
glyph MATCH  = la o. IF(int_eq(ISIP(o))(1))(la _. IF(int_eq(OKIHL(o))(1))(la _. ISICMP(o))(la _. 0))(la _. 0)

glyph SETUP = la dev. la base.
    SEQ(CFGW(dev)(4)(7))
    (SEQ(OB(base)(82)(0))
    (SEQ(OB(base)(55)(16))
    (SEQ(WAITRST(base))
    (SEQ(OL(base)(48)(RXBUF))
    (SEQ(OW(base)(60)(0))
    (SEQ(OW(base)(62)(65535))
    (SEQ(OL(base)(68)(59151))
    (SEQ(OW(base)(56)(65520))
    (OB(base)(55)(12))))))))))
glyph SKIPWIT = la o. concat("nic skip et=")(concat(HEX2(RB2(o)(16)))(HEX2(RB2(o)(17))))
glyph FROMWIT = la o. la u. concat("nic icmp req ihl=")(concat(HEX2(IHL2(o)))(concat(" type=")(concat(HEX2(RB2(o)(add(u)(4))))(concat(" from=")(concat(HEX2(RB2(o)(10)))(concat(HEX2(RB2(o)(11)))(concat(HEX2(RB2(o)(12)))(concat(HEX2(RB2(o)(13)))(concat(HEX2(RB2(o)(14)))(HEX2(RB2(o)(15))))))))))))
glyph RESPOND = la base. la o. la framelen. la u. (la ra. SEQ(COPYN(TXBUF)(add(ra)(4))(framelen))(SEQ(COPYN(TXBUF)(add(ra)(10))(6))(SEQ(COPYN(add(TXBUF)(6))(add(ra)(4))(6))(SEQ(COPYN(add(TXBUF)(26))(add(ra)(34))(4))(SEQ(COPYN(add(TXBUF)(30))(add(ra)(30))(4))(SEQ(poke(add(TXBUF)(u))(0))(SEQ((la nc. SEQ(poke(add(TXBUF)(add(u)(2)))(div(nc)(256)))(poke(add(TXBUF)(add(u)(3)))(mod(nc)(256))))(EAC(add(add(mul(TB(add(u)(2)))(256))(TB(add(u)(3))))(2048))))(SEQ(OL(base)(32)(TXBUF))(SEQ((la tl. OL(base)(16)(tl))(IF(lt(framelen)(60))(la _. 60)(la _. framelen)))(SEQ(WAITTX(base)(16))(SEQ(print("nic icmp reply sent"))(print("nic done")))))))))))))(add(RXBUF)(o))
glyph SCAN = Z(la self. la base. la o. la fuel.
    IF(int_eq(fuel)(0))(la _. print("nic no match"))(la _.
      IF(int_eq(WAITRX(base)(20000000))(0))(la _. print("nic rx timeout"))(la _.
        IF(int_eq(MATCH(o))(1))(la _. (la u. SEQ(print(FROMWIT(o)(u)))(RESPOND(base)(o)(sub(RXLEN2(o))(4))(u)))(L4OFF2(o)))(la _. SEQ(print(SKIPWIT(o)))((la n. SEQ(OW(base)(56)(sub(n)(16)))(self(base)(n)(sub(fuel)(1))))(NEXTOFF(o)))))))
glyph MAIN = SEQ(print("nic5m:"))(((la dev. IF(int_eq(dev)(32))(la _. print("nic not found"))(la _. ((la base. SEQ(SETUP(dev)(base))(SEQ(print("nic setup ok"))(SCAN(base)(0)(8))))(sub(CFG(dev)(16))(mod(CFG(dev)(16))(4))))))(FIND(0))))
