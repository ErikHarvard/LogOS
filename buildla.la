# =====================================================================
#  buildla.la — A BUILD ORCHESTRATOR IN LINGUA ADAMICA.
#
#  build.sh is bash: a foreign shell script deciding what a sovereign,
#  self-hosting OS builds and whether it passed. That is the orchestration seam.
#  This is the first real slice of closing it — not a sketch: it drives ACTUAL
#  LogOS build stages and fails the build when one fails.
#
#  It was IMPOSSIBLE until 05ed1fe. The VM's execve took no argv (so LA could not
#  run `./tiny_host kernel.la`) and there was no dup2 (so a forked child's stdout
#  went to the parent's and LA could not CAPTURE what a step printed — and
#  build.sh's checks are 274 greps over captured stdout). With execv + dup2 the
#  whole cycle is expressible:
#
#      fork -> dup2 the child's stdout into a file -> execv CMD ARGS
#           -> waitpid -> read_file the output -> check it
#
#  ── WHAT A "STEP" IS ────────────────────────────────────────────────────────
#  cmd, args, and a marker the output must contain — the same shape as build.sh's
#  `X="$(./tiny_host foo.la)"; grep -q "marker"`. HASSUB is the grep.
#
#  ── WHAT THIS CLOSES, AND WHAT IT DOES NOT ──────────────────────────────────
#  CLOSES: the ORCHESTRATION logic — deciding what to run, running it, capturing
#  it, judging it, and failing the build. In LA, on the native VM, with no shell.
#  DOES NOT CLOSE: the TOOLS. Driving `./tiny_host` still runs the C host;
#  build.sh also invokes gcc, nasm (46x), ld, qemu and python3, and each is its
#  OWN seam (assembler [~], linker [ ], emulator [!]). "the build is orchestrated
#  by LA" must never come to mean "no foreign tools in the build".
#  DOES NOT YET COVER: 48 of build.sh's 103 stages. Real ones — the whole
#  autopoiesis stack, the toolchain, the spec pipeline that builds every module
#  spec-first, the compositor, and the trimodal language layer (visual+acoustic+
#  computational) — but not the whole audit. The rest is
#  mechanical volume, and the ROADMAP keeps the item [~] until it actually is
#  done. Steps needing more than `cmd args + a stdout marker` (byte-comparing
#  artifacts, QEMU gates, unshare) will need more than a STEP entry.
#
#  VM-only (fork/dup2/execv/waitpid are VM builtins): compile with codegen.la and
#  run on logos_secd. That is the bootstrap, not a cheat — build.sh seeds the VM
#  once, exactly as tiny_host seeds the first compiler.
# =====================================================================

glyph SEQ  = la a. la b. b
glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph TRUE = la t. la f. t
glyph FALSE = la t. la f. f
glyph AND  = la a. la b. a(b)(FALSE)
glyph CONS = la h. la t. la n. la c. c(h)(t)
glyph NIL  = la n. la c. n

# ── the grep: does the captured output contain the marker? ──
glyph SW = Z(la self. la s. la p.
    IF(str_eq(p)(""))(la _. TRUE)
      (la _. IF(str_eq(s)(""))(la _. FALSE)
               (la _. IF(str_eq(str_head(s))(str_head(p)))
                        (la _. self(str_tail(s))(str_tail(p)))
                        (la _. FALSE))))
glyph HASSUB = Z(la self. la s. la p.
    IF(SW(s)(p))(la _. TRUE)
      (la _. IF(str_eq(s)(""))(la _. FALSE)(la _. self(str_tail(s))(p))))

# ── RUN(cmd)(args)(out): the cycle execv+dup2 made expressible ──
#   O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577.
glyph RUN = la cmd. la args. la out.
  (la pid.
    IF(str_eq(pid)("0"))
      (la _. SEQ(dup2(open(out)("577"))("1"))(execv(cmd)(args)))
      (la _. SEQ(waitpid(pid))(read_file(out))))
  (fork("!"))

# ── a step: cmd, args, and the marker its output must contain ──
glyph STEP = la nm. la cmd. la args. la mark. la f. f(nm)(cmd)(args)(mark)
glyph SNAME = la s. s(la a. la b. la c. la d. a)
glyph SCMD  = la s. s(la a. la b. la c. la d. b)
glyph SARGS = la s. s(la a. la b. la c. la d. c)
glyph SMARK = la s. s(la a. la b. la c. la d. d)

# ── STAGING: the orchestrator prepares its own inputs (build.sh's `cp`) ──
#   asm.la reads asm_in.asm by convention, so the build must place it — that is
#   orchestration too, not just running things.
glyph STAGE = la src. la dst. write_file(dst)(read_file(src))

# ── REAL LogOS build stages — the same checks build.sh makes, same markers ──
#   Each is cmd + args + a marker the output must contain, i.e. build.sh's
#   `X="$(./tiny_host foo.la)"; grep -q "marker"`. These are not toy steps: they
#   are the autopoiesis stack and the toolchain, driven by LA.
glyph STEPS =
  # ── language core (Phase I): the built-in primitives — the SAME checks
  #    build.sh makes at 28–215, fixtures GEN'd to /tmp before ALL(STEPS) runs.
  #    Each marker is the FULL distinctive output; str_tail / str_head-of-empty
  #    are BRACKETED ([ello] / []) so a no-op bug cannot satisfy a substring gate.
  CONS(STEP("concat built-in")("./tiny_host")("/tmp/buildla_core_concat.la")("hello, world"))(
  CONS(STEP("str_tail built-in")("./tiny_host")("/tmp/buildla_core_strtail.la")("[ello]"))(
  CONS(STEP("str_head of the empty string")("./tiny_host")("/tmp/buildla_core_strheademp.la")("[]"))(
  CONS(STEP("str_eq — the negative branch")("./tiny_host")("/tmp/buildla_core_streq2.la")("not equal"))(
  CONS(STEP("Z combinator — REVERSE via fixed point")("./tiny_host")("/tmp/buildla_core_z.la")("edcba"))(
  CONS(STEP("native integers — add/div/mod/lt + FACT(5) via Z")("./tiny_host")("/tmp/buildla_core_int.la")("fact5=120"))(
  CONS(STEP("read_file built-in")("./tiny_host")("/tmp/buildla_core_rf.la")("test content"))(
  CONS(STEP("write_file built-in")("./tiny_host")("/tmp/buildla_core_wf.la")("written by LogOS"))(
  CONS(STEP("read -> write -> read round-trip")("./tiny_host")("/tmp/buildla_core_rt.la")("round trip data"))(
  CONS(STEP("kernel speaks the Word")("./tiny_host")("kernel.la")("I AM THAT I AM"))(
  CONS(STEP("bounded self-repair (B3)")("./tiny_host")("selfrepair.la")("byte-identical-to-pre-corruption=T"))(
  CONS(STEP("self-modification")("./tiny_host")("selfmod.la")("changed=T"))(
  CONS(STEP("self-programming")("./tiny_host")("selfprog.la")("WROTE  TWELVE"))(
  CONS(STEP("self-optimization")("./tiny_host")("selfopt.la")("gain 2"))(
  CONS(STEP("runtime self-verification")("./tiny_host")("selfwatch.la")("ledger: ..R.."))(
  CONS(STEP("self-documentation")("./tiny_host")("selfdoc.la")("glyphs, read from the form itself"))(
  CONS(STEP("ELF emitter (Albedo Stage 1)")("./tiny_host")("elf.la")("emitted logos_native"))(
  CONS(STEP("assembler runs")("./tiny_host")("asm.la")("asm.la assembled"))(
  CONS(STEP("LA-native toolchain emits a binary")("./tiny_host")("asmelf.la")("no nasm, no ld"))(
  CONS(STEP("self-verifying spec table")("./tiny_host")("metadebug.la")("T5_self: T"))(
  CONS(STEP("spec pipeline deploys a module")("./tiny_host")("specpipe.la")("module VERIFIED"))(
  CONS(STEP("type checker REJECTS an ill-typed module")("./tiny_host")("typed_spec.la")("module REJECTED"))(
  CONS(STEP("nine primitives (autology)")("./tiny_host")("primitives_spec.la")("module VERIFIED"))(
  CONS(STEP("kappa — canonicalization")("./tiny_host")("canon_spec.la")("module VERIFIED"))(
  CONS(STEP("three laws of thought")("./tiny_host")("metalogic_spec.la")("module VERIFIED"))(
  CONS(STEP("AATC — autological adequacy")("./tiny_host")("aatc_spec.la")("module VERIFIED"))(
  CONS(STEP("SWC well-foundedness checker")("./tiny_host")("swc_spec.la")("module VERIFIED"))(
  CONS(STEP("glyph-DAG — the compressing form")("./tiny_host")("glyphdag_spec.la")("module VERIFIED"))(
  CONS(STEP("PSC* — phonosemantic invariants")("./tiny_host")("psc_spec.la")("module VERIFIED"))(
  CONS(STEP("TopoEmbed — visual invariants")("./tiny_host")("topoembed_spec.la")("module VERIFIED"))(
  CONS(STEP("pragmatics — the USE branch")("./tiny_host")("pragmatics_spec.la")("module VERIFIED"))(
  CONS(STEP("deixis — context-dependent reference")("./tiny_host")("deixis_spec.la")("module VERIFIED"))(
  CONS(STEP("string utilities from a spec")("./tiny_host")("strutil_spec.la")("module VERIFIED"))(
  CONS(STEP("evdev input module from a spec")("./tiny_host")("evdev_spec.la")("module VERIFIED"))(
  CONS(STEP("module isolation (privates don't leak)")("./tiny_host")("app.la")("app-value"))(
  CONS(STEP("cross-engine import isolation")("./tiny_host")("greetapp.la")("module-importer / mine:-importer"))(
  CONS(STEP("LogosIPC typed message bus")("./tiny_host")("ipc_demo.la")("typed-ok: yes"))(
  CONS(STEP("capability gating DENIES a foreign realm")("./tiny_host")("logoscap.la")("foreign capability = denied"))(
  CONS(STEP("sealed monoglyph (autological)")("./tiny_host")("seal_test.la")("seal-autological: YES"))(
  CONS(STEP("Theourgia 1 — surface composition")("./tiny_host")("theourgia.la")("composed 32x24 desktop -> canvas.ppm"))(
  CONS(STEP("Theourgia 3 — framebuffer bridge")("./tiny_host")("theourgia_fb.la")("(XRGB8888, 26 rows x 160 pitch)"))(
  CONS(STEP("Theourgia 4 — evdev decode (signed)")("./tiny_host")("theourgia_input.la")("rel x: type=2 code=0 value=-3"))(
  CONS(STEP("Theourgia 5 — session reducer")("./tiny_host")("theourgia_session.la")("session: window at 6 5"))(
  CONS(STEP("Theourgia 6 — poll multiplexing")("./tiny_host")("theourgia_poll.la")("fd 7: type=2 code=0 value=-3"))(
  CONS(STEP("Theourgia 7 — multiplexed session")("./tiny_host")("theourgia_mux_session.la")("mux-session: window at 5 5"))(
  CONS(STEP("Theourgia 8 — text rendering")("./tiny_host")("theourgia_text.la")("onto a 24x12 surface -> text.ppm"))(
  CONS(STEP("visual modality — the nine sigils")("./tiny_host")("sigil.la")("the lemniscate (infinity)"))(
  CONS(STEP("acoustic oracle — formants measured")("./tiny_host")("goertzel.la")("formants>50x-control: 3/3"))(
  CONS(STEP("meta-alphabet — the evaluator is a glyph")("./tiny_host")("metaglyph.la")("𝓡(𝓡) ≡ 𝓡 ? YES"))(
  CONS(STEP("denotational semantics (compositional)")("./tiny_host")("denote.la")("↻(BEING)≡SELF-denotationally:T"))(
  CONS(STEP("monosemy — no polysemy")("./tiny_host")("monosemy_test.la")("distinct? YES (no polysemy)"))(
  CONS(STEP("ONF graph features (automorphism)")("./tiny_host")("onf.la")("0/1/0/1/Y/SELF,SELF,"))(
  CONS(STEP("Cycle of Being — 3 beats observed")("./tiny_host")("cob.la")("[3 leaves survive+injective]: YES"))(
  CONS(STEP("archroot — the chain does NOT generate the nine")("./tiny_host")("archroot.la")("The chain does NOT generate the nine."))(
  CONS(STEP("phonological modality — the nine phonyms")("./tiny_host")("phonym.la")("9 primitives + 3 GENERATED + 2 modes + the evaluator 𝓡"))(
  CONS(STEP("phonosemantics — alignment vs fidelity")("./tiny_host")("phonsem.la")("injective(SET) Theta_P = 8 / 8"))(
  CONS(STEP("derived geometry from ONF features")("./tiny_host")("topoderive.la")("@@@ Nest3 ⊂(VOID,⊂(FORM,DEPTH))"))(
  NIL)))))))))))))))))))))))))))))))))))))))))))))))))))))))))

# ── a GUARD step: the build's THIRD kind of gate — the EXIT CODE ────────────
#  A marker step asks "did it say the right thing?"; a cross-engine step asks
#  "do both engines say the same thing?". Neither can ask the question the
#  loud-failure discipline turns on: "did it FAIL, correctly, and say why?"
#  build.sh's guard set does exactly that — feed a broken program, assert a
#  non-zero exit AND the specific diagnostic — and so does the DEPTH(DEPTH)
#  gate, whose whole content is that it must NOT terminate (timeout, rc 124).
#
#  Two things RUN cannot do, so GRUN uses RUN2:
#   1. RUN captures only stdout (dup2 ... "1") — but every diagnostic goes to
#      STDERR. RUN2 redirects BOTH fds into the one capture file.
#   2. RUN discards waitpid's result (SEQ) — the exit code IS the gate here.
#      RUN2 returns it. (Verified: waitpid yields the CODE directly, already
#      decoded — timeout->124, a failing host->1, kernel->0 — not a raw wait
#      status needing WEXITSTATUS.)
#
#  ★ Why an empty marker is ALLOWED here, unlike a marker step: a marker step's
#  only discriminator is HASSUB, and "" is contained in every output — vacuous,
#  hence the guard. A guard step's discriminator is EXACT CODE EQUALITY, which
#  is never vacuous: `str_eq(code)("124")` is a real gate on its own. So the
#  code is checked ALWAYS and the marker only when given — which is what lets
#  DEPTH(DEPTH), whose output is empty by construction, be gated honestly.
glyph GEN = la path. la content. write_file(path)(content)

glyph RUN2 = la cmd. la args. la out.
  (la pid.
    IF(str_eq(pid)("0"))
      (la _. (la fd. SEQ(dup2(fd)("1"))(SEQ(dup2(fd)("2"))(execv(cmd)(args))))(open(out)("577")))
      (la _. waitpid(pid)))
  (fork("!"))

glyph GSTEP = la nm. la cmd. la args. la code. la mark. la f. f(nm)(cmd)(args)(code)(mark)
glyph GNAME = la s. s(la a. la b. la c. la d. la e. a)
glyph GCMD  = la s. s(la a. la b. la c. la d. la e. b)
glyph GARGS = la s. s(la a. la b. la c. la d. la e. c)
glyph GCODE = la s. s(la a. la b. la c. la d. la e. d)
glyph GMARK = la s. s(la a. la b. la c. la d. la e. e)

glyph GSTEPS =
  CONS(GSTEP("DEPTH(DEPTH) must NOT terminate (rc 124)")("/usr/bin/timeout")("4 ./tiny_host /tmp/buildla_g_depth.la")("124")(""))(
  CONS(GSTEP("str_to_int REJECTS a non-decimal")("./tiny_host")("/tmp/buildla_g_int.la")("1")("str_to_int: not a decimal integer"))(
  CONS(GSTEP("chr REJECTS a byte out of range")("./tiny_host")("/tmp/buildla_g_chr.la")("1")("chr: value 300 out of byte range 0..255"))(
  NIL)))

glyph GRUN1 = la s.
  (la code.
    (la out.
      (la ok.
        SEQ(print(concat(IF(ok)(la _. "  PASS  rc  ")(la _. "  FAIL  rc  "))(GNAME(s))))(ok))
      (AND(str_eq(code)(GCODE(s)))(HASSUB(out)(GMARK(s)))))
    (read_file("/tmp/buildla_gout.txt")))
  (RUN2(GCMD(s))(GARGS(s))("/tmp/buildla_gout.txt"))

glyph GALL = Z(la self. la l.
  l(TRUE)(la h. la t. (la r. AND(r)(self(t)))(GRUN1(h))))

# ── a CROSS-ENGINE step: b_τ ≡ f_τ ──────────────────────────────────────────
#  build.sh's other big check is not a grep but an EQUALITY: `[ "$H" = "$V" ]` —
#  the same program must print the SAME BYTES on the C host and the native VM.
#  The two engines are each other's oracle. Agreement ALONE is not enough (both
#  could be identically wrong), so the marker still gates correctness: a step
#  passes iff the host output carries the marker AND the two engines agree.
#
#  ★★ IT MUST NOT RUN `./logos_secd`. That VM loads its program from the single
#  fixed path `logos_program.bin` — which DURING A BUILD IS THIS ORCHESTRATOR.
#  Running it makes the build run the build, forking at every level: a real fork
#  bomb (measured: 148,121 processes, load 27). The VM has no "run THIS program"
#  argument, so the program must be given its OWN VESSEL instead:
#      codegen -> logos_embed.bin -> bundle.la -> logos_app
#  a self-contained VM+stream binary (Albedo Stage 5, the proven route) that
#  carries its stream embedded and never reads logos_program.bin.
#
#  Two safety properties, both relied on deliberately:
#   1. The codegen step DISPLACES the orchestrator's stream from
#      logos_program.bin (it becomes the target program's), so even a bare VM
#      could not re-enter the build.
#   2. The bundle is CHECKED before it is run — if bundle.la did not report
#      success the step FAILs and logos_app is never executed, so a failed
#      bundle can never fall back into the orchestrator.
#  (Writing logos_program.bin under the running VM is safe: it drains its stream
#  into progbuf at startup. Verified — steps after a codegen step still judge.)
glyph XSTEP = la nm. la file. la mark. la f. f(nm)(file)(mark)
glyph XNAME = la s. s(la a. la b. la c. a)
glyph XFILE = la s. s(la a. la b. la c. b)
glyph XMARK = la s. s(la a. la b. la c. c)

glyph XSTEPS =
  CONS(XSTEP("meta-alphabet 𝓜")("metaglyph.la")("𝓡(𝓡) ≡ 𝓡 ? YES"))(
  CONS(XSTEP("denotational semantics")("denote.la")("↻(BEING)≡SELF-denotationally:T"))(
  CONS(XSTEP("monosemy — no polysemy")("monosemy_test.la")("distinct? YES (no polysemy)"))(
  CONS(XSTEP("evdev decode (signed)")("theourgia_input.la")("rel x: type=2 code=0 value=-3"))(
  NIL))))

glyph XRUN1 = la s.
  IF(str_eq(XMARK(s))(""))
    (la _. error(concat("buildla: cross-engine step has an empty marker (it could never fail): ")(XNAME(s))))
    (la _.
      (la hostOut.
        SEQ(STAGE(XFILE(s))("logos_source.la"))
        (SEQ(RUN("./tiny_host")("codegen.la")("/tmp/buildla_cg.txt"))
        (SEQ(STAGE("logos_program.bin")("logos_embed.bin"))
        ((la bout.
           IF(HASSUB(bout)("bundled VM + stream -> logos_app"))
             (la _.
               ((la vmOut.
                  (la ok.
                    SEQ(print(concat(IF(ok)(la _. "  PASS  host==VM  ")(la _. "  FAIL  host!=VM  "))(XNAME(s))))(ok))
                  (AND(HASSUB(hostOut)(XMARK(s)))(str_eq(hostOut)(vmOut))))
                (RUN("./logos_app")("")("/tmp/buildla_vm.txt"))))
             (la _. SEQ(print(concat("  FAIL  bundle failed, VM not run: ")(XNAME(s))))(FALSE)))
         (RUN("./tiny_host")("bundle.la")("/tmp/buildla_bundle.txt"))))))
      (RUN("./tiny_host")(XFILE(s))("/tmp/buildla_hostout.txt")))

glyph XALL = Z(la self. la l.
  l(TRUE)(la h. la t. (la r. AND(r)(self(t)))(XRUN1(h))))

# ── the guard: a step whose marker is EMPTY could never FAIL ──
#   HASSUB is substring containment, so an empty marker is contained in EVERY
#   output — the step would report PASS unconditionally, whatever the command
#   printed or however it died. That is a step that cannot fail, inside a tool
#   whose whole worth is that it can: BUILD GREEN would be a lie. An empty
#   marker is a broken build DEFINITION, not a failing step, so it must halt
#   loudly (as codegen.la does on a parse error) rather than report RED — and it
#   fires BEFORE the command runs, so a typo costs nothing to catch.
glyph RUN1 = la s.
  IF(str_eq(SMARK(s))(""))
    (la _. error(concat("buildla: step has an empty marker (it could never fail): ")(SNAME(s))))
    (la _.
      (la got.
        (la ok.
          SEQ(print(concat(IF(ok)(la _. "  PASS  ")(la _. "  FAIL  "))(SNAME(s))))(ok))
        (HASSUB(got)(SMARK(s))))
      (RUN(SCMD(s))(SARGS(s))("/tmp/buildla_out.txt")))

glyph ALL = Z(la self. la l.
  l(TRUE)(la h. la t. (la r. AND(r)(self(t)))(RUN1(h))))

# ── language-core fixtures: the .la programs (and two data files) that the
#    first nine marker steps run. A fixture is (path, content); FIX(GEN) writes
#    it. GENALL folds the list, forcing each write for effect (like ALL forces
#    RUN1) before the marker steps read the files back. \n is a real newline in
#    an .la string literal, exactly as the guard fixtures rely on.
glyph FIX = la p. la c. la f. f(p)(c)
glyph COREFIX =
  CONS(FIX("/tmp/buildla_core_concat.la")("glyph MAIN = print(concat(\"hello, \")(\"world\"))\n"))(
  CONS(FIX("/tmp/buildla_core_strtail.la")("glyph MAIN = print(concat(\"[\")(concat(str_tail(\"hello\"))(\"]\")))\n"))(
  CONS(FIX("/tmp/buildla_core_strheademp.la")("glyph MAIN = print(concat(\"[\")(concat(str_head(\"\"))(\"]\")))\n"))(
  CONS(FIX("/tmp/buildla_core_streq2.la")("glyph MAIN = print(str_eq(\"abc\")(\"xyz\")(\"equal\")(\"not equal\"))\n"))(
  CONS(FIX("/tmp/buildla_core_z.la")("glyph Z = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))\nglyph IF = la cond. la t. la f. cond(t)(f)(\"!\")\nglyph REVERSE = Z(la self. la s. IF(str_eq(s)(\"\"))(la _. \"\")(la _. concat(self(str_tail(s)))(str_head(s))))\nglyph MAIN = print(REVERSE(\"abcde\"))\n"))(
  CONS(FIX("/tmp/buildla_core_int.la")("glyph IF  = la c. la t. la f. c(t)(f)(\"!\")\nglyph SEQ = la a. la b. b\nglyph Z   = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))\nglyph FACT = Z(la self. la n. IF(int_eq(n)(0))(la _. 1)(la _. mul(n)(self(sub(n)(1)))))\nglyph MAIN = SEQ(print(int_to_str(add(2)(3))))(SEQ(print(int_to_str(div(17)(5))))(SEQ(print(int_to_str(mod(17)(5))))(SEQ(print(IF(lt(3)(5))(la _. \"less\")(la _. \"no\")))(print(concat(\"fact5=\")(int_to_str(FACT(5))))))))\n"))(
  CONS(FIX("/tmp/buildla_rf_input.txt")("test content"))(
  CONS(FIX("/tmp/buildla_core_rf.la")("glyph MAIN = print(read_file(\"/tmp/buildla_rf_input.txt\"))\n"))(
  CONS(FIX("/tmp/buildla_core_wf.la")("glyph MAIN = print(write_file(\"/tmp/buildla_wf_output.txt\")(\"written by LogOS\"))\n"))(
  CONS(FIX("/tmp/buildla_rt_src.txt")("round trip data"))(
  CONS(FIX("/tmp/buildla_core_rt.la")("glyph SEQ = la a. la b. b\nglyph MAIN = SEQ(write_file(\"/tmp/buildla_rt_dst.txt\")(read_file(\"/tmp/buildla_rt_src.txt\")))(print(read_file(\"/tmp/buildla_rt_dst.txt\")))\n"))(
  NIL)))))))))))

glyph GENALL = Z(la self. la l.
  l(TRUE)(la h. la t. (la _. self(t))(h(GEN))))

glyph MAIN =
  SEQ(print("── buildla.la: the build, orchestrated in Lingua Adamica (no shell) ──"))
  (SEQ(STAGE("asm_test_org.asm")("asm_in.asm"))
  ((la ok.
     IF(ok)
       (la _. print("  BUILD GREEN — every step ran and said what it must, driven by LA"))
       (la _. SEQ(print("  BUILD RED — a step failed"))(exit("1"))))
   # Three gate kinds, in order: marker (did it say the right thing?),
   # cross-engine (do both engines say the SAME thing?), guard (did it FAIL,
   # correctly, and say why?). AND is over ALL THREE, and none short-circuits
   # another's reporting: every step runs and reports — one failure must not
   # mask the rest.
   ((la a.
     (la b.
       (la c. AND(a)(AND(b)(c)))
       (SEQ(print("── guards: the loud-failure discipline — it must FAIL, and say why ──"))
         (SEQ(GEN("/tmp/buildla_g_depth.la")("glyph D = la g. g(g)\nglyph MAIN = D(D)\n"))
         (SEQ(GEN("/tmp/buildla_g_int.la")("glyph MAIN = print(str_to_int(\"12x\"))\n"))
         (SEQ(GEN("/tmp/buildla_g_chr.la")("glyph MAIN = print(chr(\"300\"))\n"))
           (GALL(GSTEPS)))))))
     (SEQ(print("── cross-engine: the same program, the same bytes, on host and VM ──"))(XALL(XSTEPS))))
    (SEQ(print("── language core: the built-in primitives (fixtures GEN'd to /tmp) ──"))
      (SEQ(GENALL(COREFIX))(ALL(STEPS)))))))
