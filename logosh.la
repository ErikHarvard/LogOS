# ═══════════════════════════════════════════════════════════════════
#  logosh.la — the shell of the Stage 10 terminals: parsing, builtins,
#  PATH search, and starting real programs (Theourgia Stage 10).
#
#  Every window of the tiling window manager is a terminal, and every terminal
#  runs this shell. It takes one line at a time (the terminal's line editor
#  hands it over on Enter), runs a builtin in-process, or starts a real program
#  whose stdout and stderr come back through a pipe that the WM's single poll
#  loop reads, so a running command never freezes the screen.
#
#  TWO KITS (WM_DESIGN.md "logosh.la"; kit style, builtins as parameters).
#
#  SHELL_PURE_KIT(concat)(str_at)(str_len)(str_eq)(str_to_int)(add)(sub)(div)
#                (lt)(int_eq)
#    host and VM. Returns the record   la sel. sel(parse)(normpath)
#      parse(line)          Scott list of words. Words are split on spaces and
#                           tabs (runs of them; leading and trailing ones are
#                           ignored). "..." groups: spaces and tabs inside are
#                           kept and the quotes are dropped, so a"b c"d is the
#                           one word ab cd, and "" is an empty word. A
#                           backslash escapes the next character, inside quotes
#                           too (\" \\ \ ); a trailing backslash is a literal
#                           backslash; an unterminated quote runs to the end.
#      normpath(cwd)(path)  the absolute path: a path starting with / replaces
#                           cwd, any other is appended to it; empty segments
#                           (repeated /) and . are dropped, .. removes the
#                           segment before it, and .. at / stays at /. cwd is
#                           resolved the same way (a relative cwd hangs off /).
#
#  SHELL_KIT(concat)(str_at)(str_len)(str_eq)(ord)(str_to_int)(int_to_str)
#           (add)(sub)(mul)(div)(mod)(lt)(int_eq)
#           (read_file)(stat)(mkdir)(rmdir)(unlink)(rename)(getpid)
#           (pipe)(fork)(dup2)(open)(close)(execv)(exit)(sigprocmask)
#           (waitpid)(kill)(poll)
#    VM only (it takes the VM's process builtins, so it is never constructed
#    on the host). Returns the record
#      la sel. sel(new)(prompt)(run)(finish)(interrupt)(hangup)
#      new(cwd)        shell state; cwd is normalised (normpath from /)
#      prompt(sh)      "logos:" ++ cwd ++ "$ ", e.g. "logos:/home/user$ "
#      run(sh)(line)   la k. k(sh')(output)(action). output is "" or text
#                      ending in \n (error messages too: the terminal has one
#                      stream). action, Scott-encoded:
#                        la none. la clear. la exit. la job. none   (etc.)
#                      with job(pid)(rfd) for a started program.
#      finish(sh)(pid) waits for the job and reaps it: la k. k(sh')(text),
#                      text "" on exit 0, "[exit N]\n", or "[signal N]\n".
#      interrupt(pid)  SIGINT; returns kill's answer ("0" or "-errno")
#      hangup(pid)     SIGTERM, then SIGCONT (so a stopped job dies too), for
#                      closing a window; returns the SIGTERM answer
#
#  SHARED VALUES. The shell state is the record  la k. k(cwd)(status), so the
#  WM reads the directory for a title bar as  sh(la c. la s. c). status is the
#  last command's: 0 for a builtin that succeeded (clear and exit too), 1 for
#  one that failed or a program run refused, 126 not executable, 127 not
#  found, N for [exit N], 128+N for [signal N]; an empty line and a started
#  job leave it unchanged until finish. pid and rfd are DECIMAL STRINGS (what
#  fork and pipe return; what read, poll, kill take).
#
#  HOW THE WM USES A JOB. run starts the program and returns job(pid)(rfd)
#  without reading anything. The WM polls rfd with its other fds, reads it
#  (read(rfd)(n)) until read returns "" (EOF: the program and everything it
#  started have closed the pipe), CLOSES rfd itself (finish is not given it),
#  and then calls finish(sh)(pid), which blocks until the program has exited.
#  interrupt and hangup may be called at any time before finish. Several jobs
#  may run at once (one per window); each has its own pipe.
#
#  BUILTINS. help, echo, cd [DIR] (no DIR: /), pwd, cat FILE..., mkdir DIR...,
#  rmdir DIR..., rm FILE..., mv SRC DST (into DST if it is a directory), pid
#  (the WM's own pid), word (I AM THAT I AM), clear, exit. Errors read
#  "logosh: CMD: ARG: no such file or directory" (errno named for the common
#  ones, "error N" otherwise). cd is checked with stat; the shell keeps its own
#  working directory because the VM has no chdir. The builtin cat reads only
#  regular files up to 1 MiB (read_file runs inside the WM, so a FIFO or
#  /dev/zero would freeze it); /bin/cat streams anything through the pipe.
#
#  PROGRAMS. Any other word is a program: a word containing / is a path,
#  relative to the working directory; otherwise it is looked up in /bin,
#  /usr/bin, /usr/local/bin, /sbin, /usr/sbin with stat (a regular file with an
#  execute bit). Not found: "logosh: NAME: command not found". The parent does
#  pipe + fork; the child runs ONLY this fixed sequence and never returns into
#  the WM's code:
#      sigprocmask(SETMASK, {})       a WM that blocks signals for a signalfd
#                                     would otherwise pass SIGINT/SIGTERM
#                                     blocked to every job
#      open /dev/null; dup2 -> 0      stdin is /dev/null (close 0 if no /dev)
#      dup2(wfd) -> 1, 2              stdout and stderr into the pipe
#      close 3..255                   the WM's fds (DRM, evdev, other jobs'
#                                     pipes) do not leak into the program
#      execv("/usr/bin/env")("-C <cwd> <path> <args...>")
#      exit 127                       only if execv failed
#  then the parent closes wfd. env -C runs the program in the shell's working
#  directory; env replaces itself with the program, so pid is the program.
#
#  WAITING. The VM's waitpid returns WEXITSTATUS only (measured: a child killed
#  by SIGTERM reports 0, as exit 0 does), so finish reads the zombie's
#  /proc/<pid>/stat first: its last field is the raw wait status. It polls that
#  file (poll("")(ms), backing off 1..64 ms) until the state is Z, takes the
#  status, then reaps with waitpid. Without /proc, with a /proc that belongs
#  to another pid namespace (/proc/self/stat does not name getpid; there
#  /proc/<pid> is some other process), or for a pid that is not this
#  process's child, it falls back to waitpid (and a signal shows as exit 0).
#  A pid that SAFETY below refuses is never waited for: finish returns "" (a
#  wait for pid 0 or -1 would reap some other job and take its status).
#
#  SAFETY. Every path handed to a VM builtin is shorter than 4096 bytes (the
#  VM halts the whole process on a longer one: here that would be the WM);
#  execv's argument string stays under 2048 bytes and 200 words (its limits).
#  interrupt and hangup refuse ("-3") a pid that is not 1 to 18 digits with a
#  value in 1 .. 2^31-1, and refuse the WM's own ("-1"): the VM passes the
#  number to the kernel as 64 bits and the kernel reads the low 32 as a signed
#  pid_t, so "0", "4294967296" (pid 0) or "4294967295" (pid -1) would signal
#  the WM's process group or every process.
#
#  WHERE THIS DEPARTS FROM WM_DESIGN.md (all measured on the VM):
#    - The design's execv("/usr/bin/env")("env -C <cwd> <path> <args...>")
#      passes "-C <cwd> ..." instead: the VM's execv already supplies argv[0]
#      (the path) and the string is argv[1..] (execv("/bin/echo")("a b c")
#      prints "a b c"), so a leading "env" would make env run env.
#    - The design says waitpid returns the raw wait status; this VM's returns
#      WEXITSTATUS, hence /proc above.
#    - Additions the design leaves open: the sigprocmask reset and the fd
#      closing in the child, the cat limits, the refusals below, the guards
#      above, the state record, and decimal-string pid/rfd.
#
#  PERFORMANCE (WM_DESIGN.md "How fast the VM is"). Kit style: builtins and
#  integer constants are parameters bound once while a kit is built, Z is bound
#  once as a local, and every function is let-bound, so after a kit returns no
#  operation names a glyph or a builtin (a gdb trap on the VM's glyph-table
#  lookup counts the same names for 1 and 3 rounds of every operation).
#  Booleans are applied to thunks and a dummy; strings are built with a
#  balanced join. Measured on the VM (a loaded 4-CPU machine): parse of a
#  28-byte line 0.44 ms, normpath 0.38 ms, run of echo 0.24 ms, pwd 0.06 ms,
#  cd 0.41 ms, cat of a small file 0.53 ms, a PATH miss in all five
#  directories 0.40 ms; a whole /bin/true job (run, read to EOF, close,
#  finish) 21 ms, nearly all of it fork, the two execs and the exit. All of it
#  runs once per Enter, not per frame.
#
#  OUT OF SCOPE (honestly). No pipes between commands, redirection, globbing,
#  variables, ~, single quotes (a ' is an ordinary character), job control or
#  background jobs, rm -r. execv splits its argument string on spaces, so a
#  program cannot be given an empty argument or one containing a space, nor
#  be started while the working directory's name has a space: run refuses
#  those with a message rather than splitting them silently. A program path
#  containing = is refused too (env would take it for an assignment). Jobs get
#  an empty environment (the VM's execv passes none). Signals reach the job's
#  process only, not programs it started (no process groups), and a job that
#  ignores SIGTERM survives hangup. A job inherits IGNORED signal dispositions
#  from the WM (the VM cannot reset them), so start the WM in the foreground.
#
#  gate_wm_shell.sh: parse and normpath against hand-derived answers and a
#  Python model (host and VM), and a VM driver that runs a scripted session of
#  every builtin and program case through run/finish/interrupt/hangup.
# ═══════════════════════════════════════════════════════════════════

export SHELL_PURE_KIT SHELL_KIT

glyph Z   = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph LET = la v. la f. f(v)

# SH_CORE(builtins)(k): the pure layer both kits share. It builds the helpers
# once and passes them on:
#   k(C0)(C1)(C2)(TT)(FF)(NIL)(CONS)(REV)(JOIN)(LEN)(SUBSTR)(FINDCH)(SEGS)
#    (PARSE)(NORM)
glyph SH_CORE = la concat. la str_at. la str_len. la str_eq. la str_to_int.
    la add. la sub. la div. la lt. la int_eq. la k.
  LET(Z)(la Y.
  LET(0)(la C0. LET(1)(la C1. LET(2)(la C2.
  LET(la t. la f. t)(la TT.
  LET(la t. la f. f)(la FF.
  LET(la n. la c. n(n))(la NIL.
  LET(la h. la tl. la n. la c. c(h)(tl))(la CONS.
  LET(Y(la go. la l. la acc. l(la _. acc)(la h. la tl. go(tl)(CONS(h)(acc)))))(la REVA.
  LET(la l. REVA(l)(NIL))(la REV.
  # JOIN: balanced concatenation (neighbours paired until one string is left),
  # so each byte is copied O(log n) times.
  LET(Y(la pairs. la l. l(la _. NIL)(la a. la tl.
        tl(la _. CONS(a)(NIL))(la b. la t2. CONS(concat(a)(b))(pairs(t2))))))(la PAIRS.
  LET(Y(la join. la l. l(la _. "")(la a. la tl.
        tl(la _. a)(la b. la t2. join(PAIRS(l))))))(la JOIN.
  LET(la s. str_to_int(str_len(s)))(la LEN.
  # SUBSTR(s)(lo)(hi): bytes lo..hi-1 of s, joined by halving.
  LET(la s. Y(la sp. la lo. la hi.
        lt(lo)(hi)
          (la _. int_eq(sub(hi)(lo))(C1)
             (la _. str_at(s)(lo))
             (la _. (la mid. concat(sp(lo)(mid))(sp(mid)(hi)))(div(add(lo)(hi))(C2)))(C0))
          (la _. "")(C0)))(la SUBSTR.
  # FINDCH(s)(c)(i): the first index >= i holding byte c, else the length of s.
  LET(la s. la c. (la n. Y(la go. la i.
        lt(i)(n)
          (la _. str_eq(str_at(s)(i))(c)(la _. i)(la _. go(add(i)(C1)))(C0))
          (la _. n)(C0)))(LEN(s)))(la FINDCH.
  # SEGS(s): the non-empty segments of s between slashes, in order.
  LET(la s. (la n. (la push. Y(la go. la i. la lo. la acc.
          lt(i)(n)
            (la _. str_eq(str_at(s)(i))("/")
                (la _. go(add(i)(C1))(add(i)(C1))(push(lo)(i)(acc)))
                (la _. go(add(i)(C1))(lo)(acc))(C0))
            (la _. REV(push(lo)(n)(acc)))(C0))(C0)(C0)(NIL))
        (la lo. la hi. la acc. lt(lo)(hi)(la _. CONS(SUBSTR(s)(lo)(hi))(acc))(la _. acc)(C0)))
      (LEN(s)))(la SEGS.
  # RESOLVE(stack)(segs): the stack holds a directory's segments, last first;
  # . is dropped, .. pops (and stays put at /), anything else is pushed.
  LET(Y(la res. la st. la l. l(la _. st)(la h. la tl.
        str_eq(h)(".")
          (la _. res(st)(tl))
          (la _. str_eq(h)("..")
              (la _. res(st(la _. NIL)(la a. la b. b))(tl))
              (la _. res(CONS(h)(st))(tl))(C0))(C0))))(la RESOLVE.
  LET(la st. st(la _. "/")(la h. la tl.
        JOIN(Y(la go. la s. la acc. s(la _. acc)(la a. la b. go(b)(CONS("/")(CONS(a)(acc)))))(st)(NIL))))(la BUILD.
  LET(la cwd. la path.
        BUILD(RESOLVE(str_eq(str_at(path)(C0))("/")
                        (la _. NIL)
                        (la _. RESOLVE(NIL)(SEGS(cwd)))(C0))
                     (SEGS(path))))(la NORM.
  # PARSE: one left-to-right scan. q = inside quotes; has = a word is open (a
  # word can be empty: ""); cur = its characters, last first; ws = the words,
  # last first.
  LET(la c. str_eq(c)(" ")(TT)(str_eq(c)("\t")))(la ISSEP.
  LET(la has. la cur. la ws. has(la _. CONS(JOIN(REV(cur)))(ws))(la _. ws)(C0))(la ENDW.
  LET(la line. (la n. Y(la go. la i. la q. la has. la cur. la ws.
        lt(i)(n)
          (la _. (la c. (la i1.
              str_eq(c)("\\")
                (la _. lt(i1)(n)
                    (la _. go(add(i1)(C1))(q)(TT)(CONS(str_at(line)(i1))(cur))(ws))
                    (la _. go(i1)(q)(TT)(CONS(c)(cur))(ws))(C0))
                (la _. str_eq(c)("\"")
                    (la _. go(i1)(q(FF)(TT))(TT)(cur)(ws))
                    (la _. q(TT)(ISSEP(c)(FF)(TT))
                        (la _. go(i1)(q)(TT)(CONS(c)(cur))(ws))
                        (la _. go(i1)(FF)(FF)(NIL)(ENDW(has)(cur)(ws)))(C0))(C0))(C0))
              (add(i)(C1)))(str_at(line)(i)))
          (la _. REV(ENDW(has)(cur)(ws)))(C0))
        (C0)(FF)(FF)(NIL)(NIL))(LEN(line)))(la PARSE.
  k(C0)(C1)(C2)(TT)(FF)(NIL)(CONS)(REV)(JOIN)(LEN)(SUBSTR)(FINDCH)(SEGS)(PARSE)(NORM)
  ))))))))))))))))))))))

glyph SHELL_PURE_KIT = la concat. la str_at. la str_len. la str_eq. la str_to_int.
    la add. la sub. la div. la lt. la int_eq.
  SH_CORE(concat)(str_at)(str_len)(str_eq)(str_to_int)(add)(sub)(div)(lt)(int_eq)
    (la C0. la C1. la C2. la TT. la FF. la NIL. la CONS. la REV. la JOIN. la LEN.
     la SUBSTR. la FINDCH. la SEGS. la PARSE. la NORM.
       la sel. sel(PARSE)(NORM))

glyph SHELL_KIT = la concat. la str_at. la str_len. la str_eq. la ord. la str_to_int. la int_to_str.
    la add. la sub. la mul. la div. la mod. la lt. la int_eq.
    la read_file. la stat. la mkdir. la rmdir. la unlink. la rename. la getpid.
    la pipe. la fork. la dup2. la open. la close. la execv. la exit. la sigprocmask.
    la waitpid. la kill. la poll.
  SH_CORE(concat)(str_at)(str_len)(str_eq)(str_to_int)(add)(sub)(div)(lt)(int_eq)
  (la C0. la C1. la C2. la TT. la FF. la NIL. la CONS. la REV. la JOIN. la LEN.
   la SUBSTR. la FINDCH. la SEGS. la PARSE. la NORM.
  LET(Z)(la Y.
  LET(3)(la C3. LET(4)(la C4. LET(8)(la C8. LET(9)(la C9. LET(10)(la C10.
  LET(16)(la C16. LET(36)(la C36. LET(48)(la C48. LET(49)(la C49. LET(50)(la C50.
  LET(64)(la C64. LET(126)(la C126. LET(127)(la C127. LET(128)(la C128.
  LET(200)(la C200. LET(256)(la C256. LET(2048)(la C2048. LET(4096)(la C4096.
  LET(1048576)(la CMAXCAT. LET(19)(la C19. LET(2147483648)(la CPIDLIM.
  LET(sub(0)(1))(la CM1.

  # ── small tools ──
  LET(la a. la b. b)(la SEQ.
  LET(la a. la b. la k. k(a)(b))(la PAIR.
  LET(la s. la c. lt(FINDCH(s)(c)(C0))(LEN(s)))(la HAS.
  LET(Y(la cnt. la l. l(la _. C0)(la h. la tl. add(C1)(cnt(tl)))))(la COUNT.
  LET(Y(la map. la f. la l. l(la _. NIL)(la h. la tl. CONS(f(h))(map(f)(tl)))))(la MAP.
  LET(Y(la any. la p. la l. l(la _. FF)(la h. la tl. p(h)(la _. TT)(la _. any(p)(tl))(C0))))(la ANY.
  # SPACED(l): the words of l with " " between them (JOIN it for one string).
  LET(Y(la go. la l. l(la _. NIL)(la h. la tl.
        CONS(h)(tl(la _. NIL)(la a. la b. CONS(" ")(go(tl)))))))(la SPACED.
  # LASTOF(l)(d): the last element of l, d if l is empty.
  LET(Y(la last. la l. la d. l(la _. d)(la h. la tl. last(tl)(h))))(la LASTOF.
  # NUM(s): a string of 1 to 18 digits as an int, else -1. (str_to_int halts
  # the whole VM on a malformed string; NUM is for text the shell did not make.
  # 18 digits cannot overflow the VM's 64-bit ints; 20 could wrap to anything.)
  LET(la s. (la n. lt(C0)(n)(lt(n)(C19))(FF)
        (la _. Y(la go. la i. la acc.
            lt(i)(n)
              (la _. (la d. lt(d)(C0)(TT)(lt(C9)(d))
                  (la _. CM1)
                  (la _. go(add(i)(C1))(add(mul(acc)(C10))(d)))(C0))
                (sub(str_to_int(ord(str_at(s)(i))))(C48)))
              (la _. acc)(C0))(C0)(C0))
        (la _. CM1)(C0))(LEN(s)))(la NUM.
  # PIDNUM(s): NUM(s) if the kernel reads it as that same positive pid, else -1.
  # The VM hands a pid string to the syscall as a 64-bit number and the kernel
  # takes the low 32 bits as a signed pid_t: 4294967296 would be pid 0 (the
  # WM's process group) and 4294967295 pid -1 (every process). 1 .. 2^31-1.
  LET(la s. (la n. lt(C0)(n)(lt(n)(CPIDLIM))(FF)(la _. n)(la _. CM1)(C0))(NUM(s)))(la PIDNUM.
  # LASTCH(s)(c): the last index of byte c in s, else -1.
  LET(la s. la c. Y(la go. la i.
        lt(i)(C0)
          (la _. CM1)
          (la _. str_eq(str_at(s)(i))(c)(la _. i)(la _. go(sub(i)(C1)))(C0))(C0))
      (sub(LEN(s))(C1)))(la LASTCH.
  # TOKEN(s)(p)(k): field k of a space-separated line, field 0 starting at p;
  # a field ends at a space or a newline; "" past the end.
  LET(la s. la p. la k. (la n. (la fend.
        Y(la go. la i. la j.
          int_eq(j)(k)
            (la _. SUBSTR(s)(i)(fend(i)))
            (la _. lt(i)(n)(la _. go(add(fend(i))(C1))(add(j)(C1)))(la _. "")(C0))(C0))(p)(C0))
      (Y(la fe. la i.
          lt(i)(n)
            (la _. (la c. str_eq(c)(" ")(TT)(str_eq(c)("\n"))(la _. i)(la _. fe(add(i)(C1)))(C0))(str_at(s)(i)))
            (la _. n)(C0))))(LEN(s)))(la TOKEN.

  # ── errors ──
  LET(CONS(PAIR(1)("operation not permitted"))
     (CONS(PAIR(2)("no such file or directory"))
     (CONS(PAIR(5)("input/output error"))
     (CONS(PAIR(13)("permission denied"))
     (CONS(PAIR(16)("device or resource busy"))
     (CONS(PAIR(17)("file exists"))
     (CONS(PAIR(18)("cannot move across file systems"))
     (CONS(PAIR(20)("not a directory"))
     (CONS(PAIR(21)("is a directory"))
     (CONS(PAIR(22)("invalid argument"))
     (CONS(PAIR(28)("no space left on device"))
     (CONS(PAIR(30)("read-only file system"))
     (CONS(PAIR(36)("file name too long"))
     (CONS(PAIR(39)("directory not empty"))
     (CONS(PAIR(40)("too many levels of symbolic links"))(NIL))))))))))))))))(la ERRTAB.
  LET(Y(la find. la e. la l. l(la _. concat("error ")(int_to_str(e)))
        (la h. la tl. h(la n. la m. int_eq(n)(e)(la _. m)(la _. find(e)(tl))(C0)))))(la ERRFIND.
  LET(la e. ERRFIND(e)(ERRTAB))(la ERRMSG.
  LET(la r. sub(C0)(str_to_int(r)))(la ERRNO.
  LET(la cmd. la msg. concat("logosh: ")(concat(cmd)(concat(": ")(concat(msg)("\n")))))(la ERR2.
  LET(la cmd. la arg. la msg. ERR2(cmd)(concat(arg)(concat(": ")(msg))))(la ERR3.

  # ── stat ──
  # STATX(p)(onerr)(onok): onok(mode)(size), or onerr(errno). A path of 4096
  # bytes or more is refused here (ENAMETOOLONG): the VM halts on one.
  LET(la p. la onerr. la onok.
        lt(LEN(p))(C4096)
          (la _. (la r. str_eq(str_at(r)(C0))("-")
              (la _. onerr(ERRNO(r)))
              (la _. (la sp. onok(str_to_int(SUBSTR(r)(C0)(sp)))(str_to_int(SUBSTR(r)(add(sp)(C1))(LEN(r)))))
                     (FINDCH(r)(" ")(C0)))(C0))(stat(p)))
          (la _. onerr(C36))(C0))(la STATX.
  # FTYPE: S_IFMT / 4096 — 8 regular file, 4 directory.
  LET(la m. mod(div(m)(C4096))(C16))(la FTYPE.
  LET(la m. lt(C0)(add(mod(m)(C2))(add(mod(div(m)(C8))(C2))(mod(div(m)(C64))(C2)))))(la XBIT.
  LET(la m. int_eq(FTYPE(m))(C8)(XBIT(m))(FF))(la ISEXEC.

  # ── shell state, results, actions ──
  LET(la c. la s. la k. k(c)(s))(la SH.
  LET(la sh. sh(la c. la s. c))(la CWD.
  LET(la sh. la s. sh(la c. la o. SH(c)(s)))(la SETST.
  LET(la sh. la out. la act. la k. k(sh)(out)(act))(la RES.
  LET(la n. la c. la e. la j. n)(la ANONE.
  LET(la n. la c. la e. la j. c)(la ACLEAR.
  LET(la n. la c. la e. la j. e)(la AEXIT.
  LET(la pid. la rfd. la n. la c. la e. la j. j(pid)(rfd))(la AJOB.
  LET(la sh. la out. la st. RES(SETST(sh)(st))(out)(ANONE))(la SAY.
  LET(la t. la k. k(TT)(t))(la GOOD.
  LET(la t. la k. k(FF)(t))(la BAD.

  # ── builtins ──
  # EACH(cmd)(f)(sh)(args): f(path)(arg) for each operand in order, each
  # returning GOOD(text) or BAD(text); the texts are joined, status 1 if any
  # was bad.
  LET(la cmd. la f. la sh. la args.
