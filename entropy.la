# =====================================================================
#  entropy.la — GLYPHIC ENTROPY, SEMANTIC ENTROPY, SYNTROPY, CENTROPY.
#
#  The project has enforced monosemy constructively since κ existed, but it has
#  never MEASURED it. This module names the two quantities and measures both.
#
#  ── THE TWO ENTROPIES ARE ONE JOINT DISTRIBUTION, SEEN TWICE ────────
#  Over the joint distribution of (form, meaning) there are exactly two
#  conditional entropies, and each is a different disease:
#
#      E_G  =  H(form | meaning)     the FORM drifts free of the sense
#                                    — the writing decays; this is what
#                                    alphabetic languages have and cannot lose,
#                                    because "dog" carries no bit of its own
#                                    derivation and is held to its meaning by
#                                    convention alone.
#
#      E_S  =  H(meaning | form)     the SENSE drifts free of the form
#                                    — the word decays; polysemy, the one word
#                                    that came to mean two things.
#
#  ★ κ IS A BIJECTION ⟺ E_G = 0 AND E_S = 0. This is not an analogy. Monosemy
#  IS the claim E_S ≡ 0. The triple bar between sign and referent IS the claim
#  E_G ≡ 0. The two halves of the language's founding property turn out to be
#  the two conditional entropies of one distribution — which is why they move
#  as one unit rather than as two facts that happen to agree.
#
#  ── SYNTROPY: THE OPERATIONS CANNOT INCREASE EITHER ─────────────────
#  A family of operations is SYNTROPIC in a register when no operation
#  increases the entropy of that register. Here: a collapse of two glyphs whose
#  form is already meaning-determined yields a glyph whose form is
#  meaning-determined — E_G is preserved, by construction, because COLLAPSE
#  re-derives the Ren from the etymology rather than carrying it along.
#
#  ── CENTROPY: SYNTROPY APPLIED TO ITSELF, AND ITS FIXED POINT ───────
#  Centropy is what syntropy becomes when it syntropizes itself — the
#  centripetal turn, collapsing to a metacursive tautological fixed point.
#  ★ NO GATE CAN ASSERT A LIMIT, and none here pretends to. What is checkable
#  is the fixed point's signature: ∂ = 1 — IDEMPOTENCE. Normalising an already
#  normalised form must change nothing. A normaliser that is not idempotent is
#  one that has not reached its own fixed point, and this project has already
#  shipped exactly that defect once (a stale rewrite set, fixed 2026-07-20).
#  So centropy is gated as: NORM(NORM(t)) ≡ NORM(t).
#
#  ── ★ WHY THIS MODULE RE-DECLARES κ INSTEAD OF IMPORTING IT ─────────
#  It cannot import it. `canon.la` is GENERATED by the spec pipeline, and the
#  pipeline emits no `export` line — so every generated module (canon, aatc,
#  metalogic, swc, glyphdag, pragmatics, deixis …) is UNREACHABLE by `import`.
#  The κ below is therefore a second implementation, which is the copy-drift
#  hazard this project treats as a defect class. It is named here rather than
#  hidden, and the honest fix is upstream: teach the pipeline to emit exports.
#  Until then this module's κ is checked against the real one by build.sh, the
#  same way the formant tables are held to a single source.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph AND  = la p. la q. p(q)(p)
glyph NOT  = la p. la t. la f. p(f)(t)
glyph ORDI = la c. str_to_int(ord(c))

# ── decomposition nodes (the six-way Scott shape κ walks) ───────────
glyph PRIM = la nm. la fp. la fs. la fc. la fd. la fo. la fm. fp(nm)
glyph SYN  = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fs(a)(b)
glyph CON  = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fc(a)(b)
glyph DIR  = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fd(a)(b)
glyph CONT = la a. la b. la fp. la fs. la fc. la fd. la fo. la fm. fo(a)(b)
glyph MC   = la a. la fp. la fs. la fc. la fd. la fo. la fm. fm(a)

glyph BIN = la s. la x. la y. concat(concat(concat(s)("("))(concat(x)(",")))(concat(y)(")"))

# byte-lexicographic order, so the commutative modes have a canonical side
glyph LEXLT = Z(la self. la a. la b.
    IF(str_eq(a)(""))(la _. NOT(str_eq(b)("")))
      (la _. IF(str_eq(b)(""))(la _. NOT(str_eq(a)(a)))
        (la _. IF(str_eq(str_head(a))(str_head(b)))
                 (la _. self(str_tail(a))(str_tail(b)))
                 (la _. lt(ORDI(str_head(a)))(ORDI(str_head(b)))))))
glyph SORT2 = la s. la x. la y. IF(LEXLT(y)(x))(la _. BIN(s)(y)(x))(la _. BIN(s)(x)(y))

# κ — order-preserving
glyph KAP = Z(la self. la n.
    n (la nm. nm)
      (la a. la b. BIN("⊗")(self(a))(self(b)))
      (la a. la b. BIN("⊕")(self(a))(self(b)))
      (la a. la b. BIN("▷")(self(a))(self(b)))
      (la a. la b. BIN("⊂")(self(a))(self(b)))
      (la a. concat("↻(")(concat(self(a))(")"))))

# κ normalised — ONLY ⊕ is commutative (tex:2854: that commutativity IS "the
# fundamental distinction between ⊕ and ⊗"). ⊗, ▷ and ⊂ are all order-bearing.
glyph NKAP = Z(la self. la n.
    n (la nm. nm)
      (la a. la b. BIN("⊗")(self(a))(self(b)))
      (la a. la b. SORT2("⊕")(self(a))(self(b)))
      (la a. la b. BIN("▷")(self(a))(self(b)))
      (la a. la b. BIN("⊂")(self(a))(self(b)))
      (la a. concat("↻(")(concat(self(a))(")"))))

# tree → tree normaliser, so idempotence is a statement about NORM itself
glyph NORM = Z(la self. la n.
    n (la nm. PRIM(nm))
      (la a. la b. IF(LEXLT(NKAP(b))(NKAP(a)))(la _. SYN(self(b))(self(a)))(la _. SYN(self(a))(self(b))))
      (la a. la b. IF(LEXLT(NKAP(b))(NKAP(a)))(la _. CON(self(b))(self(a)))(la _. CON(self(a))(self(b))))
      (la a. la b. DIR(self(a))(self(b)))
      (la a. la b. CONT(self(a))(self(b)))
      (la a. MC(self(a))))

# ── sealed monoglyphs, and E_G ──────────────────────────────────────
glyph MONO    = la ren. la etym. la f. f(ren)(etym)
glyph REN     = la g. g(la r. la e. r)
glyph ETYM    = la g. g(la r. la e. e)
glyph SEAL    = la et. MONO(KAP(et))(et)
glyph COLLAPSE = la mode. la a. la b. SEAL(mode(ETYM(a))(ETYM(b)))

# E_G(g) = 0 exactly when the form is recoverable from the meaning.
# H(form | meaning) = 0 ⟺ the meaning determines the form with no residue.
glyph E_G = la g. IF(str_eq(REN(g))(KAP(ETYM(g))))(la _. 0)(la _. 1)

# ── E_S over a lexicon: does one form carry two concepts? ───────────
# E_S = log2 |{concepts sharing a form}|.  Two concepts on one form is 1 bit,
# and one bit of semantic entropy is polysemy — the thing monosemy forbids.
glyph ENT     = la nm. la tree. la f. f(nm)(tree)
glyph ENAME   = la e. e(la n. la t. n)
glyph ETREE   = la e. e(la n. la t. t)
glyph COLLIDES = la x. la y.
    AND(str_eq(NKAP(ETREE(x)))(NKAP(ETREE(y))))(NOT(str_eq(ENAME(x))(ENAME(y))))
glyph E_S_PAIR = la x. la y. IF(COLLIDES(x)(y))(la _. 1)(la _. 0)

# ── the lexicon under test ──────────────────────────────────────────
glyph G_VOID = PRIM("VOID")
glyph G_LOVE = PRIM("LOVE")
glyph G_BEING = PRIM("BEING")
glyph G_FORM  = PRIM("FORM")

# ★ THE CODEX'S OWN COLLISION (ROADMAP C9): the spec gives
#   Bad   = 𝔤₆ ⊕ 𝔤₃   (Void ⊕ Love)
#   Grief = 𝔤₃ ⊕ 𝔤₆   (Love ⊕ Void)
# and declares ⊕ commutative. Two concepts, one derivation, one canonical
# form. This is not a hypothetical red input — it is in the tables today.
glyph BAD   = ENT("Bad")(CON(G_VOID)(G_LOVE))
glyph GRIEF = ENT("Grief")(CON(G_LOVE)(G_VOID))
glyph TRUTHC = ENT("Truth")(MC(PRIM("RECOGNITION")))
glyph BEAUTY = ENT("Beauty")(SYN(G_FORM)(G_LOVE))

# ── the checks ──────────────────────────────────────────────────────
# E_G = 0 on a sealed glyph; E_G = 1 on a hand-minted drifted one.
# The second is the RED input: SEAL derives the Ren, but MONO accepts any.
glyph SEALED  = SEAL(SYN(G_BEING)(G_FORM))
glyph DRIFTED = MONO("a-name-that-is-not-its-etymology")(SYN(G_BEING)(G_FORM))
glyph EG_OK   = AND(int_eq(E_G(SEALED))(0))(int_eq(E_G(DRIFTED))(1))

# E_S = 0 across distinct concepts, and 1 bit on the C9 pair.
glyph ES_CLEAN = int_eq(E_S_PAIR(TRUTHC)(BEAUTY))(0)
glyph ES_C9    = int_eq(E_S_PAIR(BAD)(GRIEF))(1)

# SYNTROPY: collapsing two E_G=0 glyphs yields an E_G=0 glyph.
glyph SYNTROPIC = int_eq(E_G(COLLAPSE(SYN)(SEALED)(SEAL(MC(G_BEING)))))(0)

# CENTROPY: ∂ = 1. Normalising a normalised form changes nothing.
glyph T_UNSORTED = CON(G_VOID)(G_LOVE)
glyph CENTROPIC = AND(str_eq(NKAP(NORM(T_UNSORTED)))(NKAP(NORM(NORM(T_UNSORTED)))))
                     (str_eq(KAP(NORM(NORM(T_UNSORTED))))(KAP(NORM(T_UNSORTED))))

# and the two registers move as ONE: the same normalisation that zeroes E_S
# across the commutative synonyms is the one that keeps E_G at zero.
glyph ONE_UNIT = AND(str_eq(NKAP(ETREE(BAD)))(NKAP(ETREE(GRIEF))))
                    (int_eq(E_G(SEAL(NORM(ETREE(BAD)))))(0))

glyph MARK = la c. IF(c)(la _. "OK")(la _. "FAIL")
glyph MAIN = print(
  concat(concat(concat(concat("entropy E_G ")(MARK(EG_OK)))
                      (concat(" | E_S clean ")(MARK(ES_CLEAN))))
               (concat(concat(" | E_S C9=1bit ")(MARK(ES_C9)))
                      (concat(" | syntropy ")(MARK(SYNTROPIC)))))
        (concat(concat(" | centropy d=1 ")(MARK(CENTROPIC)))
               (concat(" | one-unit ")(MARK(ONE_UNIT)))))

export KAP NKAP NORM E_G E_S_PAIR MONO REN ETYM SEAL COLLAPSE PRIM SYN CON DIR CONT MC
