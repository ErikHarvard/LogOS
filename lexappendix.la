# =====================================================================
#  lexappendix.la — THE LEXICON APPENDIX, EMITTED BY THE LEXICON.
#
#  ── WHY THIS IS NOT A TRANSCRIPTION ─────────────────────────────────
#  The paper states a census: N content words, M closed classes. A
#  hand-written appendix makes that count a CLAIM ABOUT the lexicon,
#  maintained beside it and free to drift from it -- and it drifted
#  today: the count moved from 59+20 to 57+18+4 when Erik's rulings
#  moved four entries between tables, and every prose statement of the
#  old numbers became false in one edit.
#
#  This is a BUILD TARGET. The rows are FOLDed out of LEX/GRAM/RULED/
#  GRULED themselves, and each row's canonical form and phonym are
#  COMPUTED by the same NORMT/KAN_N/PH_N the gates use -- not copied
#  from anywhere. So the appendix cannot disagree with the lexicon,
#  because it is a projection of it. The same discipline the formant
#  tables now stand under: not "the copies agree by care", but
#  "disagreement is unconstructible".
#
#  ── AND THE COLUMN THAT MAKES IT A CENSUS RATHER THAN A LISTING ─────
#  Each row carries its PROVENANCE, which is the one thing a reader
#  cannot recover from the derivation:
#    codex   the phonym is the codex's printed IPA and the derived
#            value AGREES with it -- an independent check, since the
#            two columns have separate origins
#    codex*  printed in the codex, and the derived value DIVERGES.
#            Two rows, both vowel elision (Think, Gratitude). Named,
#            not hidden: this is the honest residue of the phonology.
#    ruled   the codex prints NO IPA for this derivation because it
#            never wrote this derivation down. The phonym is DERIVED,
#            so it is not a check, and saying so is the point -- a
#            derived value compared against itself asserts nothing,
#            and folding these into the agreement count would inflate
#            it with self-comparisons.
#
#  longtable, not tabular, deliberately: a plain tabular cannot break
#  across pages, and at 79 rows this overflows silently. The Ledger has
#  the same latent problem and the same fix.
# =====================================================================

import("lexicon.la")    # PARSE PH_N KAN_N LEX RULED FOLD
import("opgrammar.la")  # GRAM GRULED

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph FST  = la p. p(la a. la b. a)
glyph T_ = la d. FST(PARSE(d))
glyph K_ = la d. KAN_N(T_(d))
glyph P_ = la d. PH_N(T_(d))

# LaTeX-escape the one construct the derivations contain that TeX eats.
glyph ESC = Z(la self. la s.
    IF(str_eq(s)(""))(la _. "")(la _.
    IF(str_eq(str_head(s))("_"))(la _. concat("\\_")(self(str_tail(s))))
      (la _. concat(str_head(s))(self(str_tail(s))))))

# ── one row. The phonym column shows BOTH values when they differ, so
#    a divergence is visible in the appendix rather than only in a gate.
glyph J    = la a. la b. concat(a)(b)
glyph NOTE = la d. la p. IF(str_eq(P_(d))(p))(la _. "")(la _. J(" \\textit{(codex: ")(J(ESC(p))(")}")))
glyph ROW  = la prov. la n. la d. la p. J(ESC(n))(J(" & \\texttt{")(J(ESC(d))(J("} & \\texttt{")(J(ESC(K_(d)))(J("} & ")(J(ESC(P_(d)))(J(NOTE(d)(p))(J(" & ")(J(prov)(" \\\\\n"))))))))))

glyph ROWS = la prov. la tbl. FOLD(la a. la n. la d. la p.
    concat(a)(ROW(IF(str_eq(P_(d))(p))(la _. prov)(la _. concat(prov)("*")))(n)(d)(p)))("")(tbl)

glyph CNT = la tbl. FOLD(la a. la n. la d. la p. add(a)(1))(0)(tbl)

glyph N_LEX = CNT(LEX)
glyph N_GRM = CNT(GRAM)
glyph N_RUL = add(CNT(RULED))(CNT(GRULED))
glyph N_ALL = add(add(N_LEX)(N_GRM))(N_RUL)

glyph HEAD = concat("% GENERATED by lexappendix.la from lexicon.la and opgrammar.la.\n")
   (concat("% Do not edit: it is a projection of the lexicon, not a copy of it.\n")
   (concat("\\begin{longtable}{l l l l l}\n\\toprule\n")
           ("\\textbf{Concept} & \\textbf{Derivation} & \\textbf{Canonical form} & \\textbf{Phonym} & \\textbf{Provenance} \\\\\n\\midrule\n\\endhead\n")))

glyph BODY = concat(concat(ROWS("codex")(LEX))(ROWS("codex")(GRAM)))
                   (concat(ROWS("ruled")(RULED))(ROWS("ruled")(GRULED)))

glyph FOOT = concat("\\bottomrule\n\\end{longtable}\n% counts: content=")
   (concat(int_to_str(N_LEX))(concat(" closed-class=")(concat(int_to_str(N_GRM))
   (concat(" ruled=")(concat(int_to_str(N_RUL))(concat(" total=")(concat(int_to_str(N_ALL))("\n")))))))) 

glyph TEX = concat(concat(HEAD)(BODY))(FOOT)

# ── the gate: the emitted file must hold one row per entry ───────────
#  Counting the emitted "\\\\" line-ends and requiring it to equal the
#  folded entry count is what makes the appendix a projection rather
#  than a hopeful copy. A row dropped by an escaping bug fails here.
glyph COUNTBS = Z(la self. la s.
    IF(str_eq(s)(""))(la _. 0)(la _.
    IF(str_eq(str_head(s))("\n"))(la _. add(1)(self(str_tail(s))))
      (la _. self(str_tail(s)))))
glyph N_ROWS = sub(COUNTBS(BODY))(0)

glyph MK = la c. IF(c)(la _. "OK")(la _. "FAIL")
glyph OK_ROWS = int_eq(N_ROWS)(N_ALL)

glyph MAIN = SEQ2(write_file("la_lexicon_appendix.tex")(TEX))(print(
  concat(concat("lexappendix content=")(concat(int_to_str(N_LEX))
         (concat(" closed-class=")(concat(int_to_str(N_GRM))
         (concat(" ruled=")(concat(int_to_str(N_RUL))(concat(" total=")(int_to_str(N_ALL)))))))))
         (concat(concat(" | rows=")(int_to_str(N_ROWS)))
                (concat(" | rows==entries ")(MK(OK_ROWS))))))
glyph SEQ2 = la a. la b. b

export TEX N_ALL
