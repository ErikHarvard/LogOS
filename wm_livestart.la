# ═══════════════════════════════════════════════════════════════════
#  wm_livestart.la — what the live WM decides before it takes the screen.
#
#  theourgia_wm_live.la needs three facts from text files before it takes
#  the screen: which /dev/input/eventN is the keyboard, which directory new
#  shells start in, and where its users live. All three are decided here, by
#  small kits that take every builtin they use as a parameter (WM_DESIGN.md's
#  kit style: a name looked up while a loop runs walks the whole program on
#  the VM, which made the old detector cost about 3 ms per byte of the device
#  list).
#
#  KBD_KIT(Z)(str_at)(str_len)(ord)(str_to_int)(add)(sub)(lt)(int_eq)(concat)
#    -> kbd(text) : the N of the keyboard's /dev/input/eventN, as a decimal
#       string, or "" when there is none.
#    text is /proc/bus/input/devices: blocks of lines separated by blank
#    lines, one block per device. A block is the keyboard when its
#    "N: Name=" line contains "keyboard" in any case and its "H: Handlers="
#    line names kbd and an event<N>; the first such block wins. Only that
#    block's own lines are read, so a device without an event handler, or a
#    mouse after it, is never taken for the keyboard.
#
#  CWD_KIT(Z)(str_at)(str_len)(str_eq)(concat)(str_to_int)(add)(sub)(lt)
#         (int_eq)(div)(mod)(chr)(stat)
#    -> cwd(text) : the directory new shells start in, from logos_wm.cwd: its
#       first line without spaces, tabs or carriage returns at either end; "/"
#       when that is empty or stat does not report a directory.
#
#  USERS_KIT(Z)(str_at)(str_len)(str_eq)(concat)(str_to_int)(add)(sub)(lt)
#           (int_eq)(div)(mod)(chr)(error)(stat)(mkdir)
#    -> users(text) = la k. k(dir)(first) : LogosSession's root for the lock
#       screen, from logos_wm.users (the VM's read_file gives "" for a
#       missing file): its first line, trimmed exactly as CWD_KIT trims, or
#       /var/lib/logos when that is empty. When stat says dir does not exist
#       (-2) it is made with mode 0700, one level (a missing parent halts,
#       naming the path); when it exists and is not a directory, or stat
#       fails otherwise, the run halts naming it. first is TRUE exactly when
#       stat(dir/users) is -2 (ENOENT): LogosSession's adduser makes
#       dir/users, so no user has ever been made there. The corner: an
#       adduser that failed after making users/ leaves it empty, and the
#       login screen then shows with no user able to log in; the VM has no
#       getdents, so an empty directory cannot be told from a full one.
#
#  CWD_KIT and USERS_KIT read their file with the same LS_BASE. The kits are
#  pure but for stat and mkdir, which the caller passes (stubs on the host).
#  gate_wm_livestart.sh checks them on the C host and the VM.
# ═══════════════════════════════════════════════════════════════════

export KBD_KIT CWD_KIT USERS_KIT

glyph KBD_KIT = la Z. la str_at. la str_len. la ord. la str_to_int. la add. la sub. la lt. la int_eq. la concat.
  (la C0. la C1. la C10. la C32. la C48. la C57. la C65. la C90. la TRUE. la FALSE.
   (la text. (la n.
    # o(i): the byte at i (0..n-1) as a number; lc(i) the same, lower-cased
    (la o. (la lc.
    # at(i)(p): does p occur at i, compared lower-cased (p is lower case)
    (la at. (la nl.
    # has(i)(e)(p): p occurs somewhere in [i, e)
    (la has. (la evnum.
    Z(la block. la i. la kb. la kbd. la ev.
        lt(i)(n)
          (la _. (la e. int_eq(e)(i)
              # a blank line ends the block
              (la _. kb(la _. kbd(la _. int_eq(str_to_int(str_len(ev)))(C0)(la _. block(add(e)(C1))(FALSE)(FALSE)(""))(la _. ev)(C0))
                                 (la _. block(add(e)(C1))(FALSE)(FALSE)(""))(C0))
                       (la _. block(add(e)(C1))(FALSE)(FALSE)(""))(C0))
              (la _. at(i)("n: name=")
                  (la _. block(add(e)(C1))(has(i)(e)("keyboard"))(kbd)(ev))
                  (la _. at(i)("h: handlers=")
                     (la _. block(add(e)(C1))(kb)(has(i)(e)("kbd"))(evnum(i)(e)))
                     (la _. block(add(e)(C1))(kb)(kbd)(ev))(C0))(C0))(C0))
            (nl(i)))
          # the end of the text ends the last block
          (la _. kb(la _. kbd(la _. ev)(la _. "")(C0))(la _. "")(C0))(C0))(C0)(FALSE)(FALSE)(""))
    # evnum(i)(e): the digits after the first "event" in [i, e), or ""
    (la i. la e. Z(la find. la j. lt(add(j)(4))(e)
        (la _. at(j)("event")
            (la _. Z(la digits. la k. la acc. lt(k)(e)
                (la _. (la c. lt(c)(C48)(la _. acc)(la _. lt(C57)(c)(la _. acc)(la _. digits(add(k)(C1))(concat(acc)(str_at(text)(k))))(C0))(C0))(o(k)))
                (la _. acc)(C0))(add(j)(5))(""))
            (la _. find(add(j)(C1)))(C0))
        (la _. "")(C0))(i)))
    (la i. la e. la p. (la m. Z(la go. la j. lt(sub(e)(m))(j)(la _. FALSE)(la _. at(j)(p)(la _. TRUE)(la _. go(add(j)(C1)))(C0))(C0))(i))(str_to_int(str_len(p)))))
    # nl(i): the index of the next newline at or after i, or n
    (Z(la nl. la i. lt(i)(n)(la _. int_eq(o(i))(C10)(la _. i)(la _. nl(add(i)(C1)))(C0))(la _. n)(C0))))
    (la i. la p. (la m. lt(n)(add(i)(m))(la _. FALSE)(la _.
        Z(la go. la j. lt(j)(m)(la _. int_eq(lc(add(i)(j)))(str_to_int(ord(str_at(p)(j))))(la _. go(add(j)(C1)))(la _. FALSE)(C0))(la _. TRUE)(C0))(C0))(C0))
      (str_to_int(str_len(p)))))
    (la i. (la c. lt(c)(C65)(la _. c)(la _. lt(C90)(c)(la _. c)(la _. add(c)(C32))(C0))(C0))(o(i))))
    (la i. str_to_int(ord(str_at(text)(i)))))
    (str_to_int(str_len(text)))))
  (0)(1)(10)(32)(48)(57)(65)(90)(la t. la f. t)(la t. la f. f)

# LS_BASE(Z)(str_at)(str_len)(str_eq)(concat)(str_to_int)(add)(sub)(lt)
#        (int_eq)(div)(mod)(chr)(k) -> k(line)(isdir), what CWD_KIT and
# USERS_KIT share, so both read their file the same way:
#   line(text)  the first line of text without spaces, tabs or carriage
#               returns at either end
#   isdir(st)   stat's answer "<mode> <size>" is a directory's (S_IFDIR, type
#               4); an "-errno" is not
glyph LS_BASE = la Z. la str_at. la str_len. la str_eq. la concat. la str_to_int. la add. la sub. la lt. la int_eq. la div. la mod. la chr. la k.
  (la C0. la C1. la C2. la C4. la C16. la C4096. la CR. la TRUE. la FALSE.
   (la seg. (la blank.
     k(la text. (la n.
         (la e. (la a.
            # the end of the line without its trailing blanks
            (la b. seg(text)(a)(b))
            (Z(la r. la j. lt(a)(j)(la _. blank(str_at(text)(sub(j)(C1)))(la _. r(sub(j)(C1)))(la _. j)(C0))(la _. j)(C0))(e)))
          # a: the first character that is not blank
          (Z(la l. la i. lt(i)(e)(la _. blank(str_at(text)(i))(la _. l(add(i)(C1)))(la _. i)(C0))(la _. e)(C0))(C0)))
         # e: the end of the first line
         (Z(la f. la i. lt(i)(n)(la _. str_eq(str_at(text)(i))("\n")(la _. i)(la _. f(add(i)(C1)))(C0))(la _. n)(C0))(C0)))
       (str_to_int(str_len(text))))
      # stat's answer is "<mode> <size>": a directory has type 4 (S_IFDIR)
      (la st. str_eq(str_at(st)(C0))("-")
          (la _. FALSE)
          (la _. (la mode. int_eq(mod(div(mode)(C4096))(C16))(C4))
                 (str_to_int(seg(st)(C0)(Z(la sp. la m. lt(m)(str_to_int(str_len(st)))
                     (la _. str_eq(str_at(st)(m))(" ")(la _. m)(la _. sp(add(m)(C1)))(C0))(la _. m)(C0))(C0)))))(C0)))
   # blank(c): a space, a tab or a carriage return
   (la c. str_eq(c)(" ")(TRUE)(str_eq(c)("\t")(TRUE)(str_eq(c)(CR)))))
   # seg(s)(i)(j): bytes i..j-1 of s, joined by halves
   (Z(la seg. la s. la i. la j. lt(i)(j)
        (la _. int_eq(add(i)(C1))(j)(la _. str_at(s)(i))
                 (la _. (la m. concat(seg(s)(i)(m))(seg(s)(m)(j)))(div(add(i)(j))(C2)))(C0))
        (la _. "")(C0))))
  (0)(1)(2)(4)(16)(4096)(chr("13"))(la t. la f. t)(la t. la f. f)

glyph CWD_KIT = la Z. la str_at. la str_len. la str_eq. la concat. la str_to_int. la add. la sub. la lt. la int_eq. la div. la mod. la chr. la stat.
  LS_BASE(Z)(str_at)(str_len)(str_eq)(concat)(str_to_int)(add)(sub)(lt)(int_eq)(div)(mod)(chr)(la line. la isdir.
    la text. (la c. str_eq(c)("")(la _. "/")(la _. isdir(stat(c))(la _. c)(la _. "/")("!"))("!"))(line(text)))

glyph USERS_KIT = la Z. la str_at. la str_len. la str_eq. la concat. la str_to_int. la add. la sub. la lt. la int_eq. la div. la mod. la chr. la error. la stat. la mkdir.
  LS_BASE(Z)(str_at)(str_len)(str_eq)(concat)(str_to_int)(add)(sub)(lt)(int_eq)(div)(mod)(chr)(la line. la isdir.
  (la C0. la DEFAULT. la MODE.
    (la ensure.
      la text. (la l.
          (la d. (la first. la k. k(d)(first))
                 # a first run: adduser has never made DIR/users
                 (str_eq(stat(concat(d)("/users")))("-2")))
          (ensure(str_eq(l)("")(la _. DEFAULT)(la _. l)(C0))))
        (line(text)))
    # ensure(dir): dir, made (mode 0700, one level) when it does not exist;
    # anything else that is not a directory halts, naming it
    (la dir. (la st. str_eq(st)("-2")
        (la _. (la r. str_eq(r)("0")(la _. dir)
                  (la _. error(concat("wm: cannot create the users directory ")(concat(dir)(concat(" (mkdir -> ")(concat(r)(
                      str_eq(r)("-2")(la _. "): its parent does not exist")(la _. ")")(C0)))))))(C0))
               (mkdir(dir)(MODE)))
        (la _. str_eq(str_at(st)(C0))("-")
           (la _. error(concat("wm: cannot use the users directory ")(concat(dir)(concat(" (stat -> ")(concat(st)(")"))))))
           (la _. isdir(st)(la _. dir)
                    (la _. error(concat("wm: the users directory ")(concat(dir)(" is not a directory"))))(C0))(C0))(C0))
      (stat(dir))))
  (0)("/var/lib/logos")("448"))
