# Compiled binaries (regenerated by build.sh / the toolchain)
/tiny_host
*.bin
*.o

# EXCEPTION: the self-hosted compiler reference image is COMMITTED (the bootstrap
# seed). build.sh Stage 4 checks it is a byte-identical fixed point of the current
# native_codegen3.la, so it must track the source — regenerate it after any
# native_codegen3.la / native_codegen3_rt.asm change (recipe in STAGE4_STATUS.md).
!/native_codegen3_selfhost.bin

# eval.la's self-reconstruction (regenerated each run)
/eval_reconstructed.la

# specpipe.la's generated math module (regenerated each run)
/math_generated.la

# strutil_spec.la's generated string-utilities module (regenerated each run)
/strutil_generated.la

# native binaries / artifacts emitted by elf.la, secd.la, codegen.la (regenerated each run)
/secd
/logos_native
/logos_secd
/drm_blue
/live_blue
/logos_program.bin
/logos_source.la
/new_logos_secd.bin
/compiler.bin
/runner
/native_small.bin
/logos_app
/logos_nativert
/native_codegen_out
/native_codegen2_out
/native_codegen3_out
/native_input.la
/stage4_seed_out.txt

# autopoiesis.la's medium (generation counter, regenerated each run)
/autopoiesis.gen

# Theourgia rasters (composed/recomposed each run by theourgia*.la)
*.ppm

# Unpublished codices stay local-only; ONLY codices/published/ is tracked.
# (codices/* ignores direct children but not codices/ itself, so the negation
# below can re-include the published subtree — re-including a child of a fully
# excluded dir is impossible in git.)
codices/*
!codices/published/
phonyms.wav
mathutil.la

# LogOS kernel build products (K1+): generated per-build, sources tracked
/kernel/entry.inc
/kernel/*.o
/kernel/kernel.elf
/kernel/kernel64.elf
/kernel/kernel_fault.elf
/kernel/kernel_fault64.elf
/kernel/kernel_pmm.elf
/kernel/kernel_pmm64.elf
/kernel/kernel_paging.elf
/kernel/kernel_paging64.elf
/kernel/kernel_paging_cr3.elf
/kernel/kernel_paging_cr3_64.elf
/kernel/kernel_wx.elf
/kernel/kernel_wx_64.elf
/kernel/kernel_nx.elf
/kernel/kernel_nx_64.elf
/kernel/kernel_paging_heap.elf
/kernel/kernel_paging_heap_64.elf
/kernel/kernel_timer.elf
/kernel/kernel_timer_64.elf
/kernel/kernel_preempt.elf
/kernel/kernel_preempt_64.elf
/kernel/kernel_k6a.elf
/kernel/kernel_k6a_64.elf
/kernel/kernel_k6b.elf
/kernel/kernel_k6b_64.elf
/kernel/kernel_k6c.elf
/kernel/kernel_k6c_64.elf
/kernel/kernel_k6c2.elf
/kernel/kernel_k6c2_64.elf
/kernel/kernel_k6c3.elf
/kernel/kernel_k6c3_64.elf
/kernel/kernel_k6c3b.elf
/kernel/kernel_k6c3b_64.elf
/kernel/kernel_hh1.elf
/kernel/kernel_hh1_64.elf
/kernel/kernel_hh1b.elf
/kernel/kernel_hh1b_64.elf
/kernel/kernel_hh2.elf
/kernel/kernel_hh2_64.elf
/kernel/kernel_hh2b.elf
/kernel/kernel_hh2b_64.elf
/kernel/kernel_hh2c.elf
/kernel/kernel_hh2c_64.elf
/native_codegen3_hh.la
/phonsem_host.out
