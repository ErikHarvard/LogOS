# ═══════════════════════════════════════════════════════════════════
#  x25519_gen.la — writes the unrolled field kernels of x25519.la.
#
#  WHAT. x25519.la's field arithmetic is a set of straight-line kernels:
#  a 10x10-limb multiplication, a squaring, the carry chain, and the
#  limb-wise combinations around them, each written out limb by limb. This
#  program generates their text. Its output is the section of x25519.la
#  between the lines
#      # >>> generated by x25519_gen.la (do not edit by hand)
#      # <<< end of generated section
#  and gate_x25519.sh checks that the two are byte for byte the same, so the
#  module never drifts from its generator.
#
#  HOW IT IS USED. On the VM (or the C host), from a directory that holds it:
#      cp compiler.bin logos_program.bin; cp x25519_gen.la logos_source.la
#      ./logos_secd; ./logos_secd > section.txt
#  The section is printed on stdout, the marker lines included.
#
#  THE ARITHMETIC IT WRITES (the derivation is in x25519.la's header).
#  A field element is ten limbs f0..f9, limb i weighted 2^w(i) with
#  w(i) = ceil(25.5 i): 26 bits for even i, 25 for odd. In a product,
#  f_i g_j lands in column i+j; its weight is 2^w(i+j) times 2 when both i
#  and j are odd, and a column past 9 wraps to column i+j-10 times 19
#  (2^255 = 19 mod p). So column k is
#      D1 + 2 D2 + 19 W1 + 38 W2
#  with D the direct terms (i+j = k), W the wrapped ones (i+j = k+10), and
#  2 marking the odd-odd ones. The square groups the symmetric pairs: an
#  off-diagonal pair counts twice, so its coefficient is 1, 2 or 4 direct and
#  19, 38 or 76 wrapped.
#
#  Names in the kernels are one letter (the VM scans a closure's body once
#  per bound name, byte by byte, so short text is fast text): limbs a..j and
#  A..J, add p, sub s, the multipliers u (x2), q (x4), t (x19), w (x38),
#  o (x76), and the kernel's continuation K. Pure generation: concat,
#  str_at, int ops. It runs once, by hand or from the gate; it is not hot.
# ═══════════════════════════════════════════════════════════════════

glyph Z = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph NIL = la n. la c. n(n)
glyph CONS = la h. la t. la n. la c. c(h)(t)
glyph PR = la a. la b. la k. k(a)(b)
glyph TRUE = la t. la f. t
glyph FALSE = la t. la f. f
glyph AND = la a. la b. a(b)(FALSE)
glyph OR = la a. la b. a(TRUE)(b)
glyph NOT = la a. a(FALSE)(TRUE)
glyph FOLDR = Z(la go. la f. la z. la l. l(la _. z)(la h. la t. f(h)(go(f)(z)(t))))
glyph FOLDL = Z(la go. la f. la acc. la l. l(la _. acc)(la h. la t. go(f)(f(acc)(h))(t)))
glyph MAP = la f. FOLDR(la h. la acc. CONS(f(h))(acc))(NIL)
glyph FILTER = la p. FOLDR(la h. la acc. p(h)(CONS(h)(acc))(acc))(NIL)
glyph RANGE = Z(la go. la a. la b. lt(a)(b)(la _. CONS(a)(go(add(a)(1))(b)))(la _. NIL)("!"))
glyph CAT = FOLDR(la h. la acc. concat(h)(acc))("")
# JOIN(sep)(l): the strings of l with sep between them
glyph JOIN = la sep. la l. l(la _. "")(la h. la t. concat(h)(FOLDR(la x. la acc. concat(sep)(concat(x)(acc)))("")(t)))
glyph C3 = la a. la b. la c. concat(a)(concat(b)(c))
glyph AP = la f. la x. C3(f)("(")(concat(x)(")"))
glyph AP2 = la f. la x. la y. C3(AP(f)(x))("(")(concat(y)(")"))
glyph FL = la i. str_at("abcdefghij")(i)
glyph GL = la i. str_at("ABCDEFGHIJ")(i)
glyph DIGITS = RANGE(0)(10)
glyph ODD = la i. int_eq(mod(i)(2))(1)
glyph OO = la i. la j. AND(ODD(i))(ODD(j))

# "la a. la b. ... la j." for a name function
glyph LAMS = la nm. JOIN(" ")(MAP(la i. C3("la ")(nm(i))("."))(DIGITS))
# (x0)(x1)... for a list of strings, five to a line after the first `lead`
glyph CHUNKS = Z(la go. la n. la l. l(la _. NIL)(la h. la t.
    (la split. split(la a. la b. CONS(a)(go(n)(b))))
    (Z(la tk. la k. la l. int_eq(k)(0)(la _. PR(NIL)(l))
         (la _. l(la _. PR(NIL)(NIL))(la h. la t. tk(sub(k)(1))(t)(la a. la b. PR(CONS(h)(a))(b))))("!"))(n)(l))))
glyph ARGS = la l. CAT(MAP(la x. C3("(")(x)(")"))(l))
glyph ROWS = la indent. la l. JOIN(concat("\n")(indent))(MAP(ARGS)(CHUNKS(5)(l)))

# a column: the sum of its groups, each group the left-nested sum p(p(t0)(t1))(t2)...
# of its terms, scaled by its multiplier ("" = none); empty groups dropped
glyph CHAIN = la l. l(la _. "")(la h. la t. FOLDL(la acc. la x. AP2("p")(acc)(x))(h)(t))
glyph SCALED = la gs. CHAIN(FOLDR(la g. la acc. g(la sc. la ts.
    ts(la _. acc)(la h. la t. CONS(str_eq(sc)("")(CHAIN(ts))(AP(sc)(CHAIN(ts))))(acc))))(NIL)(gs))
glyph ALLIJ = FOLDR(la i. la acc. FOLDR(la j. la acc2. CONS(PR(i)(j))(acc2))(acc)(DIGITS))(NIL)(DIGITS)
glyph UPPER = FILTER(la q. q(la i. la j. NOT(lt(j)(i))))(ALLIJ)
glyph TERMS = la pairs. la pred. la mk. MAP(la q. q(mk))(FILTER(la q. q(pred))(pairs))
glyph DIRECT = la k. la i. la j. int_eq(add(i)(j))(k)
glyph WRAPPED = la k. la i. la j. int_eq(add(i)(j))(add(k)(10))

# multiplication: a..j are mul(f_i) partials, so f_i g_j is a(A)
glyph MULT = la i. la j. AP(FL(i))(GL(j))
glyph MULCOL = la k. SCALED(
    CONS(PR("")(TERMS(ALLIJ)(la i. la j. AND(DIRECT(k)(i)(j))(NOT(OO(i)(j))))(MULT)))
   (CONS(PR("u")(TERMS(ALLIJ)(la i. la j. AND(DIRECT(k)(i)(j))(OO(i)(j)))(MULT)))
   (CONS(PR("t")(TERMS(ALLIJ)(la i. la j. AND(WRAPPED(k)(i)(j))(NOT(OO(i)(j))))(MULT)))
   (CONS(PR("w")(TERMS(ALLIJ)(la i. la j. AND(WRAPPED(k)(i)(j))(OO(i)(j)))(MULT)))(NIL)))))

# squaring: f_i f_j is m(a)(b); coefficient 2 off the diagonal, 2 more when odd-odd
glyph SQT = la i. la j. AP2("m")(FL(i))(FL(j))
glyph COEF = la i. la j. mul(int_eq(i)(j)(1)(2))(OO(i)(j)(2)(1))
glyph SQGROUP = la k. la key. la nm. PR(nm)(TERMS(UPPER)(la i. la j.
    OR(AND(DIRECT(k)(i)(j))(int_eq(COEF(i)(j))(key)))
      (AND(WRAPPED(k)(i)(j))(int_eq(mul(19)(COEF(i)(j)))(key))))(SQT))
glyph SQCOL = la k. SCALED(CONS(SQGROUP(k)(1)(""))(CONS(SQGROUP(k)(2)("u"))(CONS(SQGROUP(k)(4)("q"))
    (CONS(SQGROUP(k)(19)("t"))(CONS(SQGROUP(k)(38)("w"))(CONS(SQGROUP(k)(76)("o"))(NIL)))))))
glyph COLS = la colf. CAT(MAP(la k. C3("\n  (")(colf(k))(")"))(DIGITS))

glyph HEAD2 = la first. C3(first)("\n    ")(C3(LAMS(FL))("\n    ")(LAMS(GL)))

glyph MULC = C3(HEAD2("glyph X25519_MULC = la u. la t. la w. la K."))(" la p. K")(COLS(MULCOL))
glyph SQC = C3(C3("glyph X25519_SQC = la u. la q. la t. la w. la o. la K.\n    ")(LAMS(FL))(" la m. la p. K"))
    ("")(COLS(SQCOL))

# the carry chain: t1 = h1 + h0>>26, t2 = h2 + t1>>25, ..., t9 = h9 + t8>>26 (t_k
# bound to the upper-case letter k); u0 = (h0 & M26) + 19 (t9>>25), bound to A;
# limb 1 = (t1 & M25) + u0>>26; limb k = t_k masked to its width
glyph SH = la k. int_eq(mod(k)(2))(0)("S")("s")
glyph MK = la k. int_eq(mod(k)(2))(0)("n")("m")
glyph CPREV = la k. int_eq(k)(1)("a")(GL(sub(k)(1)))
glyph CEXPR = la k. AP2("p")(FL(k))(AP2("r")(CPREV(k))(SH(sub(k)(1))))
glyph CARRY = CAT(
    CONS(C3("glyph X25519_CARRY = la p. la r. la n. la m. la t. la S. la s.\n    ")(LAMS(FL))("\n  "))
   (CONS(CAT(MAP(la k. C3("(la ")(GL(k))(". "))(RANGE(1)(10))))
   (CONS("(la A.\n    la k. k(n(A))(p(m(B))(r(A)(S)))")
   (CONS(ARGS(MAP(la k. AP(MK(k))(GL(k)))(RANGE(2)(10))))
   (CONS(")\n    (p(n(a))(t(r(J)(s)))))")
   (CONS(CAT(MAP(la k. C3("\n    (")(CEXPR(sub(11)(k)))("))"))(RANGE(2)(10))))
   (CONS(C3("\n  (")(CEXPR(1))(")"))(NIL))))))))

# a record's limbs as multiplication partials
glyph TOPA = C3("glyph X25519_TOPA = la m. la X. la K.\n  X(")(LAMS(FL))
    (C3(" K")(ARGS(MAP(la i. AP("m")(FL(i)))(DIGITS)))(")"))

# twice the prime, limb k: 2^27 - 38, then 2^26 - 2 (odd k), 2^27 - 2 (even k)
glyph Q2P = la k. int_eq(k)(0)("Q")(ODD(k)("O")("R"))
glyph SUMS = MAP(la k. AP2("p")(FL(k))(GL(k)))(DIGITS)
glyph DIFS = MAP(la k. AP2("s")(AP2("p")(FL(k))(Q2P(k)))(GL(k)))(DIGITS)
glyph L2 = C3(HEAD2("glyph X25519_L2 = la p. la s. la Q. la O. la R."))(" la K.\n  K(la k. k")
    (C3(ROWS("           ")(SUMS))(")\n   (la k. k")(concat(ROWS("           ")(DIFS))(")")))

# select: (n(f) | y(g)) with n = band(~mask), y = band(mask): f when the mask is 0
glyph SELS = MAP(la k. AP2("o")(AP("n")(FL(k)))(AP("y")(GL(k))))(DIGITS)
glyph SQSEL = C3(HEAD2("glyph X25519_SQSEL = la z. la m. la p."))(" la o. la n. la y.\n  z")
    (concat(ROWS("   ")(SELS))("(m)(p)"))
glyph SEL = C3(HEAD2("glyph X25519_SEL ="))(" la o. la n. la y.\n  la k. k")(ROWS("       ")(SELS))

# E = AA - BB + 2p as multiplication partials, and T = AA + a24 E (to the carry)
glyph EEXPR = la k. AP2("s")(AP2("p")(FL(k))(Q2P(k)))(GL(k))
glyph ETK = C3(HEAD2("glyph X25519_ETK = la p. la s. la v. la m. la Q. la O. la R. la K. la z."))
    ("\n  z(la k. k")
    (C3(ROWS("         ")(MAP(la k. AP("m")(EEXPR(k)))(DIGITS)))(")\n   (K")
       (concat(ROWS("     ")(MAP(la k. AP2("p")(FL(k))(AP("v")(EEXPR(k))))(DIGITS)))(")")))

glyph SECTION = JOIN("\n")(
    CONS("# >>> generated by x25519_gen.la (do not edit by hand)")
   (CONS(MULC)(CONS(SQC)(CONS(CARRY)(CONS(TOPA)(CONS(L2)(CONS(SQSEL)(CONS(SEL)(CONS(ETK)
   (CONS("# <<< end of generated section")(NIL)))))))))))

glyph MAIN = print(SECTION)
