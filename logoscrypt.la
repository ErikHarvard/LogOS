  LET(SHA_SCHED(SHA_NEXTQ(SHA_NW(s0)(s1)(add))(la a. la b. la c. la d. a))
                (sub)(int_eq)(C1)(C0)(nil)(cons)(C12))(la sched.
  LET(SHA_ADD8(add)(m))(la add8.
  LET(SHA_MKBLK(Q)(C0)(C4)(C8)(C12)(C16)(C20)(24)(28)(C32)(36)(40)(44)(48)(52))(la mk.
  LET(SHA_K(str_to_int)(Q)(nil)(cons))(la K.
  LET(la H. la blk. add8(H)(rounds(H)(blk(sched))(K)))(la compress.
  LET((la a. la b. la c. la d. la e. la f. la g. la h. la k. k(a)(b)(c)(d)(e)(f)(g)(h))
        (1779033703)(3144134277)(1013904242)(2773480762)(1359893119)(2600822924)(528734635)(1541459225))(la H0.
  # hfrom(H)(pre)(msg): absorb msg into the state H, pre bytes having gone
  # before it; whole blocks straight from the string, then the final block(s):
  # the tail read past the end (as zeros) with 0x80 OR-ed into its word, and
  # the bit length (pre + len) * 8 in the last two words.
  LET((la C3. la C24. la C128.
       la H. la pre. la msg.
        (la sa. la L.
          (la g.
            Z(la go. la H. la o.
               lt(add(o)(C63))(L)
                 (la _. go(compress(H)(mk(g(o))(g(o)(C56))(g(o)(C60))))(add(o)(C64)))
                 (la _. (la rem. la bits.
                    (la gt.
