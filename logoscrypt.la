  LET(la D. D(la a. la b. la c. la d. la e. la f. la g. la h.
        (la z. la k. k(Q(a)(b)(c)(d))(Q(e)(f)(g)(h))(z)(z))(Q(C0)(C0)(C0)(C0))))(la d2kw.
  # a digest's 8 words as the outer hash's second block: 0x80, (64+32)*8 bits
  LET(la D. D(la a. la b. la c. la d. la e. la f. la g. la h.
        la k. k(Q(a)(b)(c)(d))(Q(e)(f)(g)(h))(Q(C2_31)(C0)(C0)(C0))(Q(C0)(C0)(C0)(C768))))(la d2blk.
  # a key longer than the 64-byte block is hashed first (RFC 2104)
