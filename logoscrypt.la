                    la x8. la x9. la xa. la xb. la xc. la xd. la xe. la xf.
        (la r0. la r1. la r2. la r3. la r4.
           (la a. la f. la k. k(a)(f))
           (pabs(r0)(r1)(r2)(r3)(r4)(mul(r1)(C5))(mul(r2)(C5))(mul(r3)(C5))(mul(r4)(C5)))
           (pfin(x4)(x5)(x6)(x7)))
        (band(x0)(67108863))
