  cons(Q(3624381080)(310598401)(607225278)(1426881987))(cons(Q(1925078388)(2162078206)(2614888103)(3248222580))(
  cons(Q(3835390401)(4022224774)(264347078)(604807628))(cons(Q(770255983)(1249150122)(1555081692)(1996064986))(
  cons(Q(2554220882)(2821834349)(2952996808)(3210313671))(cons(Q(3336571891)(3584528711)(113926993)(338241895))(
  cons(Q(666307205)(773529912)(1294757372)(1396182291))(cons(Q(1695183700)(1986661051)(2177026350)(2456956037))(
  cons(Q(2730485921)(2820302411)(3259730800)(3345764771))(cons(Q(3516065817)(3600352804)(4094571909)(275423344))(
  cons(Q(430227734)(506948616)(659060556)(883997877))(cons(Q(958139571)(1322822218)(1537002063)(1747873779))(
  cons(Q(1955562222)(2024104815)(2227730452)(2361852424))(cons(Q(2428436474)(2756734187)(3204031479)(3329325298))(nil))))))))))))))))

# CRYPT_FAST(str_at)(ord)(str_to_int)(int_to_str)(chr)(concat)(str_len)(error)
#           (add)(sub)(mul)(lt)(int_eq)(band)(bor)(bxor)(bshl)(bshr)
#   -> la s. s(sha256)(hmac)(hkdf)(seal)(open)(hex)
# Everything below the parameter list runs once, when the record is built:
# the constants, the byte table, the helpers applied to their dependencies.
glyph CRYPT_FAST = la str_at. la ord. la str_to_int. la int_to_str. la chr. la concat. la str_len. la error.
    la add. la sub. la mul. la lt. la int_eq. la band. la bor. la bxor. la bshl. la bshr.
