                                (la _. bshl(C128)(sub(C24)(mul(C8)(band(rem)(C3)))))
                                (la _. C0)
                                (C0))))
                  (sub(L)(o))(mul(add(pre)(L))(C8)))
                 (C0))
             (H)(C0))
          (la o. la i. rbe(sa)(add(o)(i))))
        (str_at(msg))(len(msg)))
      (3)(24)(128))(la hfrom.
  LET(la D. D(la a. la b. la c. la d. la e. la f. la g. la h.
        concat(concat(concat(wbe(a))(wbe(b)))(concat(wbe(c))(wbe(d))))
              (concat(concat(wbe(e))(wbe(f)))(concat(wbe(g))(wbe(h))))))(la out32.
  LET(la msg. out32(hfrom(H0)(C0)(msg)))(la sha256.

  # ── HMAC-SHA256 ──
  # hsched(kw): from the 16 key words, the states after the ipad and the opad
  # blocks, la k. k(inner)(outer), computed once per key.
  LET((la IP. la OP.
       la kw. kw(la q0. la q1. la q2. la q3.
         (la x. (la hi. la ho. la k. k(hi)(ho))(compress(H0)(x(IP)))(compress(H0)(x(OP))))
         (la v. (la y. la f. f(y(q0))(y(q1))(y(q2))(y(q3)))
                (la q. q(la a. la b. la c. la d. Q(bxor(a)(v))(bxor(b)(v))(bxor(c)(v))(bxor(d)(v)))))))
      (909522486)(1549556828))(la hsched.
