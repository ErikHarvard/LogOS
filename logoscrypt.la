  la C31. la C32. la C56. la C60. la C63. la C64. la C768. la C2_31. la C8160. la M32.
  LET(band(M32))(la m.
  LET(mul(4294967297))(la r.
  LET(band(255))(la n8.
  LET(band(67108863))(la n26.
  LET(la n. la c. n(n))(la nil.
  LET(la h. la t. la n. la c. c(h)(t))(la cons.
  LET(la s. str_to_int(str_len(s)))(la len.
  LET(SPAN(concat)(add)(sub)(lt)(bshr)(C0)(C1))(la span.
