   la abs. la sa. la L. la h.
  (la mw.
    Z(la go. la h. la o.
      lt(add(o)(C15))(L)
        (la _. go(abs(h)(rle(sa)(o))(rle(sa)(add(o)(C4)))(rle(sa)(add(o)(C8)))(rle(sa)(add(o)(C12))))(add(o)(C16)))
        (la _. lt(o)(L)
                 (la _. abs(h)(mw(o))(mw(add(o)(C4)))(mw(add(o)(C8)))(mw(add(o)(C12))))
                 (la _. h)
                 (C0))
        (C0))
    (h)(C0))
