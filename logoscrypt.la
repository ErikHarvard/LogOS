  # salt is 32 zero bytes, which as an HMAC key (zero-padded) is the same key.
  LET(la salt. la ikm. la info. la L.
    lt(L)(C0)(la _. error("logoscrypt: hkdf: len must be 0..8160"))(la _.
    lt(C8160)(L)(la _. error("logoscrypt: hkdf: len must be 0..8160"))(la _.
    int_eq(L)(C0)(la _. "")(la _.
      (la hk. la N.
         Z(la go. la prev. la i.
            (la t. int_eq(i)(N)
                     (la _. take(sub(L)(mul(C32)(sub(N)(C1))))(t))
                     (la _. concat(t)(go(t)(add(i)(C1))))
                     (C0))
            (out32(hmacw(hk)(concat(concat(prev)(info))(T(i))))))
         ("")(C1))
      (hsched(d2kw(hmacw(hkey(salt))(ikm))))
      (bshr(add(L)(C31))(5)))
    (C0))(C0))(C0))(la hkdf.

  # ── ChaCha20-Poly1305 ──
  LET(CC_DR(CC_QR(25)(24)(C20)(C16)(r)(bshr)(bxor)(add)(m)))(la dr.
  LET(CC_BLOCK(add)(m)(1634760805)(857760878)(2036477234)(1797285236)(dr))(la blk.
  LET(CC_XOR64(concat)(bxor)(wle)(C0)(C4)(C8)(C12)(C16)(C20)(24)(28)(C32)(36)(40)(44)(48)(52)(C56)(C60))(la x64.
  LET(P_ABS(C26)(C6)(C20)(C12)(C14)(C18)(C8)(16777216)(mul(C5))(n26)(bor)(bshl)(bshr)(add)(mul))(la pabs.
  LET(P_FINAL(C0)(C5)(C6)(C8)(C12)(C14)(C18)(C20)(C32)(67108864)(C26)(lt)(sub)(mul(C5))(bor)(bshl)(m)(n26)(bshr)(add))(la pfin.
  LET(P_SEG(rle)(lt)(add)(sub)(mul)(bshl)(band)(M32)(C0)(C1)(C4)(C8)(C12)(15)(C16))(la pseg.
  LET(la k. k(C0)(C0)(C0)(C0)(C0))(la HZ.
  # setup(who)(key)(nonce)(F): F gets this message's block function bf,
  # bf(counter)(f) -> f(x0)..(x15). A key that is not 32 bytes or a nonce that
  # is not 12 is a caller's error, and halts.
  LET(la who. la key. la nonce. la F.
    int_eq(len(key))(C32)
      (la _. int_eq(len(nonce))(C12)
         (la _. (la ka. la na.
                   F(blk(rle(ka)(C0))(rle(ka)(C4))(rle(ka)(C8))(rle(ka)(C12))
                        (rle(ka)(C16))(rle(ka)(C20))(rle(ka)(24))(rle(ka)(28))
                        (rle(na)(C0))(rle(na)(C4))(rle(na)(C8))))
