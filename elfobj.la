# =====================================================================
#  elfobj.la — AN ELF64 RELOCATABLE-OBJECT WRITER IN LINGUA ADAMICA.
#
#  The missing half of removing NASM from the kernel build. `asm.la` already
#  encodes boot.asm's instructions byte-identically, but it emits a FLAT
#  `-f bin` image, while the kernel is built `nasm -f elf64` + `ld -T
#  kernel/kernel.ld`. Line coverage was never the blocker — the OUTPUT FORMAT
#  was. This writes the container.
#
#  ── THE GATE IS NOT BYTE-IDENTITY AGAINST NASM ──────────────────────────────
#  Everywhere else in this project the standard is a byte diff against the tool
#  being replaced. For an OBJECT file that standard is wrong, and saying why
#  matters: an object's internal layout — section ordering, string-table
#  packing, padding, symbol ordering — is NASM's arbitrary convention, not
#  semantics. Two objects can differ in every one of those and still be the
#  same object. So byte-identity here would gate on imitating NASM's habits
#  rather than on being correct.
#
#  The right gate is ONE LEVEL UP, and it is still byte-identity:
#      ld(our .o)  ==  ld(nasm's .o)
#  `ld` is deterministic (verified: same input, byte-identical output), so if
#  the linked results match, the two objects were equivalent in everything the
#  linker can observe — which is the whole of what an object file means.
#
#  ── SCOPE, MEASURED FROM boot.asm's OWN nasm -f elf64 OUTPUT ────────────────
#  The target defines the spec, so it was measured rather than guessed:
#    · 11 sections (.multiboot/.boot32/.rodata/.la_image PROGBITS, .bss NOBITS,
#      .shstrtab/.symtab/.strtab, .rela.boot32/.rela.rodata)
#    · 107 symbols — 101 NOTYPE LOCAL labels, 5 SECTION, 1 GLOBAL (_start), 1 FILE
#    · 63 relocations of only THREE types: R_X86_64_64 (41), R_X86_64_32 (21),
#      R_X86_64_32S (1) — and NO R_X86_64_PC32 at all, because intra-section
#      jumps and calls are resolved by the assembler itself and cross-section
#      references are absolute. That removes an entire class of work.
#
#  ★ BUT THAT MEASUREMENT IS ABOUT boot.asm, NOT ABOUT OBJECTS IN GENERAL, and
#  it would mislead if quoted as the latter. The `link` track — building the
#  reader half — reports that `R_X86_64_PLT32` is what nasm and gcc emit for an
#  ordinary call to a global function, so a linker handling only PC32 "would
#  fail on most real objects while looking healthy on the shipped fixtures".
#  Both measurements are right about different inputs: boot.asm's calls are
#  intra-section and assembler-resolved, so it genuinely needs none of them.
#  The moment this writer is pointed at ordinary code with cross-object calls,
#  PC32/PLT32 become required. Learned across the coordination board without
#  either track reaching into the other's worktree.
#
#  ── STATE ───────────────────────────────────────────────────────────────────
#  Complete at kernel scale. `EMIT_OBJ_N(content)(symlist)(relainfo)` emits an
#  N-section object with a folded symbol table (.symtab/.strtab), the meta
#  sections (.shstrtab), and one auto-appended .rela.<name> per target — NOBITS
#  (.bss) included. GATED one level up, `ld(ours) == ld(nasm)`: byte-identical on
#  the r3 fixture (2 sections, all 3 reloc types) AND on the real kernel boot.o
#  (11 sections, 107 symbols, 63 relocs) under both plain `ld` and kernel.ld.
#
#  ── HONEST LIMITS ───────────────────────────────────────────────────────────
#  · The 107-symbol fold walls the substitution-based C host (>91 s); it runs on
#    the native SECD VM in ~0.3 s. So host==VM byte-identity is gated on the
#    small r3 fixture; boot-scale is VM-only. (A tail-recursive accumulator fold
#    would make the host practical — deferred, not required for correctness.)
#  · The section/symbol/reloc LISTS for boot are still extracted from nasm's
#    boot.o by gen_boot_driver.py — scaffolding that proves the WRITER correct.
#    asm.la emitting those lists from source is the remaining nasm-free step.
# =====================================================================

#    The record CONSTRUCTORS and the list pair are exported alongside the emitter
#    so a producer (asm.la's ASM_ELF) can build elfobj's inputs without importing
#    elfobj's representation of them — it is handed the constructors instead.
export EMIT_OBJ_N SDESC SREC RINFO RREC CONS NIL

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

#   Little-endian integer emission. An ELF field's WIDTH is part of the format,
#   so each width is its own function rather than one variadic helper — a
#   32-bit field written as 64 bits shifts every following field and produces a
#   file that parses as garbage.
glyph B   = la n. chr(int_to_str(n))
glyph LE2 = la n. concat(B(mod(n)(256)))(B(mod(div(n)(256))(256)))
glyph LE4 = la n.
    concat(B(mod(n)(256)))
   (concat(B(mod(div(n)(256))(256)))
   (concat(B(mod(div(n)(65536))(256)))
          (B(mod(div(n)(16777216))(256)))))
glyph LE8 = la n. concat(LE4(mod(n)(4294967296)))(LE4(div(n)(4294967296)))
glyph ZEROS = Z(la self. la n.
    IF(int_eq(n)(0))(la _. "")(la _. concat(B(0))(self(sub(n)(1)))))
glyph LENOF = la s. str_to_int(str_len(s))

#   PAD to a boundary. Section contents are aligned so the linker can place
#   them without re-copying; misalignment is accepted by readelf but rejected
#   by some linkers, so it is done rather than skipped.
glyph PADTO = la off. la a. ZEROS(mod(sub(a)(mod(off)(a)))(a))

# ── Church lists + pairs, and the symbol-table fold ─────────────────────────
#   Slice (ii): the symbol table is no longer three hardcoded names — it is a
#   LIST of records, folded to produce the .symtab bytes AND the .strtab in one
#   pass, threading each name's offset. A record is SREC(name)(info)(shndx)(value)
#   (name "" for a SECTION symbol, which contributes no string). The caller
#   orders the list as nasm does — FILE, the SECTION symbols, the LOCAL labels
#   in source order, then the GLOBALs — because that order survives into the
#   linked .symtab and the gate is ld(ours)==ld(nasm).
glyph NIL  = la c. la n. n
glyph CONS = la h. la t. la c. la n. c(h)(t(c)(n))
glyph PAIR = la a. la b. la f. f(a)(b)
glyph FST  = la p. p(la a. la b. a)
glyph SND  = la p. p(la a. la b. b)
#   A symbol's st_value is 64-bit and can exceed LA's signed-int lexer limit (a
#   higher-half ABS symbol is 0xFFFFFFFF80000000), so it is carried as two 32-bit
#   halves vlo/vhi rather than one literal — the emitter encodes LE4(vlo)++LE4(vhi).
glyph SREC = la name. la info. la shndx. la vlo. la vhi. la k. k(name)(info)(shndx)(vlo)(vhi)

#   SYMSTEP folds one record: it emits the record's 24-byte SYM and, for a named
#   record, appends name+NUL to the strtab and advances the offset. `rest` is the
#   already-folded tail as a function of the incoming strtab offset, so the whole
#   fold is a function of the starting offset (1, past the leading NUL).
glyph SYMSTEP = la rec. la rest. la off.
   rec(la name. la info. la shndx. la vlo. la vhi.
     IF(str_eq(name)(""))
       (la _. (la p. PAIR(concat(SYM(0)(info)(shndx)(vlo)(vhi)(0))(FST(p)))(SND(p)))
                (rest(off)))
       (la _. (la p. PAIR(concat(SYM(off)(info)(shndx)(vlo)(vhi)(0))(FST(p)))
                         (concat(concat(name)(B(0)))(SND(p))))
                (rest(add(add(off)(LENOF(name)))(1)))))

#   BUILD_SYMSTR(list) -> PAIR(symtab)(strtab): prepend the null SYM and the
#   leading strtab NUL to the fold's result.
glyph BUILD_SYMSTR = la list.
  (la tailp.
     PAIR(concat(SYM(0)(0)(0)(0)(0)(0))(FST(tailp)))
         (concat(B(0))(SND(tailp))))
  (list(SYMSTEP)(la off. PAIR("")(""))(1))

#   sh_info on .symtab = index of the first non-local symbol = count of locals.
#   Start at 1 for the null symbol; a record is local when its st_info binding
#   nibble (info >> 4) is 0.
glyph NLOCAL = la list.
   list(la rec. la acc.
          add(rec(la n. la info. la sh. la vl. la vh.
                    IF(int_eq(div(info)(16))(0))(la _. 1)(la _. 0)))
             (acc))
       (1)

# ── list utilities for the N-section emitter (slice iv-a) ───────────────────
glyph LEN    = la list. list(la h. la acc. add(1)(acc))(0)
glyph MAP    = la f. la list. list(la h. la t. CONS(f(h))(t))(NIL)
glyph APPEND = la a. la b. a(la h. la t. CONS(h)(t))(b)

#   A SECTION descriptor: 9 fields, matching the layout an ELF section header
#   needs. NOBITS (.bss) is expressed as content "" + a nonzero size — it takes a
#   header slot and a byte count but contributes NO file bytes, so the file
#   cursor does not advance over it (nasm gives .bss the same sh_offset as the
#   section that follows). A content section passes size = LENOF(content).
glyph SDESC = la name. la typ. la flags. la align. la link. la info. la entsz. la content. la size.
   la k. k(name)(typ)(flags)(align)(link)(info)(entsz)(content)(size)
glyph GETNAME    = la s. s(la nm. la t. la f. la a. la l. la i. la e. la c. la z. nm)
glyph GETCONTENT = la s. s(la nm. la t. la f. la a. la l. la i. la e. la c. la z. c)

#   A per-target relocation-info record for the auto-appended .rela.<name>
#   sections: the target section's name, its index, and the reloc list.
glyph RINFO = la tname. la tidx. la rlist. la k. k(tname)(tidx)(rlist)

#   NAMEOFF: a section name's byte offset in the shstrtab (built below). Names
#   are unique, so a left-to-right scan threading the offset finds it; the fold's
#   base returns 0 (the null section's sh_name, never otherwise reached).
glyph NAMEOFF = la target. la names.
   names(la nm. la rest. la off.
           IF(str_eq(nm)(target))(la _. off)
             (la _. rest(add(add(off)(LENOF(nm)))(1))))
        (la off. 0)
        (1)

#   SHSTRTAB_OF: the section-header string table — a leading NUL then each name
#   NUL-terminated, in the order NAMEOFF walks them.
glyph SHSTRTAB_OF = la names.
   concat(B(0))(names(la nm. la rest. concat(concat(nm)(B(0)))(rest))(""))

# ── the ELF64 header (64 bytes) ─────────────────────────────────────────────
#   e_ident is the magic plus five one-byte declarations: ELFCLASS64 (2),
#   ELFDATA2LSB (1), EV_CURRENT (1), ELFOSABI_SYSV (0), ABI version (0), then
#   7 bytes of padding. Getting the class or endianness wrong makes every
#   subsequent field the wrong size or byte order — the file will not merely be
#   invalid, it will be misread.
glyph EHDR = la shoff. la shnum. la shstrndx.
    concat(concat(B(127))(concat(B(69))(concat(B(76))(B(70)))))     # 7f E L F
   (concat(B(2))                                                    # ELFCLASS64
   (concat(B(1))                                                    # ELFDATA2LSB
   (concat(B(1))                                                    # EV_CURRENT
   (concat(B(0))                                                    # SYSV ABI
   (concat(B(0))                                                    # ABI version
   (concat(ZEROS(7))                                                # e_ident pad
   (concat(LE2(1))                                                  # e_type = ET_REL
   (concat(LE2(62))                                                 # e_machine = X86-64
   (concat(LE4(1))                                                  # e_version
   (concat(LE8(0))                                                  # e_entry (none in a .o)
   (concat(LE8(0))                                                  # e_phoff
   (concat(LE8(shoff))                                              # e_shoff
   (concat(LE4(0))                                                  # e_flags
   (concat(LE2(64))                                                 # e_ehsize
   (concat(LE2(0))                                                  # e_phentsize
   (concat(LE2(0))                                                  # e_phnum
   (concat(LE2(64))                                                 # e_shentsize
   (concat(LE2(shnum))                                              # e_shnum
          (LE2(shstrndx))))))))))))))))))))                         # e_shstrndx

# ── a section header (64 bytes) ─────────────────────────────────────────────
glyph SHDR = la nm. la typ. la flags. la off. la size. la link. la info. la align. la entsz.
    concat(LE4(nm))
   (concat(LE4(typ))
   (concat(LE8(flags))
   (concat(LE8(0))                                                  # sh_addr: 0 in a .o
   (concat(LE8(off))
   (concat(LE8(size))
   (concat(LE4(link))
   (concat(LE4(info))
   (concat(LE8(align))
          (LE8(entsz))))))))))

# ── a symbol table entry (24 bytes) ─────────────────────────────────────────
#   st_info packs binding and type into one byte: (bind << 4) | type.
#   LOCAL=0 GLOBAL=1; NOTYPE=0 SECTION=3 FILE=4.
glyph SYM = la nm. la info. la shndx. la vlo. la vhi. la size.
    concat(LE4(nm))
   (concat(B(info))
   (concat(B(0))                                                    # st_other
   (concat(LE2(shndx))
   (concat(concat(LE4(vlo))(LE4(vhi)))                              # st_value (64-bit, two halves)
          (LE8(size))))))

# ── a relocation-with-addend entry (24 bytes, Elf64_Rela) ───────────────────
#   r_info packs the symbol table index and the reloc type: (sym << 32) | type.
#   The linker reads the symbol from OUR .symtab by that index — get it wrong
#   and the fixup lands against the wrong (or a nonexistent) symbol. r_addend
#   is signed; only the non-negative case is needed here (0 for a local-label
#   reference, which nasm emits as SECTION-symbol + label-offset).
glyph REL = la off. la sym. la typ. la addend.
    concat(LE8(off))
   (concat(LE8(add(mul(sym)(4294967296))(typ)))
          (LE8(addend)))

#   Slice (iii): relocations are a LIST too, one per .rela.<section>. A record is
#   RREC(offset)(sym)(type)(addend); the three types boot.asm needs are 1
#   (R_X86_64_64, `dq`/`mov r64`), 10 (R_X86_64_32, `dd`/`mov r32`), 11
#   (R_X86_64_32S, `mov qword [m]`/`add r64`). BUILD_RELA folds a list into the
#   section's Elf64_Rela bytes, head-first (so the emitted order matches nasm's).
glyph RREC = la off. la sym. la typ. la addend. la k. k(off)(sym)(typ)(addend)
glyph BUILD_RELA = la list.
   list(la r. la acc.
          r(la off. la sym. la typ. la addend.
              concat(REL(off)(sym)(typ)(addend))(acc)))
       ("")


# ── EMIT_OBJ_N(content)(symlist)(relainfo) — the N-section emitter (iv-a) ─────
#   `content` is a list of SDESC for the allocatable sections (in source order);
#   `symlist` the caller-ordered symbol list; `relainfo` a list of RINFO(target
#   name)(target index)(reloc list). elfobj AUTO-APPENDS .shstrtab, .symtab,
#   .strtab, then one .rela.<name> per relainfo entry — so the produced section
#   order is null, [content...], .shstrtab, .symtab, .strtab, [.rela...], exactly
#   nasm's. Section indices: content are 1..numc, .symtab is numc+2 (rela sh_link),
#   .strtab numc+3 (symtab sh_link); a rela's sh_info is its target's index.
#   Offsets thread over the real sections with the file cursor starting at 64;
#   a NOBITS section (content "") emits no bytes so the cursor holds, matching
#   nasm's .bss offset. sh_name comes from NAMEOFF over the section-name list.
#   Helpers (each independently testable). BUILD_NAMES: the ordered section-name
#   list. BUILD_RELASECS: one .rela.<tn> SDESC per relainfo entry (sh_link=symtab
#   idx numc+2, sh_info=target idx). BUILD_REALSECS: content ++ the three meta
#   sections ++ the rela sections. FOLD_SECS: threads the file cursor from 64,
#   emitting the content blob + header table (sh_name via NAMEOFF, NOBITS holds
#   the cursor). ASSEMBLE_OBJ: ehdr ++ blob ++ null-header ++ headers.
glyph BUILD_NAMES = la content. la relainfo.
   APPEND(MAP(GETNAME)(content))
     (CONS("\.shstrtab")(CONS("\.symtab")(CONS("\.strtab")
       (MAP(la ri. ri(la tn. la ti. la rl. concat("\.rela")(tn)))(relainfo)))))

glyph BUILD_RELASECS = la relainfo. la numc.
   MAP(la ri. ri(la tn. la ti. la rl.
         (la body. SDESC(concat("\.rela")(tn))(4)(0)(8)(add(numc)(2))(ti)(24)(body)(LENOF(body)))
           (BUILD_RELA(rl))))(relainfo)

glyph BUILD_REALSECS = la content. la numc. la shstr. la symtab. la strtab. la symlist. la relasecs.
   APPEND(content)
     (CONS(SDESC("\.shstrtab")(3)(0)(1)(0)(0)(0)(shstr)(LENOF(shstr)))
     (CONS(SDESC("\.symtab")(2)(0)(8)(add(numc)(3))(NLOCAL(symlist))(24)(symtab)(LENOF(symtab)))
     (CONS(SDESC("\.strtab")(3)(0)(1)(0)(0)(0)(strtab)(LENOF(strtab)))
       (relasecs))))

glyph FOLD_SECS = la realsecs. la names.
   realsecs(la sec. la rest. la cur.
       sec(la nm. la typ. la flg. la aln. la lnk. la inf. la ent. la cont. la sz.
         (la p. PAIR(concat(cont)(FST(p)))
                    (concat(SHDR(NAMEOFF(nm)(names))(typ)(flg)(cur)(sz)(lnk)(inf)(aln)(ent))(SND(p))))
           (rest(add(cur)(LENOF(cont))))))
     (la cur. PAIR("")(""))
     (64)

glyph ASSEMBLE_OBJ = la numc. la nreal. la blob. la hdrs.
   concat(EHDR(add(64)(LENOF(blob)))(add(nreal)(1))(add(numc)(1)))
  (concat(blob)
  (concat(SHDR(0)(0)(0)(0)(0)(0)(0)(0)(0))
         (hdrs)))

glyph EMIT_OBJ_N = la content. la symlist. la relainfo.
  (la numc.
  (la symstr.
  (la names.
  (la realsecs.
  (la folded.
     ASSEMBLE_OBJ(numc)(LEN(realsecs))(FST(folded))(SND(folded)))
  (FOLD_SECS(realsecs)(names)))                                    # folded
  (BUILD_REALSECS(content)(numc)(SHSTRTAB_OF(names))(FST(symstr))(SND(symstr))(symlist)(BUILD_RELASECS(relainfo)(numc))))  # realsecs
  (BUILD_NAMES(content)(relainfo)))                                # names
  (BUILD_SYMSTR(symlist)))                                         # symstr
  (LEN(content))                                                   # numc

#   The fixture (r3.asm) exercises all three reloc types across both sections:
#     section .text: mov rax,_start (64@2); mov eax,_start (32@0xb);
#                    mov qword [rax],_start (32S@0x12); syscall
#     section .data: dq _start (64@0); dd _start (32@8)
#   .text is 24 bytes (movabs 10 + mov-eax 5 + mov-qword 7 + syscall 2), .data 12
#   zero bytes. Payloads are supplied here (the writer's job is the container, not
#   assembling — asm.la emitting these lists is the later integration slice); the
#   gate proves OUR container links byte-identically to nasm's given them.
glyph TEXTBYTES =
   concat(B(72))(concat(B(184))(concat(ZEROS(8))(concat(B(184))(concat(ZEROS(4))
  (concat(B(72))(concat(B(199))(concat(ZEROS(5))(concat(B(15))(B(5))))))))))

#   Symbols in nasm's order: FILE, the two SECTION symbols, the LOCAL labels in
#   source order (.data's a@0, b@8), then the GLOBAL _start (.text @0).
glyph SYMLIST =
   CONS(SREC("r3.asm")(4)(65521)(0)(0))
  (CONS(SREC("")(3)(1)(0)(0))
  (CONS(SREC("")(3)(2)(0)(0))
  (CONS(SREC("a")(0)(2)(0)(0))
  (CONS(SREC("b")(0)(2)(8)(0))
  (CONS(SREC("_start")(16)(1)(0)(0))
   (NIL))))))

#   Relocations per section, all against the .text SECTION symbol (#2) + addend 0
#   (nasm's convention for a local-label reference). Types: 1=64, 10=32, 11=32S.
glyph TEXTRELAS =
   CONS(RREC(2)(2)(1)(0))
  (CONS(RREC(11)(2)(10)(0))
  (CONS(RREC(18)(2)(11)(0))
   (NIL)))

glyph DATARELAS =
   CONS(RREC(0)(2)(1)(0))
  (CONS(RREC(8)(2)(10)(0))
   (NIL))

# The r3 fixture rebuilt through the GENERAL EMIT_OBJ_N (regression: same object
# EMIT_OBJ2 produced, now via the section-list path). .text is AX(6)/align16,
# .data WA(3)/align4; both have a rela list.
glyph CONTENT_R3 =
   CONS(SDESC("\.text")(1)(6)(16)(0)(0)(0)(TEXTBYTES)(LENOF(TEXTBYTES)))
  (CONS(SDESC("\.data")(1)(3)(4)(0)(0)(0)(ZEROS(12))(12))
   (NIL))

glyph RELAINFO_R3 =
   CONS(RINFO("\.text")(1)(TEXTRELAS))
  (CONS(RINFO("\.data")(2)(DATARELAS))
   (NIL))

glyph MAIN =
  (la obj.
    (la _. print(concat(concat("elfobj.la emitted ")(str_len(obj)))(" bytes -> elfobj_out.o")))
    (write_file("elfobj_out.o")(obj)))
  (EMIT_OBJ_N(CONTENT_R3)(SYMLIST)(RELAINFO_R3))
