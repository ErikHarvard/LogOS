# ZA : fixpoint combinator (call-by-value Z)
glyph ZA = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
# TRA : Church true
glyph TRA = la t. la f. t
# FAA : Church false
glyph FAA = la t. la f. f
# IFA : conditional over thunked branches
glyph IFA = la c. la t. la f. c(t)(f)("!")
# NILA : the empty list
glyph NILA = la n. la c. n
# CONSA : list cons
glyph CONSA = la h. la t. la n. la c. c(h)(t)
# ISNILA : is the list empty
glyph ISNILA = la l. l(TRA)(la h. la t. FAA)
# APPA : append two lists
glyph APPA = ZA(la self. la a. la b. a(b)(la h. la t. CONSA(h)(self(t)(b))))
# MAPA : map a function over a list
glyph MAPA = la f. ZA(la self. la l. l(NILA)(la h. la t. CONSA(f(h))(self(t))))
# LENA : list length
glyph LENA = ZA(la self. la l. l(0)(la h. la t. add(1)(self(t))))
# JOINA : join a list of strings with a separator
glyph JOINA = la sep. ZA(la self. la l. l("")(la h. la t. t(h)(la h2. la t2. concat(h)(concat(sep)(self(t))))))
# PCOUNT : node -> its parent count: 0 primitive, 2 binary mode, 1 metacursion (the dyadic law)
glyph PCOUNT = la n. n(la nm. 0)(la a. la b. 2)(la a. la b. 2)(la a. la b. 2)(la a. la b. 2)(la a. 1)
# KIDS : node -> the list of its parents, in order
glyph KIDS = la n. n(la nm. NILA)(la a. la b. CONSA(a)(CONSA(b)(NILA)))(la a. la b. CONSA(a)(CONSA(b)(NILA)))(la a. la b. CONSA(a)(CONSA(b)(NILA)))(la a. la b. CONSA(a)(CONSA(b)(NILA)))(la a. CONSA(a)(NILA))
# NEXTGEN : a generation -> the next one back (every parent of every node, in order)
glyph NEXTGEN = ZA(la self. la l. l(NILA)(la h. la t. APPA(KIDS(h))(self(t))))
# GENS : a generation -> it and every generation behind it, down to the leaves
glyph GENS = ZA(la self. la l. l(NILA)(la h. la t. CONSA(l)(self(NEXTGEN(l)))))
# ANC_GENS : node -> its generations, the glyph first
glyph ANC_GENS = la n. GENS(CONSA(n)(NILA))
# LEAVES : node -> the names of its leaves, left to right
glyph LEAVES = ZA(la self. la n. n(la nm. CONSA(nm)(NILA))(la a. la b. APPA(self(a))(self(b)))(la a. la b. APPA(self(a))(self(b)))(la a. la b. APPA(self(a))(self(b)))(la a. la b. APPA(self(a))(self(b)))(la a. self(a)))
# HASNAME : name -> list of names -> is it there
glyph HASNAME = ZA(la self. la x. la l. l(FAA)(la h. la t. IFA(str_eq(h)(x))(la _. TRA)(la _. self(x)(t))))
# DYAD : node -> which of its leaves ARE the dyad (VOID = 0, BEING = 1; WP sub:zeroone), or an em dash
glyph DYAD = la n. (la ls. (la v. la b. IFA(v)(la _. IFA(b)(la _. "VOID,BEING")(la _. "VOID"))(la _. IFA(b)(la _. "BEING")(la _. "—")))(HASNAME("VOID")(ls))(HASNAME("BEING")(ls)))(LEAVES(n))
# ENTRY : renderer -> node -> the node rendered, with its parent count
glyph ENTRY = la render. la n. concat(render(n))(concat("[")(concat(int_to_str(PCOUNT(n)))("]")))
# GENLINE : renderer -> index -> generation -> one line of the walk
glyph GENLINE = la render. la k. la l. concat(int_to_str(k))(concat(":")(JOINA(", ")(MAPA(ENTRY(render))(l))))
# WALKSTR : renderer -> first index -> generations -> the walk, generation by generation
glyph WALKSTR = la render. ZA(la self. la k. la gs. gs("")(la h. la t. concat(GENLINE(render)(k)(h))(t("")(la h2. la t2. concat(" / ")(self(add(k)(1))(t))))))
# ANCESTRY : renderer -> node -> the complete line back to the nine and the dyad, as ONE walk (M11b)
glyph ANCESTRY = la render. la n. concat(WALKSTR(render)(0)(ANC_GENS(n)))(concat(" :: dyad ")(DYAD(n)))
export ZA TRA FAA IFA NILA CONSA ISNILA APPA MAPA LENA JOINA PCOUNT KIDS NEXTGEN GENS ANC_GENS LEAVES HASNAME DYAD ENTRY GENLINE WALKSTR ANCESTRY 
