# =====================================================================
#  LogOS HAL.4 — linear-framebuffer display via a PCI BAR, in Lingua Adamica.
#
#  The kernel's first pixels on its own. On the HAL.1 port-I/O floor plus the
#  HAL.4 16-bit primitives (outw/inw), an LA program at ring 0:
#    1. scans PCI config space for the QEMU std VGA (vendor 0x1234 / device
#       0x1111 -> reg0 = 0x11111234 = 286331444);
#    2. reads its BAR0 (config offset 0x10) — the linear framebuffer's physical
#       base — and masks off the low type bits;
#    3. sets 640x480x32 with a linear framebuffer via the Bochs VBE "dispi"
#       registers (index port 0x1CE=462, data port 0x1CF=463): XRES/YRES/BPP,
#       then ENABLE = 0x41 (enabled | LFB). Reads back VIRT_WIDTH to get the
#       true scanline pitch;
#    4. pokes a 64x64 red square (B=0 G=0 R=255) into the top-left of the LFB;
#    5. announces "fb drawn" and spins, so the framebuffer persists for the
#       gate's screendump.
#  The high BAR (~0xFD000000) is reachable because boot.asm (%ifdef HAL4)
#  identity-maps 0..4 GiB. Flat + import-free, like pci/kbd/ata.la.
# =====================================================================

glyph Z    = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF   = la c. la t. la f. c(t)(f)("!")
glyph SEQ  = la a. la b. b

# ── PCI config-space read: reg at (bus 0, dev, off) via 0xCF8/0xCFC ──
glyph CFG = la dev. la off.
    SEQ(outl(3320)(add(add(2147483648)(mul(dev)(2048)))(off)))
       (inl(3324))

# find the std VGA on bus 0 (reg0 == 0x11111234)
glyph FIND = Z(la self. la dev.
    IF(int_eq(dev)(32))(la _. 0)(la _.
      IF(int_eq(CFG(dev)(0))(286331444))(la _. dev)(la _.
        self(add(dev)(1)))))

# ── Bochs VBE dispi: write / read a register (index 0x1CE=462, data 0x1CF=463) ──
glyph DISPI  = la idx. la val. SEQ(outw(462)(idx))(outw(463)(val))
glyph RDISPI = la idx. SEQ(outw(462)(idx))(inw(463))

# set 640x480x32 with a linear framebuffer (ENABLE bit 0 + LFB bit 6 = 0x41)
glyph SETMODE =
    SEQ(DISPI(4)(0))          # disable while configuring
    (SEQ(DISPI(1)(640))       # XRES
    (SEQ(DISPI(2)(480))       # YRES
    (SEQ(DISPI(3)(32))        # BPP
    (DISPI(4)(65)))))         # ENABLE = enabled | LFB

# ══ THE LOGOS SIGIL AS A PRECOMPUTED RUN-LENGTH BITMAP ════════════════════
# Λ, the Meta-Word (sigil.la's LOGOS glyph), rendered by the language at 128x128
# and encoded here as run lengths -- the theourgia_font.la flat-literal idiom: a
# string literal lowers to ONE instruction, where a nested structure makes codegen
# pathologically slow. Runs alternate UNLIT/LIT; each char is chr(len+40), so the
# alphabet 40..91 excludes the quote and backslash and needs no escaping.
glyph DATA = "[([([([([([([([([([([([([([([([([([([([([(9M[(F==-[(BE9-[(>M5-[(<<)<3.[(85=50.[(63E3..[(42K2,.[(30Q0+.[(10U0)/[(//Y6[(-/[(*4[(,/[(,3[(+.[(01[()/[(20[/[(4/Z.[(60X.[(71V.[(91T.[(:2S-[(;2R-[(<3P-[(=.)-N-[(?-*-M-[(?-*-L-[(@-+-J-[(4:,-I,[(1>-,H-[(-B--F-[(.B.-E,[(/B/,D-[(/>3-C,[(0:8,B-[(R-A,[(T,A,[(T,@,[(V,?,[(V,>-[(V-=,[(X,=,[(X,=,[(X,<,<3O3<,;,:8I8:,;,8<E<8,;,7?A?7,:,652,=,256,9,637*;*736,9,53:)9):35,9,43<)7)<34,9,42[(024,9,32A)1)A23,9,32B)+)+)B23,9,23C/C32,9,22D/D22,9,22D/D22,8,32C1C23,8,22D/D22,9,22D/D22,9,23C/C32,9,32B)+)+)B23,9,32A)1)A23,9,42[(024,9,43<)7)<34,9,53:)9):35,9,637*;*736,9,652,=,256,:,7?A?7,;,8<E<8,;,:8I8:,;,<3O3<,<,[(X,=,[(X,=,[(X,=-[(V->,[(V,?,[(V,@,[(T,A,[(T,A-[(R-B,[(R,C-[(P-D,[(P,E-[(N-F-[(L-H,[(L,I-[(J-J-[(H-L-[(F-M-[(F-N-[(D-P-[(B-R-[(@-S.[(>.T.[(<.V.[(:.X.[(8.Z/[(4/[()/[(2/[(,.[(0.[(//[(,/[(1/[(*/[(4/Y/[(70U0[(:0Q0[(=2K2[(@3E3[(D5=5[(I<)<[(NM[(TE[([()=[([(7)[([([([([([([([([([([([([([([([([([(Q"
glyph GOLD = la base. la pitch. la sy. la sx.
    (la p. SEQ(poke(p)(60))(SEQ(poke(add(p)(1))(210))(poke(add(p)(2))(255))))
    (add(base)(add(mul(sy)(pitch))(mul(sx)(4))))
# one lit grid cell -> a 3x3 gold block (the ×3 upscale to 384x384)
glyph BLK = la base. la pitch. la sy. la sx.
    SEQ(GOLD(base)(pitch)(sy)(sx))
   (SEQ(GOLD(base)(pitch)(sy)(add(sx)(1)))
   (SEQ(GOLD(base)(pitch)(sy)(add(sx)(2)))
   (SEQ(GOLD(base)(pitch)(add(sy)(1))(sx))
   (SEQ(GOLD(base)(pitch)(add(sy)(1))(add(sx)(1)))
   (SEQ(GOLD(base)(pitch)(add(sy)(1))(add(sx)(2)))
   (SEQ(GOLD(base)(pitch)(add(sy)(2))(sx))
   (SEQ(GOLD(base)(pitch)(add(sy)(2))(add(sx)(1)))
       (GOLD(base)(pitch)(add(sy)(2))(add(sx)(2))))))))))
glyph CELL = la base. la pitch. la i.
    (la r. la c. BLK(base)(pitch)(add(48)(mul(r)(3)))(add(128)(mul(c)(3))))
    (div(i)(128)) (mod(i)(128))
glyph RUN = Z(la self. la base. la pitch. la i. la n.
    IF(int_eq(n)(0))(la _. "!")(la _.
      SEQ(CELL(base)(pitch)(i))(self(base)(pitch)(add(i)(1))(sub(n)(1)))))
glyph WALK = Z(la self. la base. la pitch. la s. la i. la lit.
    IF(str_eq(s)(""))(la _. "!")(la _.
      (la n.
        IF(lit)
          (la _. SEQ(RUN(base)(pitch)(i)(n))
                    (self(base)(pitch)(str_tail(s))(add(i)(n))(FALSE)))
          (la _. self(base)(pitch)(str_tail(s))(add(i)(n))(TRUE)))
      (sub(str_to_int(ord(str_head(s))))(40))))
# indigo field, then the sigil over it
glyph BGROW = Z(la self. la base. la pitch. la y. la x.
    IF(int_eq(x)(640))(la _. "!")(la _.
      (la p. SEQ(poke(p)(30))(SEQ(poke(add(p)(1))(15))(SEQ(poke(add(p)(2))(25))
             (self(base)(pitch)(y)(add(x)(1))))))
      (add(base)(add(mul(y)(pitch))(mul(x)(4))))))
glyph FIELD = Z(la self. la base. la pitch. la y.
    IF(int_eq(y)(480))(la _. "!")(la _.
      SEQ(BGROW(base)(pitch)(y)(0))(self(base)(pitch)(add(y)(1)))))
glyph SPLASH = la base. la pitch.
    SEQ(FIELD(base)(pitch)(0))(WALK(base)(pitch)(DATA)(0)(FALSE))
glyph TRUE  = la t. la f. t
glyph FALSE = la t. la f. f

# hold the framebuffer up (no exit) so the gate can screendump it
glyph SPIN = Z(la self. la _. self("!"))

glyph MAIN =
    (la dev.
      (la bar.
        (la base.
          SEQ(SETMODE)
          ((la pitch.
              SEQ(print(concat(concat("fb lfb=")(int_to_str(base)))(concat(" pitch=")(int_to_str(pitch)))))
              (SEQ(SPLASH(base)(pitch))
              (SEQ(print("fb drawn"))
              (SPIN("!")))))
           (mul(RDISPI(6))(4))))          # pitch = VIRT_WIDTH * 4 bytes
        (sub(bar)(mod(bar)(16))))          # LFB base = BAR0 & ~0xF
      (CFG(dev)(16)))                       # BAR0
    (FIND(0))
