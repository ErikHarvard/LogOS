# =====================================================================
#  RUNTIME CONTINUOUS SELF-VERIFICATION — the system checks its own coherence
#  WHILE ALIVE, and restores it without stopping.
#
#  ── THE SEAM THIS CLOSES ────────────────────────────────────────────────────
#  build.sh IS the autological criterion — but it runs at BUILD time, once, and
#  then the system runs for however long with nothing watching it. selfrepair.la
#  (B3) is likewise a SINGLE act: sense, heal, done. Neither is the system
#  verifying itself while it is alive. That is the gap: everything the project
#  verifies, it verifies about a system that is not running.
#
#  aatc.la already names why this matters, in its own vocabulary: ρ (the
#  recognition coefficient) is 0 for a structure that is UNWITNESSED, and an
#  unwitnessed structure "drifts toward potentiality". A system verified only at
#  build time is unwitnessed for its entire life.
#
#  ── WHAT IT IS ──────────────────────────────────────────────────────────────
#  aatc.la's Centropic loop (Sense -> Diagnose -> Prescribe -> Learn) running
#  CONTINUOUSLY rather than once:
#     SENSE     : INTACT(path)(spec) — are my bytes still my own derivation?
#     DIAGNOSE  : autological, or heterological (bytes floated free of it)?
#     PRESCRIBE : HEAL — regenerate from the verified source, verify-or-refuse
#     LEARN     : the ledger — what happened, tick by tick
#  Nothing here is a new criterion. It is B3's criterion, put on a loop.
#
#  ── THE INJECTION IS A TEST, AND IS LABELLED AS ONE ─────────────────────────
#  To show detection-while-alive there must BE a corruption while alive, so tick
#  3 corrupts the organ deliberately (CORRUPT below) before sensing. That is a
#  test injection standing in for whatever would really corrupt a component —
#  it is not the system damaging itself, and it is not a discovery. What IS
#  demonstrated is everything after: the loop was already running, it noticed on
#  its very next sense, and it restored closure without being restarted.
#
#  ── HONEST SCOPE ────────────────────────────────────────────────────────────
#  A BOUNDED loop (N ticks), not a daemon: no scheduler, no timer, no signals,
#  and nothing else is running alongside it to be watched. It senses ONE
#  spec-generated organ — B3's boundary applies unchanged: repairable ==
#  spec-generated, because only a component whose derivation the system still
#  holds can be regenerated. Watching the WHOLE system (every organ, on a real
#  schedule, concurrently with real work) is the extension; this closes the
#  criterion-on-a-loop, which is the part that was missing.
#  And per ROADMAP Tier 3 (Gödel): this is BOUNDED self-verification — the only
#  kind there is. A consistent system cannot prove its own consistency from
#  within, so "the system fully verifies itself while alive" is not the goal and
#  is not claimed. It verifies a NAMED INVARIANT continuously, which is real.
# =====================================================================

import("specpipe.la")
import("autoloop.la")
import("selfrepair.la")

export WATCH TICK

glyph SEQ3 = la a. la b. b
glyph NOT3 = la b. b(FALSE)(TRUE)

#  A plausible corruption: a wrong constant that still PARSES and still defines
#  its namesake, so a structural sense would call the organ healthy. Only the
#  byte-exact criterion catches it (B3's lesson, kept).
glyph CORRUPT =
  concat("# generated by specpipe.la — regenerated from the spec, do not edit\n")
        ("glyph TRIPLEN = la x. mul(x)(4)\nglyph DEC = la x. sub(x)(1)\nglyph AVG = la x. la y. div(add(x)(y))(2)\n")

#  The test injection — tick 3 only. Labelled, bounded, and not the system
#  damaging itself.
glyph INJECT = la i. la path.
    IF(int_eq(i)(3))(la _. SEQ3(write_file(path)(CORRUPT))("  [tick 3: something corrupts the organ underneath the running loop]"))
                    (la _. "")

#  ONE TICK of the live loop: sense, and if closure is gone, restore it.
glyph TICK = la path. la spec.
    IF(INTACT(path)(spec))
      (la _. "ok")
      (la _. SEQ3(HEAL(path)(spec))
                 (IF(INTACT(path)(spec))(la _. "REPAIRED")(la _. "STILL-BROKEN")))

#  The loop itself. Its self-call is in tail position, so on the native VM it
#  runs in bounded dump depth — i.e. this shape is what a real daemon would use.
glyph WATCH = Z(la self. la i. la n. la path. la spec. la led.
    IF(lt(n)(i))
      (la _. led)
      (la _. (la inj.
               SEQ3(IF(str_eq(inj)(""))(la _. "")(la _. print(inj)))
               ((la r.
                  SEQ3(print(concat(concat("  tick ")(int_to_str(i)))(concat(": ")(r))))
                      (self(add(i)(1))(n)(path)(spec)(concat(led)(IF(str_eq(r)("ok"))(la _. ".")(la _. "R")))))
                (TICK(path)(spec))))
             (INJECT(i)(path))))

glyph MAIN =
  SEQ3(print("── runtime continuous self-verification: the system watches itself WHILE ALIVE ──"))
  (SEQ3(DEPLOY(ORGAN_SPEC)("watched.la"))
  (SEQ3(print("  organ deployed from its own derivation; entering the watch loop (5 ticks)"))
  ((la led.
     print(concat(concat("  ledger: ")(led))
                 (" — '.' = closure held, 'R' = drift DETECTED and closure RESTORED, live")))
   (WATCH(1)(5)("watched.la")(ORGAN_SPEC)("")))))
