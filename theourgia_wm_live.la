# ═══════════════════════════════════════════════════════════════════
#  theourgia_wm_live.la — the tiling window manager, live (VM-only, manual).
#
#  The LogOS tiling window manager on a real screen and a real keyboard:
#  terminals tile the display, each running logosh; the keyboard is read
#  straight from evdev and every frame goes out through drm_mode/present. It is
#  theourgia_wm_sim.la with the two devices made real — the same WM_BUILD and
#  the same poll loop — so everything but the devices is what
#  gate_wm_session.sh checks headless.
#
#  Needs a BARE VT (DRM master) and read access to /dev/input, so it runs as
#  root; launch it with drm_bringup_wm.sh, which builds it, frees the GPU,
#  restores the greeter afterwards and flushes the keystrokes the VT buffered.
#  The keyboard is found in /proc/bus/input/devices by wm_livestart.la's
#  KBD_KIT: the first device whose name contains "keyboard" (any case) and
#  whose handlers have kbd and an eventN. New shells start in the directory
#  named by logos_wm.cwd (drm_bringup_wm.sh writes it): its first line,
#  trimmed, or "/" when that is empty or names no directory. The text scale is
#  chosen from the screen width: 1 below 1920 pixels, 2 up to 3839, 4 above.
#
#  LOCK SCREEN: the WM starts LOCKED, its lock screen LogosSession
#  (logossession.la) behind lk_firstuser.la's app, built by
#  logos_realsess.la's REAL_LOCK, the same code theourgia_wm_simsess.la runs
#  headless (gate_wm_simsess.sh). The users directory is the first line of
#  logos_wm.users, trimmed, or /var/lib/logos when the file is missing or
#  that line is blank (wm_livestart.la's USERS_KIT); it is made, mode 0700,
#  when it does not exist, and anything there that is not a directory, a
#  line holding a NUL byte, or a directory over 3993 bytes (too long for
#  the files LogosSession makes under it) stops the WM with a message. When no user has ever been made there
#  (DIR/users does not exist) the WM starts at the first-run screen, which
#  makes the first user with LogosSession's adduser and logs in; otherwise
#  at the login screen. MOD+Esc locks. The keyboard, the cwd and the users
#  are all settled BEFORE drm_mode, so a loud failure never leaves a taken
#  screen. Keys typed while a login is checked (seconds, the lock screen
#  still drawn) are dropped once it unlocks, not typed into the terminal
#  (theourgia_wm.la's WM_LOOP). The lock screen is not a boundary against
#  someone at the keyboard: Ctrl+C still ends the whole session (below).
#
#  Keys: see theourgia_wm.la. MOD+Shift+e exits; so does Ctrl+C (the VT turns
#  it into SIGINT for the whole session).
# ═══════════════════════════════════════════════════════════════════

import("theourgia_tile.la")
import("theourgia_term.la")
import("theourgia_render.la")
import("logosh.la")
import("theourgia_wm.la")
import("theourgia_termfont.la")
import("logoskit.la")
import("lk_settings.la")
import("wm_livestart.la")
import("logos_realsess.la")

glyph B = la s. s(str_at)(ord)(str_to_int)(int_to_str)(concat)(str_eq)(str_len)
                (add)(sub)(mul)(div)(mod)(lt)(int_eq)(band)(bor)
glyph X = la s. s(poll)(read)(close)(print)(write_file)(exit)

# ── Startup helpers (run once, so written plainly) ──
glyph TRUE  = la t. la f. t
glyph FALSE = la t. la f. f
glyph Z     = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph IF    = la c. la t. la f. c(t)(f)("!")
# the keyboard: wm_livestart.la's KBD_KIT (one device block at a time; kit
# style, so the scan costs microseconds a byte, not milliseconds)
glyph DETECT = KBD_KIT(Z)(str_at)(str_len)(ord)(str_to_int)(add)(sub)(lt)(int_eq)(concat)
glyph OPEN_OR_DIE = la path.
    (la fd. IF(str_eq(str_head(fd))("-"))(la _.
        error(concat(concat("wm: cannot open ")(path))
            (concat(" (open -> ")(concat(fd)(concat("): ")(
              IF(str_eq(fd)("-2"))(la _. "no such device: the keyboard found in /proc/bus/input/devices has no node in /dev/input")
                (la _. IF(str_eq(fd)("-13"))(la _. "need read permission on /dev/input; run as root")
                         (la _. "the keyboard's device cannot be read"))))))))
    (la _. fd))(open(path)("0"))
# the directory new shells start in: wm_livestart.la's CWD_KIT (the first line
# of logos_wm.cwd, trimmed; "/" when that is empty or not a directory)
glyph CWD = CWD_KIT(Z)(str_at)(str_len)(str_eq)(concat)(str_to_int)(add)(sub)(lt)(int_eq)(div)(mod)(chr)(stat)
glyph SCALE_FOR = la w. IF(lt(w)(1920))(la _. 1)(la _. IF(lt(w)(3840))(la _. 2)(la _. 4))

glyph MAIN =
  (la kbd.
    IF(str_eq(kbd)(""))
      (la _. error("wm: no keyboard found (no device in /proc/bus/input/devices whose name has 'keyboard' and whose handlers have kbd and an event)"))
      (la _. (la fd. (la cwd. (la lock.
          (la dims. dims(la _. error("wm: drm_mode returned nothing"))(la w0. la r0. r0(la _. error("wm: bad drm_mode reply"))
                (la w1. la r1. r1(la _. error("wm: bad drm_mode reply"))(la w2. la r2.
            (la W. la H. la P.
              (la _.
                WM_BUILD(B)(X)
                  (TILE_KIT(add)(sub)(mul)(div)(lt)(int_eq)(concat)(int_to_str))
                  (TERM_KIT(str_at)(ord)(str_to_int)(str_len)(chr)(concat)(str_eq)(add)(sub)(mul)(div)(mod)(lt)(int_eq))
                  ((la font. la sc. RENDER_KIT(str_at)(ord)(str_to_int)(str_len)(chr)(int_to_str)(concat)(add)(sub)(mul)(div)(int_eq)(lt)(band)(str_eq)(error)(font)(sc))(TF_DECODE(str_at)(ord)(str_to_int)(str_len)(chr)(int_to_str)(concat)(add)(sub)(mul)(div)(int_eq)(TF_HEX)))
                  (SHELL_KIT(concat)(str_at)(str_len)(str_eq)(ord)(str_to_int)(int_to_str)(add)(sub)(mul)(div)(mod)(lt)(int_eq)
          (read_file)(stat)(mkdir)(rmdir)(unlink)(rename)(getpid)(pipe)(fork)(dup2)(open)(close)(execv)(exit)(sigprocmask)(waitpid)(kill)(poll))
                  (la s. s(LK_KIT)(SETTINGS_APP)(lock))
                  (la s. s(W)(H)(P)(SCALE_FOR(W))(cwd))
                  (la s. s(la bytes. present(bytes))(WM_CONS(fd)(WM_NIL))("2400")(FALSE)))
              (print(concat("wm: live ")(concat(int_to_str(W))(concat("x")(concat(int_to_str(H))
                  (concat(", keyboard /dev/input/event")(kbd))))))))
            (str_to_int(w0))(str_to_int(w1))(str_to_int(w2))))))
          (WM_SPLIT(B)(WM_LISTS(B))(drm_mode("!"))))
        # the lock screen, users directory and all, before drm_mode
        (REAL_LOCK(read_file("logos_wm.users"))))
        (CWD(read_file("logos_wm.cwd"))))
        (OPEN_OR_DIE(concat("/dev/input/event")(kbd)))))
  (DETECT(read_file("/proc/bus/input/devices")))
