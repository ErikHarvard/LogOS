# ════════════════════════════════════════════════════════════════
#  numderive.la — NUMBER DERIVED FROM THE NINE, THE 2^(d+2)−1 FORMULA, AND THE NON-INJECTIVITY BOUND
#  (Erik's Gate 3)
#
#  ★ ONE CORRECTION TO THE REQUEST, CHECKED IN THE CODE FIRST. Erik wrote *"Void = zero, Being = one,
#  Becoming = successor."*  Void and Becoming are right; **Being is NOT one.** `primitives.la` has
#  `BEING = la self. self` — the IDENTITY combinator, arity 1 — while Church one is `la f. la x. f(x)`,
#  arity 2. One is not a primitive at all: **one = BECOMING(VOID)**, the successor applied to zero, which
#  is the more interesting fact — unity is DERIVED, not posited. (It is also why `SELF = BEING(BEING)`
#  is a fixed point rather than a numeral.)
#
#  WHAT IS GATED.
#  (1) THE DERIVATION. Zero is `VOID = la a. la b. b` (Church zero exactly), the successor is
#      `BECOMING = la n. la f. la x. f(n(f)(x))`, and the numerals 0..5 are GENERATED by iterating the
#      successor on zero — not declared. Each is decoded to a machine integer by applying it to
#      (+1) and 0, so the claim "these ARE the numerals" is checked, not asserted.
#      ★ The two definitions are CITED, not re-invented: this module declares them locally (importing
#      `primitives.la` beside `canon.la` would collide on `DEPTH`, which both export with DIFFERENT
#      meanings) and then READS `primitives.la` BACK FROM DISK to confirm the two lines match. A drift
#      in the source turns the witness RED.
#  (2) THE FORMULA. The ⊗-self-collapse chain's unfolded size is exactly 2^(d+2)−1 — 3, 7, 15, 31, 63,
#      127 — checked at depths 0..5 against a separately computed power of two. This is where number and
#      glyph meet: the numerals MEASURE the forms, and the dyad iterating is what makes the measure a
#      power of two.
#  (3) ★★ THE BOUND, EXHIBITED AND NOT ASSERTED. The projection form → numeral is **NOT INJECTIVE**, and
#      the module shows exactly where: ⊗(BEING,VOID), ⊕(BEING,VOID), ▷(BEING,VOID) and ⊂(BEING,VOID) are
#      FOUR κ-DISTINCT forms with ONE numeral (3). **The mode is invisible to the count.** That is the
#      precise bound on arithmetising the glyph structure: size is a homomorphic image that forgets the
#      mode, so number can measure a form but cannot identify one. Anything built on "the numeral of a
#      glyph" inherits that blindness.
#
#  GATE (gate_registers.sh §47)  the numerals 0..5 decode correctly and are GENERATED from zero by the
#        successor; the source read-back matches; the 2^(d+2)−1 formula holds at six depths; and the
#        four-forms-one-numeral collapse is exhibited by name.
#        RED PATHS: (1) the successor made the identity — the numerals stop counting and the derivation
#        fails; (2) the non-injectivity probes made κ-IDENTICAL — the exhibit stops exhibiting, which is
#        the guard on the guard: an exhibit of a collapse must show forms that are genuinely DISTINCT.
#  ★ EVIDENTIAL: [W] all three; [B] the non-injectivity is exhibited on a four-form family, which
#     establishes that the projection is not injective — it does not measure how badly.
#  Pure integers + κ walks ⇒ byte-identical on the C host and the SECD VM.
# ════════════════════════════════════════════════════════════════
import("recdepth.la")   # TSIZE NORMK the κ constructors + the base surface

export ND_ZERO ND_SUCC ND_TONUM ND_POW2 ND_CITED

glyph ND_B = la b. b("T")("F")
# Px comes from recdepth.la (a local copy was dead under tiny_host — FREEZE-TRACKF.md F8, removed 2026-09-18)
glyph ND_JOIN = Z(la self. la l. l("")(la h. la t. concat(h)(self(t))))
glyph ND_CONTAINS = Z(la self. la s. la sub. IF(HAS_PREFIX(s)(sub))(la _. TRUE)(la _. IF(str_eq(s)(""))(la _. FALSE)(la _. self(str_tail(s))(sub))))

# ── (1) zero and the successor, CITED from primitives.la and read back from disk ──
glyph ND_ZERO = la a. la b. b                                  # primitives.la: glyph VOID
glyph ND_SUCC = la n. la f. la x. f(n(f)(x))                   # primitives.la: glyph BECOMING
glyph ND_CITED = AND(ND_CONTAINS(read_file("primitives.la"))("glyph VOID = la a. la b. b"))(
                     ND_CONTAINS(read_file("primitives.la"))("glyph BECOMING = la n. la f. la x. f(n(f)(x))"))
glyph ND_TONUM = la n. n(la k. add(k)(1))(0)
glyph ND_NTH = Z(la self. la k. IF(int_eq(k)(0))(la _. ND_ZERO)(la _. ND_SUCC(self(sub(k)(1)))))
glyph ND_SEQ = Z(la self. la k. IF(int_eq(k)(6))(la _. "")(la _. concat(int_to_str(ND_TONUM(ND_NTH(k))))(concat(" ")(self(add(k)(1))))))
glyph ND_OK = Z(la self. la k. IF(int_eq(k)(6))(la _. TRUE)(la _. AND(int_eq(ND_TONUM(ND_NTH(k)))(k))(self(add(k)(1)))))
# BEING is the identity combinator, not one — checked, not asserted
glyph ND_BEING = la self. self
glyph ND_ONE_IS_SUCC_ZERO = int_eq(ND_TONUM(ND_SUCC(ND_ZERO)))(1)

# ── (2) the formula: the ⊗-self-collapse chain measures 2^(d+2)−1 ──
glyph ND_POW2 = Z(la self. la n. IF(int_eq(n)(0))(la _. 1)(la _. mul(2)(self(sub(n)(1)))))
glyph ND_CHAIN = Z(la self. la k. IF(int_eq(k)(0))(la _. KAPPA)(la _. SYN(self(sub(k)(1)))(self(sub(k)(1)))))
glyph ND_SIZES = Z(la self. la k. IF(int_eq(k)(6))(la _. "")(la _. concat(int_to_str(TSIZE(ND_CHAIN(k))))(concat(" ")(self(add(k)(1))))))
glyph ND_FORMULA = Z(la self. la k. IF(int_eq(k)(6))(la _. TRUE)(la _. AND(int_eq(TSIZE(ND_CHAIN(k)))(sub(ND_POW2(add(k)(2)))(1)))(self(add(k)(1)))))

# ── (3) the bound: four κ-distinct forms, one numeral ──
glyph P1 = SYN(Px("BEING"))(Px("VOID"))
glyph P2 = CON(Px("BEING"))(Px("VOID"))
glyph P3 = DIR(Px("BEING"))(Px("VOID"))
glyph P4 = CONT(Px("BEING"))(Px("VOID"))
glyph ND_PROBES = CONSc(PAIRc("⊗")(P1))(CONSc(PAIRc("⊕")(P2))(CONSc(PAIRc("▷")(P3))(CONSc(PAIRc("⊂")(P4))(NILc))))
glyph ND_DISTINCT = Z(la self. la l. l(TRUE)(la h. la t. AND(RD_FOLD(la o. la acc. AND(acc)(NOT(str_eq(NORMK(SNDc(o)))(NORMK(SNDc(h))))))(TRUE)(t))(self(t))))
glyph ND_ONESIZE = RD_FOLD(la e. la acc. AND(acc)(int_eq(TSIZE(SNDc(e)))(3)))(TRUE)(ND_PROBES)
glyph ND_NONINJ = AND(ND_DISTINCT(ND_PROBES))(ND_ONESIZE)

# ── ★★ THE BLINDNESS IS INHERITED, AND THAT IS THE BOUND ON ARITHMETIC'S REACH (Erik: "seal the
#    blindness; it is not a defect, it is a property of the projection — name it").
#    A NUMERIC SEAL builds a glyph from a form's NUMERAL ALONE — exactly what "the numeral of a glyph"
#    means. Because the four probes share one numeral, their numeric seals are ONE GLYPH: everything κ
#    distinguishes about the mode is gone. The κ-seal of the same four keeps them four, which is the
#    contrast that shows the loss is the NUMERAL's and not the sealing's.
#    ★ NAMED: **THE MEASURE HORIZON** — arithmetic's reach within this framework stops where the mode
#    begins. Any construct downstream of a numeral inherits it; measure can say HOW BIG a form is and
#    never WHICH form it is. Not a defect: a homomorphic image forgets, and this names what it forgets.
glyph ND_NFORM = Z(la self. la n. IF(int_eq(n)(0))(la _. Px("BEING"))(la _. CONT(Px("BEING"))(self(sub(n)(1)))))
glyph ND_NSEAL = la f. NORMK(ND_NFORM(TSIZE(f)))          # a glyph built from the NUMERAL alone
glyph ND_KSEAL = la f. NORMK(f)                            # the κ-seal, for contrast
glyph ND_ALLSAME = la s. RD_FOLD(la e. la acc. AND(acc)(str_eq(s(SNDc(e)))(s(P1))))(TRUE)(ND_PROBES)
glyph ND_ALLDIFF = la s. Z(la self. la l. l(TRUE)(la h. la t. AND(RD_FOLD(la o. la acc. AND(acc)(NOT(str_eq(s(SNDc(o)))(s(SNDc(h))))))(TRUE)(t))(self(t))))(ND_PROBES)
glyph ND_HORIZON = AND(ND_ALLSAME(ND_NSEAL))(ND_ALLDIFF(ND_KSEAL))

glyph REPORT =
  ND_JOIN(
  CONSc("NUMDERIVE (1) zero=VOID, successor=BECOMING, both read back from primitives.la:")(
  CONSc(ND_B(ND_CITED))(
  CONSc(" | numerals GENERATED by iterating the successor on zero: ")(
  CONSc(ND_SEQ(0))(
  CONSc("— decode correctly 0..5:")(
  CONSc(ND_B(ND_OK(0)))(
  CONSc(" | ★ CORRECTION: BEING is the IDENTITY combinator, not one — one = BECOMING(VOID):")(
  CONSc(ND_B(ND_ONE_IS_SUCC_ZERO))(
  CONSc("\nNUMDERIVE (2) the ⊗-self-collapse chain measures: ")(
  CONSc(ND_SIZES(0))(
  CONSc("— equals 2^(d+2)−1 at depths 0..5:")(
  CONSc(ND_B(ND_FORMULA(0)))(
  CONSc(" (the dyad iterating is what makes the measure a power of two)")(
  CONSc("\nNUMDERIVE (3) ★★ THE BOUND — form→numeral is NOT INJECTIVE: ⊗(BEING,VOID) ⊕(BEING,VOID) ▷(BEING,VOID) ⊂(BEING,VOID) are pairwise κ-DISTINCT:")(
  CONSc(ND_B(ND_DISTINCT(ND_PROBES)))(
  CONSc(" yet all four measure ")(
  CONSc(int_to_str(TSIZE(P1)))(
  CONSc(" — four forms, ONE numeral:")(
  CONSc(ND_B(ND_NONINJ))(
  CONSc("\nNUMDERIVE ★★ THE BLINDNESS IS INHERITED — a glyph built from the NUMERAL alone collapses all four probes to ONE:")(
  CONSc(ND_B(ND_ALLSAME(ND_NSEAL)))(
  CONSc(" while the κ-seal of the same four keeps them FOUR:")(
  CONSc(ND_B(ND_ALLDIFF(ND_KSEAL)))(
  CONSc(" → the loss is the NUMERAL's, not the sealing's:")(
  CONSc(ND_B(ND_HORIZON))(
  CONSc(" ★ NAMED: THE MEASURE HORIZON — arithmetic's reach within this framework stops where the mode begins. Anything downstream of a numeral inherits it: measure can say HOW BIG a form is and never WHICH form it is. [W] sealed as a property of the projection, not a defect.")(
  CONSc(" ★ THE MODE IS INVISIBLE TO THE COUNT. Size is a homomorphic image that forgets the mode, so number can MEASURE a form but cannot IDENTIFY one, and anything built on “the numeral of a glyph” inherits that blindness. [B] exhibited on a four-form family: establishes non-injectivity, does not measure how badly")(
  NILc))))))))))))))))))))))))))))
glyph MAIN = print(REPORT)
