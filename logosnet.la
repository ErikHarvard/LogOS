                                         (la _. loaded(read_file(path)))
                                         (la _. die(concat("key file ")(concat(path)(" must hold 32 bytes"))))(C0))
                                (la _. die(concat("key file ")(concat(path)(" must be mode 0600 (no access for group or others)"))))(C0))
                       (la _. die(concat("key file ")(concat(path)(" is not a regular file"))))(C0)))
            (C0))
        (stat(path))))(la identity.
      la s. s(node_id)(verify_id)(identity)))))))))
  (0)(1)(16)(32)(63)(61440)(32768)(la t. la f. f)))))

# ── The kit ──────────────────────────────────────────────────────────────
glyph NET_KIT = la B. la X. la crypt. la xk.
  (la BY. NET_FRAMES(B)(BY)(la frame. la deframe. la broken.
     NET_NOISE(B)(BY)(crypt)(xk)(NET_MK)(la keypair. la xx_init. la xx_resp. la x_init. la x_resp.
         la write_message. la read_message. la done. la encrypt. la decrypt. la prologue.
     NET_ID(B)(X)(BY)(crypt)(keypair)(la node_id. la verify_id. la identity.
       la s. s(frame)(deframe)(broken)
              (keypair)(xx_init)(xx_resp)(x_init)(x_resp)
              (write_message)(read_message)(done)(encrypt)(decrypt)(prologue)
              (node_id)(verify_id)(identity)))))
