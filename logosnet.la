# ── The node: constructors, lists, text ─────────────────────────────────
# NODE_MK(la mklink. la mkent. la mkst. la mkseen. la mkctl. la mkpair.)
#   link  la k. k(fd)(phase)(hs)(tx)(rx)(buf)(peer)(expect)(t0)
#         phase 0 handshake (hs the handshake state), 1 up (tx/rx the cipher
#         states, peer its NodeID), 2 dead (closed at the end of the pass);
#         buf the deframe buffer; expect the NodeID a dialled link must
#         reach ("" for an accepted one); t0 when it started (monotonic ms)
#   entry la k. k(id)(pub)(path)(seq)(seen)   a directory entry; seen in
#         seconds of the realtime clock
#   state la k. k(links)(dir)(seen)(seq)(ctls)(tick)(quit)
#   seen  la k. k(cur)(old)(n)   the DATA msgids remembered: cur holds the
#         newest n (at most 4096), old the 4096 before them
#   ctl   la k. k(fd)(buf)(done)(tag) a control connection; tag is "",
#         or the tag it listens for (listen)
glyph NODE_MK = la s. s
  (la fd. la phase. la hs. la tx. la rx. la buf. la peer. la expect. la t0.
     la k. k(fd)(phase)(hs)(tx)(rx)(buf)(peer)(expect)(t0))
  (la id. la pub. la path. la seq. la seen. la k. k(id)(pub)(path)(seq)(seen))
  (la links. la dir. la seen. la seq. la ctls. la tick. la quit. la k. k(links)(dir)(seen)(seq)(ctls)(tick)(quit))
  (la cur. la old. la n. la k. k(cur)(old)(n))
  (la fd. la buf. la done. la tag. la k. k(fd)(buf)(done)(tag))
  (la a. la b. la k. k(a)(b))

