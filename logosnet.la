                            enchash(sym)(spub)(la ct. la sym2. wt(rest)(keys)(sym2)(concat(out)(ct))(k))))
                   (la _. wt(rest)(keys)(mixkey(sym)(dhw(keys)(tok)))(out)(k))
                   (C0))
