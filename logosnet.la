                         (byte(s)(i)))(C0)(len(s)))(la sanitize.
    LET(Z(la jn. la l. l(la _. "")(la h. la t. concat(concat("\n")(h))(jn(t)))))(la joinnl.
      la s. s(split)(words)(endswith)(sanitize)(joinnl)))))))
  (0)(1)(32)(126)(la t. la f. t)(la t. la f. f)(NET_NIL)(NET_CONS))))

# ── The node ─────────────────────────────────────────────────────────────
glyph NODE = la B. la X. la crypt. la net. la cfgtext.
  B(la str_at. la ord. la str_to_int. la int_to_str. la chr. la concat. la str_len. la str_eq. la error.
    la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor. la bxor. la bshl. la bshr.
  X(la socket. la bind. la listen. la accept. la connect. la send. la recv. la close. la unlink. la poll.
    la random. la clock_gettime. la print. la read_file. la write_file. la chmod. la stat. la mkdir. la rmdir.
    la rename. la sigprocmask.
  crypt(la sha256. la hmac. la hkdf. la seal. la open. la hex.
  net(la frame. la deframe. la broken. la keypair. la xx_init. la xx_resp. la x_init. la x_resp.
      la write_message. la read_message. la done. la encrypt. la decrypt. la prologue.
      la node_id. la verify_id. la identity.
  (la BY. la LS. BY(la len. la span. la T. la slice. la byte. la rdbe32. la be32. la le64. la rev. la zeros.
   LS(la map. la filter. la find. la any. la count. la append. la foldl.
   NODE_TEXT(B)(BY)(LS)(la split. la words. la endswith. la sanitize. la joinnl.
   NODE_MK(la mklink. la mkent. la mkst. la mkseen. la mkctl. la mkpair.
