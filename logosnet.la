# ── Identity ─────────────────────────────────────────────────────────────
# NET_ID(B)(X)(BY)(crypt)(keypair) -> la s. s(node_id)(verify_id)(identity)
glyph NET_ID = la B. la X. la BY. la crypt. la keypair.
  B(la str_at. la ord. la str_to_int. la int_to_str. la chr. la concat. la str_len. la str_eq. la error.
    la add. la sub. la mul. la div. la mod. la lt. la int_eq. la band. la bor. la bxor. la bshl. la bshr.
  X(la socket. la bind. la listen. la accept. la connect. la send. la recv. la close. la unlink. la poll.
    la random. la clock_gettime. la print. la read_file. la write_file. la chmod. la stat. la mkdir. la rmdir.
    la rename. la sigprocmask.
  BY(la len. la span. la T. la slice. la byte. la rdbe32. la be32. la le64. la rev. la zeros.
  crypt(la sha256. la hmac. la hkdf. la seal. la open. la hex.
  (la C0. la C1. la C16. la C32. la C63. la C61440. la C32768. la FALSE.
    LET(la a. la b. b)(la seq.
    LET(la pub. hex(slice(sha256(pub))(C0)(C16)))(la node_id.
    LET(la id. la pub. int_eq(len(pub))(C32)(la _. str_eq(id)(node_id(pub)))(la _. FALSE)(C0))(la verify_id.
    LET(la what. error(concat("logosnet: identity: ")(what)))(la die.
    # stat's answer "<st_mode> <st_size>" as two integers: k(mode)(size)
    LET(la st. la k. (la n. Z(la go. la i.
          lt(i)(n)
            (la _. str_eq(str_at(st)(i))(" ")
                     (la _. k(str_to_int(slice(st)(C0)(i)))(str_to_int(slice(st)(add(i)(C1))(n))))
                     (la _. go(add(i)(C1)))(C0))
            (la _. die(concat("cannot read the answer of stat: ")(st)))(C0))(C0))
        (len(st)))(la stat2.
    # loaded(sk): la k. k(keypair)(id)
    LET(la sk. (la kp. kp(la s. la pub. la k. k(kp)(node_id(pub))))(keypair(sk)))(la loaded.
    LET(Z(la identity. la path.
        (la st.
          str_eq(str_at(st)(C0))("-")
            (la _. str_eq(st)("-2")
                     # absent: a fresh key, written inside a private (0700)
                     # directory, made 0600 before it holds the key, then
                     # renamed into place
                     (la _. (la d. (la f. (la sk.
                               int_eq(len(sk))(C32)
                                 (la _. seq(unlink(f))(seq(rmdir(d))(
                                          (la r. str_eq(r)("0")
                                             (la _. seq(write_file(f)(""))(seq(chmod(f)("384"))(seq(write_file(f)(sk))(
                                                      (la r2. str_eq(r2)("0")
                                                         (la _. seq(rmdir(d))(identity(path)))
                                                         (la _. die(concat("cannot rename ")(concat(f)(concat(": ")(r2)))))(C0))
                                                      (rename(f)(path))))))
                                             (la _. die(concat("cannot create ")(concat(d)(concat(": ")(r)))))(C0))
                                          (mkdir(d)("448")))))
