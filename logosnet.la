                             str_eq(e)("")
                               (la _. rt(rest)(mkkeys(init)(s)(spub)(e)(epub)(rs)(re)(eedh)(esdh))
                                        (mixhash(sym)(re))(msg)(n)(add(pos)(C32)))
                               (la _. shared(e)(re)(la _. NONE)
                                        (la dh. rt(rest)(mkkeys(init)(s)(spub)(e)(epub)(rs)(re)(dh)(esdh))
                                                  (mixhash(sym)(re))(msg)(n)(add(pos)(C32))))
