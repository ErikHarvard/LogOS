    LET(Z(la foldl. la f. la z. la l. l(la _. z)(la h. la t. foldl(f)(f(z)(h))(t))))(la foldl.
      la s. s(map)(filter)(find)(any)(count)(append)(foldl)))))))))
  (0)(1)(la t. la f. t)(la t. la f. f)(NET_NIL)(NET_CONS))

# NODE_TEXT(B)(BY)(LS) -> la s. s(split)(words)(endswith)(sanitize)(joinnl)
