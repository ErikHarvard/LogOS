# ═══════════════════════════════════════════════════════════════════
#  felicitylive.la — ONTOFELICITY → LIVE ENFORCEMENT (LA_COMPLETION.md item "`ontofelicity` → live
#  enforcement": "PERFORM currently reports; wiring it to the real capability layer makes felicity
#  enforceable." Verified 09-10: "ontofelicity.la imports nothing. Its capability sets are string data,
#  not wired to a capability layer.")
#
#  Austin's condition (B) — the persons and circumstances are appropriate — is, at α = 1, a
#  CAPABILITY CHECK: "I hereby open X" succeeds exactly when the speaker's capability set contains X
#  (ontofelicity.la's finding: ontopragmatics is the semantics of the security model). Here (B) stops
#  being a substring test on a string of verbs and becomes logoscap.la's SEALER: a realm is
#  BRAND(secret) = (seal, unseal); a capability is the needed verb SEALED under the granting realm's
#  secret; the speaker holds it iff the speaker's UNSEAL opens it (SOME) — a foreign realm's unseal
#  and a forged probe both read NONE. Nothing else in ontofelicity changes: (A) well-formedness and
#  (Γ) uptake are the same conditions, and the world is provably unchanged on refusal.
#
#  GATE: the authorized realm performs ("performed:open", world grows); the foreign realm is
#  REFUSED with (B)=F named and the world byte-identical; a forged probe is refused; the string-caps
#  PERFORM and the live PERFORM agree on the authorized case (the refactor changed the mechanism,
#  not the verdict). RED (mutation): unsealing with the BOX'S OWN secret (a bypass) makes the
#  foreign realm pass — the gate turns RED. MINT (random secrets) is deliberately NOT used: the
#  witness must be byte-identical host==VM, so realms are branded with fixed secrets.
#  ★ EVIDENTIAL: [W] the four assertions; [B] one verb, two realms; logoscap's sealer is the
#     Morris object-capability model (exact in λ), not an OS ACL.
#  ⚖ RECLASSIFIED 2026-09-18 against the standing rule (FREEZE-TRACKF.md F35): of this module's 2 pinned witnesses — red-proven 1 · fixture-backed 1 · exact but CAPTURED 1 [B: the value is pinned, not derived — a regression turns it red; its correctness is unwitnessed]. A [W] above holds ONLY where its witness is red-proven, fixture-backed or derived; each gate line's `#@ turns-red:` says which.
# ═══════════════════════════════════════════════════════════════════
import("logoscap.la")       # SEAL UNSEAL BRAND GRANT_SEND GRANT_RECV SOME NONE
import("ontofelicity.la")   # UTT CTX PERFORM FELICITY DIAG COND_A COND_G HAS WRAP

export PERFORM_LIVE FELICITY_LIVE COND_B_LIVE

glyph FL_SEQ  = la a. la b. b
glyph FL_TRUE = la t. la f. t
glyph FL_FALSE= la t. la f. f
glyph FL_IF   = la c. la t. la f. c(t)(f)("!")
glyph FL_AND  = la a. la b. a(b)(FL_FALSE)
glyph FL_NOT  = la b. b(FL_FALSE)(FL_TRUE)
glyph FL_BSTR = la b. b("T")("F")
glyph FL_PAIR = la a. la b. la f. f(a)(b)
glyph FL_FST  = la p. p(la a. la b. a)
glyph FL_SND  = la p. p(la a. la b. b)
glyph FL_C3 = la a. la b. la c. concat(a)(concat(b)(c))
glyph FL_UVERB = la u. u(la v. la n. v)
glyph FL_UNEED = la u. u(la v. la n. n)

# a capability for a verb, sealed under the granting realm: the box opens only for that realm's unseal
glyph FL_CAP = la realm. la verb. GRANT_SEND(realm)(verb)
# (B) live: the speaker's realm opens the box AND what it holds is the verb the utterance needs
glyph COND_B_LIVE = la u. la speaker. la box. GRANT_RECV(speaker)(box)(la held. str_eq(held)(FL_UNEED(u)))(FL_FALSE)
glyph FELICITY_LIVE = la u. la ctx. la speaker. la box. FL_AND(COND_A(u))(FL_AND(COND_B_LIVE(u)(speaker)(box))(COND_G(ctx)))
glyph FL_DIAG = la u. la ctx. la speaker. la box. FL_C3(FL_BSTR(COND_A(u)))(FL_BSTR(COND_B_LIVE(u)(speaker)(box)))(FL_BSTR(COND_G(ctx)))
glyph PERFORM_LIVE = la u. la ctx. la speaker. la box. la world.
    FL_IF(FELICITY_LIVE(u)(ctx)(speaker)(box))
      (la _. FL_PAIR(FL_C3(world)(" +")(FL_UVERB(u)))(concat("performed:")(FL_UVERB(u))))
      (la _. FL_PAIR(world)(FL_C3("INFELICITOUS ")(FL_DIAG(u)(ctx)(speaker)(box))(concat(" refusing:")(FL_UVERB(u)))))

# ── the vectors: fixed secrets (no MINT), one verb, two realms, a forged probe ──
glyph REALM_A = BRAND("realm-A-secret")
glyph REALM_B = BRAND("realm-B-secret")
glyph U_OPEN  = UTT("open")("open")
glyph C_WIT   = CTX("speaker")("witness")
glyph BOX_A   = FL_CAP(REALM_A)("open")
glyph R_AUTH  = PERFORM_LIVE(U_OPEN)(C_WIT)(REALM_A)(BOX_A)("world")
glyph R_FOREIGN = PERFORM_LIVE(U_OPEN)(C_WIT)(REALM_B)(BOX_A)("world")
glyph FORGED  = BOX_A("guess-the-secret")(la held. FL_TRUE)(FL_FALSE)
glyph R_STRING = PERFORM(U_OPEN)(C_WIT)("|open|")("world")

glyph LINE1 = FL_C3("FELICITY-LIVE authorized realm: ")(FL_SND(R_AUTH))(FL_C3(" world=")(FL_FST(R_AUTH))(FL_C3(" | foreign realm: ")(FL_SND(R_FOREIGN))(FL_C3(" world unchanged:")(FL_BSTR(str_eq(FL_FST(R_FOREIGN))("world")))(""))))
glyph LINE2 = FL_C3("FELICITY-LIVE forged probe opens the box:")(FL_BSTR(FORGED))(FL_C3(" | string-caps PERFORM and live PERFORM agree on the authorized case:")(FL_BSTR(str_eq(FL_SND(R_STRING))(FL_SND(R_AUTH))))(FL_C3(" | (B) is now the sealer, not a substring: ")(FL_BSTR(FL_AND(COND_B_LIVE(U_OPEN)(REALM_A)(BOX_A))(FL_NOT(COND_B_LIVE(U_OPEN)(REALM_B)(BOX_A)))))("")))
glyph MAIN = FL_SEQ(print(LINE1))(print(LINE2))
