# ═══════════════════════════════════════════════════════════════════
#  theourgia_wm_sim.la — the tiling window manager, headless.
#
#  The same window manager as theourgia_wm_live.la — the same WM_BUILD, the
#  same poll loop, real shells, real child processes — with the two devices
#  replaced by files: the keyboard is a file of 24-byte evdev records, and the
#  screen is a frame file written whenever the input asks for one. So a whole
#  session runs, and is checked, with no VT, no GPU and no keyboard.
#
#  CONFIGURATION: wm_sim.cfg, one line, "W H SCALE CWD EVENTS [async] [users=DIR]":
#    W H     the frame size in pixels (the pitch is 4*W), each at least 12
#    SCALE   the text scale (a character cell is 8*SCALE pixels square)
#    CWD     the directory new shells start in
#    EVENTS  the event file; wm_script.py writes one from a readable script
#    async   optional: read input whenever it arrives, as the live WM does
#            (up to 100 events per read, as the live WM reads them), instead
#            of one at a time and only while no command runs. Frames are still written
#            only on request. For a test that drives the WM through a FIFO
#            with real timing, e.g. MOD+c or MOD+q while a program runs; such a
#            session is only as deterministic as its timing.
#    users=DIR  optional: the lock screen logs in through LogosSession
#            (logossession.la) over the users in DIR. This entry refuses it;
#            theourgia_wm_simsess.la, the same WM with the real session layer
#            built in, requires it. Without it the lock screen uses SIM_SESS.
#  A record of type 85 and code N writes frame N to wm_shot_N.bin (H rows of
#  4*W bytes, B G R 0 per pixel); wm_shot.py turns it into a PNG and wm_ocr.py
#  reads its text back.
#
#  LOCK SCREEN: MOD+Esc locks; the session layer behind it is SIM_SESS below, a
#  stand-in (user adam, passphrase logos), or LogosSession itself when the WM
#  is run as theourgia_wm_simsess.la (which starts locked, as the live WM
#  does). SIM_RUN(ui) is the whole run, with ui(users) giving WM_BUILD's UI
#  record (and so the lock screen) from the users=DIR option ("" when it is
#  absent); SIM_MAIN(layer) is SIM_RUN with the login screen over layer(users),
#  unlocked at the start. SIM_RUN and SIM_UI are exported for
#  theourgia_wm_simsess.la.
#
#  DETERMINISM: input is read one event at a time and only while no command is
#  running, so "type ls, press Enter, take a frame" always shows ls's output.
#  The run ends when the events are exhausted and nothing is running, or on
#  MOD+Shift+e. Everything the WM does is logged on stdout ("wm: ...").
#
#  Run: put wm_sim.cfg and the event file beside the modules, compile this file
#  with the VM's compiler (codegen.la running as compiler.bin) and run it on the
#  VM. gate_wm_session.sh does exactly that.
# ═══════════════════════════════════════════════════════════════════

import("theourgia_tile.la")
import("theourgia_term.la")
import("theourgia_render.la")
import("logosh.la")
import("theourgia_wm.la")
import("theourgia_termfont.la")
import("logoskit.la")
import("lk_settings.la")
import("lk_login.la")

glyph B = la s. s(str_at)(ord)(str_to_int)(int_to_str)(concat)(str_eq)(str_len)
                (add)(sub)(mul)(div)(mod)(lt)(int_eq)(band)(bor)
glyph X = la s. s(poll)(read)(close)(print)(write_file)(exit)

export SIM_MAIN SIM_RUN SIM_UI SIM_SESS

# the words of wm_sim.cfg (newlines and carriage returns are dropped). A bad value stops the run
# at once with a message: W and H must be at least 12, SCALE 1 or more, and each
# word after EVENTS must be async or users=DIR, each at most once. 12 is the smallest screen the WM
# can lay out: it leaves a 6-pixel gap (GAP in WM_BUILD) on every side, so a
# narrower or shorter screen has a negative tile area (the tiles started off
# the screen, or compose refused the lock window, which is at most W - 12 wide).
glyph CFG = la k. (la words. words(la _. error("wm_sim: wm_sim.cfg is empty"))
    (la w0. la r0. r0(la _. error("wm_sim: wm_sim.cfg needs W H SCALE CWD EVENTS"))
    (la w1. la r1. r1(la _. error("wm_sim: wm_sim.cfg needs W H SCALE CWD EVENTS"))
    (la w2. la r2. r2(la _. error("wm_sim: wm_sim.cfg needs W H SCALE CWD EVENTS"))
    (la w3. la r3. r3(la _. error("wm_sim: wm_sim.cfg needs W H SCALE CWD EVENTS"))
    (la w4. la r4. (la W. la H. (la tiny. lt(W)(12)(tiny)(la _. lt(H)(12)(tiny)(la _.
      (la scale. lt(scale)(1)
        (la _. error(concat("wm_sim: SCALE must be 1 or more, not ")(w2)))
        (la _. OPTS(r4)(la t. la f. t)("")(k(W)(H)(scale)(w3)(w4)))("!"))
      (str_to_int(w2)))("!"))("!"))
      (la _. error(concat("wm_sim: W and H must be at least 12 (the WM leaves a 6-pixel gap on every side), not ")
                     (concat(w0)(concat("x")(w1))))))
      (str_to_int(w0))(str_to_int(w1))))))))
  (WM_SPLIT(B)(WM_LISTS(B))(STRIP_NL(read_file("wm_sim.cfg"))))
# OPTS(words)(sync)(users)(k): k(sync)(users) after the words that follow
# EVENTS: async (sync becomes FALSE) and users=DIR, each at most once
glyph OPTS = Z(la self. la r. la sync. la users. la k.
  r(la _. k(sync)(users))
   (la w. la rest.
     str_eq(w)("async")
       (la _. sync(la _. self(rest)(la t. la f. f)(users)(k))
                  (la _. error("wm_sim: async is given twice in wm_sim.cfg"))("!"))
       (la _. str_eq(TAKEN(6)(w))("users=")
          (la _. (la dir. str_eq(dir)("")
                    (la _. error("wm_sim: users= needs a directory"))
                    (la _. str_eq(users)("")
                              (la _. self(rest)(sync)(dir)(k))
                              (la _. error("wm_sim: users= is given twice in wm_sim.cfg"))("!"))("!"))
                 (DROPN(6)(w)))
          (la _. error(concat("wm_sim: a word after EVENTS in wm_sim.cfg must be async or users=DIR, not ")(w)))("!"))("!")))
glyph TAKEN = Z(la self. la n. la s. int_eq(n)(0)(la _. "")
  (la _. str_eq(s)("")(la _. "")(la _. concat(str_head(s))(self(sub(n)(1))(str_tail(s))))("!"))("!"))
glyph DROPN = Z(la self. la n. la s. int_eq(n)(0)(la _. s)(la _. self(sub(n)(1))(str_tail(s)))("!"))
# The lock screen's session layer, a stand-in for logossession.la (which
# theourgia_wm_simsess.la uses instead): one user, adam, passphrase logos; a session is "S:<name>" and a locked
# one "L:S:<name>". It exists so a headless session can lock and unlock; it
# holds no keys and protects nothing.
glyph SIM_SESS = la s. s
  (la name. la pass. str_eq(name)("adam")(la _. str_eq(pass)("logos")(la _. la e. la o. o(concat("S:")(name)))(la _. la e. la o. e("no"))("!"))(la _. la e. la o. e("no"))("!"))
  (la sn. concat("L:")(sn))
  (la l. la pass. str_eq(pass)("logos")(la _. la e. la o. o(str_tail(str_tail(l))))(la _. la e. la o. e("no"))("!"))
glyph Z = la f. (la x. f(la v. x(x)(v)))(la x. f(la v. x(x)(v)))
glyph STRIP_NL = Z(la self. la s.
    str_eq(s)("")(la _. "")(la _.
      (la c. str_eq(c)("\n")(la t. la f. t)(str_eq(c)(chr("13")))(la _. self(str_tail(s)))(la _. concat(c)(self(str_tail(s))))("!"))
      (str_head(s)))("!"))

# the events file: a missing one or a directory stops the run with a message
# (an unchecked "-2" from open would be polled as fd 2, forever)
glyph OPEN_EVENTS = la path. (la st.
    str_eq(str_head(st))("-")
      (la _. error(concat("wm_sim: cannot open the events file ")(concat(path)(concat(" (stat -> ")(concat(st)(")"))))))
      (la _. int_eq(mod(div(str_to_int(WM_SPLIT(B)(WM_LISTS(B))(st)(la _. "0")(la h. la t. h)))(4096))(16))(4)
         (la _. error(concat("wm_sim: the events file ")(concat(path)(" is a directory"))))
         (la _. (la fd. str_eq(str_head(fd))("-")
                  (la _. error(concat("wm_sim: cannot open the events file ")(concat(path)(concat(" (open -> ")(concat(fd)(")"))))))
                  (la _. fd)("!"))
                (open(path)("0")))("!"))("!"))
  (stat(path))

# SIM_RUN(ui): the headless WM, with ui(users) as WM_BUILD's UI record
# (la s. s(LK_KIT)(SETTINGS_APP)(lockcfg)); users is the users=DIR word ("" when
# it is absent), and ui(users) runs before the events file is opened or
# anything is drawn, so a lock screen that cannot be built stops the run first
glyph SIM_RUN = la UI. CFG(la W. la H. la SCALE. la CWD. la EVENTS. la SYNC. la USERS. (la UIREC.
  (la fd.
    (la _.
      WM_BUILD(B)(X)
        (TILE_KIT(add)(sub)(mul)(div)(lt)(int_eq)(concat)(int_to_str))
        (TERM_KIT(str_at)(ord)(str_to_int)(str_len)(chr)(concat)(str_eq)(add)(sub)(mul)(div)(mod)(lt)(int_eq))
        ((la font. la sc. RENDER_KIT(str_at)(ord)(str_to_int)(str_len)(chr)(int_to_str)(concat)(add)(sub)(mul)(div)(int_eq)(lt)(band)(str_eq)(error)(font)(sc))(TF_DECODE(str_at)(ord)(str_to_int)(str_len)(chr)(int_to_str)(concat)(add)(sub)(mul)(div)(int_eq)(TF_HEX)))
        (SHELL_KIT(concat)(str_at)(str_len)(str_eq)(ord)(str_to_int)(int_to_str)(add)(sub)(mul)(div)(mod)(lt)(int_eq)
          (read_file)(stat)(mkdir)(rmdir)(unlink)(rename)(getpid)(pipe)(fork)(dup2)(open)(close)(execv)(exit)(sigprocmask)(waitpid)(kill)(poll))
        (UIREC)
        (la s. s(W)(H)(mul(W)(4))(SCALE)(CWD))
        (la s. s(la bytes. bytes)(WM_CONS(fd)(WM_NIL))(SYNC("24")("2400"))(SYNC)))
    (print(concat("wm: headless ")(concat(int_to_str(W))(concat("x")(concat(int_to_str(H))
        (concat(" scale ")(concat(int_to_str(SCALE))(concat(", events from ")(concat(EVENTS)
        (str_eq(USERS)("")(la _. "")(la _. concat(", users in ")(USERS))("!"))))))))))))
  (OPEN_EVENTS(EVENTS)))
  (UI(USERS)))

# SIM_UI(lockcfg): WM_BUILD's UI record with that lock screen, LogosKit and the
# settings panel (for theourgia_wm_simsess.la, which does not see LK_KIT)
glyph SIM_UI = la lockcfg. la s. s(LK_KIT)(SETTINGS_APP)(lockcfg)

# SIM_MAIN(layer): the headless WM, with layer(users) as the login screen's
# session layer, the WM starting unlocked
glyph SIM_MAIN = la LAYER. SIM_RUN(la USERS. (la SESS.
        (la s. s(LK_KIT)(SETTINGS_APP)(la n. la s. s(la k. k(LOGIN_APP)(SESS)(la t. la f. f)))))
  (LAYER(USERS)))

glyph MAIN = SIM_MAIN(la users. str_eq(users)("")(la _. SIM_SESS)
  (la _. error("wm_sim: users= needs the real session layer: run theourgia_wm_simsess.la"))("!"))
