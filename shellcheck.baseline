# shellcheck.baseline — the findings `shellcheck -f gcc *.sh kernel/*.sh` (ShellCheck 0.9.0)
# reported on kernel-k1 @ 9df29b0 (93 findings). gate_shellcheck.sh fails only on a finding
# NOT listed here. Key: <file>|<SCcode>|<source line, whitespace-collapsed> — not the line
# number, so editing elsewhere in a file does not churn the baseline. A repeated key
# is listed once per occurrence. Fixing a baselined finding needs no edit here (the
# gate reports it as fixed); deleting its line afterwards tightens the baseline.
build.sh|SC2015|! HSYM "g7 BECOMING" "$2" && ! VSYM "g7 BECOMING" "$2" || { echo "FAIL sigil($1): BECOMING spiral not chiral (expect neither H nor V symmetric)"; ok=0; }
build.sh|SC2015|&& echo "PASS PID 1 reaps an orphaned grandchild via reparenting: 2 reaps" \
build.sh|SC2015|&& echo "PASS reap(-1) drains direct children: forked 3, reaped 3, then ECHILD" \
build.sh|SC2015|HSYM "g2 RECOGNITION" "$2" && VSYM "g2 RECOGNITION" "$2" || { echo "FAIL sigil($1): RECOGNITION eye not mutual (expect H+V symmetric)"; ok=0; }
build.sh|SC2015|HSYM "g3 LOVE" "$2" && ! VSYM "g3 LOVE" "$2" || { echo "FAIL sigil($1): LOVE flame not upright (expect H symmetric, NOT V)"; ok=0; }
build.sh|SC2015|HSYM "g4 SELF" "$2" && VSYM "g4 SELF" "$2" || { echo "FAIL sigil($1): SELF not a centred lemniscate (expect H+V symmetric)"; ok=0; }
build.sh|SC2015|HSYM "g6 VOID" "$2" && ! VSYM "g6 VOID" "$2" || { echo "FAIL sigil($1): VOID gap not at the crown (expect H symmetric, NOT V)"; ok=0; }
build.sh|SC2015|HSYM "g8 FORM" "$2" && ! VSYM "g8 FORM" "$2" || { echo "FAIL sigil($1): FORM apex not up (expect H symmetric, NOT V)"; ok=0; }
build.sh|SC2015|[ "$NAT_INT" = "$HOST_INT" ] && [ "$NAT_INT" = "$(printf '44\n3\nyes')" ] \
build.sh|SC2015|[ "$RTC_IN" -ge 40 ] && [ "$RTC_EX" -ge 1 ] \
build.sh|SC2015|[ -f "$SIB_A" ] && [ -f "$SIB_B" ] || { echo "FAIL a sibling file is missing"; ok=0; }
build.sh|SC2015|[ -n "$BYTE_CHILD" ] && [ -f "$BYTE_CHILD" ] && cmp -s tiny_host "$BYTE_CHILD" \
build.sh|SC2015|[ -n "$EVAL_CHILD" ] && [ -f "$EVAL_CHILD" ] && cmp -s tiny_host "$EVAL_CHILD" \
build.sh|SC2015|[ -n "$LF3" ] && [ -n "$RF3" ] || { echo "FAIL formant-guard: could not extract phonym's formant triples"; ok=0; }
build.sh|SC2015|[ -n "$SECD_EXPECT" ] && [ "$SECD_EXPECT" -gt 1024 ] \
